{% extends 'base.html.twig' %}

{% block title %}{{ item.name }} ({{ item.cui }}) — Registrals{% endblock %}
{% block meta_description %}Fitxa oficial de custòdia de {{ item.name }} a Registrals.{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {# Barra Superior Privada Unificada (Fons Blanc + Línia Tènue + Avatar) #}
  {% include 'partials/_private_header.html.twig' %}

  {# Contingut Principal de la Fitxa de Bé #}
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 w-full flex-1 pb-16 md:pb-3">

    {# ==================================================================== #}
    {# 1. VISTA MÒBIL (< lg): PWA HERO LAYOUT (Foto Primer + Accions a Mà) #}
    {# ==================================================================== #}
    {# ==================================================================== #}
    {# 1. VISTA MÒBIL (< lg): ORDRE: TÍTOL -> FOTO -> FITXA -> PROVES -> GARANTIA #}
    {# ==================================================================== #}
    <div class="lg:hidden space-y-4">

      {# 1. TÍTOL & IDENTITAT (Nom, Categoria, CUI, Estat i Valor Estimat) #}
      <div class="bg-whitef border border-gold/30 rounded-2xl p-4 shadow-2xs space-y-2.5">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1.5 text-xs text-ink/60 font-semibold mb-0.5 truncate">
              <span>{{ item.category.name }}</span>
              {% if item.subcategory %}<span>&middot; {{ item.subcategory.name }}</span>{% endif %}
            </div>
            <h1 class="text-2xl font-marcellus text-ink leading-tight truncate">{{ item.name }}</h1>
          </div>
          {% if item.declaredValueEuros is not null %}
            <div class="text-right shrink-0 bg-cream/30 border border-gold/40 px-3 py-1.5 rounded-xl">
              <div class="text-[9px] uppercase tracking-wider text-ink/50 font-bold">Valor Estimat</div>
              <div class="font-bold text-ink text-sm font-raleway">
                {{ item.declaredValueEuros|number_format(0, ',', '.') }} €
              </div>
            </div>
          {% endif %}
        </div>

        {# Píndoles CUI + Estat Notarial #}
        <div class="flex items-center gap-2 pt-1 border-t border-cream">
          <span class="bg-ink text-cream text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-lg shadow-2xs border border-gold/40">
            {{ item.cui }}
          </span>
          <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-full border bg-white shadow-2xs {{ item.status.badgeClasses }}">
            {% if item.status.value == 'active' %}
              <svg class="w-2.5 h-2.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <span>Custodiat</span>
            {% else %}
              <span>{{ item.status.label }}</span>
            {% endif %}
          </span>
        </div>
      </div>

      {# 2. FOTO (Marc Panoràmic 16:9 + Barra d'Acció Ràpida) #}
      <div class="space-y-2">
        <div class="relative rounded-2xl overflow-hidden aspect-video bg-cream/40 border border-gold/30 shadow-md">
          {% if item.mainPhoto %}
            <img src="{{ path('app_media_document', {'uuid': item.mainPhoto.uuid}) }}" alt="{{ item.name }}" class="w-full h-full object-cover cursor-pointer" onclick="openDocPreview('{{ path('app_media_document', {'uuid': item.mainPhoto.uuid}) }}', '{{ item.mainPhoto.originalFilename|e('js') }}', '{{ item.mainPhoto.mimeType }}', '{{ item.mainPhoto.sha256Hash }}', '{{ (item.mainPhoto.fileSizeBytes / 1024)|round(1) }} KB')" />
          {% else %}
            <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center text-ink/50 bg-cream/20">
              <svg class="w-12 h-12 text-steel/40 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span class="text-xs">Sense fotografia principal registrada</span>
            </div>
          {% endif %}

          {# Badge Principal a la Cantonada Superior Esquerra #}
          <div class="absolute top-2.5 left-2.5 z-10">
            <span class="bg-ink/90 backdrop-blur-md text-gold text-[10px] font-bold px-2 py-0.5 rounded-lg border border-gold/40 flex items-center gap-1 shadow-xs">
              <svg class="w-2.5 h-2.5 text-gold fill-gold" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <span>Foto Principal</span>
            </span>
          </div>

          {# Barra Inferior de Segellat SHA-256 amb Opció d'Ampliar #}
          {% if item.mainPhoto %}
            <div class="absolute bottom-2 left-2 right-2 bg-ink/80 backdrop-blur-md text-[10px] text-cream px-3 py-1.5 rounded-xl flex items-center justify-between font-mono cursor-pointer" onclick="openDocPreview('{{ path('app_media_document', {'uuid': item.mainPhoto.uuid}) }}', '{{ item.mainPhoto.originalFilename|e('js') }}', '{{ item.mainPhoto.mimeType }}', '{{ item.mainPhoto.sha256Hash }}', '{{ (item.mainPhoto.fileSizeBytes / 1024)|round(1) }} KB')">
              <span class="text-gold font-bold">SHA-256</span>
              <span class="truncate ml-1.5 text-cream/80 text-[9px]">{{ item.mainPhoto.sha256Hash|slice(0, 18) }}...</span>
              <span class="text-[9px] text-gold font-bold ml-1 shrink-0 flex items-center gap-0.5">
                <span>Ampliar</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </span>
            </div>
          {% endif %}
        </div>

        {# Barra d'Acció Ràpida Foto Mòbil (Nova Foto) #}
        <div class="flex items-center justify-between px-1">
          <span class="text-[11px] font-mono text-ink/70">
            Fotos: <strong class="text-ink">{{ item.photos|length }}</strong>/{{ app.user.plan.maxPhotosPerItem }} (Free)
          </span>
          <button type="button"
            onclick="if (window.RegistralsToast) window.RegistralsToast.show('Funció del Pla PLUS', 'La custòdia de fins a 5 fotografies de detall (números de sèrie, contrastos) requereix el Pla PLUS o UNLIMITED.', 'info');"
            class="px-2.5 py-1 rounded-xl bg-white border border-gold/40 text-ink text-[11px] font-semibold flex items-center gap-1.5 shadow-2xs active:scale-95 transition-all">
            <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>Nova Foto</span>
          </button>
        </div>
      </div>

      {# 3. FITXA (Especificacions & Identificació) #}
      <div class="bg-whitef border border-gold/30 rounded-2xl p-4 shadow-2xs space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-cream">
          <h2 class="font-marcellus text-base text-ink">Especificacions & Identificació</h2>
          <span class="text-[10px] uppercase font-mono font-bold text-steel bg-cream/50 px-2 py-0.5 rounded-md border border-steel/20">Fitxa Tècnica</span>
        </div>
        
        <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-xs">
          <div>
            <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Marca</dt>
            <dd class="text-ink font-bold mt-0.5 truncate">{{ item.brand|default('—') }}</dd>
          </div>

          <div>
            <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Model</dt>
            <dd class="text-ink font-bold mt-0.5 truncate">{{ item.model|default('—') }}</dd>
          </div>

          <div class="col-span-2">
            <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Número de Sèrie / IMEI / Bastidor</dt>
            <dd class="text-ink font-mono font-bold mt-0.5 text-xs truncate bg-cream/30 p-1.5 rounded-lg border border-steel/20">
              {{ item.serialNumber|default('No indicat') }}
            </dd>
          </div>

          <div>
            <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Origen</dt>
            <dd class="text-ink font-medium mt-0.5 truncate">{{ item.acquisitionType.label }}</dd>
          </div>

          <div>
            <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Data d'Adquisició</dt>
            <dd class="text-ink font-medium mt-0.5">
              {{ item.acquisitionDate ? item.acquisitionDate|date('d/m/Y') : '—' }}
            </dd>
          </div>

          {% if item.acquisitionCircumstances %}
            <div class="col-span-2 pt-2 border-t border-cream">
              <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold mb-0.5">Observacions</dt>
              <dd class="text-ink/80 text-xs leading-relaxed">{{ item.acquisitionCircumstances }}</dd>
            </div>
          {% endif %}
        </dl>
      </div>

      {# 4. PROVES (Proves Documentals) #}
      <div class="bg-whitef border border-gold/30 rounded-2xl p-4 shadow-2xs space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-cream">
          <h2 class="font-marcellus text-base text-ink flex items-center gap-1.5">
            <span>Proves Documentals</span>
            <span class="text-[10px] font-mono font-bold bg-cream px-2 py-0.5 rounded-full text-ink border border-gold/30">
              {{ item.evidenceDocuments|length }}/{{ app.user.plan.maxEvidencesPerItem }}
            </span>
          </h2>
          <button type="button"
            onclick="if (window.RegistralsToast) window.RegistralsToast.show('Funció del Pla PLUS', 'La custòdia de fins a 5 proves documentals addicionals (factures, tiquets, garanties) requereix el Pla PLUS o UNLIMITED.', 'info');"
            class="px-2.5 py-1 rounded-xl bg-white border border-gold/40 text-ink text-[11px] font-semibold flex items-center gap-1.5 shadow-2xs active:scale-95 transition-all">
            <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>Nova Prova</span>
          </button>
        </div>

        <div class="space-y-2">
          {% for doc in item.evidenceDocuments %}
            <div class="p-2.5 rounded-xl border border-steel/20 bg-cream/20 flex items-center justify-between text-xs">
              <div class="flex items-center gap-2 min-w-0 pr-2">
                <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <div class="truncate">
                  <div class="font-bold text-ink truncate text-xs">{{ doc.originalFilename }}</div>
                  <div class="text-[9px] text-ink/60">{{ doc.type.label }} &middot; {{ (doc.fileSizeBytes / 1024)|round(1) }} KB</div>
                </div>
              </div>
              <button type="button" onclick="openDocPreview('{{ path('app_media_document', {'uuid': doc.uuid}) }}', '{{ doc.originalFilename|e('js') }}', '{{ doc.mimeType }}', '{{ doc.sha256Hash }}', '{{ (doc.fileSizeBytes / 1024)|round(1) }} KB')" class="px-2.5 py-1 bg-white border border-steel/30 rounded-lg text-ink text-[11px] font-semibold hover:bg-cream hover:border-gold/50 cursor-pointer shrink-0 transition-colors">
                Veure
              </button>
            </div>
          {% else %}
            <p class="text-xs text-ink/60 py-2">No hi ha documents adjunts addicionals.</p>
          {% endfor %}
        </div>
      </div>

      {# 5. TEXT GARANTIA (Garantia Notarial Registrals — Caixa Blava Notarial) #}
      <div class="bg-ink text-cream border border-gold/40 rounded-2xl p-4 shadow-xl shadow-ink/20 relative overflow-hidden space-y-3">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent opacity-80"></div>

        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-full bg-cream/10 border border-gold/40 text-gold flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <h3 class="font-marcellus text-base text-whitef">Garantia Notarial Registrals</h3>
          </div>
          <span class="px-2 py-0.5 rounded-full bg-gold/15 border border-gold/40 text-gold font-mono font-bold text-[10px]">v1 (Vigent)</span>
        </div>

        <p class="text-cream/85 text-[11px] leading-relaxed font-raleway">
          Titularitat de <strong class="text-whitef font-bold">{{ item.owner.fullName }}</strong> &middot; Custòdia legal eIDAS i segellat SHA-256.
        </p>

        <div class="pt-1 flex flex-wrap gap-1.5 items-center">
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-gold/15 border border-gold/40 text-gold font-mono font-bold text-[10px] tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse"></span>
            SHA-256 IMUTABLE
          </span>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-cream/15 border border-cream/20 text-cream text-[10px] font-medium">
            Custòdia Legal eIDAS
          </span>
        </div>

        {# Avís Notarial d'Immutabilitat (1 línia) #}
        <div class="guide-note-dark text-[10px]">
          <strong>Avís d'Immutabilitat:</strong> Qualsevol canvi en fotos o proves generarà la versió <code>v2</code> i requerirà nou ancoratge.
        </div>
      </div>

    </div>

    {# ==================================================================== #}
    {# 2. VISTA ESCRIPTORI (>= lg): GRAELLA NOTARIAL 4 BLOCS HARMONITZATS   #}
    {# =======================    {# ==================================================================== #}
    {# 2. VISTA ESCRIPTORI (>= lg): GRAELLA NOTARIAL 4 BLOCS HARMONITZATS   #}
    {# ==================================================================== #}
    <div class="hidden lg:block space-y-3">

      {# Sub-barra de Navegació Superior per a PC (Idèntica i Harmonitzada amb el Dashboard) #}
      <div class="flex items-center justify-between pb-2 mb-2 border-b border-gold/20">
        <nav class="flex items-center gap-2 font-raleway">
          <a href="{{ path('app_dashboard') }}" class="px-3.5 py-1.5 rounded-xl font-bold text-xs uppercase tracking-wider bg-white/70 hover:bg-white text-ink/80 hover:text-ink border border-steel/25 hover:border-gold/40 shadow-2xs transition-all flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            <span>El meu Patrimoni</span>
          </a>
          <a href="#" class="px-3.5 py-1.5 rounded-xl font-semibold text-xs uppercase tracking-wider bg-white/70 hover:bg-white text-ink/80 hover:text-ink border border-steel/25 hover:border-gold/40 shadow-2xs transition-all flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-steel" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Certificats</span>
          </a>
          <a href="#" class="px-3.5 py-1.5 rounded-xl font-semibold text-xs uppercase tracking-wider bg-white/70 hover:bg-white text-ink/80 hover:text-ink border border-steel/25 hover:border-gold/40 shadow-2xs transition-all flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-steel" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
            <span>Traspassos</span>
          </a>
        </nav>

        {# Accions Ràpides en PC: Al mateix lloc superior dret que el botó del Dashboard #}
        <div class="flex items-center gap-2">
          <button type="button" onclick="if (window.RegistralsToast) { window.RegistralsToast.show('Certificat Oficial', 'L\'emissió de certificats oficials en PDF i signatura eIDAS estarà disponible a la Iteració 5.', 'info'); }" class="py-1.5 px-4 rounded-xl shadow-md bg-ink text-gold border border-gold/40 hover:bg-ink/90 active:scale-[0.99] transition-all flex items-center gap-2 text-xs uppercase tracking-wider font-raleway font-semibold cursor-pointer">
            <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Emetre Certificat</span>
          </button>

          <button type="button" onclick="if (window.RegistralsToast) { window.RegistralsToast.show('Traspàs C2C', 'El servei de traspàs segur estarà disponible a la Iteració 6.', 'info'); }" class="py-1.5 px-4 rounded-xl bg-white border border-steel/30 text-ink shadow-2xs hover:bg-cream/40 active:scale-[0.99] transition-all flex items-center gap-2 text-xs uppercase tracking-wider font-raleway font-semibold cursor-pointer">
            <svg class="w-3.5 h-3.5 text-steel" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
            <span>Traspassar</span>
          </button>
        </div>
      </div>

      {# Capçalera d'Identitat del Bé (Títol esquerra, CUI + Custodiat + Hash a la dreta) #}
      <div class="mb-2.5 flex flex-col md:flex-row md:items-center md:justify-between gap-2 pb-2 border-b border-gold/15">
        <div>
          <div class="flex items-center gap-1.5 text-xs text-ink/60 font-semibold mb-0.5">
            <a href="{{ path('app_dashboard') }}" class="hover:text-gold transition-colors flex items-center gap-1">
              <span>El meu Patrimoni</span>
            </a>
            <span>/</span>
            <span>{{ item.category.name }}</span>
            {% if item.brand %}<span>&middot; {{ item.brand }}</span>{% endif %}
          </div>
          <h1 class="text-xl sm:text-2xl font-marcellus text-ink leading-tight">{{ item.name }}</h1>
        </div>

        {# Metadades Notarials a la Dreta: CUI + Custodiat + Hash SHA-256 #}
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <span class="bg-ink text-cream text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-lg shadow-xs border border-gold/40">
            {{ item.cui }}
          </span>

          <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-full border bg-white shadow-2xs {{ item.status.badgeClasses }}">
            {% if item.status.value == 'active' %}
              <svg class="w-2.5 h-2.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <span>Custodiat</span>
            {% else %}
              <span>{{ item.status.label }}</span>
            {% endif %}
          </span>

          {% if item.mainPhoto %}
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg bg-white border border-steel/25 text-[11px] font-mono text-ink/75 shadow-2xs" title="SHA-256: {{ item.mainPhoto.sha256Hash }}">
              <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
              <span>SHA: {{ item.mainPhoto.sha256Hash|slice(0, 10) }}...</span>
            </div>
          {% endif %}
        </div>
      </div>

      {# Graella 4 Blocs Harmonitzats (2 Superiors Igualats + 2 Inferiors Aliniats) #}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 items-stretch">

        {# FILA 1, COL 1: BLOC 1 - Especificacions & Identificació #}
        <div class="bg-whitef border border-gold/30 rounded-2xl p-3.5 sm:p-4 shadow-2xs flex flex-col justify-between h-full space-y-2">
          <div>
            <div class="flex items-center justify-between pb-1.5 border-b border-cream">
              <h2 class="font-marcellus text-base text-ink flex items-center gap-2 whitespace-nowrap">
                <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                <span>Especificacions & Identificació</span>
              </h2>
              <span class="text-[10px] uppercase font-mono font-bold text-steel bg-cream/50 px-2 py-0.5 rounded-md border border-steel/20 whitespace-nowrap">
                Fitxa Tècnica
              </span>
            </div>

            <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-3 gap-y-2 text-xs pt-1.5">
              <div>
                <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Marca</dt>
                <dd class="text-ink font-bold mt-0.5 truncate">{{ item.brand|default('—') }}</dd>
              </div>

              <div>
                <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Model</dt>
                <dd class="text-ink font-bold mt-0.5 truncate">{{ item.model|default('—') }}</dd>
              </div>

              <div>
                <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Valor Estimat</dt>
                <dd class="text-ink font-bold mt-0.5 text-xs font-raleway">
                  {% if item.declaredValueEuros is not null %}
                    {{ item.declaredValueEuros|number_format(0, ',', '.') }} €
                  {% else %}
                    —
                  {% endif %}
                </dd>
              </div>

              <div class="col-span-2 sm:col-span-3">
                <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Número de Sèrie / IMEI / Bastidor</dt>
                <dd class="text-ink font-mono font-bold mt-0.5 text-xs truncate bg-cream/30 p-1.5 rounded-lg border border-steel/20">
                  {{ item.serialNumber|default('No indicat') }}
                </dd>
              </div>

              <div>
                <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Origen</dt>
                <dd class="text-ink font-medium mt-0.5 truncate">{{ item.acquisitionType.label }}</dd>
              </div>

              <div>
                <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Data d'Adquisició</dt>
                <dd class="text-ink font-medium mt-0.5">
                  {{ item.acquisitionDate ? item.acquisitionDate|date('d/m/Y') : '—' }}
                </dd>
              </div>

              <div>
                <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold">Inscripció Registrals</dt>
                <dd class="text-ink/75 font-mono text-[11px] mt-0.5">
                  {{ item.createdAt|date('d/m/Y H:i') }}
                </dd>
              </div>

              {% if item.acquisitionCircumstances %}
                <div class="col-span-2 sm:col-span-3 pt-1.5 border-t border-cream">
                  <dt class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold mb-0.5">Observacions</dt>
                  <dd class="text-ink/80 text-xs leading-relaxed truncate">{{ item.acquisitionCircumstances }}</dd>
                </div>
              {% endif %}
            </dl>
          </div>

          <div class="pt-1.5 border-t border-cream/80 text-[11px] text-ink/50 flex items-center justify-between mt-auto">
            <span>Dades validades pel titular</span>
            <span class="font-mono text-steel">v1 (Original)</span>
          </div>
        </div>

        {# FILA 1, COL 2: BLOC 2 - Galeria Fotogràfica #}
        <div class="bg-whitef border border-gold/30 rounded-2xl p-3.5 sm:p-4 shadow-2xs flex flex-col justify-between h-full space-y-2">
          <div>
            <div class="flex items-center justify-between pb-1.5 border-b border-cream gap-2">
              <div class="flex items-center gap-2">
                <h2 class="font-marcellus text-base text-ink flex items-center gap-2 whitespace-nowrap">
                  <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <span>Galeria Fotogràfica</span>
                </h2>

                {# Controls < > pujats a la part superior #}
                <div class="flex items-center gap-1 ml-1">
                  <button type="button" class="w-6 h-6 rounded-md bg-white border border-steel/20 flex items-center justify-center text-steel cursor-not-allowed opacity-60" title="Foto anterior" disabled>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                  </button>
                  <button type="button" class="w-6 h-6 rounded-md bg-white border border-steel/20 flex items-center justify-center text-steel cursor-not-allowed opacity-60" title="Foto següent" disabled>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </button>
                </div>
              </div>

              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] font-mono font-bold text-ink/75 bg-cream/60 px-2 py-0.5 rounded-md border border-steel/20 whitespace-nowrap">
                  {{ item.photos|length }}/{{ app.user.plan.maxPhotosPerItem }} foto (Free)
                </span>
                <button type="button"
                  onclick="if (window.RegistralsToast) window.RegistralsToast.show('Funció del Pla PLUS', 'La custòdia de fins a 5 fotografies de detall (números de sèrie, contrastos) requereix el Pla PLUS o UNLIMITED.', 'info');"
                  class="px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer shadow-2xs bg-white/90 border border-gold/40 text-ink/85 hover:bg-cream/40 active:scale-95 whitespace-nowrap"
                  title="Afegir nova fotografia">
                  <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                  <span>Nova Foto</span>
                </button>
              </div>
            </div>

            {# Marc Imatge Protagonista Panoràmica amb alçada màxima adaptada a portàtil #}
            <div class="pt-1.5">
              {% if item.mainPhoto %}
                <div class="rounded-xl overflow-hidden border border-steel/20 bg-cream/20 aspect-video max-h-[170px] xl:max-h-[180px] 2xl:max-h-[220px] relative group cursor-pointer" onclick="openDocPreview('{{ path('app_media_document', {'uuid': item.mainPhoto.uuid}) }}', '{{ item.mainPhoto.originalFilename|e('js') }}', '{{ item.mainPhoto.mimeType }}', '{{ item.mainPhoto.sha256Hash }}', '{{ (item.mainPhoto.fileSizeBytes / 1024)|round(1) }} KB')">
                  <img src="{{ path('app_media_document', {'uuid': item.mainPhoto.uuid}) }}" alt="{{ item.name }}" class="w-full h-full object-cover transition-transform group-hover:scale-102 duration-300" />
                  
                  <div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/20 transition-colors flex items-center justify-center">
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-ink/85 text-cream px-3 py-1.5 rounded-full text-xs font-semibold flex items-center gap-1.5 shadow-md">
                      <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                      <span>Ampliar a pantalla completa</span>
                    </span>
                  </div>

                  {# Badge de Foto Principal #}
                  <div class="absolute top-2 left-2 z-10">
                    <span class="bg-ink/90 backdrop-blur-md text-gold text-[10px] font-bold px-2 py-0.5 rounded-lg border border-gold/40 flex items-center gap-1 shadow-xs">
                      <svg class="w-3 h-3 text-gold fill-gold" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                      <span>Principal</span>
                    </span>
                  </div>

                  {# Barra Inferior Hash de Foto #}
                  <div class="absolute bottom-1.5 left-1.5 right-1.5 bg-ink/85 backdrop-blur-xs text-[10px] text-cream px-2 py-0.5 rounded-md truncate font-mono flex items-center justify-between">
                    <span class="truncate text-[9px]">SHA-256: {{ item.mainPhoto.sha256Hash|slice(0, 16) }}...</span>
                    <span class="text-gold font-semibold shrink-0 ml-2 text-[9px]">Foto {{ item.photos|length }} de 1</span>
                  </div>
                </div>
              {% else %}
                <div class="rounded-xl border-2 border-dashed border-steel/30 bg-cream/10 aspect-video max-h-[170px] flex flex-col items-center justify-center p-4 text-center text-ink/60">
                  <svg class="w-8 h-8 text-steel/50 mb-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <span class="text-xs">Sense fotografia registrada</span>
                </div>
              {% endif %}
            </div>
          </div>

          {# Línia inferior idèntica a la de Proves Documentals #}
          <div class="pt-1.5 border-t border-cream/80 text-[11px] text-ink/50 flex items-center justify-between mt-auto">
            <span>Custòdia privada Flysystem</span>
            <span class="text-gold font-semibold">Ampliable a Pla Plus (fins a 5)</span>
          </div>
        </div>

        {# FILA 2, COL 1: BLOC 4 - Garantia Notarial Registrals (Caixa Blava Notarial) #}
        <div class="bg-ink text-cream border border-gold/40 rounded-2xl p-3.5 sm:p-4 shadow-xl relative overflow-hidden flex flex-col justify-between h-full space-y-2">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent opacity-80"></div>

          <div>
            <div class="flex items-center justify-between pb-1.5 border-b border-gold/20">
              <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-full bg-cream/10 border border-gold/40 text-gold flex items-center justify-center shrink-0">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                </div>
                <h3 class="font-marcellus text-base text-whitef whitespace-nowrap">Garantia Notarial Registrals</h3>
              </div>
              <span class="px-2 py-0.5 rounded-full bg-gold/15 border border-gold/40 text-gold font-mono font-bold text-[10px] whitespace-nowrap">
                Versió v1 (Vigent)
              </span>
            </div>

            <p class="text-cream/85 text-xs font-raleway pt-1 leading-relaxed">
              Titularitat de <strong class="text-whitef font-bold">{{ item.owner.fullName }}</strong> &middot; Custòdia legal eIDAS i segellat SHA-256.
            </p>

            {# Píndoles de Segellat #}
            <div class="pt-1 flex flex-wrap gap-1.5 items-center">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-gold/15 border border-gold/40 text-gold font-mono font-bold text-[10px] tracking-wider whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse"></span>
                SHA-256 IMUTABLE
              </span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-cream/10 border border-cream/20 text-cream/90 text-[10px] whitespace-nowrap">
                Data Certa eIDAS
              </span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-cream/10 border border-cream/20 text-cream/90 text-[10px] whitespace-nowrap">
                Polygon L2 Ready
              </span>
            </div>

            {# Avís d'Immutabilitat i Cost de Re-segellat complet sense tallar #}
            <div class="guide-note-dark text-xs mt-2 py-2 px-3 leading-relaxed">
              <strong>Avís d'Immutabilitat:</strong> Qualsevol canvi en fotos o proves generarà la versió <code>v2</code> i requerirà un nou ancoratge criptogràfic.
            </div>
          </div>
        </div>

        {# FILA 2, COL 2: BLOC 3 - Proves Documentals #}
        <div class="bg-whitef border border-gold/30 rounded-2xl p-3.5 sm:p-4 shadow-2xs flex flex-col justify-between h-full space-y-2">
          <div>
            <div class="flex items-center justify-between pb-1.5 border-b border-cream gap-2">
              <div class="flex items-center gap-2">
                <h2 class="font-marcellus text-base text-ink flex items-center gap-2 whitespace-nowrap">
                  <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                  <span>Proves Documentals</span>
                </h2>

                {# Controls < > a la part superior de proves #}
                <div class="flex items-center gap-1 ml-1">
                  <button type="button" class="w-6 h-6 rounded-md bg-white border border-steel/20 flex items-center justify-center text-steel cursor-not-allowed opacity-60" title="Prova anterior" disabled>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                  </button>
                  <button type="button" class="w-6 h-6 rounded-md bg-white border border-steel/20 flex items-center justify-center text-steel cursor-not-allowed opacity-60" title="Prova següent" disabled>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </button>
                </div>
              </div>

              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] font-mono font-bold text-ink/75 bg-cream/60 px-2 py-0.5 rounded-md border border-steel/20 whitespace-nowrap">
                  {{ item.evidenceDocuments|length }}/{{ app.user.plan.maxEvidencesPerItem }} prova (Free)
                </span>
                <button type="button"
                  onclick="if (window.RegistralsToast) window.RegistralsToast.show('Funció del Pla PLUS', 'La custòdia de fins a 5 proves documentals addicionals (factures, tiquets, garanties) requereix el Pla PLUS o UNLIMITED.', 'info');"
                  class="px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer shadow-2xs bg-white/90 border border-gold/40 text-ink/85 hover:bg-cream/40 active:scale-95 whitespace-nowrap"
                  title="Afegir nova prova documental">
                  <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                  <span>Nova Prova</span>
                </button>
              </div>
            </div>

            <div class="pt-2 space-y-1.5">
              {% for doc in item.evidenceDocuments %}
                <div class="p-2.5 rounded-xl border border-steel/20 bg-cream/20 flex items-center justify-between text-xs hover:border-gold/40 transition-colors">
                  <div class="flex items-center gap-2 min-w-0 pr-2">
                    <div class="w-7 h-7 rounded-lg bg-white border border-gold/30 flex items-center justify-center shrink-0 text-gold">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </div>
                    <div class="truncate">
                      <div class="font-bold text-ink truncate text-xs">{{ doc.originalFilename }}</div>
                      <div class="text-[10px] text-ink/60 font-mono">{{ doc.type.label }} &middot; {{ (doc.fileSizeBytes / 1024)|round(1) }} KB</div>
                    </div>
                  </div>
                  <button type="button" onclick="openDocPreview('{{ path('app_media_document', {'uuid': doc.uuid}) }}', '{{ doc.originalFilename|e('js') }}', '{{ doc.mimeType }}', '{{ doc.sha256Hash }}', '{{ (doc.fileSizeBytes / 1024)|round(1) }} KB')" class="px-2.5 py-0.5 bg-white border border-steel/30 rounded-lg text-ink text-xs font-semibold hover:bg-cream hover:border-gold/50 cursor-pointer shrink-0 transition-colors shadow-2xs">
                    Veure
                  </button>
                </div>
              {% else %}
                <p class="text-xs text-ink/60 py-3 text-center">Sense proves documentals addicionals.</p>
              {% endfor %}
            </div>
          </div>

          <div class="pt-2 border-t border-cream/80 text-[11px] text-ink/50 flex items-center justify-between mt-auto">
            <span>Custòdia privada Flysystem</span>
            <span class="text-gold font-semibold">Ampliable a Pla Plus (fins a 5)</span>
          </div>
        </div>

      </div>

    </div>

  </main>

  {# ==================================================================== #}
  {# Barra d'Accions Contextual Inferior PWA (Fitxa del Bé — Mòbil < md)  #}
  {# ==================================================================== #}
  <nav class="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-steel/20 px-3 py-1.5 md:hidden shadow-[0_-8px_25px_-6px_rgba(29,47,75,0.12)]">
    <div class="grid grid-cols-4 items-center justify-items-center max-w-md mx-auto">
      
      {# 1. Retorn a Patrimoni #}
      <a href="{{ path('app_dashboard') }}" class="flex flex-col items-center justify-center gap-1 text-steel hover:text-ink active:scale-95 transition-all py-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span class="text-[10px] font-bold font-raleway">Patrimoni</span>
      </a>

      {# 2. Emetre Certificat (Acció Notarial Destacada) #}
      <button type="button" onclick="if (window.RegistralsToast) { window.RegistralsToast.show('Certificat Oficial', 'L\'emissió de certificats oficials en PDF i signatura eIDAS estarà disponible a la Iteració 5.', 'info'); }" class="flex flex-col items-center justify-center gap-1 text-ink hover:text-gold active:scale-95 transition-all py-1 cursor-pointer">
        <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <span class="text-[10px] font-bold font-raleway">Certificat</span>
      </button>

      {# 3. Traspàs C2C #}
      <button type="button" onclick="if (window.RegistralsToast) { window.RegistralsToast.show('Traspàs C2C', 'El servei de traspàs de titularitat estarà disponible a la Iteració 6.', 'info'); }" class="flex flex-col items-center justify-center gap-1 text-steel hover:text-ink active:scale-95 transition-all py-1 cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
        </svg>
        <span class="text-[10px] font-bold font-raleway">Traspàs</span>
      </button>

      {# 4. Assistent IA amb Micro-badge PLUS #}
      <button type="button" onclick="openAiNudgingModal()" class="relative flex flex-col items-center justify-center gap-1 text-steel hover:text-gold active:scale-95 transition-all py-1 cursor-pointer">
        <div class="relative">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          <span class="absolute -top-1 -right-3 px-1 py-0.2 bg-gold text-ink text-[7px] font-extrabold uppercase rounded-full shadow-xs leading-none">
            PLUS
          </span>
        </div>
        <span class="text-[10px] font-bold font-raleway text-ink/80">Assistent IA</span>
      </button>

    </div>
  </nav>

  {# Peu de pàgina privat per a PC (>= md) #}
  <footer class="border-t border-gold/30 py-5 text-center text-xs text-ink/65 bg-whitef hidden md:block">
    <p>&copy; {{ "now"|date("Y") }} Registrals &middot; Fitxa notarial protegida.</p>
  </footer>

</div>

{# Modal Notarial de Previsualització de Documents de Custòdia #}
<div id="modal-doc-preview" class="fixed inset-0 z-50 bg-ink/80 backdrop-blur-sm hidden items-center justify-center p-3 sm:p-6 transition-all" onclick="if(event.target === this) closeDocPreview();">
  <div class="bg-white rounded-3xl border border-gold/50 shadow-2xl flex flex-col overflow-hidden w-full max-w-4xl max-h-[92vh] animate-in fade-in zoom-in-95 duration-200">
    
    {# Capçalera del Modal #}
    <div class="px-5 py-3.5 sm:px-6 sm:py-4 bg-ink text-cream border-b border-gold/30 flex items-center justify-between gap-4">
      <div class="min-w-0 flex items-center gap-2.5 sm:gap-3">
        <div class="w-8 h-8 rounded-full bg-cream/15 text-gold flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div class="min-w-0">
          <h3 id="modal-doc-title" class="font-bold text-cream text-xs sm:text-base truncate">Nom del document</h3>
          <p id="modal-doc-meta" class="text-[10px] sm:text-[11px] text-cream/70 font-mono truncate">SHA-256</p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <a id="modal-doc-download" href="#" target="_blank" class="px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-xl bg-cream/15 hover:bg-cream/25 text-cream text-xs font-semibold transition-colors flex items-center gap-1.5" title="Obrir en una pestanya nova">
          <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          <span class="hidden sm:inline">Obrir externament</span>
        </a>
        <button type="button" onclick="closeDocPreview()" class="w-8 h-8 rounded-full bg-cream/10 hover:bg-cream/20 text-cream flex items-center justify-center text-sm transition-colors cursor-pointer" aria-label="Tancar">
          &times;
        </button>
      </div>
    </div>

    {# Cos del Modal (Imatge o PDF) #}
    <div id="modal-doc-body" class="p-3 sm:p-6 bg-cream/30 flex-1 overflow-auto flex items-center justify-center min-h-[300px]">
      {# S'injecta dinàmicament per JS #}
    </div>

    {# Peu de pàgina del Modal #}
    <div class="px-5 py-3 sm:px-6 bg-white border-t border-gold/20 flex items-center justify-between text-xs text-ink/70">
      <span class="font-mono text-[10px] sm:text-[11px] text-steel">Custòdia xifrada Flysystem · SHA-256</span>
      <button type="button" onclick="closeDocPreview()" class="px-4 py-1.5 rounded-xl bg-ink text-cream font-semibold hover:bg-ink/90 transition-colors cursor-pointer text-xs">
        Tancar
      </button>
    </div>

  </div>
</div>

{# Modal Notarial de Freemium Nudging — Assistent d'IA Pla Plus #}
<div id="modal-ai-nudging" class="fixed inset-0 z-50 bg-ink/80 backdrop-blur-sm hidden items-center justify-center p-4 transition-all" onclick="if(event.target === this) closeAiNudgingModal();">
  <div class="bg-whitef rounded-3xl border border-gold/50 shadow-2xl overflow-hidden w-full max-w-md animate-in fade-in zoom-in-95 duration-200">
    <div class="bg-ink text-cream p-5 border-b border-gold/30 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-cream/15 text-gold flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <div>
          <h3 class="font-marcellus text-lg text-cream">Assistent d'IA Avançat</h3>
          <span class="text-[10px] font-mono text-gold uppercase tracking-wider font-bold">Funció Exclusiva Pla Plus</span>
        </div>
      </div>
      <button type="button" onclick="closeAiNudgingModal()" class="w-8 h-8 rounded-full bg-cream/10 hover:bg-cream/20 text-cream flex items-center justify-center text-sm transition-colors cursor-pointer" aria-label="Tancar">&times;</button>
    </div>
    
    <div class="p-5 space-y-4 text-xs font-raleway">
      <p class="text-ink/80 leading-relaxed">
        El teu compte opera amb el <strong>Pla Free</strong>. L'Assistent d'IA sobre la fitxa del bé permet serveis de màxim valor afegit:
      </p>

      <div class="space-y-2.5">
        <div class="p-3 rounded-2xl bg-cream/30 border border-gold/30 flex items-start gap-2.5">
          <span class="text-gold text-sm font-bold shrink-0">📄</span>
          <div>
            <div class="font-bold text-ink">Informes Pericials d'Assegurança</div>
            <div class="text-ink/70 text-[11px] mt-0.5">Redacció d'un informe formal de sinistre o robatori preparat per tramitar directament amb la teva companyia asseguradora.</div>
          </div>
        </div>

        <div class="p-3 rounded-2xl bg-cream/30 border border-gold/30 flex items-start gap-2.5">
          <span class="text-gold text-sm font-bold shrink-0">🔍</span>
          <div>
            <div class="font-bold text-ink">Auditoria Forense de Proves</div>
            <div class="text-ink/70 text-[11px] mt-0.5">Verificació automàtica de resolució, números de sèrie i validesa documental abans de sinistres.</div>
          </div>
        </div>

        <div class="p-3 rounded-2xl bg-cream/30 border border-gold/30 flex items-start gap-2.5">
          <span class="text-gold text-sm font-bold shrink-0">⚡</span>
          <div>
            <div class="font-bold text-ink">Model Local Sobirà (Qwen VL)</div>
            <div class="text-ink/70 text-[11px] mt-0.5">Processament 100% confidencial i custodiat a servidors privats sense cessió de dades a tercers.</div>
          </div>
        </div>
      </div>

      <div class="pt-2">
        <button type="button" onclick="closeAiNudgingModal()" class="w-full py-2.5 px-4 rounded-xl bg-ink text-cream font-bold text-center hover:bg-ink/90 active:scale-95 transition-all cursor-pointer">
          Entesos
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function openAiNudgingModal() {
    const modal = document.getElementById('modal-ai-nudging');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('overflow-hidden');
    }
  }

  function closeAiNudgingModal() {
    const modal = document.getElementById('modal-ai-nudging');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
    }
  }

  function openDocPreview(url, title, mimeType, sha256, size) {
    const modal = document.getElementById('modal-doc-preview');
    const titleEl = document.getElementById('modal-doc-title');
    const metaEl = document.getElementById('modal-doc-meta');
    const bodyEl = document.getElementById('modal-doc-body');
    const downloadEl = document.getElementById('modal-doc-download');

    titleEl.textContent = title;
    metaEl.textContent = `Mida: ${size} · SHA-256: ${sha256}`;
    downloadEl.href = url;

    bodyEl.innerHTML = '';

    if (mimeType.startsWith('image/')) {
      const img = document.createElement('img');
      img.src = url;
      img.alt = title;
      img.className = 'max-w-full max-h-[70vh] object-contain rounded-xl shadow-md border border-steel/20';
      bodyEl.appendChild(img);
    } else if (mimeType === 'application/pdf') {
      const iframe = document.createElement('iframe');
      iframe.src = url;
      iframe.className = 'w-full h-[65vh] rounded-xl border border-steel/20 shadow-sm';
      bodyEl.appendChild(iframe);
    } else {
      bodyEl.innerHTML = `
        <div class="text-center py-12">
          <svg class="w-16 h-16 text-steel/50 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <p class="text-sm text-ink font-semibold">Aquest format no té visor incrustat directe.</p>
          <p class="text-xs text-ink/60 mt-1">Fes clic a "Obrir externament" per descarregar-lo o veure'l amb l'aplicació nativa.</p>
        </div>
      `;
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
  }

  function closeDocPreview() {
    const modal = document.getElementById('modal-doc-preview');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  }

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      closeDocPreview();
      closeAiNudgingModal();
    }
  });
</script>
{% endblock %}
