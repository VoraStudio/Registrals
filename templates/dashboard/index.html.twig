{% extends 'base.html.twig' %}

{% block title %}El meu Patrimoni — Registrals{% endblock %}
{% block meta_description %}Àrea privada de gestió de béns mobles, proves i certificats.{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {# Barra Superior Privada Unificada (Fons Blanc + Línia Tènue + Avatar amb Micro-Badge) #}
  {% include 'partials/_private_header.html.twig' %}

  {# Contingut del Dashboard #}
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 sm:py-5 w-full flex-1">

    {# Sub-barra de Navegació Superior per a PC (Sub-Header Net sense Sidebars) #}
    <div class="hidden md:flex items-center justify-between pb-3.5 mb-3.5 border-b border-gold/20">
      <nav class="flex items-center gap-2 font-raleway">
        <a href="{{ path('app_dashboard') }}" class="px-4 py-2 rounded-xl font-bold text-xs uppercase tracking-wider bg-ink text-gold border border-gold/40 shadow-xs flex items-center gap-2">
          <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          <span>El meu Patrimoni</span>
        </a>
        <a href="#" class="px-4 py-2 rounded-xl font-semibold text-xs uppercase tracking-wider bg-white/70 hover:bg-white text-ink/80 hover:text-ink border border-steel/25 hover:border-gold/40 shadow-2xs transition-all flex items-center gap-2">
          <svg class="w-4 h-4 text-steel" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Certificats</span>
        </a>
        <a href="#" class="px-4 py-2 rounded-xl font-semibold text-xs uppercase tracking-wider bg-white/70 hover:bg-white text-ink/80 hover:text-ink border border-steel/25 hover:border-gold/40 shadow-2xs transition-all flex items-center gap-2">
          <svg class="w-4 h-4 text-steel" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          <span>Traspassos</span>
        </a>
      </nav>

      <a href="{{ path('app_item_new') }}" style="background-color: #1D2F4B; color: #FAF6F0;" class="py-2 px-5 rounded-xl shadow-md hover:bg-ink/90 active:scale-[0.99] transition-all flex items-center gap-2 text-xs uppercase tracking-wider font-raleway font-semibold cursor-pointer">
        <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"/></svg>
        <span>Registrar Nou Bé</span>
      </a>
    </div>

    {# Barra de Resum i Benvinguda #}
    <div class="mb-3 sm:mb-4 flex flex-col md:flex-row md:items-center md:justify-between gap-1 sm:gap-2 pb-2.5 sm:pb-3.5 border-b border-gold/15">
      <div>
        <h1 class="text-xl sm:text-3xl font-marcellus text-ink tracking-wide">El meu Patrimoni</h1>
        <p class="text-xs sm:text-sm text-ink/75 mt-0.5 font-raleway">Benvingut/da, {{ app.user.firstName }}. Relació dels teus béns custodiats i protegits.</p>
      </div>

      {# Comptador/botó en tauletes (a mòbil el botó central està al PWA Bottom Bar) #}
      <div class="hidden sm:flex md:hidden items-center justify-between gap-3">
        <div class="text-xs font-mono text-ink/70">
          Total: <strong class="text-ink font-bold">{{ items|length }}</strong> béns
        </div>
        <a href="{{ path('app_item_new') }}" style="background-color: #1D2F4B; color: #FAF6F0;" class="py-2 px-4 rounded-xl shadow-md text-xs uppercase tracking-wider font-raleway font-semibold flex items-center gap-1.5">
          <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"/></svg>
          <span>Nou Bé</span>
        </a>
      </div>
    </div>

    {# Barra de Mètriques de Pla (Nudging de la Secció 7 del PRD) #}
    {% set itemsCount = items|length %}
    {% set maxAllowed = app.user.plan ? app.user.plan.maxActiveItems : -1 %}
    {% set pct = maxAllowed > 0 ? ((itemsCount / maxAllowed * 100)|round) : 10 %}
    {% set aiUsed = app.user.aiUsageCount %}
    {% set maxAi = app.user.plan ? app.user.plan.aiAssistanceQuota : -1 %}
    {% set aiPct = maxAi > 0 ? ((aiUsed / maxAi * 100)|round) : 0 %}

    <div class="sm:hidden mb-4 bg-whitef border border-gold/40 rounded-2xl p-2 shadow-2xs flex items-center justify-between text-xs">
      {# Segment 1: Béns #}
      <div class="flex-1 flex items-center justify-center gap-1.5 px-1 border-r border-steel/20">
        <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        <span class="font-mono text-[11px] font-bold text-ink whitespace-nowrap">
          {{ itemsCount }}<span class="text-ink/45 font-normal">/{{ maxAllowed > 0 ? maxAllowed : '∞' }}</span>
        </span>
        <span class="text-[9px] text-ink/60 font-semibold uppercase tracking-tight">Béns</span>
      </div>

      {# Segment 2: Crèdits IA #}
      <div class="flex-1 flex items-center justify-center gap-1.5 px-1 border-r border-steel/20">
        <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span class="font-mono text-[11px] font-bold text-ink whitespace-nowrap">
          {{ aiUsed }}<span class="text-ink/45 font-normal">/{{ maxAi > 0 ? maxAi : '∞' }}</span>
        </span>
        <span class="text-[9px] text-ink/60 font-semibold uppercase tracking-tight whitespace-nowrap">IA</span>
      </div>

      {# Segment 3: Pla Actiu #}
      <div class="flex-1 flex items-center justify-center px-1">
        <span class="inline-flex items-center gap-1 text-[9px] font-bold px-2 py-0.5 rounded-full bg-cream text-ink border border-gold/40 whitespace-nowrap">
          <svg class="w-2.5 h-2.5 text-gold shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span>{{ app.user.plan ? app.user.plan.name|split('(')[0]|trim : 'ADMINISTRADOR' }}</span>
        </span>
      </div>
    </div>

    {# Versió Escriptori: Franja Notarial Horitzontal Compacta (>= sm) #}
    <div class="hidden sm:flex items-center justify-between gap-4 bg-whitef border border-gold/35 rounded-2xl p-3 sm:px-6 sm:py-3.5 mb-6 shadow-2xs">
      {# Segment 1: Capacitat de Béns #}
      <div class="flex items-center gap-3.5 flex-1 pr-4 border-r border-gold/20">
        <div class="w-10 h-10 rounded-xl bg-cream/50 border border-gold/30 flex items-center justify-center shrink-0 text-gold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        </div>
        <div class="min-w-0">
          <div class="text-[10px] uppercase tracking-wider text-ink/60 font-bold">Capacitat de Béns</div>
          <div class="flex items-baseline gap-1.5 mt-0.5">
            <span class="font-marcellus text-lg font-bold text-ink">{{ itemsCount }}</span>
            <span class="text-xs text-ink/55 font-mono">/ {{ maxAllowed > 0 ? maxAllowed : '∞' }}</span>
          </div>
        </div>
        <div class="w-24 bg-cream/70 h-1.5 rounded-full overflow-hidden border border-gold/25 ml-auto hidden md:block">
          <div class="bg-gold h-full rounded-full" style="width: {{ pct > 100 ? 100 : pct }}%"></div>
        </div>
      </div>

      {# Segment 2: Crèdits IA #}
      <div class="flex items-center gap-3.5 flex-1 pr-4 border-r border-gold/20">
        <div class="w-10 h-10 rounded-xl bg-cream/50 border border-gold/30 flex items-center justify-center shrink-0 text-gold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <div class="min-w-0">
          <div class="text-[10px] uppercase tracking-wider text-ink/60 font-bold">Crèdits IA</div>
          <div class="flex items-baseline gap-1.5 mt-0.5">
            <span class="font-marcellus text-lg font-bold text-ink">{{ aiUsed }}</span>
            <span class="text-xs text-ink/55 font-mono">/ {{ maxAi > 0 ? maxAi : '∞' }} consultes</span>
          </div>
        </div>
        <div class="w-24 bg-cream/70 h-1.5 rounded-full overflow-hidden border border-gold/25 ml-auto hidden md:block">
          <div class="bg-gold h-full rounded-full" style="width: {{ aiPct > 100 ? 100 : aiPct }}%"></div>
        </div>
      </div>

      {# Segment 3: Pla & Protecció #}
      <div class="flex items-center gap-3.5 flex-1">
        <div class="w-10 h-10 rounded-xl bg-cream/50 border border-gold/30 flex items-center justify-center shrink-0 text-gold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div class="min-w-0">
          <div class="text-[10px] uppercase tracking-wider text-ink/60 font-bold">Pla & Seguretat</div>
          <div class="flex items-center gap-2 mt-0.5">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-cream text-ink border border-gold/40">
              {{ app.user.plan ? app.user.plan.name|split('(')[0]|trim : 'ADMINISTRADOR' }}
            </span>
            <span class="text-[11px] text-ink/50 hidden lg:inline">eIDAS + Polygon</span>
          </div>
        </div>
      </div>
    </div>

    {# Si té béns registrats: Filtres i Llistat #}
    {% if items is not empty %}
      <div class="space-y-4 sm:space-y-6">
        {# Barra d'eines: Filtres de Categoria (Scroll a mòbil, Wrap net a PC) #}
        <div class="py-1">
          <div class="flex items-center gap-2 overflow-x-auto sm:flex-wrap pb-1 sm:pb-0 no-scrollbar">
            <button type="button" onclick="filterCategory('all', event)" class="category-filter-btn active px-3.5 py-1.5 rounded-full text-xs font-semibold bg-ink text-cream border border-ink transition-all shrink-0">
              Tots ({{ itemsCount }})
            </button>
            {% for cat in categories %}
              <button type="button" onclick="filterCategory('{{ cat.slug }}', event)" class="category-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-steel/30 text-ink/80 hover:bg-cream/40 transition-all shrink-0">
                {{ cat.name }}
              </button>
            {% endfor %}
          </div>
        </div>

        {# 1. VISTA MÒBIL (< sm): Llistat Compacte de Miniatures Horitzontals #}
        <div class="sm:hidden space-y-2.5" id="mobile-items-list">
          {% for item in items %}
            <div class="item-card bg-whitef border border-gold/30 hover:border-gold rounded-2xl p-2.5 shadow-2xs flex items-center gap-2.5 relative transition-all" data-category="{{ item.category.slug }}">
              {# Checkbox de Selecció #}
              <label class="flex items-center justify-center w-5 h-5 rounded-md bg-cream/50 border border-gold/60 cursor-pointer shrink-0">
                <input type="checkbox" value="{{ item.cui }}" onchange="handleItemCheckboxChange()" class="item-checkbox w-3.5 h-3.5 text-ink rounded accent-ink cursor-pointer" />
              </label>

              {# Miniatura Quadrada #}
              <div class="w-14 h-14 rounded-xl overflow-hidden bg-cream/40 border border-steel/20 shrink-0 relative">
                {% if item.mainPhoto %}
                  <img src="{{ path('app_media_document', {'uuid': item.mainPhoto.uuid}) }}" alt="{{ item.name }}" class="w-full h-full object-cover" />
                {% else %}
                  <div class="w-full h-full flex items-center justify-center text-steel/40">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  </div>
                {% endif %}
              </div>

              {# Dades del Bé #}
              <div class="flex-1 min-w-0">
                {# Fila 1: CUI a l'esquerra + Estat Custodiat a la dreta (Idèntic a PC) #}
                <div class="flex items-center justify-between gap-1 mb-0.5">
                  <span class="bg-ink/85 text-cream text-[9px] font-mono px-2 py-0.5 rounded-md font-semibold whitespace-nowrap shadow-2xs">
                    {{ item.cui }}
                  </span>

                  {# Icona / Badge d'Estat Compacte amb Icona #}
                  <span class="inline-flex items-center gap-1 text-[9px] font-bold px-1.5 py-0.5 rounded-full border bg-white/95 whitespace-nowrap shrink-0 {{ item.status.badgeClasses }}">
                    {% if item.status.value == 'active' %}
                      {# Escut amb checkmark verd de custòdia notarial #}
                      <svg class="w-2.5 h-2.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                      <span>Custodiat</span>
                    {% elseif item.status.value == 'draft' %}
                      <span class="w-1.5 h-1.5 rounded-full bg-steel shrink-0"></span>
                      <span>Esborrany</span>
                    {% elseif item.status.value == 'stolen' %}
                      <svg class="w-2.5 h-2.5 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                      <span>Denunciat</span>
                    {% elseif item.status.value == 'transfer_pending' %}
                      <svg class="w-2.5 h-2.5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                      <span>Traspàs</span>
                    {% else %}
                      <span>{{ item.status.label }}</span>
                    {% endif %}
                  </span>
                </div>

                {# Fila 2: Títol del Bé #}
                <a href="{{ path('app_item_show', {'cui': item.cui}) }}" class="font-marcellus text-sm font-bold text-ink truncate block hover:text-gold transition-colors leading-tight">
                  {{ item.name }}
                </a>

                {# Fila 3: Categoria a l'esquerra + Valor i Fletxa d'edició a la dreta #}
                <div class="text-[10px] text-ink/60 truncate mt-1 pt-1 border-t border-cream/60 flex items-center justify-between">
                  <span class="truncate">{{ item.category.name }}{% if item.brand %} &middot; {{ item.brand }}{% endif %}</span>
                  
                  <div class="flex items-center gap-1.5 shrink-0 ml-1.5">
                    {% if item.declaredValueEuros is not null %}
                      <span class="font-bold text-ink text-xs font-raleway">{{ item.declaredValueEuros|number_format(0, ',', '.') }} €</span>
                    {% endif %}
                    <a href="{{ path('app_item_show', {'cui': item.cui}) }}" class="w-5 h-5 rounded-md bg-cream/60 flex items-center justify-center text-ink/70 hover:text-ink hover:bg-cream transition-colors" aria-label="Veure Fitxa">
                      <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        {# 2. VISTA ESCRIPTORI (>= sm): Graella Notarial de 4 Columnes #}
        <div class="hidden sm:grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="desktop-items-grid">
          {% for item in items %}
            <div class="item-card bg-whitef border border-gold/30 hover:border-gold rounded-2xl p-3 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group relative" data-category="{{ item.category.slug }}">
              <div>
                {# Imatge del Bé amb Checkbox de Selecció Múltiple #}
                <div class="rounded-xl overflow-hidden aspect-[16/10] bg-cream/30 border border-steel/20 relative mb-2.5">
                  {% if item.mainPhoto %}
                    <img src="{{ path('app_media_document', {'uuid': item.mainPhoto.uuid}) }}" alt="{{ item.name }}" class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" />
                  {% else %}
                    <div class="w-full h-full flex flex-col items-center justify-center text-steel/50">
                      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      <span class="text-[9px] mt-1 text-ink/50">Sense fotografia</span>
                    </div>
                  {% endif %}

                  {# Checkbox de Selecció a la cantonada superior esquerra #}
                  <div class="absolute top-2 left-2 flex items-center gap-1 z-10">
                    <label class="flex items-center justify-center w-5 h-5 rounded-md bg-white/90 backdrop-blur-xs border border-gold/60 shadow-2xs cursor-pointer hover:bg-white">
                      <input type="checkbox" value="{{ item.cui }}" onchange="handleItemCheckboxChange()" class="item-checkbox w-3.5 h-3.5 text-ink rounded accent-ink cursor-pointer" />
                    </label>
                    <span class="bg-ink/90 backdrop-blur-xs text-cream text-[9px] font-mono px-1.5 py-0.5 rounded font-semibold shadow-2xs">
                      {{ item.cui }}
                    </span>
                  </div>

                  {# Badge d'Estat a la dreta amb escut per a Actiu/Custodiat #}
                  <div class="absolute top-2 right-2">
                    <span class="inline-flex items-center gap-1 text-[9px] font-bold px-2 py-0.5 rounded-full border bg-white/95 shadow-2xs {{ item.status.badgeClasses }}">
                      {% if item.status.value == 'active' %}
                        <svg class="w-2.5 h-2.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        <span>Custodiat</span>
                      {% else %}
                        <span>{{ item.status.label }}</span>
                      {% endif %}
                    </span>
                  </div>
                </div>

                {# Dades del Bé #}
                <div class="space-y-0.5">
                  <div class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold truncate">{{ item.category.name }}</div>
                  <h3 class="font-marcellus text-sm sm:text-base font-bold text-ink truncate group-hover:text-gold transition-colors leading-snug">{{ item.name }}</h3>
                  
                  <div class="flex items-center justify-between text-xs pt-1">
                    <span class="text-ink/60 truncate text-[11px]">{{ item.brand|default('—') }}</span>
                    <span class="font-bold text-ink text-xs sm:text-sm shrink-0">
                      {% if item.declaredValueEuros is not null %}
                        {{ item.declaredValueEuros|number_format(0, ',', '.') }} €
                      {% else %}
                        —
                      {% endif %}
                    </span>
                  </div>
                </div>
              </div>

              {# Acció Veure Fitxa #}
              <div class="pt-2.5 mt-2.5 border-t border-cream flex items-center justify-between">
                <span class="text-[10px] text-ink/50">{{ item.createdAt|date('d/m/Y') }}</span>
                <div class="flex items-center gap-2">
                  <a href="{{ path('app_item_show', {'cui': item.cui}) }}" class="text-xs font-bold text-ink group-hover:text-gold flex items-center gap-1 transition-colors">
                    <span>Fitxa</span>
                    <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

    {# Si no té béns: Estat Buit #}
    {% else %}
      <div class="bg-whitef border-2 border-gold/40 rounded-3xl p-10 sm:p-16 text-center max-w-2xl mx-auto my-8 shadow-lg relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-transparent via-gold to-transparent opacity-90"></div>

        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-cream/60 border border-gold/50 text-gold mx-auto flex items-center justify-center mb-5 shadow-xs">
          <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-marcellus text-ink">Encara no has registrat cap bé</h2>
        <p class="text-sm text-ink/75 mt-2.5 max-w-md mx-auto font-raleway">
          Comença catalogant el teu primer objecte de valor (bicicleta, rellotge, joia, dispositiu) per generar el seu codi CUI únic i protegir les teves proves de tinença.
        </p>
        <div class="mt-6 sm:mt-8">
          <a href="{{ path('app_item_new') }}" style="background-color: #1D2F4B; color: #FAF6F0;" class="py-3.5 px-7 rounded-xl shadow-lg hover:bg-ink/90 active:scale-[0.99] transition-all inline-flex items-center gap-2.5 text-sm uppercase tracking-wider font-raleway font-semibold">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>Registrar el meu primer bé</span>
          </a>
        </div>
      </div>
    {% endif %}

  </main>

  {# Barra Flotant d'Accions per Lot a PC (Quan hi ha selecció activa) #}
  <div id="desktop-batch-bar" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 bg-ink text-cream border border-gold/50 rounded-2xl px-6 py-3.5 shadow-2xl items-center gap-6 animate-in slide-in-from-bottom duration-200">
    <div class="flex items-center gap-3 pr-4 border-r border-gold/30 font-mono text-xs">
      <button type="button" onclick="clearBatchSelection()" class="text-gold hover:text-white font-bold cursor-pointer">✕</button>
      <span><strong id="desktop-batch-count">0</strong> béns seleccionats</span>
    </div>
    <div class="flex items-center gap-3">
      <button type="button" onclick="executeBatchAction('certificate')" class="px-4 py-2 rounded-xl bg-gold text-ink font-bold text-xs flex items-center gap-1.5 hover:bg-gold-light transition-colors cursor-pointer shadow-xs">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Emetre Certificat de Lot</span>
      </button>
      <button type="button" onclick="executeBatchAction('transfer')" class="px-4 py-2 rounded-xl bg-cream/20 hover:bg-cream/30 text-cream font-semibold text-xs flex items-center gap-1.5 transition-colors cursor-pointer border border-cream/30">
        <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        <span>Traspassar</span>
      </button>
      <button type="button" onclick="executeBatchAction('delete')" class="px-3 py-2 rounded-xl border border-red-400/40 text-red-300 hover:text-white hover:bg-red-900/40 text-xs font-semibold transition-colors cursor-pointer" title="Donar de baixa">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      </button>
    </div>
  </div>

  {# Barra Inferior Dinàmica PWA per a Mòbil (< md) #}
  <nav class="md:hidden sticky bottom-0 z-40 bg-white/95 backdrop-blur-md border-t border-steel/20 shadow-lg px-4 py-2">
    
    {# Mode Normal: Navegació #}
    <div id="pwa-bottom-nav" class="flex items-center justify-around">
      <a href="{{ path('app_dashboard') }}" class="flex flex-col items-center gap-0.5 text-[10px] font-bold text-ink">
        <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        <span>Patrimoni</span>
      </a>

      <a href="#" class="flex flex-col items-center gap-0.5 text-[10px] font-semibold text-ink/65">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Certificats</span>
      </a>

      {# Botó Central Destacat (+) #}
      <a href="{{ path('app_item_new') }}" class="w-11 h-11 -mt-4 rounded-full bg-ink text-gold border-2 border-gold flex items-center justify-center shadow-lg active:scale-95 transition-transform" aria-label="Registrar Nou Bé">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
      </a>

      <a href="#" class="flex flex-col items-center gap-0.5 text-[10px] font-semibold text-ink/65">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        <span>Traspassos</span>
      </a>

      <button type="button" onclick="toggleUserMenu()" class="flex flex-col items-center gap-0.5 text-[10px] font-semibold text-ink/65 cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        <span>Perfil</span>
      </button>
    </div>

    {# Mode Contextual: Accions per Lot (Quan hi ha selecció) #}
    <div id="pwa-batch-bar" class="hidden items-center justify-between gap-2 py-1">
      <div class="flex items-center gap-2">
        <button type="button" onclick="clearBatchSelection()" class="w-7 h-7 rounded-lg bg-cream text-ink text-xs font-bold flex items-center justify-center">✕</button>
        <span class="text-xs font-bold text-ink font-mono"><span id="pwa-batch-count">0</span> sel.</span>
      </div>

      <div class="flex items-center gap-2">
        <button type="button" onclick="executeBatchAction('certificate')" class="px-3 py-1.5 rounded-lg bg-gold text-ink text-xs font-bold flex items-center gap-1 shadow-xs">
          <span>Certificat</span>
        </button>
        <button type="button" onclick="executeBatchAction('transfer')" class="px-3 py-1.5 rounded-lg bg-ink text-cream text-xs font-semibold flex items-center gap-1">
          <span>Traspàs</span>
        </button>
        <button type="button" onclick="executeBatchAction('delete')" class="p-1.5 rounded-lg border border-red-300 text-red-700 text-xs">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      </div>
    </div>

  </nav>

  {# Peu de pàgina privat #}
  <footer class="border-t border-gold/30 py-5 text-center text-xs text-ink/65 bg-whitef hidden md:block">
    <p>&copy; {{ "now"|date("Y") }} Registrals &middot; Àrea privada de custòdia de patrimoni moble.</p>
  </footer>

</div>

<script>
  function filterCategory(slug, evt) {
    const cards = document.querySelectorAll('.item-card');
    const buttons = document.querySelectorAll('.category-filter-btn');

    buttons.forEach(btn => {
      btn.classList.remove('bg-ink', 'text-cream', 'border-ink');
      btn.classList.add('bg-white', 'text-ink/80', 'border-steel/30');
    });

    const targetBtn = evt ? evt.currentTarget : (window.event ? window.event.currentTarget : null);
    if (targetBtn) {
      targetBtn.classList.remove('bg-white', 'text-ink/80', 'border-steel/30');
      targetBtn.classList.add('bg-ink', 'text-cream', 'border-ink');
    }

    cards.forEach(card => {
      card.style.display = (slug === 'all' || card.dataset.category === slug) ? 'flex' : 'none';
    });
  }

  // ==========================================
  // Gestió de Selecció Múltiple i Barres d'Acció
  // ==========================================
  function handleItemCheckboxChange() {
    const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
    const count = selectedCheckboxes.length;

    const desktopBar = document.getElementById('desktop-batch-bar');
    const pwaNav = document.getElementById('pwa-bottom-nav');
    const pwaBatchBar = document.getElementById('pwa-batch-bar');
    const desktopCount = document.getElementById('desktop-batch-count');
    const pwaCount = document.getElementById('pwa-batch-count');

    if (desktopCount) desktopCount.innerText = count;
    if (pwaCount) pwaCount.innerText = count;

    if (count > 0) {
      if (desktopBar) desktopBar.classList.remove('hidden');
      if (desktopBar) desktopBar.classList.add('flex');
      if (pwaNav) pwaNav.classList.add('hidden');
      if (pwaBatchBar) pwaBatchBar.classList.remove('hidden');
      if (pwaBatchBar) pwaBatchBar.classList.add('flex');
    } else {
      if (desktopBar) desktopBar.classList.add('hidden');
      if (desktopBar) desktopBar.classList.remove('flex');
      if (pwaNav) pwaNav.classList.remove('hidden');
      if (pwaBatchBar) pwaBatchBar.classList.add('hidden');
      if (pwaBatchBar) pwaBatchBar.classList.remove('flex');
    }
  }

  function clearBatchSelection() {
    const checkboxes = document.querySelectorAll('.item-checkbox');
    checkboxes.forEach(cb => cb.checked = false);
    handleItemCheckboxChange();
  }

  function executeBatchAction(action) {
    const selected = Array.from(document.querySelectorAll('.item-checkbox:checked')).map(cb => cb.value);
    if (selected.length === 0) return;

    if (action === 'certificate') {
      if (window.RegistralsToast) {
        window.RegistralsToast.show('Emissió de Lot', `Preparant l'emissió del certificat oficial per a ${selected.length} béns...`, 'info');
      } else {
        alert(`Preparant certificat conjunt per a ${selected.length} béns: ` + selected.join(', '));
      }
    } else if (action === 'transfer') {
      if (window.RegistralsToast) {
        window.RegistralsToast.show('Traspàs de Lot', `Iniciant canvi de titularitat per a ${selected.length} béns...`, 'info');
      } else {
        alert(`Iniciant traspàs per a: ` + selected.join(', '));
      }
    } else if (action === 'delete') {
      if (confirm(`Estàs segur que vols donar de baixa aquests ${selected.length} béns del teu inventari?`)) {
        if (window.RegistralsToast) {
          window.RegistralsToast.show('Baixa processada', `S'han tramitat les baixes dels béns seleccionats.`, 'info');
        }
        clearBatchSelection();
      }
    }
  }
</script>
{% endblock %}
