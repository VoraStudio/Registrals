{% extends 'base.html.twig' %}

{% block title %}El meu Patrimoni — Registrals{% endblock %}
{% block meta_description %}Àrea privada de gestió de béns mobles, proves i certificats.{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {# Barra Superior Privada #}
  <header class="border-b border-gold/30 bg-whitef sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <div class="flex items-center gap-8">
        <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3.5 group">
          <img src="{{ asset('img/logos/Isotip/1-transparent.svg') }}" alt="Isotip Registrals" class="w-10 h-10 transition-transform group-hover:scale-105" />
          <span class="font-marcellus tracking-widest uppercase text-2xl text-ink font-medium">Registrals</span>
        </a>
        <nav class="hidden md:flex items-center gap-2 text-sm uppercase tracking-wider font-semibold text-ink/70 font-raleway">
          <a href="{{ path('app_dashboard') }}" class="px-4 py-2 rounded-xl text-ink bg-cream/70 border border-gold/40">Patrimoni</a>
          <a href="#" class="px-4 py-2 rounded-xl hover:text-ink hover:bg-cream/30 transition-colors">Certificats</a>
          <a href="#" class="px-4 py-2 rounded-xl hover:text-ink hover:bg-cream/30 transition-colors">Traspassos</a>
        </nav>
      </div>

      <div class="flex items-center gap-5">
        {# Insígnia del Pla #}
        <div class="hidden sm:flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-cream border border-gold/40 text-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-gold"></span>
          <span class="text-ink font-bold">{{ app.user.plan.name }}</span>
        </div>

        {# Perfil d'usuari i Logout #}
        <div class="flex items-center gap-4">
          <div class="text-right hidden sm:block">
            <div class="text-sm font-bold text-ink">{{ app.user.fullName }}</div>
            <div class="text-xs text-ink/65">{{ app.user.email }}</div>
          </div>
          <a href="{{ path('app_logout') }}" class="p-2.5 rounded-xl bg-cream/50 hover:bg-cream border border-gold/30 text-ink/80 hover:text-ink transition-colors" title="Tancar Sessió" aria-label="Tancar Sessió">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          </a>
        </div>
      </div>
    </div>
  </header>

  {# Contingut del Dashboard #}
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full flex-1">

    {# Barra de Resum i Benvinguda #}
    <div class="mb-10 flex flex-col md:flex-row md:items-center md:justify-between gap-5 pb-8 border-b border-gold/30">
      <div>
        <h1 class="text-3xl sm:text-4xl font-marcellus text-ink tracking-wide">El meu Patrimoni</h1>
        <p class="text-base text-ink/75 mt-2 font-raleway">Benvingut/da, {{ app.user.firstName }}. Aquí trobaràs la relació dels teus béns custodiats i protegits.</p>
      </div>

      <div class="flex items-center gap-3">
        <button type="button" class="py-3 px-6 bg-ink text-cream font-semibold rounded-xl shadow-md hover:bg-ink/90 active:scale-[0.99] transition-all flex items-center gap-2.5 text-sm uppercase tracking-wider font-raleway">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>Registrar Nou Bé</span>
        </button>
      </div>
    </div>

    {# Barra de Mètriques de Pla (Nudging de la Secció 7 del PRD) #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <div class="bg-whitef border-2 border-gold/30 rounded-2xl p-6 shadow-sm">
        <div class="text-xs uppercase tracking-wider text-ink/70 mb-2 font-bold">Capacitat de Béns</div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold text-ink font-marcellus">{{ app.user.lifetimeItemsRegistered }}</span>
          <span class="text-sm text-ink/65">/ {{ app.user.plan.maxActiveItems }} permesos</span>
        </div>
        <div class="w-full bg-cream h-2.5 rounded-full mt-4 overflow-hidden border border-gold/20">
          <div class="bg-gold h-full rounded-full" style="width: 0%"></div>
        </div>
      </div>

      <div class="bg-whitef border-2 border-gold/30 rounded-2xl p-6 shadow-sm">
        <div class="text-xs uppercase tracking-wider text-ink/70 mb-2 font-bold">Assistent IA de Tast</div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold text-ink font-marcellus">{{ app.user.plan.aiAssistanceQuota - app.user.aiUsageCount }}</span>
          <span class="text-sm text-ink/65">consultes disponibles</span>
        </div>
        <p class="text-xs text-ink/65 mt-3">Classificació visual i OCR de tiquets d'origen.</p>
      </div>

      <div class="bg-whitef border-2 border-gold/30 rounded-2xl p-6 shadow-sm">
        <div class="text-xs uppercase tracking-wider text-ink/70 mb-2 font-bold">Estat de Seguretat</div>
        <div class="flex items-center gap-2 mt-1.5">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-cream text-ink border border-gold/40">
            Compte Bàsic (Free)
          </span>
        </div>
        <p class="text-xs text-ink/65 mt-3">Doble capa eIDAS i Blockchain activa.</p>
      </div>
    </div>

    {# Estat Buit Elegant #}
    <div class="bg-whitef border-2 border-gold/40 rounded-3xl p-12 sm:p-16 text-center max-w-2xl mx-auto my-10 shadow-lg relative overflow-hidden">
      {# Lluentor daurada superior #}
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-transparent via-gold to-transparent opacity-90"></div>

      <div class="w-20 h-20 rounded-full bg-cream/60 border border-gold/50 text-gold mx-auto flex items-center justify-center mb-6 shadow-xs">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-marcellus text-ink">Encara no has registrat cap bé</h2>
      <p class="text-base text-ink/75 mt-3 max-w-md mx-auto font-raleway">
        Comença catalogant el teu primer objecte de valor (bicicleta, rellotge, joia, dispositiu) per generar el seu codi CUI únic i protegir les teves proves de tinença.
      </p>
      <div class="mt-8">
        <button type="button" class="py-4 px-8 bg-ink text-cream font-semibold rounded-xl shadow-lg hover:bg-ink/90 active:scale-[0.99] transition-all inline-flex items-center gap-3 text-base uppercase tracking-wider font-raleway">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>Registrar el meu primer bé</span>
        </button>
      </div>
    </div>

  </main>

  {# Peu de pàgina privat #}
  <footer class="border-t border-gold/30 py-5 text-center text-sm text-ink/65 bg-whitef">
    <p>&copy; {{ "now"|date("Y") }} Registrals &middot; Àrea privada de custòdia de patrimoni moble.</p>
  </footer>

</div>
{% endblock %}
