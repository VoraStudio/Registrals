{% extends 'base.html.twig' %}

{% block title %}El meu Patrimoni — Registrals{% endblock %}
{% block meta_description %}Àrea privada de gestió de béns mobles, proves i certificats.{% endblock %}

{% block body_class %}bg-cream-50 text-ink min-h-screen flex flex-col font-raleway antialiased selection:bg-gold selection:text-ink{% endblock %}

{% block body %}
  {# Barra Superior Privada Unificada (Fons Blanc + Línia Tènue + Avatar amb Micro-Badge) #}
  {% include 'partials/_private_header.html.twig' %}

  {# Contingut del Dashboard #}
  <main class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3.5 w-full flex-1">

    {# 1. Línia de Ruta Mínima #}
    <nav class="flex items-center gap-1.5 text-[11px] font-mono text-steel uppercase tracking-wider mb-2" aria-label="Ruta de navegació">
      <span class="text-ink font-bold">Inici</span>
    </nav>

    {# 2. Barra de Títol i Acció Principal #}
    <div class="mb-3.5 sm:mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-2.5 sm:pb-3.5 border-b border-gold/15">
      <div>
        <h1 class="text-xl sm:text-3xl font-marcellus text-ink tracking-wide">El meu Patrimoni</h1>
        <p class="text-xs sm:text-sm text-ink/75 mt-0.5 font-raleway">Benvingut/da, {{ app.user.firstName }}. Relació dels teus béns custodiats i protegits.</p>
      </div>

      <div class="flex items-center gap-3">
        <a href="{{ path('app_item_new') }}" style="background-color: #1D2F4B; color: #FAF6F0;" class="py-2 px-4 sm:px-5 rounded-xl shadow-md hover:bg-ink/90 active:scale-[0.99] transition-all flex items-center gap-2 text-xs uppercase tracking-wider font-raleway font-semibold cursor-pointer">
          <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"/></svg>
          <span>Registrar Nou Bé</span>
        </a>
      </div>
    </div>

    {# Notificació Notarial de Traspassos Rebuts Pendents d'Acceptació #}
    {% if pendingIncomingTransfers is defined and pendingIncomingTransfers|length > 0 %}
      <div class="mb-4 sm:mb-6 p-4 sm:p-5 rounded-2xl bg-amber-50/90 border border-amber-300 shadow-sm space-y-3">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
            <h2 class="font-marcellus text-base sm:text-lg text-ink font-bold">
              Invitació de Traspàs de Titularitat Pendent ({{ pendingIncomingTransfers|length }})
            </h2>
          </div>
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-200 text-amber-900 border border-amber-400">
            Requereix Acció
          </span>
        </div>

        <p class="text-xs text-ink/80">
          Un altre titular ha iniciat la transferència de la custòdia d'un bé al teu favor. Revisa els detalls i accepta'l per incorporar-lo al teu patrimoni:
        </p>

        <div class="space-y-2.5 pt-1">
          {% for transfer in pendingIncomingTransfers %}
            <div class="p-3.5 sm:p-4 rounded-xl bg-white border border-amber-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs">
              <div class="space-y-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="bg-ink text-gold font-mono font-bold text-xs px-2.5 py-0.5 rounded-lg border border-gold/40">
                    {{ transfer.item.cui }}
                  </span>
                  <span class="text-sm font-marcellus text-ink font-bold truncate">
                    {{ transfer.item.name }}
                  </span>
                  <span class="text-xs text-steel font-semibold">
                    ({{ transfer.item.category.name }})
                  </span>
                </div>
                <p class="text-xs text-steel">
                  Remitent: <strong class="text-ink">{{ transfer.sender.fullName }}</strong> (<span class="font-mono text-ink/70">{{ transfer.sender.email }}</span>) &middot; Caduca el <strong>{{ transfer.expiresAt|date('d/m/Y H:i') }} UTC</strong>
                </p>
              </div>

              <a href="{{ path('app_transfer_claim', {'token': transfer.token}) }}" class="px-4 py-2 rounded-xl bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-bold text-xs uppercase tracking-wider transition-all shadow-xs flex items-center justify-center gap-1.5 shrink-0 cursor-pointer">
                <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                <span>Revisar i Acceptar</span>
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {# Banner de Període de Gràcia per Downgrade a Pla Free #}
    {% if inGracePeriod is defined and inGracePeriod %}
      <div class="mb-4 sm:mb-6 p-4 sm:p-5 rounded-2xl bg-amber-50/95 border-2 border-amber-400 shadow-sm space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="w-3 h-3 rounded-full bg-amber-500 animate-pulse"></span>
            <h2 class="font-marcellus text-base sm:text-lg text-ink font-bold">
              Període d'Adequació de Patrimoni Actiu (Pla Free)
            </h2>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-amber-200 text-amber-900 border border-amber-400 shrink-0">
            {{ graceDaysLeft }} dies restants
          </span>
        </div>
        <p class="text-xs sm:text-sm text-ink/80 leading-relaxed font-raleway">
          Tens <strong>{{ items|length }} béns actius</strong> sota el Pla Free, superant la quota operativa de <strong>{{ maxFreeItems }} béns</strong>. Disposes d'un període de gràcia de <strong>{{ graceDaysLeft }} dies</strong> per triar quins béns vols mantenir operatius. Quan finalitzi aquest termini, els béns excedents passaran automàticament a <em>custòdia en fred</em>.
        </p>
        <div class="flex flex-wrap items-center gap-2.5 pt-1">
          <a href="{{ path('app_downgrade_adequacy') }}" class="px-4 py-2 rounded-xl bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-bold text-xs uppercase tracking-wider transition-all shadow-xs flex items-center gap-1.5 cursor-pointer">
            <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            <span>Adequar els meus {{ maxFreeItems }} béns actius</span>
          </a>
          <a href="{{ path('app_plan') }}" class="px-4 py-2 rounded-xl bg-white text-ink border border-amber-300 hover:bg-amber-100/60 font-semibold text-xs transition-all">
            Ampliar a Pla Plus (Fins a {{ maxPlusItems }} béns)
          </a>
        </div>
      </div>

      {# Notificació Toast per emfatitzar la situació rellevant en carregar #}
      <script>
        (function() {
          function showGraceToast() {
            if (window.RegistralsToast) {
              window.RegistralsToast.show(
                'Període d\'Adequació Actiu',
                'Tens {{ items|length }} de {{ maxFreeItems }} béns actius. Disposes de {{ graceDaysLeft }} dies per triar quins conserves operatius abans que passin a custòdia en fred.',
                'warning',
                6500
              );
            }
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', showGraceToast);
          } else {
            showGraceToast();
          }
        })();
      </script>
    {% endif %}

    {# Barra de Mètriques de Pla (Nudging de la Secció 7 del PRD) #}
    {% set itemsCount = items|length %}
    {% set maxAllowed = app.user.plan ? app.user.plan.maxActiveItems : -1 %}
    {% set pct = maxAllowed > 0 ? ((itemsCount / maxAllowed * 100)|round) : 10 %}
    {% set yearlyRegs = app.user.periodItemsRegistered %}
    {% set maxYearlyRegs = app.user.plan ? app.user.plan.maxYearlyRegistrations : -1 %}
    {% set aiUsed = app.user.aiUsageCount %}
    {% set maxAi = app.user.plan ? app.user.plan.aiAssistanceQuota : -1 %}
    {% set aiPct = maxAi > 0 ? ((aiUsed / maxAi * 100)|round) : 0 %}

    <div class="sm:hidden mb-4 bg-whitef border border-gold/40 rounded-2xl p-2 shadow-2xs flex items-center justify-between text-xs">
      {# Segment 1: Béns #}
      <div class="flex-1 flex items-center justify-center gap-1.5 px-1 border-r border-steel/20">
        <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        <span class="font-mono text-[11px] font-bold text-ink whitespace-nowrap">
          {{ itemsCount }}<span class="text-ink/45 font-normal">/{{ maxAllowed > 0 ? maxAllowed : '∞' }}</span>
        </span>
        <span class="text-[9px] text-ink/60 font-semibold uppercase tracking-tight">Béns</span>
      </div>

      {# Segment 2: Crèdits IA #}
      <div class="flex-1 flex items-center justify-center gap-1.5 px-1 border-r border-steel/20">
        <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span class="font-mono text-[11px] font-bold text-ink whitespace-nowrap">
          {{ aiUsed }}<span class="text-ink/45 font-normal">/{{ maxAi > 0 ? maxAi : '∞' }}</span>
        </span>
        <span class="text-[9px] text-ink/60 font-semibold uppercase tracking-tight whitespace-nowrap">IA</span>
      </div>

      {# Segment 3: Pla Actiu #}
      <div class="flex-1 flex items-center justify-center px-1">
        <span class="inline-flex items-center gap-1 text-[9px] font-bold px-2 py-0.5 rounded-full bg-cream text-ink border border-gold/40 whitespace-nowrap">
          <svg class="w-2.5 h-2.5 text-gold shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span>{{ app.user.plan ? app.user.plan.name|split('(')[0]|trim : 'ADMINISTRADOR' }}</span>
        </span>
      </div>
    </div>

    {# Versió Escriptori: Franja Notarial Horitzontal Compacta (>= sm) #}
    <div class="hidden sm:flex items-center justify-between gap-4 bg-whitef border border-gold/35 rounded-2xl p-3 sm:px-6 sm:py-3.5 mb-6 shadow-2xs">
      {# Segment 1: Capacitat de Béns #}
      <div class="flex items-center gap-3.5 flex-1 pr-4 border-r border-gold/20">
        <div class="w-10 h-10 rounded-xl bg-cream/50 border border-gold/30 flex items-center justify-center shrink-0 text-gold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        </div>
        <div class="min-w-0">
          <div class="text-[10px] uppercase tracking-wider text-ink/60 font-bold">Capacitat de Béns</div>
          <div class="flex items-baseline gap-1.5 mt-0.5">
            <span class="font-marcellus text-lg font-bold text-ink">{{ itemsCount }}</span>
            <span class="text-xs text-ink/55 font-mono">/ {{ maxAllowed > 0 ? maxAllowed : '∞' }} actius</span>
          </div>
          {% if maxYearlyRegs > 0 and maxYearlyRegs < 9999 %}
            <div class="text-[10px] text-ink/50 font-mono mt-0.5">Altes aquest cicle: <strong class="text-ink font-semibold">{{ yearlyRegs }}</strong>/{{ maxYearlyRegs }}</div>
          {% endif %}
        </div>
        <div class="w-24 bg-cream/70 h-1.5 rounded-full overflow-hidden border border-gold/25 ml-auto hidden md:block">
          <div class="bg-gold h-full rounded-full" style="width: {{ pct > 100 ? 100 : pct }}%"></div>
        </div>
      </div>

      {# Segment 2: Crèdits IA #}
      <div class="flex items-center gap-3.5 flex-1 pr-4 border-r border-gold/20">
        <div class="w-10 h-10 rounded-xl bg-cream/50 border border-gold/30 flex items-center justify-center shrink-0 text-gold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <div class="min-w-0">
          <div class="text-[10px] uppercase tracking-wider text-ink/60 font-bold">Crèdits IA</div>
          <div class="flex items-baseline gap-1.5 mt-0.5">
            <span class="font-marcellus text-lg font-bold text-ink">{{ aiUsed }}</span>
            <span class="text-xs text-ink/55 font-mono">/ {{ maxAi > 0 ? maxAi : '∞' }} consultes</span>
          </div>
        </div>
        <div class="w-24 bg-cream/70 h-1.5 rounded-full overflow-hidden border border-gold/25 ml-auto hidden md:block">
          <div class="bg-gold h-full rounded-full" style="width: {{ aiPct > 100 ? 100 : aiPct }}%"></div>
        </div>
      </div>

      {# Segment 3: Pla & Protecció #}
      <div class="flex items-center gap-3.5 flex-1">
        <div class="w-10 h-10 rounded-xl bg-cream/50 border border-gold/30 flex items-center justify-center shrink-0 text-gold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div class="min-w-0">
          <div class="text-[10px] uppercase tracking-wider text-ink/60 font-bold">Pla & Seguretat</div>
          <div class="flex items-center gap-2 mt-0.5">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-cream text-ink border border-gold/40">
              {{ app.user.plan ? app.user.plan.name|split('(')[0]|trim : 'ADMINISTRADOR' }}
            </span>
            <span class="text-[11px] text-ink/50 hidden lg:inline">eIDAS + Polygon</span>
          </div>
        </div>
      </div>
    </div>

    {# Si té béns registrats: Filtres i Llistat #}
    {% if items is not empty %}
      <div class="space-y-4 sm:space-y-6">
        {# Barra d'eines: Filtres de Categoria (Scroll a mòbil, Wrap net a PC) #}
        <div class="py-1">
          <div class="flex items-center gap-2 overflow-x-auto sm:flex-wrap pb-1 sm:pb-0 no-scrollbar">
            <button type="button" onclick="filterCategory('all', event)" class="category-filter-btn active px-3.5 py-1.5 rounded-full text-xs font-semibold bg-ink text-cream border border-ink transition-all shrink-0">
              Tots ({{ itemsCount }})
            </button>
            {% for cat in categories %}
              <button type="button" onclick="filterCategory('{{ cat.slug }}', event)" class="category-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-steel/30 text-ink/80 hover:bg-cream/40 transition-all shrink-0">
                {{ cat.name }}
              </button>
            {% endfor %}
          </div>
        </div>

        {# 1. VISTA MÒBIL (< sm): Llistat Compacte de Miniatures Horitzontals #}
        <div class="sm:hidden space-y-2.5" id="mobile-items-list">
          {% for item in items %}
            <div class="item-card bg-whitef border border-gold/30 hover:border-gold rounded-2xl p-2.5 shadow-2xs flex items-center gap-2.5 relative transition-all" data-category="{{ item.category.slug }}">
              {# Checkbox de Selecció #}
              <label class="flex items-center justify-center w-5 h-5 rounded-md bg-cream/50 border border-gold/60 cursor-pointer shrink-0">
                <input type="checkbox"
                       value="{{ item.cui }}"
                       data-cui="{{ item.cui }}"
                       data-name="{{ item.name|e('html_attr') }}"
                       data-id="{{ item.id }}"
                       data-csrf="{{ csrf_token('deactivate_item_' ~ item.id) }}"
                       data-has-official-cert="{{ item.certificates|filter(c => c.mode.isOfficial)|length > 0 ? '1' : '0' }}"
                       data-has-transfers="{{ item.transfers|length > 0 ? '1' : '0' }}"
                       data-show-url="{{ path('app_item_show', {'cui': item.cui}) }}"
                       onchange="handleItemCheckboxChange()"
                       class="item-checkbox w-3.5 h-3.5 text-ink rounded accent-ink cursor-pointer" />
              </label>

              {# Miniatura Quadrada #}
              <div class="w-14 h-14 rounded-xl overflow-hidden bg-cream/40 border border-steel/20 shrink-0 relative">
                {% if item.mainPhoto %}
                  <img src="{{ path('app_media_document', {'uuid': item.mainPhoto.uuid}) }}" alt="{{ item.name }}" class="w-full h-full object-cover" />
                {% else %}
                  <div class="w-full h-full flex items-center justify-center text-steel/40">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  </div>
                {% endif %}
              </div>

              {# Dades del Bé #}
              <div class="flex-1 min-w-0">
                {# Fila 1: CUI a l'esquerra + Estat Custodiat a la dreta (Idèntic a PC) #}
                <div class="flex items-center justify-between gap-1 mb-0.5">
                  <span class="bg-ink/85 text-cream text-[9px] font-mono px-2 py-0.5 rounded-md font-semibold whitespace-nowrap shadow-2xs">
                    {{ item.cui }}
                  </span>

                  {# Icona / Badge d'Estat Compacte amb Icona #}
                  <span class="inline-flex items-center gap-1 text-[9px] font-bold px-1.5 py-0.5 rounded-full border bg-white/95 whitespace-nowrap shrink-0 {{ item.status.badgeClasses }}">
                    {% if item.status.value == 'active' %}
                      {# Escut amb checkmark verd de custòdia notarial #}
                      <svg class="w-2.5 h-2.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                      <span>Custodiat</span>
                    {% elseif item.status.value == 'draft' %}
                      <span class="w-1.5 h-1.5 rounded-full bg-steel shrink-0"></span>
                      <span>Esborrany</span>
                    {% elseif item.status.value == 'stolen' %}
                      <svg class="w-2.5 h-2.5 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                      <span>Denunciat</span>
                    {% elseif item.status.value == 'transfer_pending' %}
                      <svg class="w-2.5 h-2.5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                      <span>Traspàs</span>
                    {% else %}
                      <span>{{ item.status.label }}</span>
                    {% endif %}
                  </span>
                </div>

                {# Fila 2: Títol del Bé #}
                <a href="{{ path('app_item_show', {'cui': item.cui}) }}" class="font-marcellus text-sm font-bold text-ink truncate block hover:text-gold transition-colors leading-tight">
                  {{ item.name }}
                </a>

                {# Fila 3: Categoria a l'esquerra + Valor i Fletxa d'edició a la dreta #}
                <div class="text-[10px] text-ink/60 truncate mt-1 pt-1 border-t border-cream/60 flex items-center justify-between">
                  <span class="truncate">{{ item.category.name }}{% if item.brand %} &middot; {{ item.brand }}{% endif %}</span>
                  
                  <div class="flex items-center gap-1.5 shrink-0 ml-1.5">
                    {% if item.declaredValueEuros is not null %}
                      <span class="font-bold text-ink text-xs font-raleway">{{ item.declaredValueEuros|number_format(0, ',', '.') }} €</span>
                    {% endif %}
                    <a href="{{ path('app_item_show', {'cui': item.cui}) }}" class="w-5 h-5 rounded-md bg-cream/60 flex items-center justify-center text-ink/70 hover:text-ink hover:bg-cream transition-colors" aria-label="Veure Fitxa">
                      <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        {# 2. VISTA ESCRIPTORI (>= sm): Graella Notarial Fins a 5 Columnes #}
        <div class="hidden sm:grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3.5 sm:gap-4" id="desktop-items-grid">
          {% for item in items %}
            <div class="item-card bg-whitef border border-gold/30 hover:border-gold rounded-2xl p-3 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group relative" data-category="{{ item.category.slug }}">
              <div>
                {# Imatge del Bé amb Checkbox de Selecció Múltiple #}
                <div class="rounded-xl overflow-hidden aspect-[16/10] bg-cream/30 border border-steel/20 relative mb-2.5">
                  {% if item.mainPhoto %}
                    <img src="{{ path('app_media_document', {'uuid': item.mainPhoto.uuid}) }}" alt="{{ item.name }}" class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" />
                  {% else %}
                    <div class="w-full h-full flex flex-col items-center justify-center text-steel/50">
                      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      <span class="text-[9px] mt-1 text-ink/50">Sense fotografia</span>
                    </div>
                  {% endif %}

                  {# Checkbox de Selecció a la cantonada superior esquerra #}
                  <div class="absolute top-2 left-2 flex items-center gap-1 z-10">
                    <label class="flex items-center justify-center w-5 h-5 rounded-md bg-white/90 backdrop-blur-xs border border-gold/60 shadow-2xs cursor-pointer hover:bg-white">
                      <input type="checkbox"
                             value="{{ item.cui }}"
                             data-cui="{{ item.cui }}"
                             data-name="{{ item.name|e('html_attr') }}"
                             data-id="{{ item.id }}"
                             data-csrf="{{ csrf_token('deactivate_item_' ~ item.id) }}"
                             data-has-official-cert="{{ item.certificates|filter(c => c.mode.isOfficial)|length > 0 ? '1' : '0' }}"
                             data-has-transfers="{{ item.transfers|length > 0 ? '1' : '0' }}"
                             data-show-url="{{ path('app_item_show', {'cui': item.cui}) }}"
                             onchange="handleItemCheckboxChange()"
                             class="item-checkbox w-3.5 h-3.5 text-ink rounded accent-ink cursor-pointer" />
                    </label>
                    <span class="bg-ink/90 backdrop-blur-xs text-cream text-[9px] font-mono px-1.5 py-0.5 rounded font-semibold shadow-2xs">
                      {{ item.cui }}
                    </span>
                  </div>

                  {# Badge d'Estat a la dreta amb escut per a Actiu/Custodiat #}
                  <div class="absolute top-2 right-2">
                    <span class="inline-flex items-center gap-1 text-[9px] font-bold px-2 py-0.5 rounded-full border bg-white/95 shadow-2xs {{ item.status.badgeClasses }}">
                      {% if item.status.value == 'active' %}
                        <svg class="w-2.5 h-2.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        <span>Custodiat</span>
                      {% else %}
                        <span>{{ item.status.label }}</span>
                      {% endif %}
                    </span>
                  </div>
                </div>

                {# Dades del Bé #}
                <div class="space-y-0.5">
                  <div class="text-[10px] uppercase tracking-wider text-ink/60 font-semibold truncate">{{ item.category.name }}</div>
                  <h3 class="font-marcellus text-sm sm:text-base font-bold text-ink truncate group-hover:text-gold transition-colors leading-snug">{{ item.name }}</h3>
                  
                  <div class="flex items-center justify-between text-xs pt-1">
                    <span class="text-ink/60 truncate text-[11px]">{{ item.brand|default('—') }}</span>
                    <span class="font-bold text-ink text-xs sm:text-sm shrink-0">
                      {% if item.declaredValueEuros is not null %}
                        {{ item.declaredValueEuros|number_format(0, ',', '.') }} €
                      {% else %}
                        —
                      {% endif %}
                    </span>
                  </div>
                </div>
              </div>

              {# Acció Veure Fitxa #}
              <div class="pt-2.5 mt-2.5 border-t border-cream flex items-center justify-between">
                <span class="text-[10px] text-ink/50">{{ item.createdAt|date('d/m/Y') }}</span>
                <div class="flex items-center gap-2">
                  <a href="{{ path('app_item_show', {'cui': item.cui}) }}" class="text-xs font-bold text-ink group-hover:text-gold flex items-center gap-1 transition-colors">
                    <span>Fitxa</span>
                    <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

    {# Si no té béns: Estat Buit #}
    {% else %}
      <div class="bg-whitef border-2 border-gold/40 rounded-3xl p-10 sm:p-16 text-center max-w-2xl mx-auto my-8 shadow-lg relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-transparent via-gold to-transparent opacity-90"></div>

        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-cream/60 border border-gold/50 text-gold mx-auto flex items-center justify-center mb-5 shadow-xs">
          <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-marcellus text-ink">Encara no has registrat cap bé</h2>
        <p class="text-sm text-ink/75 mt-2.5 max-w-md mx-auto font-raleway">
          Comença catalogant el teu primer objecte de valor (bicicleta, rellotge, joia, dispositiu) per generar el seu codi CUI únic i protegir les teves proves de tinença.
        </p>
        <div class="mt-6 sm:mt-8">
          <a href="{{ path('app_item_new') }}" style="background-color: #1D2F4B; color: #FAF6F0;" class="py-3.5 px-7 rounded-xl shadow-lg hover:bg-ink/90 active:scale-[0.99] transition-all inline-flex items-center gap-2.5 text-sm uppercase tracking-wider font-raleway font-semibold">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>Registrar el meu primer bé</span>
          </a>
        </div>
      </div>
    {% endif %}

    {# Secció de Custòdia en Fred (Drawer Inferior) #}
    {% if frozenCount is defined and frozenCount > 0 %}
      <div class="mt-8 pt-6 border-t border-steel/20">
        <div class="bg-slate-900/5 border border-slate-300/70 rounded-2xl p-4 sm:p-5 shadow-2xs backdrop-blur-xs">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3.5 border-b border-slate-200">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-slate-800 text-slate-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              <div>
                <h2 class="font-marcellus text-base sm:text-lg text-ink font-bold flex items-center gap-2">
                  <span>Béns en Custòdia en Fred</span>
                  <span class="px-2 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-200 text-slate-800 border border-slate-300">
                    {{ frozenCount }}
                  </span>
                </h2>
                <p class="text-xs text-ink/70 font-raleway">
                  Béns immutables protegits per sobre de la quota del Pla Free. En estat només de lectura amb integritat criptogràfica garantida.
                </p>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <button type="button" onclick="toggleFrozenList()" id="toggle-frozen-btn" class="px-3 py-1.5 rounded-lg bg-white border border-slate-300 text-xs font-semibold text-ink/80 hover:text-ink hover:bg-slate-50 transition-colors flex items-center gap-1.5 cursor-pointer">
                <span id="toggle-frozen-label">Desplegar llista ({{ frozenCount }})</span>
                <svg id="toggle-frozen-icon" class="w-3.5 h-3.5 text-steel transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <a href="{{ path('app_downgrade_adequacy') }}" class="px-3 py-1.5 rounded-lg bg-white border border-slate-300 text-xs font-semibold text-ink/80 hover:text-ink hover:bg-slate-50 transition-colors">
                Adequar Selecció
              </a>
              <button type="button" onclick="openReactivationModal()" class="px-3.5 py-1.5 rounded-lg bg-ink text-gold font-bold text-xs uppercase tracking-wider hover:bg-ink/90 transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <span>Descongelar amb Pla Plus</span>
              </button>
            </div>
          </div>

          {# Taula compacta de béns congelats (Desplegable amb scroll intern) #}
          <div id="frozen-items-container" class="hidden mt-3 divide-y divide-slate-200/60 overflow-y-auto max-h-72 sm:max-h-80 rounded-xl bg-white/70 border border-slate-200/80 shadow-2xs">
            {% for fItem in frozenItems %}
              <div class="p-3 sm:px-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 opacity-80 hover:opacity-100 transition-opacity">
                <div class="flex items-center gap-3 min-w-0">
                  <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                  <span class="font-mono text-xs font-semibold bg-slate-100 text-slate-700 px-2 py-0.5 rounded border border-slate-300 shrink-0">
                    {{ fItem.cui }}
                  </span>
                  <span class="font-marcellus text-sm font-bold text-ink truncate">
                    {{ fItem.name }}
                  </span>
                  <span class="text-xs text-steel shrink-0 hidden md:inline">
                    ({{ fItem.category.name }})
                  </span>
                </div>

                <div class="flex items-center justify-between sm:justify-end gap-3 shrink-0">
                  <span class="text-xs font-mono text-ink/70">
                    {{ fItem.declaredValueEuros ? fItem.declaredValueEuros|number_format(0, ',', '.') ~ ' €' : '—' }}
                  </span>
                  <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-slate-200 text-slate-700 border border-slate-300">
                    Custòdia en fred
                  </span>
                  {% set canReactivateItem = (maxAllowed == -1 or maxAllowed >= 9999 or itemsCount < maxAllowed) %}
                  <button type="button" onclick="openReactivationModal('{{ fItem.name|e('js') }}', '{{ fItem.cui }}', '{{ csrf_token('reactivate_item_' ~ fItem.id) }}', {{ canReactivateItem ? 'true' : 'false' }})" class="text-xs text-gold font-bold hover:underline cursor-pointer flex items-center gap-1">
                    <span>Reactivar</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  </button>
                </div>
              </div>
            {% endfor %}

            {% if frozenCount > frozenItems|length %}
              <div class="p-2.5 bg-slate-100/70 text-center text-xs font-mono text-steel border-t border-slate-200">
                Mostrant {{ frozenItems|length }} de {{ frozenCount }} béns en custòdia en fred.
                <a href="{{ path('app_downgrade_adequacy') }}" class="text-gold font-bold hover:underline ml-1">Gestionar tots a l'assistent →</a>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}

  </main>

  {# Barra Flotant d'Accions per Lot a PC (Quan hi ha selecció activa) #}
  <div id="desktop-batch-bar" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 bg-ink text-cream border border-gold/50 rounded-2xl px-6 py-3.5 shadow-2xl items-center gap-6 animate-in slide-in-from-bottom duration-200">
    <div class="flex items-center gap-3 pr-4 border-r border-gold/30 font-mono text-xs">
      <button type="button" onclick="clearBatchSelection()" class="text-gold hover:text-white font-bold cursor-pointer" aria-label="Desmarcar selecció">✕</button>
      <span><strong id="desktop-batch-count">0</strong> <span id="desktop-batch-count-label">béns seleccionats</span></span>
    </div>
    <div class="flex items-center gap-3">
      <button type="button" onclick="executeBatchAction('certificate')" class="px-4 py-2 rounded-xl bg-gold text-ink font-bold text-xs flex items-center gap-1.5 hover:bg-gold-light transition-colors cursor-pointer shadow-xs">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span id="desktop-batch-cert-label">Emetre Certificat</span>
      </button>
      <button type="button" onclick="executeBatchAction('transfer')" class="px-4 py-2 rounded-xl bg-cream/20 hover:bg-cream/30 text-cream font-semibold text-xs flex items-center gap-1.5 transition-colors cursor-pointer border border-cream/30">
        <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        <span id="desktop-batch-transfer-label">Traspassar</span>
      </button>
      <button type="button" onclick="executeBatchAction('delete')" class="px-3.5 py-2 rounded-xl border border-red-400/40 text-red-300 hover:text-white hover:bg-red-900/40 text-xs font-semibold transition-colors cursor-pointer flex items-center gap-1.5" title="Donar de baixa o eliminar">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <span id="desktop-batch-delete-label">Donar de baixa</span>
      </button>
    </div>
  </div>

  {# Barra Inferior Dinàmica PWA per a Mòbil (< md) #}
  <nav class="md:hidden sticky bottom-0 z-40 bg-white/95 backdrop-blur-md border-t border-steel/20 shadow-lg px-4 py-2">
    
    {# Mode Normal: Navegació #}
    <div id="pwa-bottom-nav" class="flex items-center justify-around">
      <a href="{{ path('app_dashboard') }}" class="flex flex-col items-center gap-0.5 text-[10px] font-bold text-ink">
        <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        <span>Patrimoni</span>
      </a>

      <a href="{{ path('app_certificates_index') }}" class="flex flex-col items-center gap-0.5 text-[10px] font-semibold text-ink/65 hover:text-ink">
        <svg class="w-5 h-5 text-steel" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Certificats</span>
      </a>

      {# Botó Central Destacat (+) #}
      <a href="{{ path('app_item_new') }}" class="w-11 h-11 -mt-4 rounded-full bg-ink text-gold border-2 border-gold flex items-center justify-center shadow-lg active:scale-95 transition-transform" aria-label="Registrar Nou Bé">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
      </a>

      <a href="{{ path('app_transfers_index') }}" class="flex flex-col items-center gap-0.5 text-[10px] font-semibold text-ink/65 hover:text-ink">
        <svg class="w-5 h-5 text-steel" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        <span>Traspassos</span>
      </a>

      <a href="{{ path('app_profile') }}" class="flex flex-col items-center gap-0.5 text-[10px] font-semibold text-ink/65 hover:text-ink">
        <svg class="w-5 h-5 text-steel" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        <span>Perfil</span>
      </a>
    </div>

    {# Mode Contextual: Accions per Lot (Quan hi ha selecció) — Només icones a mòbil #}
    <div id="pwa-batch-bar" class="hidden items-center justify-between gap-2 py-1">
      <div class="flex items-center gap-2">
        <button type="button" onclick="clearBatchSelection()" class="w-7 h-7 rounded-lg bg-cream text-ink text-xs font-bold flex items-center justify-center" aria-label="Desmarcar selecció">✕</button>
        <span class="text-xs font-bold text-ink font-mono"><span id="pwa-batch-count">0</span> sel.</span>
      </div>

      <div class="flex items-center gap-2">
        <button type="button" onclick="executeBatchAction('certificate')" class="p-2 rounded-lg bg-gold text-ink text-xs font-bold flex items-center justify-center shadow-xs" title="Emetre Certificat">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </button>
        <button type="button" onclick="executeBatchAction('transfer')" class="p-2 rounded-lg bg-ink text-cream text-xs font-semibold flex items-center justify-center border border-gold/30" title="Traspassar">
          <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        </button>
        <button type="button" onclick="executeBatchAction('delete')" class="p-2 rounded-lg border border-red-300 text-red-700 hover:bg-red-50 text-xs flex items-center justify-center" title="Donar de baixa o eliminar">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      </div>
    </div>

  </nav>

<script>
  function filterCategory(slug, evt) {
    const cards = document.querySelectorAll('.item-card');
    const buttons = document.querySelectorAll('.category-filter-btn');

    buttons.forEach(btn => {
      btn.classList.remove('bg-ink', 'text-cream', 'border-ink');
      btn.classList.add('bg-white', 'text-ink/80', 'border-steel/30');
    });

    const targetBtn = evt ? evt.currentTarget : (window.event ? window.event.currentTarget : null);
    if (targetBtn) {
      targetBtn.classList.remove('bg-white', 'text-ink/80', 'border-steel/30');
      targetBtn.classList.add('bg-ink', 'text-cream', 'border-ink');
    }

    cards.forEach(card => {
      card.style.display = (slug === 'all' || card.dataset.category === slug) ? 'flex' : 'none';
    });
  }

  // ==========================================
  // Gestió de Selecció Múltiple i Barres d'Acció
  // ==========================================
  function handleItemCheckboxChange() {
    const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
    const count = selectedCheckboxes.length;

    const desktopBar = document.getElementById('desktop-batch-bar');
    const pwaNav = document.getElementById('pwa-bottom-nav');
    const pwaBatchBar = document.getElementById('pwa-batch-bar');
    const desktopCount = document.getElementById('desktop-batch-count');
    const pwaCount = document.getElementById('pwa-batch-count');

    const countLabel = document.getElementById('desktop-batch-count-label');
    const certLabel = document.getElementById('desktop-batch-cert-label');
    const transferLabel = document.getElementById('desktop-batch-transfer-label');
    const deleteLabel = document.getElementById('desktop-batch-delete-label');

    if (desktopCount) desktopCount.innerText = count;
    if (pwaCount) pwaCount.innerText = count;

    if (count === 1) {
      if (countLabel) countLabel.innerText = 'bé seleccionat';
      if (certLabel) certLabel.innerText = 'Emetre Certificat';
      if (transferLabel) transferLabel.innerText = 'Traspassar';
      if (deleteLabel) deleteLabel.innerText = 'Donar de baixa';
    } else {
      if (countLabel) countLabel.innerText = 'béns seleccionats';
      if (certLabel) certLabel.innerText = 'Emetre Certificats de Lot';
      if (transferLabel) transferLabel.innerText = 'Traspàs de Lot';
      if (deleteLabel) deleteLabel.innerText = `Donar de baixa (${count})`;
    }

    if (count > 0) {
      if (desktopBar) { desktopBar.classList.remove('hidden'); desktopBar.classList.add('flex'); }
      if (pwaNav) pwaNav.classList.add('hidden');
      if (pwaBatchBar) { pwaBatchBar.classList.remove('hidden'); pwaBatchBar.classList.add('flex'); }
    } else {
      if (desktopBar) { desktopBar.classList.add('hidden'); desktopBar.classList.remove('flex'); }
      if (pwaNav) pwaNav.classList.remove('hidden');
      if (pwaBatchBar) { pwaBatchBar.classList.add('hidden'); pwaBatchBar.classList.remove('flex'); }
    }
  }

  function clearBatchSelection() {
    const checkboxes = document.querySelectorAll('.item-checkbox');
    checkboxes.forEach(cb => cb.checked = false);
    handleItemCheckboxChange();
  }

  function executeBatchAction(action) {
    const selectedCheckboxes = Array.from(document.querySelectorAll('.item-checkbox:checked'));
    if (selectedCheckboxes.length === 0) return;

    if (action === 'certificate') {
      if (selectedCheckboxes.length === 1) {
        window.location.href = selectedCheckboxes[0].dataset.showUrl;
      } else {
        if (window.RegistralsToast) {
          window.RegistralsToast.show('Emissió de Lot', `Preparant l'emissió del certificat oficial per a ${selectedCheckboxes.length} béns...`, 'info');
        }
      }
    } else if (action === 'transfer') {
      if (selectedCheckboxes.length === 1) {
        window.location.href = selectedCheckboxes[0].dataset.showUrl;
      } else {
        if (window.RegistralsToast) {
          window.RegistralsToast.show('Traspàs de Lot', `Iniciant canvi de titularitat per a ${selectedCheckboxes.length} béns...`, 'info');
        }
      }
    } else if (action === 'delete') {
      openDeactivateModal(selectedCheckboxes);
    }
  }

  function openDeactivateModal(selectedCheckboxes) {
    const modal = document.getElementById('modal-deactivate-item');
    if (!modal) return;

    const count = selectedCheckboxes.length;
    const form = document.getElementById('deactivate-item-form');
    const csrfInput = document.getElementById('deactivate-csrf-token');
    const batchInputsContainer = document.getElementById('deactivate-batch-inputs');
    const itemCard = document.getElementById('deactivate-item-card');
    const itemCui = document.getElementById('deactivate-item-cui');
    const itemName = document.getElementById('deactivate-item-name');
    const protectedNotice = document.getElementById('deactivate-protected-notice');
    const unprotectedOptions = document.getElementById('deactivate-unprotected-options');
    const batchNotice = document.getElementById('deactivate-batch-notice');
    const submitBtnLabel = document.getElementById('deactivate-submit-btn-label');
    const modalTitle = document.getElementById('deactivate-modal-title');

    batchInputsContainer.innerHTML = '';

    if (count === 1) {
      const cb = selectedCheckboxes[0];
      const cui = cb.dataset.cui;
      const name = cb.dataset.name;
      const csrf = cb.dataset.csrf;
      const isProtected = cb.dataset.hasOfficialCert === '1' || cb.dataset.hasTransfers === '1';

      form.action = `/app/items/${cui}/deactivate`;
      csrfInput.value = csrf;

      if (modalTitle) modalTitle.textContent = isProtected ? 'Donar de Baixa Bé' : 'Donar de Baixa o Eliminar Bé';
      if (itemCard) itemCard.classList.remove('hidden');
      if (itemCui) itemCui.textContent = cui;
      if (itemName) itemName.textContent = name;
      if (batchNotice) batchNotice.classList.add('hidden');

      if (isProtected) {
        if (protectedNotice) protectedNotice.classList.remove('hidden');
        if (unprotectedOptions) unprotectedOptions.classList.add('hidden');
        const pInput = document.getElementById('deactivate-action-type-protected');
        if (pInput) pInput.disabled = false;
        document.querySelectorAll('#deactivate-unprotected-options input').forEach(el => el.disabled = true);
        const bInput = document.getElementById('deactivate-action-type-batch');
        if (bInput) bInput.disabled = true;
        if (submitBtnLabel) submitBtnLabel.textContent = 'Donar de Baixa i Arxivar';
      } else {
        if (protectedNotice) protectedNotice.classList.add('hidden');
        if (unprotectedOptions) unprotectedOptions.classList.remove('hidden');
        const pInput = document.getElementById('deactivate-action-type-protected');
        if (pInput) pInput.disabled = true;
        document.querySelectorAll('#deactivate-unprotected-options input').forEach(el => el.disabled = false);
        const bInput = document.getElementById('deactivate-action-type-batch');
        if (bInput) bInput.disabled = true;
        if (submitBtnLabel) submitBtnLabel.textContent = 'Confirmar';
      }
    } else {
      form.action = '{{ path('app_item_batch_deactivate') }}';
      csrfInput.value = '{{ csrf_token('batch_deactivate_items') }}';

      const pInput = document.getElementById('deactivate-action-type-protected');
      if (pInput) pInput.disabled = true;
      document.querySelectorAll('#deactivate-unprotected-options input').forEach(el => el.disabled = true);
      const bInput = document.getElementById('deactivate-action-type-batch');
      if (bInput) bInput.disabled = false;

      if (modalTitle) modalTitle.textContent = `Donar de Baixa ${count} Béns`;
      if (itemCard) itemCard.classList.add('hidden');
      if (protectedNotice) protectedNotice.classList.add('hidden');
      if (unprotectedOptions) unprotectedOptions.classList.add('hidden');
      if (batchNotice) batchNotice.classList.remove('hidden');
      const batchCountNum = document.getElementById('deactivate-batch-count-num');
      if (batchCountNum) batchCountNum.textContent = count;
      if (submitBtnLabel) submitBtnLabel.textContent = `Donar de Baixa (${count})`;

      selectedCheckboxes.forEach(cb => {
        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'cuis[]';
        hidden.value = cb.dataset.cui;
        batchInputsContainer.appendChild(hidden);
      });
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
  }

  function closeDeactivateModal() {
    const modal = document.getElementById('modal-deactivate-item');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  }

  // ==========================================
  // Desplegable de Custòdia en Fred
  // ==========================================
  function toggleFrozenList() {
    const container = document.getElementById('frozen-items-container');
    const label = document.getElementById('toggle-frozen-label');
    const icon = document.getElementById('toggle-frozen-icon');
    if (!container) return;

    const isHidden = container.classList.contains('hidden');
    if (isHidden) {
      container.classList.remove('hidden');
      if (label) label.textContent = 'Plegar llista';
      if (icon) icon.classList.add('rotate-180');
    } else {
      container.classList.add('hidden');
      if (label) label.textContent = 'Desplegar llista ({{ frozenCount }})';
      if (icon) icon.classList.remove('rotate-180');
    }
  }

  // ==========================================
  // Modal de Reactivació de Béns en Custòdia en Fred (PWA Dual)
  // ==========================================
  function openReactivationModal(itemName, cui, csrf, canDirectlyReactivate) {
    const modal = document.getElementById('reactivation-modal');
    const itemNameEl = document.getElementById('modal-frozen-item-name');
    const cuiEl = document.getElementById('modal-frozen-item-cui');
    const form = document.getElementById('reactivate-item-form');
    const csrfInput = document.getElementById('reactivate-csrf-token');
    const availableBlock = document.getElementById('reactivate-available-block');
    const fullBlock = document.getElementById('reactivate-full-block');
    const directActionBtn = document.getElementById('reactivate-submit-btn');
    const upgradeActions = document.getElementById('reactivate-upgrade-actions');

    if (itemNameEl) itemNameEl.textContent = itemName || 'aquest bé moble';
    if (cuiEl) {
      if (cui) {
        cuiEl.textContent = cui;
        cuiEl.classList.remove('hidden');
      } else {
        cuiEl.classList.add('hidden');
      }
    }

    if (cui && form) {
      form.action = `/app/items/${cui}/reactivate`;
    }
    if (csrfInput) {
      csrfInput.value = csrf || '';
    }

    if (canDirectlyReactivate) {
      if (availableBlock) availableBlock.classList.remove('hidden');
      if (fullBlock) fullBlock.classList.add('hidden');
      if (form) form.classList.remove('hidden');
      if (upgradeActions) upgradeActions.classList.add('hidden');
      if (directActionBtn) {
        directActionBtn.disabled = false;
        directActionBtn.classList.remove('opacity-75');
      }
    } else {
      if (availableBlock) availableBlock.classList.add('hidden');
      if (fullBlock) fullBlock.classList.remove('hidden');
      if (form) form.classList.add('hidden');
      if (upgradeActions) upgradeActions.classList.remove('hidden');
    }

    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('overflow-hidden');
    }
  }

  function closeReactivationModal() {
    const modal = document.getElementById('reactivation-modal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
    }
  }

  document.addEventListener('keydown', function(evt) {
    if (evt.key === 'Escape') {
      closeReactivationModal();
      closeDeactivateModal();
    }
  });
</script>

{# Modal Canònic Dual PWA: Reactivació de Béns Congelats #}
<div id="reactivation-modal" class="hidden fixed inset-0 z-50 bg-ink/75 backdrop-blur-xs items-end sm:items-center justify-center p-0 sm:p-4 transition-all duration-200" onclick="if(event.target === this) closeReactivationModal();">
  <div class="bg-white rounded-t-3xl sm:rounded-2xl border-t sm:border border-gold/40 shadow-2xl max-w-md w-full max-h-[90vh] sm:max-h-[92vh] overflow-hidden flex flex-col animate-in fade-in zoom-in-95 duration-150">
    {# Nansa tàctil mòbil #}
    <div class="sm:hidden w-10 h-1 bg-steel/30 rounded-full mx-auto mt-2 -mb-1 shrink-0"></div>

    {# Capçalera Solemne #}
    <div class="p-4 sm:p-5 border-b border-steel/15 flex items-center justify-between bg-cream/30">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-ink text-gold flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <div>
          <h3 class="font-marcellus text-base sm:text-lg text-ink font-bold leading-tight">
            Reactivació de Custòdia
          </h3>
          <p class="text-[11px] font-mono text-steel">Retorn al Patrimoni Actiu</p>
        </div>
      </div>
      <button type="button" onclick="closeReactivationModal()" class="w-8 h-8 rounded-lg bg-white border border-steel/20 text-steel hover:text-ink flex items-center justify-center text-sm font-bold cursor-pointer" aria-label="Tancar">
        ✕
      </button>
    </div>

    {# Cos del Modal #}
    <div class="p-4 sm:p-5 overflow-y-auto space-y-3 font-raleway text-xs sm:text-sm text-ink/80 leading-relaxed">
      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
        <div class="flex items-center gap-2 flex-wrap">
          <span id="modal-frozen-item-cui" class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-ink text-gold border border-gold/30"></span>
          <strong id="modal-frozen-item-name" class="font-marcellus text-ink text-sm"></strong>
        </div>
        <p class="text-xs text-steel">Estat actual: <strong>Custòdia en fred (Només lectura)</strong></p>
      </div>

      {# Cas A: Capacitat disponible (Directe) #}
      <div id="reactivate-available-block" class="space-y-3">
        <div class="p-3.5 rounded-xl bg-emerald-500/10 border-l-[3.5px] border-emerald-600 text-ink text-xs font-raleway space-y-1">
          <strong class="text-emerald-900 block font-bold">Capacitat disponible al teu pla</strong>
          <p class="text-ink/80">
            Disposes de places lliures a la teva caixa forta (<strong>{{ itemsCount }} / {{ maxAllowed > 0 ? maxAllowed : '∞' }}</strong> actius). Pots retornar aquest bé al teu patrimoni actiu ara mateix.
          </p>
        </div>
        <p class="text-xs text-steel leading-relaxed">
          En reactivar-lo, el bé tornarà a la graella principal de patrimoni i recuperarà totes les funcionalitats operatives (emissió de certificats, edició i traspassos).
        </p>
      </div>

      {# Cas B: Quota exhaurida (Upsell / Downgrade Adequacy) #}
      <div id="reactivate-full-block" class="hidden space-y-3">
        <div class="p-3.5 rounded-xl bg-gold/10 border-l-[3.5px] border-gold text-ink text-xs font-raleway space-y-1">
          <strong>Límit de capacitat actiu assolit</strong>
          <p class="text-ink/80">
            La teva caixa forta està plena (<strong>{{ itemsCount }} / {{ maxAllowed }}</strong> béns actius). Per retornar aquest bé al patrimoni actiu, pots passar al Pla Plus o bé donar de baixa un altre bé.
          </p>
        </div>
        <p class="text-xs text-steel leading-relaxed">
          Pots reactivar el <strong>Pla Plus ({{ plusPlan ? (plusPlan.priceCents / 100)|number_format(0) : '22' }} €/any)</strong> amb capacitat per a {{ maxPlusItems }} béns per descongelar automàticament tot el patrimoni en fred.
        </p>
      </div>
    </div>

    {# Peu d'accions #}
    <div class="p-4 bg-cream-50/50 border-t border-steel/15 flex flex-col sm:flex-row items-center justify-end gap-2.5">
      <button type="button" onclick="closeReactivationModal()" class="w-full sm:w-auto px-4 py-2 rounded-xl border border-steel/30 text-ink/75 hover:text-ink hover:bg-white text-xs font-semibold text-center transition-all cursor-pointer">
        Cancel·lar
      </button>

      {# Formulari Directe per a usuaris amb capacitat disponible #}
      <form id="reactivate-item-form" method="POST" action="" onsubmit="const btn = document.getElementById('reactivate-submit-btn'); if(btn){ btn.disabled = true; btn.classList.add('opacity-75'); } const lbl = document.getElementById('reactivate-submit-btn-label'); if(lbl){ lbl.textContent = 'Reactivant...'; }" class="w-full sm:w-auto">
        <input type="hidden" name="_token" id="reactivate-csrf-token" value="">
        <button type="submit" id="reactivate-submit-btn" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          <span id="reactivate-submit-btn-label">Descongelar i Reactivar Bé</span>
        </button>
      </form>

      {# Botons d'ampliació per quan la capacitat està plena #}
      <div id="reactivate-upgrade-actions" class="hidden flex flex-col sm:flex-row items-center gap-2 w-full sm:w-auto">
        <a href="{{ path('app_plan') }}" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-bold text-xs uppercase tracking-wider text-center transition-all shadow-xs flex items-center justify-center gap-1.5">
          <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <span>Passar a Pla Plus</span>
        </a>
      </div>
    </div>
  </div>
</div>

{# Modal Canònic Dual PWA: Donar de Baixa o Eliminar Bé #}
<div id="modal-deactivate-item" class="hidden fixed inset-0 z-50 bg-ink/75 backdrop-blur-xs items-end sm:items-center justify-center p-0 sm:p-4 transition-all duration-200" onclick="if(event.target === this) closeDeactivateModal();">
  <div class="bg-white rounded-t-3xl sm:rounded-2xl border-t sm:border border-gold/40 shadow-2xl max-w-md w-full max-h-[90vh] sm:max-h-[92vh] overflow-hidden flex flex-col animate-in fade-in zoom-in-95 duration-150">
    {# Nansa tàctil mòbil #}
    <div class="sm:hidden w-10 h-1 bg-steel/30 rounded-full mx-auto mt-2 -mb-1 shrink-0"></div>

    {# Capçalera Solemne #}
    <div class="p-4 sm:p-5 border-b border-steel/15 flex items-center justify-between bg-cream/30">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-red-100 text-red-700 flex items-center justify-center shrink-0 border border-red-200">
          <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </div>
        <div>
          <h3 id="deactivate-modal-title" class="font-marcellus text-base sm:text-lg text-ink font-bold leading-tight">
            Donar de Baixa Bé
          </h3>
          <p class="text-[11px] font-mono text-steel">Gestió de Patrimoni & Arxiu</p>
        </div>
      </div>
      <button type="button" onclick="closeDeactivateModal()" class="w-8 h-8 rounded-lg bg-white border border-steel/20 text-steel hover:text-ink flex items-center justify-center text-sm font-bold cursor-pointer" aria-label="Tancar">
        ✕
      </button>
    </div>

    {# Formulari d'Acció #}
    <form id="deactivate-item-form" method="POST" action="" onsubmit="const btn = document.getElementById('deactivate-submit-btn'); if (btn) { btn.disabled = true; btn.classList.add('opacity-75'); } const lbl = document.getElementById('deactivate-submit-btn-label'); if (lbl) { lbl.textContent = 'Processant baixa...'; }" class="flex flex-col flex-1 overflow-hidden">
      <input type="hidden" name="_token" id="deactivate-csrf-token" value="">
      <div id="deactivate-batch-inputs"></div>

      {# Cos del Modal #}
      <div class="p-4 sm:p-5 overflow-y-auto space-y-3 font-raleway text-xs sm:text-sm text-ink/80 leading-relaxed flex-1">
        
        {# Fitxa d'identificació del bé o lot #}
        <div id="deactivate-item-card" class="p-3 rounded-xl bg-cream-50/70 border border-steel/20 space-y-1">
          <div class="flex items-center gap-2 flex-wrap">
            <span id="deactivate-item-cui" class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-ink text-gold border border-gold/30"></span>
            <strong id="deactivate-item-name" class="font-marcellus text-ink text-sm"></strong>
          </div>
        </div>

        {# Bloc Protegit per Integritat Jurídica #}
        <div id="deactivate-protected-notice" class="hidden space-y-2">
          <div class="p-3.5 rounded-xl bg-gold/10 border-l-[3.5px] border-gold text-ink text-xs font-raleway space-y-1">
            <strong>Integritat Jurídica de la Certificació</strong>
            <p class="text-ink/80">
              Aquest bé disposa de <strong>certificats oficials emesos</strong> o d'un <strong>històric de traspàs registrat</strong>. Per preservar la validesa probatòria davant tercers, asseguradores i tribunals (i el funcionament del codi QR de verificació), <strong>el registre no es pot purgar completament</strong>.
            </p>
          </div>
          <p class="text-xs text-steel leading-relaxed">
            En donar-lo de baixa, el bé <strong>s'arxiva a la custòdia en fred</strong>: allibera quota del vostre pla i surt del patrimoni actiu, protegint la traçabilitat històrica.
          </p>
          <input type="hidden" name="action_type" id="deactivate-action-type-protected" value="archive">
        </div>

        {# Bloc No Protegit (Permet triar entre Arxivar o Eliminar) #}
        <div id="deactivate-unprotected-options" class="hidden space-y-3">
          <p class="text-xs text-ink/80">
            Aquest bé no té certificats oficials ni traspassos associats. Trieu com voleu procedir:
          </p>
          <div class="space-y-2">
            <label class="flex items-start gap-2.5 p-3 rounded-xl border border-steel/30 bg-cream/20 hover:bg-cream/40 cursor-pointer transition-colors">
              <input type="radio" name="action_type" value="archive" checked class="mt-0.5 accent-ink cursor-pointer">
              <div class="text-xs">
                <strong class="text-ink block font-bold">Arxivar a la custòdia en fred (Recomanat)</strong>
                <span class="text-steel block text-[11px] mt-0.5">Allibera la quota de béns del pla i conserva les fotografies i dades per si voleu reactivar-lo més endavant.</span>
              </div>
            </label>
            <label class="flex items-start gap-2.5 p-3 rounded-xl border border-red-200 bg-red-50/40 hover:bg-red-50/70 cursor-pointer transition-colors">
              <input type="radio" name="action_type" value="delete" class="mt-0.5 accent-red-600 cursor-pointer">
              <div class="text-xs">
                <strong class="text-red-800 block font-bold">Eliminar permanentment (Purga)</strong>
                <span class="text-red-700/80 block text-[11px] mt-0.5">Esborra el bé i purga totes les fotografies i comprovants de forma definitiva i irreversible (Dret a l'oblit).</span>
              </div>
            </label>
          </div>
        </div>

        {# Bloc de Baixa en Lot #}
        <div id="deactivate-batch-notice" class="hidden space-y-2">
          <p class="text-xs text-ink/80">
            Esteu a punt de donar de baixa <strong id="deactivate-batch-count-num"></strong> béns del vostre patrimoni actiu.
          </p>
          <div class="p-3.5 rounded-xl bg-gold/10 border-l-[3.5px] border-gold text-ink text-xs font-raleway space-y-1">
            <strong>Custòdia en fred i alliberament de quota</strong>
            <p class="text-ink/80">
              Els béns s'arxivaran a la custòdia en fred, alliberant les places corresponents del vostre pla i preservant la integritat de les dades registrades.
            </p>
          </div>
          <input type="hidden" name="action_type" id="deactivate-action-type-batch" value="archive">
        </div>

      </div>

      {# Peu d'accions #}
      <div class="p-4 bg-cream-50/50 border-t border-steel/15 flex items-center justify-end gap-2.5 shrink-0">
        <button type="button" onclick="closeDeactivateModal()" class="px-4 py-2 rounded-xl border border-steel/30 text-ink/75 hover:text-ink hover:bg-white text-xs font-semibold transition-all cursor-pointer">
          Cancel·lar
        </button>
        <button type="submit" id="deactivate-submit-btn" class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-xs flex items-center gap-1.5 cursor-pointer">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          <span id="deactivate-submit-btn-label">Confirmar Baixa</span>
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
