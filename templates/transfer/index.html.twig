{% extends 'base.html.twig' %}

{% block title %}Safata de Traspassos — Registrals{% endblock %}
{% block meta_description %}Gestió de traspassos de titularitat de béns mobles rebuts i enviats a Registrals.{% endblock %}

{% block body_class %}bg-cream-50 text-ink min-h-screen flex flex-col font-raleway antialiased selection:bg-gold selection:text-ink{% endblock %}

{% block body %}
  {# Barra Superior Privada Unificada #}
  {% include 'partials/_private_header.html.twig' %}

  {# Contingut Principal #}
  <main class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3.5 w-full flex-1 pb-20 md:pb-5">

    {# 1. Línia de Ruta Mínima #}
    <nav class="flex items-center gap-1.5 text-[11px] font-mono text-steel uppercase tracking-wider mb-2" aria-label="Ruta de navegació">
      <a href="{{ path('app_dashboard') }}" class="hover:text-gold transition-colors">Inici</a>
      <span class="text-steel/40">/</span>
      <span class="text-ink font-bold">Traspassos</span>
    </nav>

    {# 2. Capçalera de Pàgina #}
    <div class="mb-3.5 sm:mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-2.5 sm:pb-3.5 border-b border-gold/15">
      <div>
        <h1 class="text-xl sm:text-3xl font-marcellus text-ink tracking-wide">Safata de Traspassos de Titularitat</h1>
        <p class="text-xs sm:text-sm text-ink/75 mt-0.5 font-raleway">
          Supervisió de traspassos certificats C2C, custòdia de proves i segellat a Polygon Blockchain.
        </p>
      </div>
    </div>

    {# Missatges Flash via Toast Oficial #}
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            if (window.RegistralsToast) {
              window.RegistralsToast.show(
                '{{ label == 'error' ? 'Avís de Seguretat' : (label == 'warning' ? 'Atenció' : 'Notificació del Traspàs') }}',
                '{{ message|e('js') }}',
                '{{ label == 'error' ? 'error' : (label == 'warning' ? 'info' : 'info') }}',
                5000
              );
            }
          });
        </script>
      {% endfor %}
    {% endfor %}

    {# Selector de Safata per a Mòbil (< lg): Condensa l'alçada en dues pestanyes #}
    {% set totalPending = pendingReceived|length + pendingSent|length %}
    {% set totalHistory = historyReceived|length + historySent|length %}
    <div class="lg:hidden flex items-center p-1 bg-cream/50 border border-steel/20 rounded-xl mb-3.5 text-xs font-semibold">
      <button type="button" id="tab-btn-pending" onclick="switchTransferTab('pending')" class="flex-1 py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 transition-all bg-ink text-gold border border-gold/40 shadow-2xs font-bold min-h-[40px]">
        <span>Pendents en Curs</span>
        <span class="px-1.5 py-0.2 rounded-full font-mono text-[10px] {{ totalPending > 0 ? 'bg-amber-500 text-ink font-bold' : 'bg-cream text-steel border border-steel/20' }}">
          {{ totalPending }}
        </span>
      </button>
      <button type="button" id="tab-btn-history" onclick="switchTransferTab('history')" class="flex-1 py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 transition-all text-ink/70 hover:text-ink min-h-[40px]">
        <span>Històric de Traspassos</span>
        <span class="px-1.5 py-0.2 rounded-full font-mono text-[10px] bg-steel/15 text-steel">
          {{ totalHistory }}
        </span>
      </button>
    </div>

    {# Graella 2x2 a PC / Pestanyes Condensades a Mòbil #}
    <div class="space-y-4 lg:space-y-0 lg:grid lg:grid-cols-2 lg:gap-4 items-start">

      {# Bloc Grup Pendents (Bloc 1 + Bloc 2) #}
      <div id="transfer-group-pending" class="space-y-4 lg:space-y-0 lg:contents">

      {# ==================================================================== #}
      {# FILA 1, COL 1: BLOC 1 - REBUTS PENDENTS D'ACCEPTAR                  #}
      {# ==================================================================== #}
      <div class="bg-whitef border border-gold/30 rounded-2xl p-4 sm:p-5 shadow-2xs flex flex-col justify-between space-y-3">
        <div>
          {# Capçalera de Caixa #}
          <div class="flex items-center justify-between pb-2 border-b border-cream gap-2">
            <h2 class="font-marcellus text-base text-ink flex items-center gap-2 whitespace-nowrap">
              <svg class="w-4 h-4 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
              <span>Rebuts Pendents d'Acceptar</span>
            </h2>
            <span class="text-[10px] uppercase font-mono font-bold text-steel bg-cream/50 px-2.5 py-0.5 rounded-md border border-steel/20 whitespace-nowrap">
              {{ pendingReceived|length }} pendent(s)
            </span>
          </div>

          {# Cos de la Caixa amb Scroll Delimitat #}
          <div class="pt-2">
            {% if pendingReceived|length > 0 %}
              <div class="max-h-[300px] overflow-y-auto space-y-2 pr-1">
                {% for transfer in pendingReceived %}
                  <div class="bg-white rounded-xl border border-gold/40 border-l-4 border-l-emerald-500 p-2.5 sm:p-3 shadow-2xs hover:border-gold transition-all flex items-center justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5 mb-0.5">
                        <h4 class="font-marcellus text-sm font-bold text-ink truncate">{{ transfer.item.name }}</h4>
                        <span class="bg-cream/80 text-ink/75 font-mono text-[10px] px-1.5 py-0.5 rounded border border-steel/20 shrink-0">{{ transfer.item.cui }}</span>
                      </div>
                      <div class="text-[11px] text-steel flex items-center gap-2 truncate">
                        <span>De: <strong class="text-ink">{{ transfer.sender.fullName }}</strong></span>
                        <span>&middot;</span>
                        <span class="text-amber-800 font-medium">Caduca {{ transfer.expiresAt|date('d/m H:i') }}</span>
                      </div>
                    </div>
                    <div class="shrink-0 flex items-center gap-1.5">
                      <a href="{{ path('app_transfer_claim', {'token': transfer.token}) }}" class="h-7 px-2.5 rounded-lg bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-bold text-[11px] uppercase tracking-wider shadow-2xs transition-all flex items-center gap-1.5 cursor-pointer" title="Revisar i acceptar traspàs">
                        <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        <span>Acceptar</span>
                      </a>
                      <button type="button" onclick="openRejectTransferModal('{{ transfer.token }}', '{{ csrf_token('reject_transfer_' ~ transfer.id) }}', '{{ transfer.item.name|e('js') }}', '{{ transfer.item.cui|e('js') }}', '{{ transfer.sender.fullName|e('js') }}')" class="h-7 px-2 sm:px-2.5 rounded-lg bg-white hover:bg-red-50 border border-red-200/80 hover:border-red-300 text-red-700 hover:text-red-800 text-[11px] font-semibold transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs" title="Rebutjar sol·licitud de traspàs">
                        <svg class="w-3.5 h-3.5 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        <span class="hidden sm:inline">Rebutjar</span>
                      </button>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <div class="py-4 px-3 rounded-xl bg-cream-50/50 border border-steel/15 text-center text-xs text-steel flex items-center justify-center gap-2">
                <svg class="w-4 h-4 text-steel/60 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                <span>No teniu cap traspàs pendent d'acceptar</span>
              </div>
            {% endif %}
          </div>
        </div>

        {# Peu de Caixa #}
        <div class="pt-2 border-t border-cream/80 text-[11px] text-ink/50 flex items-center justify-between">
          <span>Entrada de patrimoni</span>
          <span class="font-mono text-steel">72 h de validesa</span>
        </div>
      </div>

      {# ==================================================================== #}
      {# FILA 1, COL 2: BLOC 2 - ENVIATS EN CURS (PENDENT RECEPTOR)          #}
      {# ==================================================================== #}
      <div class="bg-whitef border border-gold/30 rounded-2xl p-4 sm:p-5 shadow-2xs flex flex-col justify-between space-y-3">
        <div>
          {# Capçalera de Caixa #}
          <div class="flex items-center justify-between pb-2 border-b border-cream gap-2">
            <h2 class="font-marcellus text-base text-ink flex items-center gap-2 whitespace-nowrap">
              <svg class="w-4 h-4 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              <span>Enviats en Curs (Pendent Receptor)</span>
            </h2>
            <span class="text-[10px] uppercase font-mono font-bold text-steel bg-cream/50 px-2.5 py-0.5 rounded-md border border-steel/20 whitespace-nowrap">
              {{ pendingSent|length }} en curs
            </span>
          </div>

          {# Cos de la Caixa amb Scroll Delimitat #}
          <div class="pt-2">
            {% if pendingSent|length > 0 %}
              <div class="max-h-[300px] overflow-y-auto space-y-2 pr-1">
                {% for transfer in pendingSent %}
                  <div class="bg-white rounded-xl border border-gold/40 border-l-4 border-l-amber-500 p-2.5 sm:p-3 shadow-2xs hover:border-gold transition-all flex items-center justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5 mb-0.5">
                        <h4 class="font-marcellus text-sm font-bold text-ink truncate">{{ transfer.item.name }}</h4>
                        <span class="bg-cream/80 text-ink/75 font-mono text-[10px] px-1.5 py-0.5 rounded border border-steel/20 shrink-0">{{ transfer.item.cui }}</span>
                      </div>
                      <div class="text-[11px] text-steel flex items-center gap-2 truncate">
                        <span>A: <strong class="text-ink font-mono">{{ transfer.recipientEmail }}</strong></span>
                        <span>&middot;</span>
                        <span class="text-amber-800 font-medium">Caduca {{ transfer.expiresAt|date('d/m H:i') }}</span>
                      </div>
                    </div>
                    <div class="shrink-0 flex items-center gap-2">
                      <button type="button" onclick="openTransferDetailModal('{{ transfer.id }}')" class="px-3 py-1.5 rounded-lg bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-bold text-xs uppercase tracking-wider shadow-2xs transition-all flex items-center gap-1.5 cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        <span>Detalls</span>
                      </button>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <div class="py-4 px-3 rounded-xl bg-cream-50/50 border border-steel/15 text-center text-xs text-steel flex items-center justify-center gap-2">
                <svg class="w-4 h-4 text-steel/60 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                <span>No teniu cap traspàs iniciat en curs</span>
              </div>
            {% endif %}
          </div>
        </div>

        {# Peu de Caixa #}
        <div class="pt-2 border-t border-cream/80 text-[11px] text-ink/50 flex items-center justify-between">
          <span>Sortida de patrimoni</span>
          <span class="font-mono text-steel">Codi PIN opcional</span>
        </div>
      </div>

      </div>

      {# Bloc Grup Històric (Bloc 3 + Bloc 4) #}
      <div id="transfer-group-history" class="hidden lg:contents space-y-4 lg:space-y-0">

      {# ==================================================================== #}
      {# FILA 2, COL 1: BLOC 3 - HISTÒRIC DE REBUTS                           #}
      {# ==================================================================== #}
      {% set receivedCompleted = historyReceived|filter(t => t.status.value == 'accepted') %}
      {% set receivedUncompleted = historyReceived|filter(t => t.status.value != 'accepted') %}

      <div class="bg-whitef border border-gold/30 rounded-2xl p-4 sm:p-5 shadow-2xs flex flex-col justify-between space-y-3">
        <div>
          {# Capçalera de Caixa #}
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-2 border-b border-cream gap-2">
            <h2 class="font-marcellus text-base text-ink flex items-center gap-2 whitespace-nowrap">
              <svg class="w-4 h-4 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Històric de Rebuts</span>
            </h2>

            {% if historyReceived|length > 0 %}
              <div class="flex items-center gap-1 p-0.5 bg-cream/50 border border-steel/20 rounded-lg text-[10px] font-semibold self-start sm:self-auto">
                <button type="button" onclick="filterReceivedHistory('all')" id="btn-filter-received-all" class="px-2 py-0.5 rounded-md transition-all font-bold bg-ink text-gold shadow-2xs cursor-pointer">
                  Tots ({{ historyReceived|length }})
                </button>
                <button type="button" onclick="filterReceivedHistory('completed')" id="btn-filter-received-completed" class="px-2 py-0.5 rounded-md transition-all text-ink/70 hover:text-ink cursor-pointer">
                  Completats ({{ receivedCompleted|length }})
                </button>
                <button type="button" onclick="filterReceivedHistory('uncompleted')" id="btn-filter-received-uncompleted" class="px-2 py-0.5 rounded-md transition-all text-ink/70 hover:text-ink cursor-pointer">
                  No completats ({{ receivedUncompleted|length }})
                </button>
              </div>
            {% else %}
              <span class="text-[10px] uppercase font-mono font-bold text-steel bg-cream/50 px-2.5 py-0.5 rounded-md border border-steel/20 whitespace-nowrap">
                0 rebut(s)
              </span>
            {% endif %}
          </div>

          {# Cos de la Caixa amb Scroll Delimitat #}
          <div class="pt-2">
            {% if historyReceived|length > 0 %}
              <div class="max-h-[300px] overflow-y-auto space-y-2 pr-1" id="history-received-list">
                {% for transfer in historyReceived %}
                  {% set isComp = transfer.status.value == 'accepted' %}
                  <div class="history-received-item bg-cream-50/70 rounded-xl border border-steel/20 border-l-4 {{ isComp ? 'border-l-emerald-600' : 'border-l-stone-400' }} p-2.5 sm:p-3 hover:border-gold/40 transition-all flex items-center justify-between gap-3" data-category="{{ isComp ? 'completed' : 'uncompleted' }}">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5 mb-0.5">
                        <h4 class="font-marcellus text-sm font-bold text-ink truncate">{{ transfer.item.name }}</h4>
                        <span class="text-[10px] font-mono text-steel bg-white px-1.5 py-0.5 rounded border border-steel/20 shrink-0">{{ transfer.item.cui }}</span>
                      </div>
                      <div class="text-[11px] text-steel flex items-center gap-2 truncate">
                        <span>De: <strong class="text-ink">{{ transfer.sender.fullName }}</strong></span>
                        <span>&middot;</span>
                        <span class="font-mono text-ink/75">{{ (transfer.completedAt ?: transfer.cancelledAt ?: transfer.requestedAt)|date('d/m/Y') }}</span>
                      </div>
                    </div>
                    <div class="shrink-0 flex items-center gap-2">
                      {% if isComp %}
                        <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-100 text-emerald-900 border border-emerald-300 uppercase tracking-wider">
                          Rebut
                        </span>
                        {% if transfer.item.owner.id == app.user.id %}
                          <a href="{{ path('app_item_show', {'cui': transfer.item.cui}) }}" class="px-2.5 py-1 rounded-lg bg-white hover:bg-cream text-ink text-xs font-semibold border border-steel/25 transition-all">
                            Veure Bé
                          </a>
                        {% else %}
                          <span class="px-2 py-0.5 rounded-full text-[9px] font-semibold bg-gray-100 text-gray-500 border border-gray-200" title="Aquest bé ha estat transmès posteriorment a un altre titular">
                            Transmès
                          </span>
                        {% endif %}
                      {% else %}
                        <span class="font-bold text-[9px] px-2 py-0.5 rounded-full uppercase tracking-wider border {{ transfer.status.badgeClasses }}">
                          {{ transfer.status.label }}
                        </span>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}

                <div id="history-received-filter-empty" class="hidden py-4 px-3 rounded-xl bg-cream-50/50 border border-steel/15 text-center text-xs text-steel">
                  No hi ha traspassos rebuts en aquesta categoria.
                </div>
              </div>
            {% else %}
              <div class="py-4 px-3 rounded-xl bg-cream-50/50 border border-steel/15 text-center text-xs text-steel flex items-center justify-center gap-2">
                <svg class="w-4 h-4 text-steel/60 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>Cap traspàs rebut a l'històric</span>
              </div>
            {% endif %}
          </div>
        </div>

        {# Peu de Caixa #}
        <div class="pt-2 border-t border-cream/80 text-[11px] text-ink/50 flex items-center justify-between">
          <span>Patrimoni adquirit</span>
          <span class="font-mono text-steel">Immutabilitat</span>
        </div>
      </div>

      {# ==================================================================== #}
      {# FILA 2, COL 2: BLOC 4 - HISTÒRIC D'ENVIATS                           #}
      {# ==================================================================== #}
      {% set sentCompleted = historySent|filter(t => t.status.value == 'accepted') %}
      {% set sentUncompleted = historySent|filter(t => t.status.value != 'accepted') %}

      <div class="bg-whitef border border-gold/30 rounded-2xl p-4 sm:p-5 shadow-2xs flex flex-col justify-between space-y-3">
        <div>
          {# Capçalera de Caixa #}
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-2 border-b border-cream gap-2">
            <h2 class="font-marcellus text-base text-ink flex items-center gap-2 whitespace-nowrap">
              <svg class="w-4 h-4 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Històric d'Enviats</span>
            </h2>

            {% if historySent|length > 0 %}
              <div class="flex items-center gap-1 p-0.5 bg-cream/50 border border-steel/20 rounded-lg text-[10px] font-semibold self-start sm:self-auto">
                <button type="button" onclick="filterSentHistory('all')" id="btn-filter-sent-all" class="px-2 py-0.5 rounded-md transition-all font-bold bg-ink text-gold shadow-2xs cursor-pointer">
                  Tots ({{ historySent|length }})
                </button>
                <button type="button" onclick="filterSentHistory('completed')" id="btn-filter-sent-completed" class="px-2 py-0.5 rounded-md transition-all text-ink/70 hover:text-ink cursor-pointer">
                  Completats ({{ sentCompleted|length }})
                </button>
                <button type="button" onclick="filterSentHistory('uncompleted')" id="btn-filter-sent-uncompleted" class="px-2 py-0.5 rounded-md transition-all text-ink/70 hover:text-ink cursor-pointer">
                  No completats ({{ sentUncompleted|length }})
                </button>
              </div>
            {% else %}
              <span class="text-[10px] uppercase font-mono font-bold text-steel bg-cream/50 px-2.5 py-0.5 rounded-md border border-steel/20 whitespace-nowrap">
                0 enviat(s)
              </span>
            {% endif %}
          </div>

          {# Cos de la Caixa amb Scroll Delimitat #}
          <div class="pt-2">
            {% if historySent|length > 0 %}
              <div class="max-h-[300px] overflow-y-auto space-y-2 pr-1" id="history-sent-list">
                {% for transfer in historySent %}
                  {% set isComp = transfer.status.value == 'accepted' %}
                  <div class="history-sent-item bg-cream-50/70 rounded-xl border border-steel/20 border-l-4 {{ isComp ? 'border-l-emerald-600' : 'border-l-stone-400' }} p-2.5 sm:p-3 hover:border-gold/40 transition-all flex items-center justify-between gap-3" data-category="{{ isComp ? 'completed' : 'uncompleted' }}">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5 mb-0.5">
                        <h4 class="font-marcellus text-sm font-bold text-ink truncate">{{ transfer.item.name }}</h4>
                        <span class="text-[10px] font-mono text-steel bg-white px-1.5 py-0.5 rounded border border-steel/20 shrink-0">{{ transfer.item.cui }}</span>
                      </div>
                      <div class="text-[11px] text-steel flex items-center gap-2 truncate">
                        <span>A: <strong class="text-ink font-mono">{{ transfer.recipientEmail }}</strong></span>
                        <span>&middot;</span>
                        <span class="font-mono text-ink/75">{{ (transfer.completedAt ?: transfer.cancelledAt ?: transfer.requestedAt)|date('d/m/Y') }}</span>
                      </div>
                    </div>
                    <div class="shrink-0 flex items-center gap-2">
                      <span class="font-bold text-[9px] px-2 py-0.5 rounded-full uppercase tracking-wider border {{ transfer.status.badgeClasses }}">
                        {{ transfer.status.label }}
                      </span>
                      {% if transfer.item.owner.id == app.user.id %}
                        <a href="{{ path('app_item_show', {'cui': transfer.item.cui}) }}" class="px-2.5 py-1 rounded-lg bg-white hover:bg-cream text-ink text-xs font-semibold border border-steel/25 transition-all">
                          Veure Bé
                        </a>
                      {% else %}
                        <span class="px-2 py-0.5 rounded-full text-[9px] font-semibold bg-gray-100 text-gray-500 border border-gray-200" title="Titularitat transmesa a un tercer">
                          Cedit
                        </span>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}

                <div id="history-sent-filter-empty" class="hidden py-4 px-3 rounded-xl bg-cream-50/50 border border-steel/15 text-center text-xs text-steel">
                  No hi ha traspassos enviats en aquesta categoria.
                </div>
              </div>
            {% else %}
              <div class="py-4 px-3 rounded-xl bg-cream-50/50 border border-steel/15 text-center text-xs text-steel flex items-center justify-center gap-2">
                <svg class="w-4 h-4 text-steel/60 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>Cap traspàs enviat a l'històric</span>
              </div>
            {% endif %}
          </div>
        </div>

        {# Peu de Caixa #}
        <div class="pt-2 border-t border-cream/80 text-[11px] text-ink/50 flex items-center justify-between">
          <span>Transmissions certificades</span>
          <span class="font-mono text-steel">Traçabilitat forense</span>
        </div>
      </div>

    </div>

    {# ==================================================================== #}
    {# MODALS DE DETALL DE TRASPÀS EN CURS                                  #}
    {# ==================================================================== #}
    {% for transfer in pendingSent %}
      <div id="modal-transfer-{{ transfer.id }}" class="fixed inset-0 z-50 bg-ink/65 backdrop-blur-xs hidden items-end sm:items-center justify-center p-0 sm:p-4 transition-opacity">
        <div class="bg-white rounded-t-3xl sm:rounded-3xl border-t sm:border border-gold/50 shadow-2xl flex flex-col overflow-hidden w-full max-w-lg max-h-[90vh] sm:max-h-[92vh] animate-in slide-in-from-bottom sm:zoom-in-95 duration-200">
          <div class="sm:hidden w-10 h-1 bg-cream/30 rounded-full mx-auto mt-2 -mb-1 shrink-0"></div>
          
          {# Capçalera del Modal #}
          <div class="px-5 py-3.5 sm:px-6 sm:py-4 bg-ink text-cream border-b border-gold/30 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-cream/15 text-gold flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
              </div>
              <div>
                <h3 class="font-marcellus text-lg text-cream">Gestió del Traspàs</h3>
                <span class="text-[10px] font-mono text-gold uppercase tracking-wider font-bold">{{ transfer.item.name }} &middot; {{ transfer.item.cui }}</span>
              </div>
            </div>
            <button type="button" onclick="closeTransferDetailModal('{{ transfer.id }}')" class="w-8 h-8 rounded-full bg-cream/10 hover:bg-cream/20 text-cream flex items-center justify-center text-sm transition-colors cursor-pointer" aria-label="Tancar">&times;</button>
          </div>

          {# Cos del Modal #}
          <div class="p-5 sm:p-6 overflow-y-auto space-y-4 text-xs font-raleway">
            
            {# Caixa d'estat #}
            <div class="p-4 rounded-2xl bg-amber-50/80 border border-amber-300 text-amber-900 space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-xs uppercase tracking-wider flex items-center gap-1.5 text-amber-900">
                  <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                  <span>Traspàs Pendent d'Acceptació</span>
                </span>
                <span class="text-[10px] font-mono bg-white px-2 py-0.5 rounded-md border border-amber-300 font-bold">72 h</span>
              </div>
              <p class="text-xs text-amber-800">
                S'ha enviat una invitació de transmissió de titularitat a <strong class="text-ink">{{ transfer.recipientEmail }}</strong>.
              </p>
              <div class="text-[11px] text-amber-700/90 pt-1 border-t border-amber-200">
                Caduca el: <strong>{{ transfer.expiresAt|date('d/m/Y H:i') }} UTC</strong>
              </div>
            </div>

            {# PIN de Seguretat si n'hi ha #}
            {% if transfer.securityCode %}
              <div class="p-3 bg-cream-50 rounded-xl border border-steel/20 flex items-center justify-between">
                <span class="text-steel text-[11px] uppercase tracking-wider font-bold">Codi PIN de Seguretat Requerit:</span>
                <span class="font-mono font-bold text-ink text-sm bg-white px-2.5 py-0.5 rounded-lg border border-gold/40 shadow-2xs">{{ transfer.securityCode }}</span>
              </div>
            {% endif %}

            {# Enllaç Directe per al Receptor #}
            <div class="space-y-1.5">
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider">Enllaç directe per al receptor</label>
              <div class="flex items-center gap-2">
                <input type="text" readonly value="{{ url('app_transfer_claim', {'token': transfer.token}) }}" class="flex-1 px-3 py-2 rounded-xl border border-steel/25 bg-cream-50 text-xs font-mono text-ink/80 select-all" id="modal-input-transfer-{{ transfer.id }}">
                <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('modal-input-transfer-{{ transfer.id }}').value); if(window.RegistralsToast) RegistralsToast.show('Enllaç Copiat', 'S\'ha copiat l\'enllaç al porta-retalls.', 'success');" class="px-3.5 py-2 rounded-xl bg-ink text-gold text-xs font-bold hover:bg-ink/90 cursor-pointer shadow-2xs shrink-0">
                  Copiar
                </button>
              </div>
            </div>

            {# Accions #}
            <div class="pt-3 border-t border-steel/15 flex flex-col sm:flex-row items-center justify-between gap-3">
              <a href="{{ path('app_item_show', {'cui': transfer.item.cui}) }}" class="text-ink hover:text-gold font-bold underline transition-colors text-xs flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <span>Veure Fitxa del Bé</span>
              </a>
              <form action="{{ path('app_item_transfer_cancel', {'cui': transfer.item.cui}) }}" method="POST" onsubmit="return confirm('Esteu segur que voleu cancel·lar aquest traspàs? El bé continuarà al vostre patrimoni.');">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel_transfer_' ~ transfer.item.id) }}">
                <button type="submit" class="px-3.5 py-2 rounded-xl bg-red-700 hover:bg-red-800 text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer shadow-2xs">
                  Cancel·lar Traspàs
                </button>
              </form>
            </div>

          </div>

          {# Peu del Modal #}
          <div class="px-6 py-3 bg-cream-50/70 border-t border-steel/15 flex items-center justify-end">
            <button type="button" onclick="closeTransferDetailModal('{{ transfer.id }}')" class="px-4 py-2 rounded-xl bg-cream hover:bg-cream/80 text-ink font-semibold text-xs transition-colors cursor-pointer">
              Tancar
            </button>
          </div>

        </div>
      </div>
    {% endfor %}

    {# Modal de Confirmació de Rebuig de Traspàs (PWA Dual Modal) #}
    <div id="modal-reject-transfer" class="fixed inset-0 z-50 bg-ink/75 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 hidden transition-all duration-200" onclick="if(event.target === this) closeRejectTransferModal();">
      <div class="bg-white rounded-t-3xl sm:rounded-2xl border-t sm:border border-gold/40 shadow-2xl max-w-md w-full max-h-[92vh] overflow-hidden flex flex-col font-raleway animate-in slide-in-from-bottom sm:zoom-in-95 duration-200">
        <div class="sm:hidden w-10 h-1 bg-steel/30 rounded-full mx-auto mt-2 -mb-1 shrink-0"></div>

        <div class="p-4 sm:p-5 bg-ink text-cream border-b border-gold/30 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-red-500/20 border border-red-400/40 text-red-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </div>
            <div>
              <h3 class="font-marcellus text-base sm:text-lg text-whitef">Rebutjar Traspàs de Titularitat</h3>
              <p id="reject-modal-item-subtitle" class="text-[11px] font-mono text-steel truncate max-w-[240px] sm:max-w-xs"></p>
            </div>
          </div>
          <button type="button" onclick="closeRejectTransferModal()" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 text-cream flex items-center justify-center text-sm font-bold cursor-pointer" aria-label="Tancar">
            ✕
          </button>
        </div>

        <form id="form-reject-transfer" method="POST" action="" class="p-4 sm:p-5 overflow-y-auto space-y-4 text-xs sm:text-sm text-ink/80 leading-relaxed">
          <input type="hidden" id="reject-modal-csrf" name="_token" value="">
          <input type="hidden" name="redirect_to" value="tray">

          <div class="guide-note text-xs space-y-1">
            <strong>Efecte Jurídic del Rebuig:</strong>
            <p class="text-ink/80">
              El bé no s'incorporarà al vostre patrimoni i romandrà sota la titularitat de <strong id="reject-modal-sender-name" class="text-ink">l'emissor</strong>. La sol·licitud quedarà invalidada de forma irreversible.
            </p>
          </div>

          <div class="space-y-1.5">
            <label for="select-reject-reason" class="block text-xs font-bold uppercase tracking-wider text-ink/70">
              Motiu del Rebuig (Opcional)
            </label>
            <select id="select-reject-reason" name="reason_type" class="w-full px-3 py-2 rounded-xl bg-white border border-steel/30 text-ink text-xs font-semibold focus:outline-none focus:border-gold">
              <option value="No reconec aquest bé o procedència">No reconec aquest bé o la seva procedència</option>
              <option value="Dades o condicions del traspàs errònies">Dades o condicions del traspàs errònies</option>
              <option value="Operació cancel·lada de comú acord">Operació cancel·lada de comú acord</option>
              <option value="Altres motius">Altres motius</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="input-reject-details" class="block text-xs font-bold uppercase tracking-wider text-ink/70">
              Comentari Addicional (Opcional)
            </label>
            <textarea id="input-reject-details" name="reason" rows="2" placeholder="Observacions addicionals per al remitent..." class="w-full px-3 py-2 rounded-xl bg-white border border-steel/30 text-ink text-xs focus:outline-none focus:border-gold resize-none"></textarea>
          </div>

          <div class="pt-2 flex items-center justify-end gap-2.5 border-t border-steel/15">
            <button type="button" onclick="closeRejectTransferModal()" class="px-4 py-2 rounded-xl border border-steel/30 text-ink/75 hover:text-ink hover:bg-white text-xs font-semibold transition-all cursor-pointer">
              Cancel·lar
            </button>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-xs flex items-center gap-1.5 cursor-pointer">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <span>Rebutjar Definitivament</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    {# Scripts dels Modals de Detall #}
    <script>
      function openRejectTransferModal(token, csrfToken, itemName, itemCui, senderName) {
        const form = document.getElementById('form-reject-transfer');
        if (form) {
          form.action = '{{ path('app_transfer_reject_alt', {'token': 'TOKEN_PLACEHOLDER'}) }}'.replace('TOKEN_PLACEHOLDER', token);
        }
        const csrfInput = document.getElementById('reject-modal-csrf');
        if (csrfInput) csrfInput.value = csrfToken;

        const subtitle = document.getElementById('reject-modal-item-subtitle');
        if (subtitle) subtitle.textContent = `${itemName} · ${itemCui}`;

        const senderEl = document.getElementById('reject-modal-sender-name');
        if (senderEl) senderEl.textContent = senderName;

        const modal = document.getElementById('modal-reject-transfer');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.classList.add('overflow-hidden');
        }
      }

      function closeRejectTransferModal() {
        const modal = document.getElementById('modal-reject-transfer');
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          document.body.classList.remove('overflow-hidden');
        }
      }

      function openTransferDetailModal(id) {
        const el = document.getElementById('modal-transfer-' + id);
        if (el) {
          el.classList.remove('hidden');
          el.classList.add('flex');
          document.body.classList.add('overflow-hidden');
        }
      }

      function closeTransferDetailModal(id) {
        const el = document.getElementById('modal-transfer-' + id);
        if (el) {
          el.classList.add('hidden');
          el.classList.remove('flex');
          document.body.classList.remove('overflow-hidden');
        }
      }

      function filterSentHistory(category) {
        const allBtn = document.getElementById('btn-filter-sent-all');
        const compBtn = document.getElementById('btn-filter-sent-completed');
        const uncompBtn = document.getElementById('btn-filter-sent-uncompleted');
        
        [allBtn, compBtn, uncompBtn].forEach(btn => {
          if (btn) {
            btn.classList.remove('bg-ink', 'text-gold', 'shadow-2xs', 'font-bold');
            btn.classList.add('text-ink/70');
          }
        });

        const activeBtn = category === 'completed' ? compBtn : (category === 'uncompleted' ? uncompBtn : allBtn);
        if (activeBtn) {
          activeBtn.classList.remove('text-ink/70');
          activeBtn.classList.add('bg-ink', 'text-gold', 'shadow-2xs', 'font-bold');
        }

        const items = document.querySelectorAll('.history-sent-item');
        let visibleCount = 0;
        items.forEach(item => {
          const itemCat = item.dataset.category;
          if (category === 'all' || itemCat === category) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        const emptyEl = document.getElementById('history-sent-filter-empty');
        if (emptyEl) {
          if (visibleCount === 0 && items.length > 0) {
            emptyEl.classList.remove('hidden');
          } else {
            emptyEl.classList.add('hidden');
          }
        }
      }

      function filterReceivedHistory(category) {
        const allBtn = document.getElementById('btn-filter-received-all');
        const compBtn = document.getElementById('btn-filter-received-completed');
        const uncompBtn = document.getElementById('btn-filter-received-uncompleted');
        
        [allBtn, compBtn, uncompBtn].forEach(btn => {
          if (btn) {
            btn.classList.remove('bg-ink', 'text-gold', 'shadow-2xs', 'font-bold');
            btn.classList.add('text-ink/70');
          }
        });

        const activeBtn = category === 'completed' ? compBtn : (category === 'uncompleted' ? uncompBtn : allBtn);
        if (activeBtn) {
          activeBtn.classList.remove('text-ink/70');
          activeBtn.classList.add('bg-ink', 'text-gold', 'shadow-2xs', 'font-bold');
        }

        const items = document.querySelectorAll('.history-received-item');
        let visibleCount = 0;
        items.forEach(item => {
          const itemCat = item.dataset.category;
          if (category === 'all' || itemCat === category) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        const emptyEl = document.getElementById('history-received-filter-empty');
        if (emptyEl) {
          if (visibleCount === 0 && items.length > 0) {
            emptyEl.classList.remove('hidden');
          } else {
            emptyEl.classList.add('hidden');
          }
        }
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeRejectTransferModal();
          document.querySelectorAll('[id^="modal-transfer-"]').forEach(m => {
            m.classList.add('hidden');
            m.classList.remove('flex');
          });
          document.body.classList.remove('overflow-hidden');
        }
      });

      function switchTransferTab(tab) {
        const btnPending = document.getElementById('tab-btn-pending');
        const btnHistory = document.getElementById('tab-btn-history');
        const groupPending = document.getElementById('transfer-group-pending');
        const groupHistory = document.getElementById('transfer-group-history');
        if (!btnPending || !btnHistory || !groupPending || !groupHistory) return;

        if (tab === 'pending') {
          btnPending.className = 'flex-1 py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 transition-all bg-ink text-gold border border-gold/40 shadow-2xs font-bold min-h-[40px]';
          btnHistory.className = 'flex-1 py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 transition-all text-ink/70 hover:text-ink min-h-[40px]';
          groupPending.classList.remove('hidden');
          groupHistory.classList.add('hidden');
        } else {
          btnHistory.className = 'flex-1 py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 transition-all bg-ink text-gold border border-gold/40 shadow-2xs font-bold min-h-[40px]';
          btnPending.className = 'flex-1 py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 transition-all text-ink/70 hover:text-ink min-h-[40px]';
          groupHistory.classList.remove('hidden');
          groupPending.classList.add('hidden');
        }
      }

      // Si no hi ha pendents però hi ha històric, obre directament l'històric a mòbil
      document.addEventListener('DOMContentLoaded', function() {
        {% if totalPending == 0 and totalHistory > 0 %}
          if (window.innerWidth < 1024) {
            switchTransferTab('history');
          }
        {% endif %}
      });

      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('[id^="modal-transfer-"]').forEach(modal => {
          modal.addEventListener('click', function(e) {
            if (e.target === modal) {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
              document.body.classList.remove('overflow-hidden');
            }
          });
        });
      });
    </script>

  </main>

  {# Barra Inferior Dinàmica PWA per a Mòbil (< md) #}
  {% include 'partials/_pwa_bottom_nav.html.twig' with {'active_tab': 'transfers'} %}

{% endblock %}
