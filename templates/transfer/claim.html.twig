{% extends 'base.html.twig' %}

{% block title %}Traspàs Notarial de Propietat — Registrals{% endblock %}
{% block meta_description %}Recepció i acceptació de traspàs de titularitat del bé {{ item.name }} ({{ item.cui }}).{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {# Capçalera Pública Institucional #}
  <header class="bg-white sticky top-0 z-50 border-b border-steel/20 shadow-2xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="{{ path('app_home') }}" class="flex items-center gap-2.5">
        <span class="font-marcellus text-xl tracking-wider text-ink font-bold">REGISTRALS</span>
        <span class="text-[9px] uppercase tracking-widest text-gold font-bold bg-cream px-2 py-0.5 rounded-full border border-gold/30">Fe Pública Digital</span>
      </a>
      <div>
        {% if app.user %}
          <a href="{{ path('app_dashboard') }}" class="px-3.5 py-1.5 rounded-xl font-bold text-xs uppercase tracking-wider bg-ink text-gold border border-gold/40 hover:bg-ink/90 transition-all shadow-2xs flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span>El meu Patrimoni</span>
          </a>
        {% else %}
          <a href="{{ path('app_login') }}" class="px-3.5 py-1.5 rounded-xl font-bold text-xs uppercase tracking-wider bg-white border border-steel/30 text-ink hover:text-gold hover:border-gold/50 transition-all shadow-2xs">
            Accés Usuaris
          </a>
        {% endif %}
      </div>
    </div>
  </header>

  {# Contingut Principal en format 16:9 Horitzontal Widescreen #}
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10 w-full flex-1 flex flex-col justify-center">

    {# Missatges Flash via Notarial Toast Oficial #}
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            if (window.RegistralsToast) {
              window.RegistralsToast.show(
                '{{ label == 'error' ? 'Avís de Seguretat' : (label == 'warning' ? 'Atenció' : 'Notificació Notarial') }}',
                '{{ message|e('js') }}',
                '{{ label == 'error' ? 'error' : (label == 'warning' ? 'info' : 'info') }}',
                5000
              );
            }
          });
        </script>
      {% endfor %}
    {% endfor %}

    <div class="bg-white rounded-3xl border border-gold/40 shadow-xl overflow-hidden">
      
      {# Lluentor Daurada Superior #}
      <div class="h-1.5 bg-gradient-to-r from-ink via-gold to-ink"></div>

      <div class="p-6 sm:p-8 lg:p-10">

        {# Graella Horitzontal 2 Columnes (16:9 en PC) #}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          {# ========================================== #}
          {# COLUMNA ESQUERRA (5 cols): IDENTITAT I FOTO DEL BÉ #}
          {# ========================================== #}
          <div class="lg:col-span-5 space-y-4">
            
            {# Marc Panoràmic 16:9 de la Fotografia #}
            <div class="relative rounded-2xl overflow-hidden aspect-video bg-cream/40 border border-gold/30 shadow-md">
              {% if item.mainPhoto %}
                <img src="{{ path('app_transfer_thumbnail', {'token': transfer.token}) }}" alt="{{ item.name }}" class="w-full h-full object-cover" onerror="this.style.display='none'; document.getElementById('claim-photo-fallback').style.display='flex';" />
                <div id="claim-photo-fallback" class="w-full h-full flex-col items-center justify-center p-6 text-center text-ink/50 bg-cream/30" style="display: none;">
                  <svg class="w-12 h-12 text-steel/40 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <span class="text-xs font-semibold text-ink/70">{{ item.name }}</span>
                </div>
              {% else %}
                <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center text-ink/50 bg-cream/30">
                  <svg class="w-12 h-12 text-steel/40 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <span class="text-xs text-steel">Sense fotografia principal registrada</span>
                </div>
              {% endif %}

              {# Badge CUI Superior Esquerre #}
              <div class="absolute top-2.5 left-2.5 z-10">
                <span class="bg-ink/90 backdrop-blur-md text-gold text-xs font-mono font-bold px-2.5 py-1 rounded-lg border border-gold/40 flex items-center gap-1 shadow-xs">
                  {{ item.cui }}
                </span>
              </div>

              {# Badge Polygon L2 Inferior #}
              <div class="absolute bottom-2.5 left-2.5 z-10">
                <span class="bg-emerald-50/90 backdrop-blur-md text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-300 flex items-center gap-1 shadow-2xs">
                  <svg class="w-2.5 h-2.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  <span>Custòdia Polygon L2</span>
                </span>
              </div>
            </div>

            {# Identitat del Bé #}
            <div class="space-y-1">
              <div class="text-xs text-steel font-semibold">
                <span>{{ item.category.name }}</span>
                {% if item.brand %}<span> &middot; {{ item.brand }}</span>{% endif %}
              </div>
              <h2 class="font-marcellus text-2xl text-ink font-bold leading-tight">{{ item.name }}</h2>
              {% if item.declaredValueEuros %}
                <p class="text-xs text-steel pt-0.5">
                  Valor estimat declarat: <strong class="text-ink font-raleway">{{ item.declaredValueEuros|number_format(0, ',', '.') }} €</strong>
                </p>
              {% endif %}
            </div>

            {# Avís Notarial Canònic d'Efecte Jurídic #}
            <div class="guide-note rounded-xl p-3.5 text-[11px] text-ink/85 leading-relaxed border-l-[3.5px] border-gold bg-gold/10 space-y-1">
              <strong class="text-ink block">Efecte Jurídic Immediat:</strong>
              <p>
                En acceptar aquest traspàs, la titularitat i la custòdia d'aquest bé seran transferides <strong>irrevocablement</strong> al vostre compte. S'emetrà un comprovant de transmissió immutable a Polygon L2.
              </p>
            </div>

          </div>

          {# ========================================== #}
          {# COLUMNA DRETA (7 cols): GESTIÓ I ACCEPTACIÓ #}
          {# ========================================== #}
          <div class="lg:col-span-7 bg-cream-50/80 rounded-2xl border border-steel/20 p-5 sm:p-7 space-y-5 flex flex-col justify-between">
            
            <div class="space-y-4">
              
              {# Capçalera de Traspàs #}
              <div class="space-y-1.5">
                <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-cream text-ink text-[11px] font-bold border border-gold/40">
                  <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                  <span>Procediment Notarial C2C</span>
                </div>
                <h1 class="font-marcellus text-2xl sm:text-3xl text-ink font-bold">Invitació de Traspàs de Titularitat</h1>
                <p class="text-xs text-steel leading-relaxed">
                  <strong class="text-ink">{{ sender.fullName }}</strong> (<span class="font-mono text-ink/75">{{ sender.email }}</span>) us transfereix la propietat d'aquest bé custodiat a Registrals.
                </p>
              </div>

              {# Dades de la Sol·licitud #}
              <div class="bg-white rounded-xl border border-steel/20 p-4 space-y-2 text-xs">
                <div class="flex items-center justify-between">
                  <span class="text-steel">Destinatari autoritzat:</span>
                  <strong class="font-mono text-ink text-xs">{{ transfer.recipientEmail }}</strong>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-steel">Taxa notarial de segellat L2:</span>
                  <span class="text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">Abonada per l'emissor (0,00 €)</span>
                </div>
                <div class="flex items-center justify-between pt-1 border-t border-steel/15 text-[11px]">
                  <span class="text-steel">Termini d'acceptació (72 hores):</span>
                  <strong class="text-ink">{{ transfer.expiresAt|date('d/m/Y H:i') }} UTC</strong>
                </div>
              </div>

              {# Acció Segons Estat d'Autenticació #}
              {% if app.user %}
                {% if app.user.email|lower == transfer.recipientEmail|lower %}
                  
                  {# FORMULARI D'ACCEPTACIÓ (Usuari correcte) #}
                  <form action="{{ path('app_transfer_accept', {'token': transfer.token}) }}" method="POST" class="space-y-4 pt-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('accept_transfer_' ~ transfer.id) }}">

                    {% if transfer.securityCode %}
                      <div class="p-3.5 rounded-xl border border-gold/40 bg-gold/10 space-y-1.5">
                        <label for="security_code" class="block text-xs font-bold uppercase tracking-wider text-ink">
                          Codi PIN de Seguretat Notarial (Requerit)
                        </label>
                        <p class="text-[11px] text-steel">
                          L'emissor ha definit un codi de seguretat de 6 dígits.
                        </p>
                        <input type="text" id="security_code" name="security_code" required maxlength="10" placeholder="Ex: 849201" class="w-full max-w-xs px-3.5 py-2 rounded-xl border border-steel/30 focus:border-gold focus:ring-1 focus:ring-gold bg-white text-ink font-mono text-center tracking-widest text-lg font-bold" autocomplete="one-time-code">
                      </div>
                    {% endif %}

                    <div class="space-y-3 pt-1">
                      <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-ink text-gold border border-gold/50 hover:bg-ink/90 font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer">
                        <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        <span>Acceptar Traspàs de Titularitat</span>
                      </button>
                    </div>
                  </form>

                  {# Acció de Rebuig #}
                  <div class="pt-2 text-center">
                    <form action="{{ path('app_transfer_reject', {'token': transfer.token}) }}" method="POST" onsubmit="return confirm('Esteu segur que voleu rebutjar aquest traspàs de propietat? L\'acció no es podrà desfer.');">
                      <input type="hidden" name="_token" value="{{ csrf_token('reject_transfer_' ~ transfer.id) }}">
                      <button type="submit" class="text-xs text-red-700 hover:text-red-900 font-semibold underline decoration-red-300 hover:decoration-red-600 transition-all cursor-pointer">
                        Rebutjar aquest traspàs
                      </button>
                    </form>
                  </div>

                {% else %}
                  
                  {# Compte diferent #}
                  <div class="p-4 rounded-xl border border-amber-200 bg-amber-50 text-amber-900 text-xs space-y-2">
                    <p>
                      <strong>Compte diferent detectat:</strong> Heu iniciat sessió com a <code>{{ app.user.email }}</code>, però aquest traspàs està reservat a <code>{{ transfer.recipientEmail }}</code>.
                    </p>
                    <p class="text-amber-800">
                      Per acceptar la titularitat, si us plau tanqueu la sessió actual i accediu amb el compte corresponent.
                    </p>
                    <div class="pt-1">
                      <a href="{{ path('app_logout') }}" class="inline-block px-4 py-2 rounded-xl bg-amber-800 text-white font-bold text-xs uppercase tracking-wider hover:bg-amber-900 transition-colors">
                        Tancar Sessió
                      </a>
                    </div>
                  </div>

                {% endif %}

              {% else %}
                
                {# Usuari no autenticat #}
                <div class="p-5 rounded-2xl border border-gold/40 bg-white space-y-3 text-center">
                  <div class="space-y-1">
                    <h3 class="font-bold text-ink text-sm">Identificació de Receptor Requerida</h3>
                    <p class="text-xs text-steel">
                      Aquest bé serà custodiat a nom de <strong class="text-ink font-mono">{{ transfer.recipientEmail }}</strong>. Accedeix o registra't per acceptar-lo.
                    </p>
                  </div>

                  <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
                    <a href="{{ path('app_login') }}" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-bold text-xs uppercase tracking-wider shadow-sm transition-all text-center">
                      Iniciar Sessió
                    </a>
                    <a href="{{ path('app_register') }}" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-white border border-steel/30 text-ink hover:border-gold hover:text-gold font-bold text-xs uppercase tracking-wider shadow-2xs transition-all text-center">
                      Crear Compte Gratuït
                    </a>
                  </div>
                </div>

              {% endif %}

            </div>

            {# Peu de la Targeta Dreta #}
            <div class="pt-3 border-t border-steel/15 flex items-center justify-between text-[11px] text-steel">
              <span>Fe pública digital garantida</span>
              <span class="font-mono text-[10px]">Token: {{ transfer.token|slice(0, 10) }}...</span>
            </div>

          </div>

        </div>

      </div>

    </div>

  </main>

  {# Peu de Pàgina Institucional #}
  {{ include('page/home/_footer.html.twig') }}

</div>
{% endblock %}
