{% extends 'base.html.twig' %}

{% block title %}Facturació & Evidència de Pagaments — Registrals{% endblock %}
{% block meta_description %}Historial certificat de pagaments, descàrrega de factures fiscals amb IVA i gestió de mètodes de pagament a Registrals.{% endblock %}

{% block body_class %}bg-cream-50 text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream-50">

  {# Barra Superior Privada Unificada #}
  {% include 'partials/_private_header.html.twig' %}

  <main class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-8 py-3.5 sm:py-5 w-full flex-1 pb-20 md:pb-5">

    {# Capçalera Notarial Canònica de Subpàgina #}
    {% include 'partials/_subpage_header.html.twig' with {
      breadcrumbs: [
        { label: 'Inici', url: path('app_dashboard') },
        { label: 'Perfil', url: path('app_profile') },
        { label: 'Facturació' }
      ],
      title: 'Facturació & Evidència de Pagaments',
      subtitle: 'Custòdia certificada d\'actes de pagament, gestió fiscal i descàrrega de factures amb IVA.',
      nav_prev_url: path('app_plan'),
      nav_prev_label: 'El meu Pla',
      nav_next_url: path('app_profile_install_app'),
      nav_next_label: 'App Mòbil'
    } %}

    {# Secció 1: Resum de Subscripció i Estat Fiscal #}
    <div class="bg-white rounded-2xl border border-steel/20 shadow-xs p-5 sm:p-7 mb-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between pb-5 mb-5 border-b border-steel/15 gap-4">
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-xl bg-cream border border-gold/40 flex items-center justify-center text-ink shrink-0 shadow-2xs">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-marcellus text-lg sm:text-xl text-ink">Subscripció: {{ currentPlan.name }}</h2>
              <span class="px-2 py-0.5 rounded-md font-mono text-[10px] font-bold uppercase tracking-wider {{ currentPlan.code == 'plus' ? 'bg-ink text-gold border border-gold/40' : (currentPlan.code == 'unlimited' ? 'bg-gold text-ink' : 'bg-cream text-steel border border-steel/20') }}">
                {{ currentPlan.code|upper }}
              </span>
              {% if currentPlan.code != 'free' %}
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 text-[10px] font-mono font-bold border border-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Renovació Automàtica Activa
                </span>
              {% else %}
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-cream text-steel text-[10px] font-mono font-bold border border-steel/20">
                  Sense Quotes
                </span>
              {% endif %}
            </div>
            <p class="text-xs text-ink/65 mt-0.5">
              Tarifa vigent: <strong class="text-ink">{{ currentPlan.priceCents > 0 ? ((currentPlan.priceCents / 100)|number_format(2, ',', '.') ~ ' € / any') : '0,00 € (Gratuïta)' }}</strong>
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-2 w-full sm:w-auto">
          {% if user.stripeCustomerId %}
            <a href="{{ path('app_payment_portal') }}" class="w-full sm:w-auto justify-center px-3.5 py-2.5 sm:py-1.5 rounded-lg bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-raleway font-bold text-xs uppercase tracking-wider shadow-2xs transition-all flex items-center gap-1.5 min-h-[44px] sm:min-h-0">
              <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              <span>Gestionar a Stripe</span>
            </a>
          {% else %}
            <a href="{{ path('app_plan') }}" class="w-full sm:w-auto justify-center px-3.5 py-2.5 sm:py-1.5 rounded-lg bg-white border border-steel/30 text-ink hover:border-gold hover:text-gold font-raleway font-bold text-xs uppercase tracking-wider shadow-2xs transition-all min-h-[44px] sm:min-h-0 flex items-center">
              Millorar de Pla →
            </a>
          {% endif %}

          {% if currentPlan.code != 'free' %}
            <button type="button" onclick="openCancelModal()" class="w-full sm:w-auto justify-center px-3.5 py-2.5 sm:py-1.5 rounded-lg bg-rose-50/80 hover:bg-rose-100/90 text-rose-900 border border-rose-300/80 hover:border-rose-400 font-raleway font-semibold text-xs tracking-wider shadow-2xs transition-all flex items-center gap-1.5 min-h-[44px] sm:min-h-0 cursor-pointer">
              <svg class="w-3.5 h-3.5 text-rose-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <span>Cancel·lar Subscripció</span>
            </button>
          {% endif %}
        </div>
      </div>

      {# Metadades fiscals i de calendari #}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-cream/30 border border-steel/15">
          <span class="text-[10px] uppercase font-mono tracking-wider text-ink/50 block">Inici & Vigència</span>
          <span class="font-bold text-ink text-xs block mt-0.5">
            {{ user.planStartedAt ? user.planStartedAt|date('d/m/Y') : user.createdAt|date('d/m/Y') }}
            {% if user.planExpiresAt %}
              fins al {{ user.planExpiresAt|date('d/m/Y') }}
            {% endif %}
          </span>
          <span class="text-[10px] text-ink/50 block mt-0.5">
            {{ user.planExpiresAt ? 'Renovació anual programada' : 'Pla gratuït indefinit' }}
          </span>
        </div>

        <div class="p-3 rounded-xl bg-cream/30 border border-steel/15">
          <span class="text-[10px] uppercase font-mono tracking-wider text-ink/50 block">Titular Fiscal (NIF / CIF)</span>
          <span class="font-bold text-ink text-xs block mt-0.5 font-mono">
            {{ user.taxId ?: 'Sense NIF indicat' }}
          </span>
          <span class="text-[10px] text-ink/50 block mt-0.5">
            <a href="{{ path('app_profile') }}" class="text-gold hover:underline">Modificar al perfil →</a>
          </span>
        </div>

        <div class="p-3 rounded-xl bg-cream/30 border border-steel/15">
          <span class="text-[10px] uppercase font-mono tracking-wider text-ink/50 block">Mètode de Pagament</span>
          <span class="font-bold text-ink text-xs block mt-0.5">
            {{ user.stripeCustomerId ? 'Targeta custodiada a Stripe' : 'Cap mètode requerit (Free)' }}
          </span>
          <span class="text-[10px] text-ink/50 block mt-0.5 font-mono">
            {{ user.stripeCustomerId ? user.stripeCustomerId|slice(0, 14) ~ '...' : 'Sense despeses' }}
          </span>
        </div>
      </div>
    </div>

    {# Avís Notarial Canònic (guia-destils / .guide-note) #}
    <div class="mb-6 p-3.5 rounded-xl border-l-[3.5px] border-gold bg-gold/10 text-xs text-ink/80 leading-relaxed font-raleway">
      <strong>Custòdia Fiscal Certificada:</strong> Totes les quotes de subscripció i les taxes d'emissió s'associen al teu NIF/CIF (<code>{{ user.taxId ?: 'Sense NIF indicat' }}</code>) i queden registrades a la nostra matriu comptable. Les factures oficials amb IVA desglossat per a deducció fiscal estan disponibles per a descàrrega immediata en PDF al portal de Stripe.
    </div>

    {# Secció 2: Taula d'Actes de Pagament Notarials #}
    <div class="bg-white rounded-2xl border border-steel/20 shadow-xs p-5 sm:p-7">
      <div class="flex items-center justify-between pb-3 mb-3 border-b border-steel/15">
        <div>
          <h3 class="font-marcellus text-base sm:text-lg text-ink">Historial d'Actes de Pagament</h3>
          <p class="text-xs text-ink/65">Traçabilitat forense de transaccions, compres de certificats oficials i traspassos.</p>
        </div>
        <span class="text-xs font-mono text-ink/60 bg-cream/50 px-2.5 py-1 rounded-lg border border-steel/15">
          {{ transactions|length }} registre{{ transactions|length == 1 ? '' : 's' }}
        </span>
      </div>

      {% if transactions is not empty %}
        {# Vista Mòbil PWA: Targetes de Rebut Notarial (< sm) #}
        <div class="sm:hidden space-y-3">
          {% for tx in transactions %}
            <div class="bg-white rounded-xl border border-steel/20 p-3.5 shadow-2xs hover:border-gold/50 transition-all">
              <div class="flex items-center justify-between pb-2 mb-2 border-b border-steel/10">
                <div class="flex items-center gap-1.5 font-mono text-[11px] text-ink/70">
                  <svg class="w-3.5 h-3.5 text-steel/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <span>{{ tx.createdAt|date('d/m/Y') }}</span>
                  <span class="text-steel/40">·</span>
                  <span class="text-[10px] text-steel/80 bg-cream/70 px-1.5 py-0.5 rounded border border-steel/15 font-mono">
                    {{ tx.uuid|slice(0, 8) }}
                  </span>
                </div>
                <div>
                  {% if tx.status.isSuccess %}
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-[11px] font-mono font-semibold border border-emerald-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Pagat
                    </span>
                  {% elseif tx.status.value == 'pending' %}
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 text-[11px] font-mono font-semibold border border-amber-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pendent
                    </span>
                  {% else %}
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-red-50 text-red-700 text-[11px] font-mono font-semibold border border-red-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> {{ tx.status.label }}
                    </span>
                  {% endif %}
                </div>
              </div>

              <div class="flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="font-semibold text-ink text-xs sm:text-sm truncate">
                    {{ tx.type.label }}
                  </div>
                  <div class="text-[10px] text-ink/50 mt-0.5">
                    Acte fiscal certificat
                  </div>
                </div>
                <div class="text-right shrink-0">
                  <div class="font-mono font-bold text-ink text-sm sm:text-base">
                    {{ tx.amountFormatted }}
                  </div>
                  <div class="text-[10px] text-steel/60 font-mono">
                    IVA inclòs
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        {# Vista Escriptori: Taula Notarial d'Alta Densitat (>= sm) #}
        <div class="hidden sm:block border border-steel/15 rounded-xl overflow-hidden shadow-2xs">
          <table class="w-full text-left text-xs">
            <thead class="bg-cream/40 border-b border-steel/15 text-[10px] uppercase font-mono tracking-wider text-ink/70">
              <tr>
                <th class="py-2.5 px-4">Data & ID Transacció</th>
                <th class="py-2.5 px-4">Concepte</th>
                <th class="py-2.5 px-4 text-right">Import</th>
                <th class="py-2.5 px-4 text-center">Estat</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-steel/10 bg-white">
              {% for tx in transactions %}
                <tr class="hover:bg-cream/20 transition-colors">
                  <td class="py-2.5 px-4 font-mono text-xs text-ink/70 whitespace-nowrap">
                    {{ tx.createdAt|date('d/m/Y') }}
                    <span class="block text-[10px] text-steel/70 font-mono">{{ tx.uuid|slice(0, 8) }}...</span>
                  </td>
                  <td class="py-2.5 px-4 font-semibold text-ink text-xs sm:text-sm">
                    {{ tx.type.label }}
                  </td>
                  <td class="py-2.5 px-4 text-right font-mono font-bold text-ink whitespace-nowrap text-xs sm:text-sm">
                    {{ tx.amountFormatted }}
                  </td>
                  <td class="py-2.5 px-4 text-center whitespace-nowrap">
                    {% if tx.status.isSuccess %}
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-mono font-semibold border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Pagat
                      </span>
                    {% elseif tx.status.value == 'pending' %}
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-700 text-xs font-mono font-semibold border border-amber-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pendent
                      </span>
                    {% else %}
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-red-50 text-red-700 text-xs font-mono font-semibold border border-red-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> {{ tx.status.label }}
                      </span>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="p-4 rounded-xl border border-steel/20 bg-cream/30 text-ink/65 text-xs text-center font-raleway">
          Sense moviments de pagament registrats. Les teves subscripcions i certificats de pagament constaran aquí.
        </div>
      {% endif %}
    </div>

  </main>

  {# Barra Inferior Dinàmica PWA per a Mòbil #}
  {% include 'partials/_pwa_bottom_nav.html.twig' with {'active_tab': 'profile'} %}

</div>

{% if currentPlan.code != 'free' %}
  {# Modal Canònic Dual PWA: Cancel·lació de Subscripció #}
  <div id="cancel-subscription-modal" class="hidden fixed inset-0 z-50 bg-ink/75 backdrop-blur-xs items-end sm:items-center justify-center p-0 sm:p-4 transition-all duration-200" onclick="if(event.target === this) closeCancelModal();">
    <div class="bg-white rounded-t-3xl sm:rounded-2xl border-t sm:border border-gold/40 shadow-2xl max-w-md w-full max-h-[90vh] sm:max-h-[92vh] overflow-hidden flex flex-col animate-in fade-in zoom-in-95 duration-150">
      {# Nansa tàctil mòbil #}
      <div class="sm:hidden w-10 h-1 bg-steel/30 rounded-full mx-auto mt-2 -mb-1 shrink-0"></div>

      {# Capçalera Solemne #}
      <div class="p-4 sm:p-5 border-b border-steel/15 flex items-center justify-between bg-cream/30">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <h3 class="font-marcellus text-base sm:text-lg text-ink font-bold leading-tight">
              Cancel·lació de Subscripció
            </h3>
            <p class="text-[11px] font-mono text-steel">Retorn al Pla Free</p>
          </div>
        </div>
        <button type="button" onclick="closeCancelModal()" class="w-8 h-8 rounded-lg bg-white border border-steel/20 text-steel hover:text-ink flex items-center justify-center text-sm font-bold cursor-pointer">
          ✕
        </button>
      </div>

      {# Cos del Modal #}
      <div class="p-4 sm:p-5 overflow-y-auto space-y-3 font-raleway text-xs sm:text-sm text-ink/80 leading-relaxed">
        <p>
          Estàs a punt de cancel·lar la teva subscripció al <strong>{{ currentPlan.name }}</strong>. La renovació automàtica s'aturarà a Stripe i el teu compte passarà al <strong>Pla Free (sense quotes)</strong>.
        </p>

        {# Avís Canònic .guide-note #}
        {% set effectiveFreeLimit = maxFreeItems is defined ? maxFreeItems : (freePlan ? freePlan.maxActiveItems : 20) %}
        {% set effectivePlusLimit = maxPlusItems is defined ? maxPlusItems : (plusPlan ? plusPlan.maxActiveItems : 100) %}
        <div class="p-3.5 rounded-xl bg-gold/10 border-l-[3.5px] border-gold text-ink text-xs font-raleway space-y-1">
          <strong>Límit de {{ effectiveFreeLimit }} béns actius i període de gràcia</strong>
          <p class="text-ink/80">
            El Pla Free manté fins a <code>{{ effectiveFreeLimit }} béns actius</code>. Si el teu patrimoni supera aquesta quota, disposaràs de <strong>7 dies de període de gràcia</strong> per triar quins béns conserves operatius.
          </p>
          <p class="text-ink/80 pt-0.5">
            Els béns excedents restaran <strong>100% protegits i immutables sota custòdia en fred</strong>.
          </p>
        </div>

        <p class="text-[11px] text-steel">
          Podràs reactivar el Pla Plus en qualsevol moment per recuperar la capacitat completa de {{ effectivePlusLimit }} béns i consultes d'IA sobirana.
        </p>
      </div>

      {# Peu d'accions #}
      <div class="p-4 bg-cream-50/50 border-t border-steel/15 flex flex-col sm:flex-row items-center justify-end gap-2.5">
        <button type="button" onclick="closeCancelModal()" class="w-full sm:w-auto px-4 py-2.5 rounded-xl border border-steel/30 bg-white text-ink/80 hover:text-ink hover:bg-cream/40 text-xs font-semibold text-center transition-all cursor-pointer">
          Mantenir Pla Plus
        </button>
        <form method="POST" action="{{ path('app_payment_cancel_subscription') }}" class="w-full sm:w-auto m-0">
          <input type="hidden" name="_token" value="{{ csrf_token('cancel_subscription') }}">
          <button type="submit" style="background-color: #be123c; color: #ffffff;" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-rose-700 hover:bg-rose-800 text-white font-bold text-xs uppercase tracking-wider text-center transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
            <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7"/></svg>
            <span style="color: #ffffff;">Confirmar i Baixar a Free</span>
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    function openCancelModal() {
      const modal = document.getElementById('cancel-subscription-modal');
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.classList.add('overflow-hidden');
      }
    }

    function closeCancelModal() {
      const modal = document.getElementById('cancel-subscription-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
      }
    }

    document.addEventListener('keydown', function(evt) {
      if (evt.key === 'Escape') {
        closeCancelModal();
      }
    });

    if (window.location.hash === '#cancel-subscription') {
      openCancelModal();
    }
  </script>
{% endif %}
{% endblock %}
