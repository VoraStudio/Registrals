{% extends 'base.html.twig' %}

{% block title %}El meu Pla i Facturació — Registrals{% endblock %}
{% block meta_description %}Estat de la subscripció, consum en calent de quotes, gestió de facturació i comparativa de plans a Registrals.{% endblock %}

{% block body_class %}bg-cream-50 text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream-50">

  {# Barra Superior Privada Unificada #}
  {% include 'partials/_private_header.html.twig' %}

  <main class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-8 py-3.5 sm:py-5 w-full flex-1 pb-20 md:pb-5">

    {# Capçalera Institucional de Subpàgina #}
    {% include 'partials/_subpage_header.html.twig' with {
      breadcrumbs: [
        { label: 'Inici', url: path('app_dashboard') },
        { label: 'Perfil', url: path('app_profile') },
        { label: 'Plans' }
      ],
      title: 'El meu Pla & Quotes',
      subtitle: 'Seguiment del consum en calent de quotes, gestió de la subscripció i comparativa de plans.',
      nav_prev_url: path('app_profile'),
      nav_prev_label: 'Perfil',
      nav_next_url: path('app_plan_billing'),
      nav_next_label: 'Facturació'
    } %}

    {# Secció 1: Estat del Pla Actual i Consum en Calent #}
    <div class="bg-white rounded-2xl border border-steel/20 shadow-xs p-5 sm:p-7 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-5 mb-6 border-b border-steel/15 gap-4">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-cream border border-gold/40 flex items-center justify-center text-ink shrink-0 shadow-2xs">
            {% if currentPlan.code == 'plus' %}
              <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            {% elseif currentPlan.code == 'unlimited' %}
              <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
            {% else %}
              <svg class="w-6 h-6 text-steel" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            {% endif %}
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-marcellus text-xl sm:text-2xl text-ink">{{ currentPlan.name }}</h2>
              <span class="px-2 py-0.5 rounded-md font-mono text-[10px] font-bold uppercase tracking-wider {{ currentPlan.code == 'plus' ? 'bg-ink text-gold border border-gold/40' : (currentPlan.code == 'unlimited' ? 'bg-gold text-ink' : 'bg-cream text-steel border border-steel/20') }}">
                {{ currentPlan.code|upper }}
              </span>
              {% if currentPlan.code != 'free' %}
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 text-[10px] font-mono font-bold border border-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Renovació Automàtica Activa
                </span>
              {% endif %}
            </div>
            <p class="text-xs text-ink/65 mt-1 flex flex-wrap items-center gap-x-2 gap-y-1">
              <span>Actiu des del <strong>{{ user.planStartedAt ? user.planStartedAt|date('d/m/Y') : user.createdAt|date('d/m/Y') }}</strong></span>
              {% if user.planExpiresAt %}
                <span>·</span>
                <span>Pròxim cobrament anual: <strong>{{ user.planExpiresAt|date('d/m/Y') }}</strong></span>
              {% else %}
                <span>·</span>
                <span>Modalitat permanent (sense quotes)</span>
              {% endif %}
              {% if user.taxId %}
                <span>·</span>
                <span>Facturat a NIF: <strong>{{ user.taxId }}</strong></span>
              {% endif %}
            </p>
          </div>
        </div>

        <div class="text-left sm:text-right">
          <div class="text-xs text-ink/60 uppercase font-mono">Quota de subscripció</div>
          <div class="text-lg sm:text-xl font-bold font-mono text-ink">
            {% if currentPlan.priceCents > 0 %}
              {{ (currentPlan.priceCents / 100)|number_format(2, ',', '.') }} € <span class="text-xs font-normal text-ink/60">/ any</span>
            {% else %}
              0,00 € <span class="text-xs font-normal text-ink/60">(Gratuït)</span>
            {% endif %}
          </div>
        </div>
      </div>

      {# Graella de 4 Targetes de Consum #}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        {# KPI 1: Béns Custodiats #}
        <div class="p-4 rounded-xl bg-cream/30 border border-steel/15 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs text-ink/70 mb-1">
              <span class="font-semibold">Béns Actius</span>
              <span class="font-mono text-xs">{{ activeItemsCount }} / {{ maxActive >= 9999 or maxActive == -1 ? '∞' : maxActive }}</span>
            </div>
            <div class="text-xl font-bold font-mono text-ink mt-1">
              {{ activeItemsCount }} <span class="text-xs font-normal text-ink/60">béns registrats</span>
            </div>
            {% if frozenCount is defined and frozenCount > 0 %}
              <div class="mt-1.5 text-[11px] font-mono text-slate-700 flex items-center gap-1.5 bg-slate-100 px-2 py-0.5 rounded border border-slate-300">
                <svg class="w-3 h-3 text-slate-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <span><strong>{{ frozenCount }}</strong> en custòdia en fred</span>
                <a href="{{ path('app_downgrade_adequacy') }}" class="text-gold font-bold hover:underline ml-auto font-sans">Adequar</a>
              </div>
            {% endif %}
          </div>
          <div class="mt-3">
            <div class="w-full bg-steel/20 rounded-full h-2 overflow-hidden">
              <div class="bg-ink h-2 rounded-full transition-all duration-500" style="width: {{ itemsPct }}%;"></div>
            </div>
            <span class="text-[10px] text-ink/50 mt-1 block text-right font-mono">{{ maxActive >= 9999 or maxActive == -1 ? 'Sense límit' : itemsPct ~ '% ocupat' }}</span>
          </div>
        </div>

        {# KPI 2: Assistència d'IA Sobirana #}
        <div class="p-4 rounded-xl bg-cream/30 border border-steel/15 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs text-ink/70 mb-1">
              <span class="font-semibold">Consultes d'IA</span>
              <span class="font-mono text-xs">{{ aiUsed }} / {{ maxAi >= 9999 or maxAi == -1 ? '∞' : maxAi }}</span>
            </div>
            <div class="text-xl font-bold font-mono text-ink mt-1">
              {{ aiUsed }} <span class="text-xs font-normal text-ink/60">de {{ maxAi >= 9999 or maxAi == -1 ? 'il·limitades' : maxAi ~ ' anuals' }}</span>
            </div>
          </div>
          <div class="mt-3">
            <div class="w-full bg-steel/20 rounded-full h-2 overflow-hidden">
              <div class="bg-gold h-2 rounded-full transition-all duration-500" style="width: {{ aiPct }}%;"></div>
            </div>
            <span class="text-[10px] text-ink/50 mt-1 block text-right font-mono">{{ maxAi >= 9999 or maxAi == -1 ? 'Ús lliure' : aiPct ~ '% consumit' }}</span>
          </div>
        </div>

        {# KPI 3: Fotos i Proves per Bé #}
        <div class="p-4 rounded-xl bg-cream/30 border border-steel/15 flex flex-col justify-between">
          <div>
            <div class="text-xs text-ink/70 font-semibold mb-1">Evidències per Bé</div>
            <div class="text-sm font-bold text-ink mt-1 space-y-1">
              <div class="flex items-center justify-between">
                <span class="text-xs text-ink/75">Fotografies:</span>
                <span class="font-mono font-bold">{{ currentPlan.maxPhotosPerItem >= 9999 or currentPlan.maxPhotosPerItem == -1 ? 'Il·limitades' : currentPlan.maxPhotosPerItem ~ ' per bé' }}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs text-ink/75">Comprovants/Tiquets:</span>
                <span class="font-mono font-bold">{{ currentPlan.maxEvidencesPerItem >= 9999 or currentPlan.maxEvidencesPerItem == -1 ? 'Il·limitats' : currentPlan.maxEvidencesPerItem ~ ' per bé' }}</span>
              </div>
            </div>
          </div>
          <div class="mt-2 text-[10px] text-ink/50">
            {% if currentPlan.code == 'free' %}
              * Ampliable a 5 fotos amb Pla Plus
            {% else %}
              * Capacitat multievidència activa
            {% endif %}
          </div>
        </div>

        {# KPI 4: Certificats i Traspassos #}
        <div class="p-4 rounded-xl bg-cream/30 border border-steel/15 flex flex-col justify-between">
          <div>
            <div class="text-xs text-ink/70 font-semibold mb-1">Garantia de Certificació eIDAS</div>
            <div class="text-sm font-bold text-ink mt-1 space-y-1">
              <div class="flex items-center justify-between">
                <span class="text-xs text-ink/75">Certificats emesos:</span>
                <span class="font-mono font-bold">{{ user.certificatesIssuedCount }}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs text-ink/75">Segellat oficial:</span>
                <span class="font-mono text-xs {{ currentPlan.allowOfficialCertificates ? 'text-emerald-700 font-bold' : 'text-amber-700' }}">
                  {{ currentPlan.allowOfficialCertificates ? 'Inclòs' : 'Esborrany (Free)' }}
                </span>
              </div>
            </div>
          </div>
          <div class="mt-2 text-[10px] text-ink/50">
            Doble capa: eIDAS (Signaturit / Namirial) + Polygon L2
          </div>
        </div>

      </div>
    </div>

    {# Secció 2: Comparativa Institucional de Plans #}
    <div class="mb-4">
      <h2 class="text-xl sm:text-2xl font-marcellus text-ink mb-1">Comparativa de Plans</h2>
      <p class="text-xs text-ink/65 mb-6">Selecciona el nivell de protecció patrimonial i custòdia documental que millor s'adapti a les teves necessitats.</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        {% for plan in allPlans %}
          {% set isCurrent = (plan.code == currentPlan.code) %}
          {% set isPlus = (plan.code == 'plus') %}
          {% set isUnlimited = (plan.code == 'unlimited') %}

          <div class="rounded-2xl {{ isCurrent ? 'bg-white border-gold shadow-md ring-2 ring-gold/20' : (isUnlimited or not plan.isActive ? 'bg-cream-50/70 border-steel/25 shadow-2xs opacity-75 backdrop-blur-[2px]' : 'bg-white border-steel/20 shadow-xs hover:border-gold/50') }} border flex flex-col justify-between p-6 transition-all relative">
            
            {# Insígnia del Pla Actual o Properament #}
            {% if isCurrent %}
              <div class="absolute -top-3 right-6 px-3 py-0.5 rounded-full bg-ink text-gold border border-gold/50 font-mono text-[10px] font-bold uppercase tracking-wider shadow-xs">
                Pla Actual
              </div>
            {% elseif isUnlimited or not plan.isActive %}
              <div class="absolute -top-3 right-6 px-3 py-0.5 rounded-full bg-cream-50 text-steel border border-steel/30 font-mono text-[10px] font-bold uppercase tracking-wider shadow-2xs flex items-center gap-1.5">
                <svg class="w-3 h-3 text-steel/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <span>Properament</span>
              </div>
            {% endif %}

            <div>
              {# Capçalera de la Targeta de Pla #}
              <div class="mb-4">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="font-marcellus text-xl {{ isUnlimited or not plan.isActive ? 'text-ink/75' : 'text-ink' }}">{{ plan.name }}</h3>
                </div>
                <div class="mt-2 flex items-baseline gap-1">
                  <span class="font-mono text-3xl font-bold {{ isUnlimited or not plan.isActive ? 'text-ink/70' : 'text-ink' }}">
                    {{ plan.priceCents > 0 ? ((plan.priceCents % 100 == 0) ? (plan.priceCents / 100)|number_format(0, ',', '.') : (plan.priceCents / 100)|number_format(2, ',', '.')) : '0' }} €
                  </span>
                  <span class="text-xs text-ink/60 font-raleway">
                    {{ plan.priceCents > 0 ? (plan.billingPeriod == 'monthly' ? '/ mes' : (plan.billingPeriod == 'lifetime' ? 'únic' : '/ any')) : 'per sempre' }}
                  </span>
                </div>
                {% if isUnlimited or not plan.isActive %}
                  <p class="mt-1 text-[11px] text-steel italic">En preparació per a grans col·leccions i patrimonis.</p>
                {% endif %}
              </div>

              {# Llista de Prestacions #}
              <ul class="space-y-3 py-4 border-t border-steel/15 text-xs {{ isUnlimited or not plan.isActive ? 'text-ink/65' : 'text-ink/80' }}">
                <li class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 {{ isUnlimited or not plan.isActive ? 'text-steel/70' : 'text-emerald-600' }} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>
                    <strong class="text-ink font-bold">{{ plan.maxActiveItems == -1 or plan.maxActiveItems >= 9999 ? 'Il·limitats' : 'Fins a ' ~ plan.maxActiveItems }}</strong> béns actius
                    ({{ plan.maxYearlyRegistrations == -1 or plan.maxYearlyRegistrations >= 9999 ? 'altes il·limitades' : plan.maxYearlyRegistrations ~ ' altes/any' }})
                  </span>
                </li>

                <li class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 {{ isUnlimited or not plan.isActive ? 'text-steel/70' : 'text-emerald-600' }} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span><strong class="text-ink font-bold">{{ plan.maxPhotosPerItem == -1 or plan.maxPhotosPerItem >= 9999 ? 'Il·limitades' : plan.maxPhotosPerItem }}</strong> {{ plan.maxPhotosPerItem == 1 ? 'fotografia' : 'fotografies' }} per bé</span>
                </li>

                <li class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 {{ isUnlimited or not plan.isActive ? 'text-steel/70' : 'text-emerald-600' }} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span><strong class="text-ink font-bold">{{ plan.maxEvidencesPerItem == -1 or plan.maxEvidencesPerItem >= 9999 ? 'Il·limitades' : plan.maxEvidencesPerItem }}</strong> {{ plan.maxEvidencesPerItem == 1 ? 'prova documental' : 'proves documentals' }} per bé</span>
                </li>

                <li class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 {{ isUnlimited or not plan.isActive ? 'text-steel/70' : 'text-emerald-600' }} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  {% if plan.aiAssistanceEnabled %}
                    <span><strong class="text-ink font-bold">{{ plan.aiAssistanceQuota == -1 or plan.aiAssistanceQuota >= 9999 ? 'Il·limitades' : plan.aiAssistanceQuota }}</strong> consultes d'IA sobirana</span>
                  {% else %}
                    <span class="text-ink/60">Assistència IA sobirana desactivada</span>
                  {% endif %}
                </li>

                <li class="flex items-center gap-2.5">
                  {% if plan.allowOfficialCertificates %}
                    <svg class="w-4 h-4 {{ isUnlimited or not plan.isActive ? 'text-steel/70' : 'text-emerald-600' }} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span>Certificats oficials eIDAS ({{ plan.monthlyCertificatesQuota == -1 or plan.monthlyCertificatesQuota >= 9999 ? 'il·limitats' : plan.monthlyCertificatesQuota ~ '/mes' }})</span>
                  {% else %}
                    <svg class="w-4 h-4 text-steel/50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    <span class="text-ink/60">Esborranys de certificat (marca d'aigua)</span>
                  {% endif %}
                </li>

                <li class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 {{ isUnlimited or not plan.isActive ? 'text-steel/70' : 'text-emerald-600' }} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>
                    {% if plan.transfersIncluded == -1 or plan.transfersIncluded >= 9999 %}
                      Traspassos C2C il·limitats
                    {% elseif plan.transfersIncluded > 0 %}
                      <strong class="text-ink font-bold">{{ plan.transfersIncluded }}</strong> traspassos C2C inclosos
                    {% else %}
                      Traspassos C2C a <strong class="text-ink font-bold">{{ (plan.extraTransferPriceCents / 100)|number_format(2, ',', '.') }} €</strong>/u.
                    {% endif %}
                  </span>
                </li>

                <li class="flex items-center gap-2.5">
                  {% if plan.code == 'plus' or plan.code == 'unlimited' %}
                    <svg class="w-4 h-4 {{ isUnlimited or not plan.isActive ? 'text-steel/70' : 'text-emerald-600' }} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span>Identificació de titular eIDAS (Namirial)</span>
                  {% else %}
                    <svg class="w-4 h-4 text-steel/50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    <span class="text-ink/60">Sense identificació oficial de titular</span>
                  {% endif %}
                </li>

                <li class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 {{ isUnlimited or not plan.isActive ? 'text-steel/70' : 'text-emerald-600' }} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>Ancoratge criptogràfic a Polygon Blockchain</span>
                </li>
              </ul>
            </div>

            {# Botó d'Acció de la Targeta #}
            <div class="pt-4 border-t border-steel/15 mt-4">
              {% if isCurrent %}
                <button type="button" disabled class="w-full py-2.5 px-4 rounded-xl bg-cream/70 text-ink/60 border border-steel/20 text-xs font-bold uppercase tracking-wider text-center cursor-default">
                  Pla Contractat
                </button>
              {% elseif isUnlimited or not plan.isActive %}
                <button type="button" onclick="if (window.RegistralsToast) { window.RegistralsToast.show('Pla Unlimited', 'Aquest pla estarà disponible properament per a grans col·leccions i patrimonis. Pots activar ara el Pla Plus!', 'info', 4500); }" class="w-full py-2.5 px-4 rounded-xl bg-cream/50 text-steel border border-steel/25 text-xs font-bold uppercase tracking-wider text-center hover:bg-cream/80 transition-all cursor-pointer">
                  Properament
                </button>
              {% elseif plan.code == 'free' %}
                {% if currentPlan.code != 'free' %}
                  <a href="{{ path('app_plan_billing') }}#cancel-subscription" class="w-full block py-2.5 px-4 rounded-xl bg-white hover:bg-rose-50/60 text-slate-700 hover:text-rose-700 border border-steel/30 hover:border-rose-300 text-xs font-bold uppercase tracking-wider text-center transition-all shadow-2xs">
                    Baixar a Pla Free
                  </a>
                {% else %}
                  <button type="button" disabled class="w-full py-2.5 px-4 rounded-xl bg-cream/70 text-ink/60 border border-steel/20 text-xs font-bold uppercase tracking-wider text-center cursor-default">
                    Pla Gratuït per Defecte
                  </button>
                {% endif %}
              {% else %}
                <form action="{{ path('app_payment_plan_checkout', {'code': plan.code}) }}" method="POST">
                  <input type="hidden" name="_token" value="{{ csrf_token('checkout_plan_' ~ plan.code) }}">
                  <button type="submit" class="w-full py-2.5 px-4 rounded-xl {{ isPlus ? 'bg-ink text-gold border border-gold/40 hover:bg-ink/90' : 'bg-white border border-steel/30 text-ink hover:border-gold hover:text-gold' }} text-xs font-bold uppercase tracking-wider text-center shadow-xs transition-all cursor-pointer">
                    Contractar {{ plan.name }}
                  </button>
                </form>
              {% endif %}
            </div>

          </div>
        {% endfor %}

      </div>
    </div>

    {# Avís Canònic de Certificació (.guide-note oficial) #}
    <div class="mt-8 p-4 rounded-xl bg-gold/10 border-l-[3.5px] border-gold text-xs text-ink/80 leading-relaxed">
      <strong class="text-ink font-bold block mb-1">Parametrització en Calent i Garantia de Certificació</strong>
      Tots els límits i quotes associades als plans són dinàmics i es poden ampliar en qualsevol moment sense interrompre la custòdia digital ni alterar els segellats criptogràfics dels teus béns existents.
    </div>

    {# Modal d'Upgrade #}
    <div id="upgrade-modal" class="hidden fixed inset-0 z-50 bg-ink/65 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 transition-opacity" role="dialog" aria-modal="true" aria-labelledby="upgrade-modal-title">
      <div class="relative bg-white border-t sm:border border-gold/40 rounded-t-3xl sm:rounded-2xl shadow-2xl max-w-md w-full overflow-hidden max-h-[90vh] animate-in slide-in-from-bottom sm:zoom-in-95 duration-150">
        <div class="sm:hidden w-10 h-1 bg-steel/30 rounded-full mx-auto mt-2 -mb-1 shrink-0"></div>
        <div class="h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>
        <div class="p-6">
