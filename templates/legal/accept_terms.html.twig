{% extends 'base.html.twig' %}

{% block title %}Acceptació de Clàusules de Custòdia i Certificació — Registrals{% endblock %}
{% block meta_description %}Revisió i consentiment exprés de les clàusules de custòdia de proves digitals, immutabilitat i segellat legal eIDAS per accedir a Registrals.{% endblock %}

{% block body_class %}bg-cream-50 text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream-50">

  {# Barra Superior Institucional Neta #}
  <header class="border-b border-steel/20 bg-white sticky top-0 z-50 shadow-xs">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
      <div class="flex items-center gap-2.5 sm:gap-3.5">
        <img src="{{ asset('img/logos/Isotip/1-transparent.svg') }}" alt="Isotip Registrals" class="w-8 h-8 sm:w-10 sm:h-10" />
        <span class="font-marcellus tracking-widest uppercase text-lg sm:text-2xl text-ink font-medium">Registrals</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-gold/15 text-ink border border-gold/40">
          <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Marc Jurídic eIDAS
        </span>
      </div>
    </div>
  </header>

  {# Contingut Central: Caixa Solemne Institucional #}
  <main class="w-full max-w-4xl mx-auto py-8 sm:py-12 px-4 sm:px-6 lg:px-8 space-y-6">

    {# Capçalera Solemne Institucional #}
    <div class="text-center space-y-2">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-ink text-gold border border-gold/40 shadow-sm mb-1">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 004 11a8.003 8.003 0 002.343 5.657"/></svg>
      </div>
      <h1 class="text-2xl sm:text-3xl font-marcellus text-ink tracking-wide font-normal">
        Clàusules de Custòdia i Certificació Digital
      </h1>
      <p class="text-xs sm:text-sm text-steel max-w-xl mx-auto">
        Hola, <strong class="text-ink">{{ user.firstName }} {{ user.lastName }}</strong>. Per garantir la màxima validesa jurídica i eficàcia probatòria dels teus certificats, cal que revisis i acceptis les condicions de custòdia de la plataforma (versió <span class="font-mono text-gold font-bold">{{ termsVersion }}</span>).
      </p>
    </div>

    {# Targeta Principal de Clàusules #}
    <div class="bg-white border border-steel/20 rounded-2xl shadow-sm p-6 sm:p-8 space-y-6">

      {# Advertiment Canònic (Guia d'Estils) #}
      <div class="border-l-[3.5px] border-gold bg-gold/10 p-4 rounded-r-xl text-xs sm:text-sm text-ink/85 leading-relaxed">
        <strong class="font-bold text-ink">Compromís de Seguretat Jurídica:</strong>
        Registrals no és un simple inventari al núvol, sinó una plataforma de <code>custòdia de proves i certificació digital de propietat</code>. Els certificats oficials emesos gaudeixen de presumpció d'exactitud i data certa davant tribunals, pèrits i companyies asseguradores sota el Reglament UE 910/2014 (eIDAS).
      </div>

      {# Les 4 Clàusules Fonamentals #}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">

        {# Clàusula 1 #}
        <div class="bg-cream-50/70 border border-steel/15 rounded-xl p-4 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-ink text-gold flex items-center justify-center text-xs font-mono font-bold shrink-0">1</span>
              <h2 class="font-marcellus text-sm font-semibold text-ink">Immutabilitat i Hash SHA-256</h2>
            </div>
            <p class="text-xs text-ink/75 leading-relaxed">
              El fingerprint del bé és un hash determinista calculat sobre les seves especificacions i fotografies. <strong>Qualsevol modificació posterior canvia el hash</strong>, crea una nova versió a l'històric d'auditoria i requereix un nou ancoratge criptogràfic.
            </p>
          </div>
        </div>

        {# Clàusula 2 #}
        <div class="bg-cream-50/70 border border-steel/15 rounded-xl p-4 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-ink text-gold flex items-center justify-center text-xs font-mono font-bold shrink-0">2</span>
              <h2 class="font-marcellus text-sm font-semibold text-ink">Custòdia Aïllada (Flysystem)</h2>
            </div>
            <p class="text-xs text-ink/75 leading-relaxed">
              Les fotografies, factures i tiquets es guarden fora de l'arrel web sota custòdia privada i <strong>mai són públics</strong>. Únicament el titular i els receptors autoritzats tenen permís de descàrrega mitjançant enllaços protegits per credencial.
            </p>
          </div>
        </div>

        {# Clàusula 3 #}
        <div class="bg-cream-50/70 border border-steel/15 rounded-xl p-4 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-ink text-gold flex items-center justify-center text-xs font-mono font-bold shrink-0">3</span>
              <h2 class="font-marcellus text-sm font-semibold text-ink">Ancoratge Criptogràfic (Polygon L2) &amp; eIDV (Namirial)</h2>
            </div>
            <p class="text-xs text-ink/75 leading-relaxed">
              La data certa del document queda enregistrada a la blockchain descentralitzada <strong>Polygon PoS Layer 2</strong>. La identitat del titular es valida mitjançant inspecció oficial de document i biometria (<em>Namirial OnBoarding</em>) sota el Reglament europeu eIDAS (UE 910/2014). Privadesa per disseny: cap dada personal viatja a la cadena.
            </p>
          </div>
        </div>

        {# Clàusula 4 #}
        <div class="bg-cream-50/70 border border-steel/15 rounded-xl p-4 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-ink text-gold flex items-center justify-center text-xs font-mono font-bold shrink-0">4</span>
              <h2 class="font-marcellus text-sm font-semibold text-ink">Assistència d'IA Sobirana Local (Art. 22 RGPD)</h2>
            </div>
            <p class="text-xs text-ink/75 leading-relaxed">
              L'assistent de visió i lectura OCR (Qwen VL / SGLang) s'executa estrictament en servidors privats locals propis. <strong>Cap dada s'envia a tercers</strong> ni s'utilitza per a re-entrenament. La validació jurídica final és sempre humana i responsabilitat del titular.
            </p>
          </div>
        </div>

      </div>

      {# Enllaços a textos legals complets #}
      <div class="border-t border-steel/15 pt-4 text-xs text-steel flex flex-wrap items-center justify-between gap-3">
        <span>Pots consultar els documents legals íntegres en qualsevol moment:</span>
        <div class="flex items-center gap-3">
          <a href="{{ path('app_legal') }}#avis-legal" target="_blank" rel="noopener noreferrer" class="text-ink hover:text-gold font-medium underline inline-flex items-center gap-1">
            Condicions Generals
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
          <span>·</span>
          <a href="{{ path('app_legal') }}#privacitat" target="_blank" rel="noopener noreferrer" class="text-ink hover:text-gold font-medium underline inline-flex items-center gap-1">
            Política de Privadesa
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
          <span>·</span>
          <a href="{{ path('app_legal_ai_sovereign') }}" target="_blank" rel="noopener noreferrer" class="text-ink hover:text-gold font-medium underline inline-flex items-center gap-1">
            IA Sobirana
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>

      {# Formulari d'Acceptació #}
      <form method="POST" action="{{ path('app_legal_accept_terms') }}" class="border-t border-steel/15 pt-6 space-y-5">
        <input type="hidden" name="_token" value="{{ csrf_token('legal_terms_accept') }}" />

        <div class="flex items-start gap-3 bg-cream/30 p-3.5 rounded-xl border border-steel/20">
          <input type="checkbox" id="chk-accept" name="confirm_checkbox" required class="mt-1 w-4 h-4 text-gold rounded border-steel/40 focus:ring-gold focus:ring-offset-0 cursor-pointer" />
          <label for="chk-accept" class="text-xs sm:text-sm text-ink leading-relaxed cursor-pointer select-none">
            He llegit atentament, comprenc i accepto expressament les <strong>Condicions Generals del Servei de Certificació Digital (versió {{ termsVersion }})</strong>, el règim de responsabilitat del titular sobre els béns declarats i la <strong>Política de Privadesa RGPD</strong> de Registrals.
          </label>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
          <a href="{{ path('app_logout') }}" class="text-xs text-steel hover:text-rose-600 transition-colors">
            No accepto ara (Tancar sessió)
          </a>

          <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-ink text-gold font-medium text-sm hover:bg-ink-light transition-all shadow-sm cursor-pointer border border-gold/40">
            <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Acceptar i Continuar a l'Àrea Privada
          </button>
        </div>
      </form>

    </div>

  </main>

  {# Peu de pàgina discret #}
  <footer class="py-4 text-center text-xs text-steel border-t border-steel/15 bg-white">
    Registrals © {{ 'now'|date('Y') }} · Vora Studio · Tots els drets reservats.
  </footer>

</div>
{% endblock %}
