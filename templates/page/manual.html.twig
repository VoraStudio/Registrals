<script>
  function filterManualSection(topic, evt) {
    const cards = document.querySelectorAll('.manual-card');
    const buttons = document.querySelectorAll('.manual-tab-btn');
    const grid = document.getElementById('manual-grid');

    buttons.forEach(btn => {
      btn.classList.remove('bg-ink', 'text-cream', 'border-ink');
      btn.classList.add('bg-white', 'text-ink/80', 'border-steel/30');
    });

    const targetBtn = evt ? evt.currentTarget : null;
    if (targetBtn) {
      targetBtn.classList.remove('bg-white', 'text-ink/80', 'border-steel/30');
      targetBtn.classList.add('bg-ink', 'text-cream', 'border-ink');
    }

    cards.forEach(card => {
      card.style.display = (topic === 'all' || card.dataset.topic === topic) ? 'flex' : 'none';
    });

    if (grid) {
      if (topic === 'all') {
        grid.classList.add('lg:grid-cols-2');
      } else {
        grid.classList.remove('lg:grid-cols-2');
      }
    }
  }

  function updateManualChecklist() {
    const checks = document.querySelectorAll('.manual-check');
    const checked = document.querySelectorAll('.manual-check:checked');
    const counter = document.getElementById('manual-checklist-counter');
    if (counter) {
      counter.textContent = `${checked.length} / ${checks.length}`;
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    updateManualChecklist();
    const hash = window.location.hash.replace('#', '');
    if (['fotos', 'factures', 'certificats', 'traspassos', 'herencia'].includes(hash)) {
      const btn = document.querySelector(`.manual-tab-btn[onclick*="'${hash}'"]`);
      if (btn) btn.click();
    }
  });
</script>
{% endblock %}
