        {# Lluentor daurada superior #}
        <div class="h-1 bg-gradient-to-r from-transparent via-gold to-transparent w-full"></div>
        
        {# Capçalera del Modal #}
        <div class="px-5 py-3.5 border-b border-steel/15 flex items-center justify-between bg-cream/30">
          <div class="flex items-center gap-2">
            <span class="text-gold font-serif">📜</span>
            <h3 id="comic-modal-title" class="font-marcellus text-base sm:text-lg text-ink font-bold"></h3>
          </div>
          <button type="button" onclick="closeComicModal()" class="w-8 h-8 rounded-lg border border-steel/20 text-steel hover:text-ink hover:bg-cream flex items-center justify-center transition-all text-sm font-bold" aria-label="Tancar">
            ✕
          </button>
        </div>

        {# Contingut: Imatge del Còmic a Alta Resolució #}
        <div class="p-3 sm:p-4 overflow-y-auto flex items-center justify-center bg-cream/10 flex-1">
          <img id="comic-modal-img" src="" alt="Còmic a pantalla completa" class="max-h-[75vh] w-auto max-w-full rounded-xl shadow-md border border-steel/20 object-contain">
        </div>

        {# Peu del Modal #}
        <div class="px-5 py-3 border-t border-steel/15 flex items-center justify-between bg-white text-xs text-steel">
          <span>Toca <kbd class="px-1.5 py-0.5 rounded bg-cream border border-steel/20 font-mono text-[10px]">ESC</kbd> o l'exterior per tancar</span>
          <button type="button" onclick="closeComicModal()" class="px-4 py-1.5 rounded-lg bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-raleway font-bold text-xs transition-all">
            Tancar
          </button>
        </div>
      </div>
    </div>

    {# Script per al Modal Notarial del Còmic #}
    <script>
      function openComicModal(src, title) {
        var modal = document.getElementById('comic-modal');
        var img = document.getElementById('comic-modal-img');
        var titleElem = document.getElementById('comic-modal-title');
        if (modal && img && titleElem) {
          img.src = src;
          titleElem.textContent = title;
          modal.classList.remove('hidden');
          document.body.classList.add('overflow-hidden');
        }
      }

      function closeComicModal() {
        var modal = document.getElementById('comic-modal');
        if (modal) {
          modal.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        }
      }

      // Tancar amb tecla ESC o clic exterior
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeComicModal();
        }
      });

      document.getElementById('comic-modal')?.addEventListener('click', function(e) {
        if (e.target === this) {
          closeComicModal();
        }
      });
    </script>

