    {# Modal Notarial per a Ampliar el Còmic #}
    <div id="comic-modal" class="hidden fixed inset-0 z-50 bg-ink/75 backdrop-blur-xs flex items-center justify-center p-3 sm:p-6 transition-opacity" role="dialog" aria-modal="true">
