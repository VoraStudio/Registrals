                    <td class="py-3 px-3">Permanent (fins a l'esborrament manual de dades)</td>
                  </tr>
                  <tr>
                    <td class="py-3 px-3 font-mono text-xs font-semibold text-ink"><code>__stripe_mid</code></td>
