<!-- === S8 · FAQ === -->
<section
  id="s8"
  aria-labelledby="s8-title"
  class="relative z-10 -mt-8 overflow-hidden rounded-t-[2rem] border-t border-cream/10 bg-ink px-4 py-16 md:py-24"
>
  <img
    data-reveal="icon"
    src="{{ asset('img/logos/Isotip/3-transparent.svg') }}"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-0 bottom-0 -z-10 w-64 translate-y-[7.5%] opacity-10 select-none md:right-16 md:w-[28rem]"
  />
  <div class="mx-auto max-w-4xl">
    <div class="flex flex-col gap-4 md:flex-row md:gap-24">
      <h2 id="s8-title" class="font-marcellus text-5xl text-cream md:text-6xl">FAQ</h2>
      <p data-reveal="description" class="max-w-lg text-xl text-cream/85">
        Si no has trobat la resposta que buscaves, el nostre equip estarà encantat
        <a href="#contacte" class="rounded-full bg-gold px-2 text-ink hover:bg-gold/90">d'ajudar-te.</a>
      </p>
    </div>
    <div class="relative mt-12 md:ml-36">
      <div
        id="faq-scroll-container"
        class="max-h-[30rem] overflow-y-auto md:overflow-hidden pr-2 md:pr-0 [scrollbar-color:rgba(202,163,108,0.55)_transparent] [scrollbar-width:thin]"
      >
        <div id="faq-scroll-track" class="space-y-3.5 will-change-transform">
        {% for faq in faqs|default([]) %}
          <details data-reveal="card" name="faq" class="group rounded-2xl border border-cream/10 bg-steel/40 px-6 py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-cream">
              <span>{{ faq.question }}</span>
              <span
                class="grid size-8 shrink-0 place-items-center rounded-full bg-cream text-ink transition group-open:rotate-180"
                aria-hidden="true"
              >
                <svg
                  class="size-4"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m4 6 4 4 4-4" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 space-y-2.5 text-sm leading-relaxed text-cream/85">
              {% for block in faq.answer|split('\n\n') %}
                {% if '• ' in block %}
                  {% set lines = block|split('\n') %}
                  {% set listItems = [] %}
                  {% for line in lines %}
                    {% set trimmed = line|trim %}
                    {% if trimmed starts with '• ' %}
                      {% set listItems = listItems|merge([trimmed|slice(2)]) %}
                    {% elseif trimmed is not empty %}
                      <p>{{ trimmed }}</p>
                    {% endif %}
                  {% endfor %}
                  {% if listItems is not empty %}
                    <ul class="list-disc space-y-1.5 pl-5 marker:text-gold">
                      {% for item in listItems %}
                        {% if ':' in item %}
                          {% set parts = item|split(':', 2) %}
                          <li><strong class="font-semibold text-cream">{{ parts[0] }}:</strong>{{ parts[1] }}</li>
                        {% else %}
                          <li>{{ item }}</li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  {% endif %}
                {% else %}
                  <p>{{ block }}</p>
                {% endif %}
              {% endfor %}
            </div>
          </details>
        {% endfor %}
        </div>
      </div>
      <div
        id="faq-scroll-fade"
        aria-hidden="true"
        class="pointer-events-none absolute right-2 bottom-6 left-0 h-16 bg-gradient-to-t from-ink via-ink/75 to-transparent transition-opacity duration-300"
      ></div>
      {% if faqs|default([])|length > 6 %}
        <p id="faq-scroll-hint" class="mt-3 text-right font-mono text-[11px] text-gold/80 transition-opacity duration-300">
          {{ faqs|length }} preguntes · Fes scroll per veure-les totes ↓
        </p>
      {% endif %}
    </div>
  </div>
</section>
