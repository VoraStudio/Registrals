<!-- === CONTACTE (brand.pdf) === -->
<section id="contacte" aria-labelledby="contacte-title" class="relative z-10 -mt-8 scroll-mt-24 rounded-t-[2rem] bg-cream px-4 py-16 md:py-24">
  <div class="mx-auto max-w-6xl">
    <h2 id="contacte-title" class="font-marcellus text-4xl md:text-5xl md:whitespace-nowrap">Confiança que es pot demostrar</h2>
    <div class="mt-8 grid grid-cols-1 gap-10 md:grid-cols-2">
      <div>
        <p data-reveal="description" class="max-w-md text-lg text-ink/90">
          Cada registre genera una prova criptogràfica única que permet verificar la propietat de forma instantània davant asseguradores,
          compradors o autoritats.
        </p>
        <ul class="mt-8 space-y-4">
          <li data-reveal="field" class="flex items-center gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-ink text-cream" aria-hidden="true">
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"
                />
              </svg>
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-bold">Telèfon</span>
              <span class="text-ink/90">[Telèfon]</span>
            </span>
          </li>
          <li data-reveal="field" class="flex items-center gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-ink text-cream" aria-hidden="true">
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-10 6L2 7" />
              </svg>
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-bold">Correu electrònic</span>
              <a
                href="mailto:info@registrals.com"
                class="text-ink/90 underline decoration-gold decoration-2 underline-offset-4 hover:text-steel"
                >info@registrals.com</a
              >
            </span>
          </li>
          <li data-reveal="field" class="flex items-center gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-ink text-cream" aria-hidden="true">
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-bold">Adreça</span>
              <span class="text-ink/90">[Adreça postal]</span>
            </span>
          </li>
        </ul>
      </div>
      <form action="#" method="post" class="grid grid-cols-1 content-start gap-4 sm:grid-cols-2">
        <div data-reveal="field" class="flex flex-col gap-1.5">
          <label for="contact-name" class="sr-only">Nom</label>
          <input
            id="contact-name"
            type="text"
            name="name"
            autocomplete="name"
            required
            placeholder="Nom"
            class="peer rounded-lg border border-ink/20 bg-cream/30 px-4 py-3 text-ink placeholder:text-ink/70 user-invalid:border-red-700"
          />
          <p class="hidden text-sm text-red-700 peer-user-invalid:block">Introdueix el teu nom.</p>
        </div>
        <div data-reveal="field" class="flex flex-col gap-1.5">
          <label for="contact-email" class="sr-only">Correu electrònic</label>
          <input
            id="contact-email"
            type="email"
            name="email"
            autocomplete="email"
            required
            placeholder="Correu electrònic"
            class="peer rounded-lg border border-ink/20 bg-cream/30 px-4 py-3 text-ink placeholder:text-ink/70 user-invalid:border-red-700"
          />
          <p class="hidden text-sm text-red-700 peer-user-invalid:block">Introdueix un correu electrònic vàlid.</p>
        </div>
        <div data-reveal="field" class="flex flex-col gap-1.5 sm:col-span-2">
          <label for="contact-subject" class="sr-only">Assumpte</label>
          <input
            id="contact-subject"
            type="text"
            name="subject"
            autocomplete="off"
            required
            placeholder="Assumpte"
            class="peer rounded-lg border border-ink/20 bg-cream/30 px-4 py-3 text-ink placeholder:text-ink/70 user-invalid:border-red-700"
          />
          <p class="hidden text-sm text-red-700 peer-user-invalid:block">Indica l'assumpte del missatge.</p>
        </div>
        <div data-reveal="field" class="flex flex-col gap-1.5 sm:col-span-2">
          <label for="contact-message" class="sr-only">Missatge</label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            required
            placeholder="Escriu aquí el teu missatge"
            class="peer resize-y rounded-lg border border-ink/20 bg-cream/30 px-4 py-3 text-ink placeholder:text-ink/70 user-invalid:border-red-700"
          ></textarea>
          <p class="hidden text-sm text-red-700 peer-user-invalid:block">Escriu el teu missatge.</p>
        </div>
        <div data-reveal="field" class="flex flex-col gap-1.5 sm:col-span-2">
          <div class="relative flex flex-wrap items-start gap-x-3 gap-y-1">
            <input
              id="contact-privacy"
              type="checkbox"
              name="privacy"
              required
              aria-describedby="contact-privacy-error"
              class="peer mt-1 size-5 shrink-0 accent-ink user-invalid:outline-2 user-invalid:outline-red-700"
            />
            <label for="contact-privacy" class="text-sm text-ink/90">
              He llegit i accepto la
              <a href="{{ path('app_legal') }}#privacitat" class="font-semibold underline decoration-gold decoration-2 underline-offset-4 hover:text-steel"
                >política de privacitat</a
              >.
            </label>
            <p id="contact-privacy-error" class="sr-only w-full pl-8 text-sm text-red-700 peer-user-invalid:not-sr-only">
              Cal que acceptis la política de privacitat.
            </p>
          </div>
        </div>
        <button
          data-reveal="field"
          type="submit"
          class="rounded-full bg-ink px-15 py-2 md:py-1 font-medium text-cream transition-[background-color,scale] hover:bg-ink/90 active:scale-[0.98] sm:col-span-2 md:justify-self-start pointer-events-auto"
        >
          ENVIA
        </button>
      </form>
    </div>
  </div>
</section>
