{% extends 'base.html.twig' %}

{% block title %}Campanyes &amp; Publicitat — Registrals{% endblock %}
{% block meta_description %}Presentacions visuals i campanyes actives de Registrals, la plataforma de custòdia i certificació digital de béns mobles.{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {% include 'partials/_public_subpage_header.html.twig' %}

  <main class="w-full flex-1">
    <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-4">
      {% if campaigns is empty %}
        <div class="rounded-3xl border border-gold/30 bg-white p-10 text-center shadow-sm">
          <p class="font-marcellus text-2xl text-ink">No hi ha cap campanya activa en aquest moment</p>
          <p class="text-sm text-steel mt-2">Torna aviat per descobrir les noves presentacions de Registrals.</p>
        </div>
      {% else %}
        <div id="rr-stage" class="relative rounded-3xl overflow-hidden bg-ink border border-gold/30 shadow-2xl group">
          {# Barra de progrés superior #}
          {% if campaigns|length > 1 %}
            <div class="h-1 bg-white/10 w-full relative z-20">
              <div id="rr-progress" class="h-full bg-gold transition-none" style="width: 0%;"></div>
            </div>
          {% endif %}

          <div id="rr-track" class="flex transition-transform duration-500 ease-out items-center">
            {% for ad in campaigns %}
              <article class="rr-slide w-full shrink-0" data-duration="{{ ad.durationSeconds }}">
                {% if ad.mediaType == 'video' %}
                  <video src="{{ asset(ad.mediaPath) }}" muted {{ campaigns|length == 1 ? 'loop autoplay' : '' }} playsinline preload="auto" class="w-full max-h-[78vh] object-contain mx-auto block bg-ink"></video>
                {% else %}
                  <img src="{{ asset(ad.mediaPath) }}" alt="{{ ad.title }}" class="w-full max-h-[78vh] object-contain mx-auto block bg-ink">
                {% endif %}
              </article>
            {% endfor %}
          </div>

          {% if campaigns|length > 1 %}
            <button type="button" id="rr-prev" aria-label="Anterior"
                    class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-ink/75 hover:bg-ink text-gold border border-gold/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer shadow-lg">
              ‹
            </button>
            <button type="button" id="rr-next" aria-label="Següent"
                    class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-ink/75 hover:bg-ink text-gold border border-gold/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer shadow-lg">
              ›
            </button>
          {% endif %}
        </div>

        {% if campaigns|length > 1 %}
          <div class="flex items-center justify-center gap-2 pt-1">
            {% for ad in campaigns %}
              <button type="button" data-rr-dot="{{ loop.index0 }}" aria-label="Anar a la campanya {{ loop.index }}"
                      class="rr-dot h-2.5 rounded-full transition-all cursor-pointer {{ loop.first ? 'w-8 bg-ink' : 'w-2.5 bg-ink/25 hover:bg-ink/50' }}"></button>
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}
    </section>
  </main>

  {% include 'page/home/_footer.html.twig' %}

</div>

{% if campaigns|length > 1 %}
<script>
  (() => {
    const stage = document.getElementById('rr-stage');
    const track = document.getElementById('rr-track');
    const slides = Array.from(document.querySelectorAll('.rr-slide'));
    const dots = Array.from(document.querySelectorAll('.rr-dot'));
    const counter = document.getElementById('rr-counter');
    const progress = document.getElementById('rr-progress');
    if (!track || slides.length < 2) return;

    let current = 0;
    let paused = false;
    let elapsed = 0;
    let lastTick = performance.now();

    function syncSlideMedia() {
      slides.forEach((slide, i) => {
        const video = slide.querySelector('video');
        if (!video) return;
        if (i === current) {
          video.currentTime = 0;
          if (!paused) video.play().catch(() => {});
        } else {
          video.pause();
          video.currentTime = 0;
        }
      });
    }

    function goTo(index) {
      current = (index + slides.length) % slides.length;
      track.style.transform = `translateX(-${current * 100}%)`;
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
      dots.forEach((d, i) => {
        d.classList.toggle('w-8', i === current);
        d.classList.toggle('bg-ink', i === current);
        d.classList.toggle('w-2.5', i !== current);
        d.classList.toggle('bg-ink/25', i !== current);
      });
      elapsed = 0;
      if (progress) progress.style.width = '0%';
      syncSlideMedia();
    }

    slides.forEach((slide, i) => {
      const video = slide.querySelector('video');
      if (video) {
        video.addEventListener('ended', () => {
          if (i === current) goTo(current + 1);
        });
      }
    });

    document.getElementById('rr-prev')?.addEventListener('click', () => goTo(current - 1));
    document.getElementById('rr-next')?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((d) => d.addEventListener('click', () => goTo(Number(d.dataset.rrDot))));

    stage?.addEventListener('mouseenter', () => {
      paused = true;
      slides[current]?.querySelector('video')?.pause();
    });
    stage?.addEventListener('mouseleave', () => {
      paused = false;
      lastTick = performance.now();
      slides[current]?.querySelector('video')?.play().catch(() => {});
    });

    function tick(now) {
      const dt = now - lastTick;
      lastTick = now;
      if (!paused) {
        const activeSlide = slides[current];
        const video = activeSlide?.querySelector('video');
        if (video && Number.isFinite(video.duration) && video.duration > 0) {
          if (progress) progress.style.width = `${Math.min(100, (video.currentTime / video.duration) * 100)}%`;
        } else if (!video) {
          const durationMs = Math.max(2000, Number(activeSlide.dataset.duration || 8) * 1000);
          elapsed += dt;
          if (progress) progress.style.width = `${Math.min(100, (elapsed / durationMs) * 100)}%`;
          if (elapsed >= durationMs) {
            goTo(current + 1);
          }
        }
      }
      requestAnimationFrame(tick);
    }

    syncSlideMedia();
    requestAnimationFrame(tick);
  })();
</script>
{% endif %}
{% endblock %}

