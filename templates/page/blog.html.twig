{% extends 'base.html.twig' %}

{% block title %}Blog de Propietat Digital & Seguretat — Registrals{% endblock %}
{% block meta_description %}Articles d'actualitat, consells legals, tecnologia blockchain, eIDAS i bones pràctiques per a la custòdia i protecció del patrimoni moble.{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {# Header Institucional per a Subpàgines #}
  {% include 'partials/_public_subpage_header.html.twig' %}

  <main class="w-full flex-1">

    {# Hero Blog #}
    <section class="bg-ink text-cream py-14 sm:py-18 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-radial-at-t from-gold/15 via-transparent to-transparent pointer-events-none"></div>
      <div class="max-w-4xl mx-auto space-y-4 relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cream/10 border border-gold/30 text-gold text-xs font-mono">
          <span>✍️ Divulgació, Dret &amp; Tecnologia</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-marcellus text-cream tracking-wide leading-tight">
          El Blog de la Propietat Digital
        </h1>
        <p class="text-sm sm:text-base text-cream/80 max-w-2xl mx-auto font-raleway leading-relaxed">
          Consells pericials, novetats normatives i anàlisi tècnica sobre com custodiar i defensar el teu patrimoni moble.
        </p>

        {% if isPreview %}
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 border border-amber-400/50 text-amber-200 text-[11px] font-mono">
            <span>👁️ Mode Previsualització Actiu (inclou articles futurs)</span>
            <a href="{{ path('app_blog', {preview: 'off'}) }}" class="underline hover:text-white ml-1">Sortir</a>
          </div>
        {% endif %}
      </div>
    </section>

    {# Contingut del Blog #}
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">

      {# Barra de Controls: Filtres per Tag, Ordenació i Selector d'Idioma (Traducció IA Sobirana) #}
      <div class="flex flex-col lg:flex-row items-center justify-between gap-4 border-b border-steel/15 pb-6">

        {# Filtres / Categories dinàmiques #}
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs font-semibold">
          <a href="{{ path('app_blog', {sort: sort, lang: lang}) }}"
             class="px-3.5 py-1.5 rounded-full border transition-all {{ selectedTag == '' ? 'bg-ink-light text-gold border-gold/40 shadow-sm' : 'bg-ink/5 text-ink/75 border-steel/25 hover:bg-ink-light hover:text-cream hover:border-gold/30' }}">
            Tots els articles
          </a>
          {% for t in tags %}
            <a href="{{ path('app_blog', {tag: t, sort: sort, lang: lang}) }}"
               class="px-3.5 py-1.5 rounded-full border transition-all {{ selectedTag == t ? 'bg-ink-light text-gold border-gold/40 shadow-sm' : 'bg-ink/5 text-ink/75 border-steel/25 hover:bg-ink-light hover:text-cream hover:border-gold/30' }}">
              <span class="translatable-text" data-original="{{ t|e('html_attr') }}">{{ translations[t]|default(t) }}</span>
            </a>
          {% endfor %}
        </div>

        {# Ordenació i Selector d'Idioma #}
        <div class="flex items-center gap-3 shrink-0">
          {# Ordenació #}
          <div class="inline-flex items-center rounded-full bg-white/80 border border-steel/25 p-0.5 text-[11px] font-mono">
            <a href="{{ path('app_blog', {tag: selectedTag ?: null, sort: 'newest', lang: lang}) }}"
               class="px-3 py-1 rounded-full transition-colors {{ sort == 'newest' ? 'bg-ink text-gold font-bold' : 'text-ink/70 hover:text-ink' }}">
              Més recents
            </a>
            <a href="{{ path('app_blog', {tag: selectedTag ?: null, sort: 'oldest', lang: lang}) }}"
               class="px-3 py-1 rounded-full transition-colors {{ sort == 'oldest' ? 'bg-ink text-gold font-bold' : 'text-ink/70 hover:text-ink' }}">
              Més antics
            </a>
          </div>

          {# Selector d'Idioma amb Traducció Sobirana #}
          <div class="inline-flex items-center rounded-full bg-white/80 border border-gold/35 p-0.5 text-[11px] font-mono" id="blog-lang-switcher" title="Traducció automàtica local amb memòria cau SHA-256">
            <button type="button" onclick="switchBlogListLang('cat')" data-lang="cat"
                    class="lang-btn px-2.5 py-1 rounded-full transition-colors cursor-pointer {{ lang == 'cat' ? 'bg-ink text-gold font-bold' : 'text-ink/70 hover:text-ink' }}">
              CAT
            </button>
            <button type="button" onclick="switchBlogListLang('es')" data-lang="es"
                    class="lang-btn px-2.5 py-1 rounded-full transition-colors cursor-pointer {{ lang == 'es' ? 'bg-ink text-gold font-bold' : 'text-ink/70 hover:text-ink' }}">
              ES
            </button>
            <button type="button" onclick="switchBlogListLang('en')" data-lang="en"
                    class="lang-btn px-2.5 py-1 rounded-full transition-colors cursor-pointer {{ lang == 'en' ? 'bg-ink text-gold font-bold' : 'text-ink/70 hover:text-ink' }}">
              EN
            </button>
          </div>
        </div>

      </div>

      {% if posts is empty %}
        <div class="p-10 rounded-2xl bg-white/70 border border-steel/20 text-center space-y-2">
          <p class="font-marcellus text-lg text-ink">No s'han trobat articles per a aquest filtre.</p>
          <a href="{{ path('app_blog') }}" class="inline-block text-xs font-bold text-ink underline hover:text-gold">Veure tots els articles</a>
        </div>
      {% else %}

        {# Article Destacat en Gran Format #}
        {% if featuredPost is not null %}
          <a href="{{ path('app_blog_show', {slug: featuredPost.slug, lang: lang}) }}" class="block group">
            <article class="bg-ink-light text-cream rounded-3xl border border-gold/40 shadow-2xl p-8 sm:p-12 relative overflow-hidden transition-all group-hover:border-gold/70">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>
              <div class="absolute -right-16 -bottom-16 w-72 h-72 rounded-full bg-gold/10 blur-3xl pointer-events-none"></div>

              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
                <div class="lg:col-span-9 space-y-4">
                  <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-gold">
                    <span class="px-3 py-1 rounded-full bg-gold/20 border border-gold/30 font-bold uppercase tracking-wider text-[10px]">
                      ★ Article Destacat
                    </span>
                    <span>{{ featuredPost.formattedDate }}</span>
                    <span class="text-cream/50">&middot;</span>
                    <span class="text-cream/70">{{ featuredPost.readTime }} de lectura</span>
                  </div>

                  <h2 class="translatable-text text-2xl sm:text-3xl lg:text-4xl font-marcellus text-cream leading-tight group-hover:text-gold-light transition-colors"
                      data-original="{{ featuredPost.title|e('html_attr') }}">
                    {{ translations[featuredPost.title]|default(featuredPost.title) }}
                  </h2>

                  <p class="translatable-text text-xs sm:text-sm text-cream/80 font-raleway leading-relaxed max-w-3xl"
                     data-original="{{ featuredPost.summary|e('html_attr') }}">
                    {{ translations[featuredPost.summary]|default(featuredPost.summary) }}
                  </p>

                  <div class="pt-2 flex flex-wrap items-center gap-4 text-xs font-mono text-cream/70">
                    <span>Per {{ featuredPost.author }}</span>
                    <span class="text-gold/50">&middot;</span>
                    <span class="text-gold font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                      <span>Llegir article complet</span>
                      <span>→</span>
                    </span>
                  </div>
                </div>

                <div class="lg:col-span-3 flex flex-wrap lg:flex-col gap-2 items-start lg:items-end justify-start">
                  {% for tag in featuredPost.tags %}
                    <span class="px-3 py-1 rounded-full bg-cream/10 border border-gold/25 text-gold text-[11px] font-mono">
                      #<span class="translatable-text" data-original="{{ tag|e('html_attr') }}">{{ translations[tag]|default(tag) }}</span>
                    </span>
                  {% endfor %}
                </div>
              </div>
            </article>
          </a>
        {% endif %}

        {# Graella d'Articles #}
        {% if otherPosts is not empty %}
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {% for post in otherPosts %}
              <a href="{{ path('app_blog_show', {slug: post.slug, lang: lang}) }}" class="block group h-full">
                <article class="h-full bg-ink-light text-cream rounded-3xl border border-gold/40 shadow-xl p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden transition-all group-hover:scale-[1.01] group-hover:border-gold/70">
                  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>

                  <div class="space-y-4">
                    <div class="flex items-center justify-between gap-2 text-[11px] font-mono">
                      {% if post.tags is not empty %}
                        <span class="translatable-text px-2.5 py-1 rounded-full bg-gold/15 text-gold border border-gold/30 font-bold uppercase tracking-wider text-[10px]"
                              data-original="{{ post.tags[0]|e('html_attr') }}">
                          {{ translations[post.tags[0]]|default(post.tags[0]) }}
                        </span>
                      {% else %}
                        <span></span>
                      {% endif %}
                      <span class="text-cream/60">{{ post.formattedDate }}</span>
                    </div>

                    <h3 class="translatable-text font-marcellus text-xl text-cream leading-snug group-hover:text-gold-light transition-colors"
                        data-original="{{ post.title|e('html_attr') }}">
                      {{ translations[post.title]|default(post.title) }}
                    </h3>

                    <p class="translatable-text text-xs sm:text-sm text-cream/75 font-raleway leading-relaxed"
                       data-original="{{ post.summary|e('html_attr') }}">
                      {{ translations[post.summary]|default(post.summary) }}
                    </p>
                  </div>

                  <div class="pt-5 mt-6 border-t border-gold/20 flex items-center justify-between text-xs font-mono">
                    <span class="text-cream/60">{{ post.readTime }} de lectura</span>
                    <span class="text-gold font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                      <span>Llegir article</span>
                      <span>→</span>
                    </span>
                  </div>
                </article>
              </a>
            {% endfor %}
          </div>
        {% endif %}

      {% endif %}

      {# Caixa de Subscripció al Butlletí en Color Daurat Oficial (Gold #CAA36C) #}
      <section class="bg-gold text-ink p-8 sm:p-12 rounded-3xl border border-gold-dark/30 shadow-2xl relative overflow-hidden flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
        <div class="absolute -right-10 -bottom-10 w-60 h-60 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>

        <div class="space-y-2 relative z-10 max-w-xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-ink/10 border border-ink/20 text-ink text-xs font-mono mb-1 font-semibold">
            <span>📬 Butlletí Registrals</span>
          </div>
          <h4 class="font-marcellus text-2xl text-ink font-bold leading-tight">Rep les anàlisis i novetats legals</h4>
          <p class="text-xs sm:text-sm text-ink/85 font-raleway leading-relaxed">
            Una publicació amb novetats normatives de la UE, dret civil patrimonial i consells de custòdia documental.
          </p>
        </div>
        <div class="w-full sm:w-auto relative z-10 flex flex-col sm:flex-row gap-3">
          <input type="email" placeholder="el-teu@correu.com" class="px-4 py-3 rounded-xl bg-white/80 border border-ink/20 text-ink placeholder:text-ink/50 text-xs font-raleway focus:outline-none focus:ring-2 focus:ring-ink w-full sm:w-64">
          <button type="button" onclick="if (window.RegistralsToast) { window.RegistralsToast.show('Subscripció', 'Gràcies pel teu interès! T\'hem afit a la llista de novetats de Registrals.', 'success', 4000); }" class="px-5 py-3 rounded-xl bg-ink text-gold font-raleway font-bold text-xs uppercase tracking-wider shadow-md hover:bg-ink/90 transition-all shrink-0 border border-gold/30 cursor-pointer">
            Subscriure'm
          </button>
        </div>
      </section>

    </div>

  </main>

  {# Peu de pàgina institucional #}
  {{ include('page/home/_footer.html.twig') }}

</div>

<script>
  async function switchBlogListLang(targetLang) {
    const btns = document.querySelectorAll('#blog-lang-switcher .lang-btn');
    btns.forEach(b => {
      if (b.dataset.lang === targetLang) {
        b.className = 'lang-btn px-2.5 py-1 rounded-full transition-colors cursor-pointer bg-ink text-gold font-bold';
      } else {
        b.className = 'lang-btn px-2.5 py-1 rounded-full transition-colors cursor-pointer text-ink/70 hover:text-ink';
      }
    });

    // Actualitzar enllaços dels articles perquè obrin amb el mateix idioma
    document.querySelectorAll('a[href*="/blog/"]').forEach(link => {
      try {
        const url = new URL(link.href, window.location.origin);
        if (targetLang === 'cat') {
          url.searchParams.delete('lang');
        } else {
          url.searchParams.set('lang', targetLang);
        }
        link.href = url.pathname + url.search;
      } catch (e) {}
    });

    const elements = Array.from(document.querySelectorAll('.translatable-text'));
    if (targetLang === 'cat') {
      elements.forEach(el => {
        if (el.dataset.original) el.textContent = el.dataset.original;
      });
      return;
    }

    const items = elements.map(el => el.dataset.original).filter(Boolean);
    if (items.length === 0) return;

    elements.forEach(el => el.classList.add('opacity-60'));
    try {
      const resp = await fetch('{{ path("app_blog_translate") }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lang: targetLang, items: items })
      });
      const json = await resp.json();
      if (json.success && json.items) {
        elements.forEach(el => {
          const orig = el.dataset.original;
          if (orig && json.items[orig]) {
            el.textContent = json.items[orig];
          }
        });
      }
    } catch (err) {
      console.warn('No s\'ha pogut traduir la llista:', err);
    } finally {
      elements.forEach(el => el.classList.remove('opacity-60'));
    }
  }
</script>
{% endblock %}
