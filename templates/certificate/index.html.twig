{% extends 'base.html.twig' %}

{% block title %}Els meus Certificats Digitals — Registrals{% endblock %}

{% block body_class %}bg-cream-50 text-ink min-h-screen flex flex-col font-raleway antialiased selection:bg-gold selection:text-ink{% endblock %}

{% block body %}
  {# Capçalera Privada Unificada #}
  {% include 'partials/_private_header.html.twig' %}

  <main class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3.5 w-full flex-1 pb-20 md:pb-5">

    {# 1. Línia de Ruta Mínima #}
    <nav class="flex items-center gap-1.5 text-[11px] font-mono text-steel uppercase tracking-wider mb-2" aria-label="Ruta de navegació">
      <a href="{{ path('app_dashboard') }}" class="hover:text-gold transition-colors">Inici</a>
      <span class="text-steel/40">/</span>
      <span class="text-ink font-bold">Certificats</span>
    </nav>

    {# 2. Capçalera Solemne & Títol #}
    <div class="mb-3.5 sm:mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-2.5 sm:pb-3.5 border-b border-gold/15">
      <div>
        <h1 class="text-xl sm:text-3xl font-marcellus text-ink tracking-wide">Els meus Certificats Digitals</h1>
        <p class="text-xs sm:text-sm text-ink/75 mt-0.5 font-raleway">
          Historial de certificats de propietat amb segellat de temps legal eIDAS i esborranys informatius de custòdia.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-cream border border-gold/40 text-ink">
          <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Custòdia Immutable
        </span>
      </div>
    </div>

    {# Resum Mètric Compacte (1 sola línia d'alta densitat) #}
    <div class="bg-white rounded-xl border border-steel/20 px-4 py-2 shadow-2xs flex flex-wrap items-center justify-between gap-3 text-xs font-raleway mb-3.5 sm:mb-4">
      <div class="flex items-center gap-4 sm:gap-6 flex-wrap">
        <div class="flex items-center gap-1.5">
          <span class="text-[11px] font-bold uppercase tracking-wider text-ink/65">Total</span>
          <span class="font-marcellus text-base font-bold text-ink px-2 py-0.5 rounded-md bg-cream-50 border border-steel/20">{{ metrics.total }}</span>
        </div>
        <span class="h-3.5 w-px bg-steel/25"></span>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="text-[11px] font-bold uppercase tracking-wider text-gold">Oficials eIDAS</span>
          <span class="font-marcellus text-base font-bold text-ink px-2 py-0.5 rounded-md bg-cream-50 border border-gold/30">{{ metrics.official }}</span>
        </div>
        <span class="h-3.5 w-px bg-steel/25"></span>
        <div class="flex items-center gap-1.5">
          <span class="text-[11px] font-bold uppercase tracking-wider text-steel">Esborranys</span>
          <span class="font-marcellus text-base font-bold text-ink px-2 py-0.5 rounded-md bg-cream-50 border border-steel/20">{{ metrics.draft }}</span>
        </div>
      </div>
      <div class="hidden sm:flex items-center gap-1.5 text-[11px] text-ink/60">
        <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
        <span>Doble certificació eIDAS & Blockchain</span>
      </div>
    </div>

    {# Barra de Filtres & Cerca Notarial (Condensada a Mòbil amb Acordió) #}
    {% set hasActiveFilters = (currentMode != 'all' or currentStatus != 'all') %}
    <div class="bg-white rounded-2xl border border-steel/20 p-3 sm:p-4 shadow-xs mb-4 sm:mb-5">
      <form method="get" action="{{ path('app_certificates_index') }}" class="text-xs font-raleway">
        
        <div class="flex flex-col sm:grid sm:grid-cols-12 gap-2.5 sm:gap-3 sm:items-end">
          
          {# Cerca per text #}
          <div class="sm:col-span-5">
            <label for="q" class="block text-[11px] font-bold uppercase tracking-wider text-ink/70 mb-1">Cerca de Certificat</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-steel">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              </div>
              <input type="text" name="q" id="q" value="{{ currentSearch }}" placeholder="Nº certificat (CERT-...), CUI o nom del bé..." class="w-full pl-9 pr-3 py-2 rounded-xl border border-steel/30 text-ink text-xs focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold bg-cream-50/30">
            </div>
          </div>

          {# Botó Toggle Filtres Avançats en Mòbil (< sm) #}
          <div class="flex items-center gap-2 sm:hidden">
            <button type="button" onclick="toggleMobileCertFilters()" class="flex-1 py-2 px-3 rounded-xl bg-cream/60 hover:bg-cream border border-steel/25 text-ink text-xs font-semibold flex items-center justify-between transition-colors min-h-[40px]">
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
                <span>Filtres avançats</span>
                {% set activeCount = (currentMode != 'all' ? 1 : 0) + (currentStatus != 'all' ? 1 : 0) %}
                {% if activeCount > 0 %}
                  <span class="w-4 h-4 rounded-full bg-ink text-gold font-mono text-[10px] font-bold flex items-center justify-center">{{ activeCount }}</span>
                {% endif %}
              </span>
              <svg id="cert-filters-arrow" class="w-3.5 h-3.5 text-steel transition-transform {{ hasActiveFilters ? 'rotate-180' : '' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <button type="submit" class="py-2 px-4 rounded-xl bg-ink text-gold font-bold text-xs border border-gold/40 shadow-xs flex items-center gap-1.5 min-h-[40px]">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <span>Buscar</span>
            </button>
            {% if currentSearch or hasActiveFilters %}
              <a href="{{ path('app_certificates_index') }}" class="p-2 rounded-xl bg-cream text-ink text-xs border border-steel/20 flex items-center justify-center min-h-[40px] min-w-[40px]" title="Netejar filtres">
                ✕
              </a>
            {% endif %}
          </div>

          {# Filtres Secundaris: Col·lapsables a Mòbil (< sm), en línia a Desktop (>= sm) #}
          <div id="cert-advanced-filters" class="{{ hasActiveFilters ? '' : 'hidden' }} sm:!grid sm:col-span-7 sm:grid-cols-7 gap-2.5 sm:gap-3 items-end pt-2 sm:pt-0 border-t border-steel/15 sm:border-0 mt-1 sm:mt-0">
            {# Filtre per Tipus #}
            <div class="sm:col-span-3">
              <label for="mode" class="block text-[11px] font-bold uppercase tracking-wider text-ink/70 mb-1">Tipus</label>
              <select name="mode" id="mode" class="w-full px-3 py-2 rounded-xl border border-steel/30 text-ink text-xs focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold bg-cream-50/30 cursor-pointer">
                <option value="all" {{ currentMode == 'all' ? 'selected' : '' }}>Tots els tipus</option>
                <option value="official" {{ currentMode == 'official' ? 'selected' : '' }}>Certificat Oficial (eIDAS)</option>
                <option value="draft" {{ currentMode == 'draft' ? 'selected' : '' }}>Esborrany Informatiu</option>
              </select>
            </div>

            {# Filtre per Estat #}
            <div class="sm:col-span-2">
              <label for="status" class="block text-[11px] font-bold uppercase tracking-wider text-ink/70 mb-1">Estat</label>
              <select name="status" id="status" class="w-full px-3 py-2 rounded-xl border border-steel/30 text-ink text-xs focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold bg-cream-50/30 cursor-pointer">
                <option value="all" {{ currentStatus == 'all' ? 'selected' : '' }}>Tots els estats</option>
                <option value="valid" {{ currentStatus == 'valid' ? 'selected' : '' }}>Vigents</option>
                <option value="superseded" {{ currentStatus == 'superseded' ? 'selected' : '' }}>Superats (v2)</option>
                <option value="revoked" {{ currentStatus == 'revoked' ? 'selected' : '' }}>Revocats</option>
              </select>
            </div>

            {# Botó d'acció Escriptori (>= sm) #}
            <div class="hidden sm:flex sm:col-span-2 items-center gap-2">
              <button type="submit" class="w-full py-2 px-4 rounded-xl bg-ink hover:bg-ink/90 text-gold font-bold text-xs border border-gold/40 shadow-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                <span>Filtrar</span>
              </button>
              {% if currentSearch or hasActiveFilters %}
                <a href="{{ path('app_certificates_index') }}" class="p-2 rounded-xl bg-cream hover:bg-cream/80 text-ink text-xs font-semibold border border-steel/20 flex items-center justify-center" title="Netejar filtres">
                  ✕
                </a>
              {% endif %}
            </div>

            {# Botó Aplicar en Mòbil dins el desplegable #}
            <div class="sm:hidden pt-2">
              <button type="submit" class="w-full py-2 px-4 rounded-xl bg-ink text-gold font-bold text-xs border border-gold/40 shadow-xs flex items-center justify-center gap-1.5 min-h-[40px]">
                Aplicar Filtres Avançats
              </button>
            </div>
          </div>

        </div>

      </form>
    </div>

    {# Galeria / Llistat de Certificats #}
    {% if certificates is empty %}
      <div class="bg-white rounded-2xl border border-steel/20 p-8 sm:p-12 text-center shadow-xs">
        <div class="w-16 h-16 rounded-2xl bg-cream text-gold flex items-center justify-center mx-auto mb-4 border border-gold/30">
          <svg class="w-8 h-8 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <h2 class="font-marcellus text-xl text-ink font-bold mb-2">Sense certificats registrats</h2>
        <p class="text-xs sm:text-sm text-ink/70 font-raleway max-w-md mx-auto mb-6 leading-relaxed">
          {% if currentSearch or currentMode != 'all' or currentStatus != 'all' %}
            No s'ha trobat cap certificat que coincideixi amb els filtres aplicats.
          {% else %}
            Encara no has emès cap certificat de propietat. Pots emetre esborranys o certificats oficials eIDAS des de la fitxa de qualsevol bé del teu patrimoni.
          {% endif %}
        </p>

        {% if currentSearch or currentMode != 'all' or currentStatus != 'all' %}
          <a href="{{ path('app_certificates_index') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-cream text-ink text-xs font-semibold border border-steel/20 hover:bg-cream/80 transition-colors">
            <span>Restablir filtres</span>
          </a>
        {% else %}
          <a href="{{ path('app_dashboard') }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-ink text-gold border border-gold/40 text-xs font-bold shadow-xs hover:bg-ink/90 transition-colors">
            <span>Explorar El meu Patrimoni</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        {% endif %}
      </div>
    {% else %}
      <div class="grid grid-cols-3 sm:flex sm:flex-wrap justify-center sm:justify-start gap-2 sm:gap-6 lg:gap-8 justify-items-center">
        {% for cert in certificates %}
          {% include 'certificate/_certificate_tile.html.twig' with { cert: cert, qr: qrCodes[cert.id] ?? null } only %}
        {% endfor %}
      </div>
    {% endif %}

  </main>

  {# Barra Inferior Dinàmica PWA per a Mòbil (< md) #}
  {% include 'partials/_pwa_bottom_nav.html.twig' with { active_tab: 'certificates' } %}

  <script>
    function toggleMobileCertFilters() {
      const filters = document.getElementById('cert-advanced-filters');
      const arrow = document.getElementById('cert-filters-arrow');
      if (!filters) return;
      filters.classList.toggle('hidden');
      if (arrow) arrow.classList.toggle('rotate-180');
    }
  </script>

{% endblock %}
