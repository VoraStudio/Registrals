{# Targeta canònica unificada per a estats buits de l'àrea privada #}
<div class="bg-whitef border-2 border-gold/40 rounded-3xl p-8 sm:p-11 text-center max-w-2xl mx-auto my-5 sm:my-7 shadow-lg relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-transparent via-gold to-transparent opacity-90"></div>

  <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-cream/60 border border-gold/50 text-gold mx-auto flex items-center justify-center mb-5 shadow-xs">
    {% if icon|default('cube') == 'document' %}
      <svg class="w-8 h-8 sm:w-9 sm:h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
    {% elseif icon|default('cube') == 'search' %}
      <svg class="w-8 h-8 sm:w-9 sm:h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    {% else %}
      <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
    {% endif %}
  </div>

  <h2 class="text-2xl sm:text-3xl font-marcellus text-ink">{{ title }}</h2>
  <p class="text-sm text-ink/75 mt-2.5 max-w-md mx-auto font-raleway leading-relaxed">
    {{ description }}
  </p>

  {% if cta_url|default(null) and cta_label|default(null) %}
    <div class="mt-6 sm:mt-7">
      <a href="{{ cta_url }}" style="background-color: #1D2F4B; color: #FAF6F0;" class="py-3.5 px-7 rounded-xl shadow-lg hover:bg-ink/90 active:scale-[0.99] transition-all inline-flex items-center gap-2.5 text-sm uppercase tracking-wider font-raleway font-semibold">
        {% if cta_icon|default('arrow') == 'plus' %}
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        {% elseif cta_icon|default('arrow') == 'reset' %}
          <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        {% else %}
          <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7"/></svg>
        {% endif %}
        <span>{{ cta_label }}</span>
      </a>
    </div>
  {% endif %}
</div>

