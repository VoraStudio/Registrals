<script>
  document.addEventListener('click', function(event) {
    const toggleBtn = event.target.closest('[data-password-toggle]');
    if (!toggleBtn) return;

    const targetId = toggleBtn.dataset.passwordToggle;
    const input = targetId ? document.getElementById(targetId) : null;
    if (!input) return;

    const show = input.type === 'password';
    input.type = show ? 'text' : 'password';

    const eyeOpen = toggleBtn.querySelector('[data-eye-open]');
    const eyeClosed = toggleBtn.querySelector('[data-eye-closed]');
    if (eyeOpen) eyeOpen.classList.toggle('hidden', show);
    if (eyeClosed) eyeClosed.classList.toggle('hidden', !show);

    toggleBtn.setAttribute('aria-pressed', show ? 'true' : 'false');
    toggleBtn.setAttribute('aria-label', show ? 'Ocultar contrasenya' : 'Mostrar contrasenya');
  });
</script>

