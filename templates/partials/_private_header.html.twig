<script>
  function toggleUserMenu() {
    if (window.innerWidth < 768) {
      const bottomSheet = document.getElementById('user-menu-bottom-sheet');
      if (!bottomSheet) return;
      const isHidden = bottomSheet.classList.contains('hidden');
      if (isHidden) {
        bottomSheet.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      } else {
        bottomSheet.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }
      return;
    }

    const dropdown = document.getElementById('user-menu-dropdown');
    const button = document.getElementById('user-menu-button');
    if (!dropdown || !button) return;

    const isHidden = dropdown.classList.contains('hidden');
    if (isHidden) {
      dropdown.classList.remove('hidden');
      button.setAttribute('aria-expanded', 'true');
    } else {
      dropdown.classList.add('hidden');
      button.setAttribute('aria-expanded', 'false');
    }
  }

  function closeUserMenuMobile() {
    const bottomSheet = document.getElementById('user-menu-bottom-sheet');
    if (bottomSheet) {
      bottomSheet.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }
  }

  // Tancar el desplegable d'escriptori en fer clic fora
  document.addEventListener('click', function(event) {
    const container = document.getElementById('user-menu-container');
    const dropdown = document.getElementById('user-menu-dropdown');
    const button = document.getElementById('user-menu-button');
    if (!container || !dropdown || !button) return;

    if (!container.contains(event.target)) {
      dropdown.classList.add('hidden');
      button.setAttribute('aria-expanded', 'false');
    }
  });

  // Tancar Bottom Sheet mòbil amb ESC o clic al backdrop
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeUserMenuMobile();
  });
  document.addEventListener('DOMContentLoaded', function() {
    const mobileSheet = document.getElementById('user-menu-bottom-sheet');
    if (mobileSheet) {
      mobileSheet.addEventListener('click', function(e) {
        if (e.target === mobileSheet) {
          closeUserMenuMobile();
        }
      });
    }
  });
</script>
