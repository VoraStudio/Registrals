{% extends 'base.html.twig' %}

{% block title %}Nova Contrasenya — Registrals{% endblock %}
{% block meta_description %}Defineix una nova contrasenya segura per accedir al teu compte de Registrals.{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {# Barra Superior Unificada #}
  <header class="border-b border-steel/20 bg-white sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
      <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 sm:gap-3.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded-xl p-1" aria-label="Tornar a la pàgina d'inici">
        <img src="{{ asset('img/logos/Isotip/1-transparent.svg') }}" alt="Isotip Registrals" class="w-8 h-8 sm:w-10 sm:h-10 transition-transform duration-300 group-hover:scale-105" />
        <span class="font-marcellus tracking-widest uppercase text-lg sm:text-2xl text-ink font-medium group-hover:text-gold transition-colors">Registrals</span>
      </a>
      <a href="{{ path('app_login') }}" class="text-xs sm:text-sm text-ink/75 hover:text-ink transition-colors flex items-center gap-1 sm:gap-1.5 font-semibold shrink-0">
        <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>Tornar a Iniciar Sessió</span>
      </a>
    </div>
  </header>

  <main class="w-full max-w-md mx-auto my-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="bg-ink border border-gold/40 rounded-3xl p-6 sm:p-8 md:p-9 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)] relative overflow-hidden text-cream">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent opacity-90"></div>

      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gold/15 border border-gold/40 text-gold mb-2.5 shadow-xs">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <h1 class="text-2xl sm:text-3xl font-marcellus text-cream tracking-wide font-normal">Nova Contrasenya</h1>
        <p class="text-xs sm:text-sm text-cream/75 mt-1 font-raleway">Defineix una nova contrasenya segura d'accés</p>
      </div>

      {% include 'partials/_persistent_flashes.html.twig' with { margin_class: 'mb-4' } %}

      <div class="border-l-[3.5px] border-gold bg-gold/12 p-3.5 rounded-r-xl text-xs text-cream/90 leading-relaxed mb-5">
        <strong>Requisits de seguretat:</strong> Utilitza un mínim de <code>8 caràcters</code>. Aquest enllaç quedarà invalidat automàticament un cop desis el canvi.
      </div>

      {{ form_start(resetForm, {
        'attr': {
          'class': 'space-y-4',
          'novalidate': 'novalidate',
          'onsubmit': "
            const p1 = document.getElementById('" ~ resetForm.newPassword.first.vars.id ~ "');
            const p2 = document.getElementById('" ~ resetForm.newPassword.second.vars.id ~ "');
            if (!p1 || !p1.value || p1.value.length < 8) {
              event.preventDefault();
              if (window.RegistralsToast) window.RegistralsToast.show('Contrasenya curta', 'La nova contrasenya ha de tenir un mínim de 8 caràcters.', 'error');
              if (p1) p1.focus();
              return false;
            }
            if (!p2 || p1.value !== p2.value) {
              event.preventDefault();
              if (window.RegistralsToast) window.RegistralsToast.show('Contrasenyes no coincideixen', 'Les dues contrasenyes han de ser idèntiques.', 'error');
              if (p2) p2.focus();
              return false;
            }
          "
        }
      }) }}
        <div>
          {{ form_label(resetForm.newPassword.first, null, {'label_attr': {'class': 'block text-xs font-semibold uppercase tracking-wider text-cream/90 mb-1.5 font-raleway'}}) }}
          <div class="relative rounded-xl shadow-xs">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-steel">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            {{ form_widget(resetForm.newPassword.first, {'attr': {'class': 'block w-full pl-10 pr-11 py-2.5 bg-white/90 border border-steel/30 rounded-xl text-ink text-sm placeholder-steel/60 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/40 focus:bg-white transition-all', 'autofocus': true}}) }}
            {% include 'partials/_password_toggle_button.html.twig' with { target_id: resetForm.newPassword.first.vars.id } %}
          </div>
          {{ form_errors(resetForm.newPassword.first, {'attr': {'class': 'text-red-300 text-xs mt-1.5'}}) }}
        </div>

        <div>
          {{ form_label(resetForm.newPassword.second, null, {'label_attr': {'class': 'block text-xs font-semibold uppercase tracking-wider text-cream/90 mb-1.5 font-raleway'}}) }}
          <div class="relative rounded-xl shadow-xs">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-steel">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            {{ form_widget(resetForm.newPassword.second, {'attr': {'class': 'block w-full pl-10 pr-11 py-2.5 bg-white/90 border border-steel/30 rounded-xl text-ink text-sm placeholder-steel/60 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/40 focus:bg-white transition-all'}}) }}
            {% include 'partials/_password_toggle_button.html.twig' with { target_id: resetForm.newPassword.second.vars.id } %}
          </div>
          {{ form_errors(resetForm.newPassword.second, {'attr': {'class': 'text-red-300 text-xs mt-1.5'}}) }}
        </div>

        <button type="submit" style="background-color: #CAA36C !important; color: #1D2F4B !important;" class="w-full mt-2 py-3 px-6 font-bold rounded-xl shadow-lg hover:brightness-95 active:scale-[0.99] transition-all flex items-center justify-center gap-2 text-sm sm:text-base uppercase tracking-wider font-raleway cursor-pointer">
          <span style="color: #1D2F4B !important;">Guardar Nova Contrasenya</span>
          <svg class="w-4 h-4 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        </button>
      {{ form_end(resetForm) }}
    </div>
  </main>

  <footer class="w-full max-w-7xl mx-auto py-2 text-center text-xs text-ink/70 font-medium">
    <p>&copy; {{ "now"|date("Y") }} Registrals &middot; Plataforma protegida amb seguretat avançada i eIDAS.</p>
  </footer>

</div>
{% endblock %}
