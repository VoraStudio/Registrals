{% extends 'base.html.twig' %}

{% block title %}Accedir — Registrals{% endblock %}
{% block meta_description %}Inicia sessió a la teva àrea privada de Registrals per consultar el teu patrimoni moble custodiat i emetre certificats.{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {# Barra Superior Unificada (Fons Blanc + Línia Tènue) #}
  <header class="border-b border-steel/20 bg-white sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
      <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 sm:gap-3.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded-xl p-1" aria-label="Tornar a la pàgina d'inici">
        <img src="{{ asset('img/logos/Isotip/1-transparent.svg') }}" alt="Isotip Registrals" class="w-8 h-8 sm:w-10 sm:h-10 transition-transform duration-300 group-hover:scale-105" />
        <span class="font-marcellus tracking-widest uppercase text-lg sm:text-2xl text-ink font-medium group-hover:text-gold transition-colors">Registrals</span>
      </a>
      <a href="{{ path('app_home') }}" class="text-xs sm:text-sm text-ink/75 hover:text-ink transition-colors flex items-center gap-1 sm:gap-1.5 font-semibold shrink-0">
        <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>Tornar a l'inici</span>
      </a>
    </div>
  </header>

  {# Contingut Principal / Targeta Blau Marí Notarial Fosc amb Ombrejat 80% #}
  <main class="w-full max-w-md mx-auto my-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="bg-ink border border-gold/40 rounded-3xl p-6 sm:p-8 md:p-9 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)] relative overflow-hidden text-cream">
      {# Lluentor daurada superior #}
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent opacity-90"></div>

      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gold/15 border border-gold/40 text-gold mb-2.5 shadow-xs">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <h1 class="text-2xl sm:text-3xl font-marcellus text-cream tracking-wide font-normal">Accés Privat</h1>
        <p class="text-xs sm:text-sm text-cream/75 mt-1 font-raleway">Entra al teu espai segur de custòdia i certificació</p>
      </div>

      {# Missatges Flash via Notarial Toast #}
      {% for message in app.flashes('success') %}
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            if (window.RegistralsToast) {
              window.RegistralsToast.show(
                'Registre Completat',
                '{{ message|e('js') }}',
                'info',
                5500
              );
            }
          });
        </script>
      {% endfor %}

      {% if error %}
        <div class="mb-5 p-3.5 rounded-xl bg-red-950/80 border border-red-400/50 text-red-200 text-xs sm:text-sm flex items-start gap-2.5">
          <svg class="w-4 h-4 shrink-0 text-red-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        </div>
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            if (window.RegistralsToast) {
              window.RegistralsToast.show(
                'Credencials Incorrectes',
                '{{ error.messageKey|trans(error.messageData, 'security')|e('js') }}',
                'error',
                5000
              );
            }
          });
        </script>
      {% endif %}

      {# Mode A: Dispositiu reconegut amb proveïdor OAuth (Google) #}
      {% if recognized_user and (recognized_user.authProvider|default('local')) == 'google' %}
        <div class="space-y-4">
          <div class="p-4 bg-white/10 border border-gold/40 rounded-2xl flex items-center justify-between text-xs text-cream/90">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gold/20 text-gold border border-gold/40 flex items-center justify-center font-bold text-base">
                {{ recognized_user.firstName|slice(0, 1)|upper }}
              </div>
              <div>
                <span class="font-medium text-cream text-sm block">Hola de nou, {{ recognized_user.firstName }}!</span>
                <span class="text-cream/65 text-xs">{{ recognized_user.email }}</span>
              </div>
            </div>
            <a href="{{ path('app_login_forget_device') }}" class="text-gold text-xs hover:underline font-semibold">Canviar</a>
          </div>

          <p class="text-xs text-cream/70 text-center">Aquest compte està vinculat a Google. Desbloqueja la teva sessió amb un sol clic:</p>

          <a href="{{ path('connect_google_start') }}" style="background-color: #FAF6F0; color: #1D2F4B;" class="w-full py-3 px-4 rounded-xl border border-steel/40 shadow-lg hover:brightness-105 active:scale-[0.99] transition-all flex items-center justify-center gap-3 text-sm sm:text-base font-bold font-raleway">
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span style="color: #1D2F4B !important;">Desbloqueja amb Google</span>
          </a>

          <div class="text-center pt-2">
            <a href="{{ path('app_login_forget_device') }}" class="text-xs text-cream/70 hover:text-cream underline">
              No ets tu? Inicia sessió amb un altre compte
            </a>
          </div>
        </div>

      {# Mode B: Usuari normal de contrasenya (o primer cop) #}
      {% else %}
        <form id="form-login" method="post" action="{{ path('app_login') }}" class="space-y-4" novalidate onsubmit="
          const emailInput = document.getElementById('inputEmail');
          const passInput = document.getElementById('inputPassword');
          if (!emailInput.value.trim()) {
            event.preventDefault();
            if (window.RegistralsToast) window.RegistralsToast.show('Correu obligatori', 'Si us plau, introdueix la teva adreça de correu electrònic.', 'error');
            emailInput.focus();
            return false;
          }
          if (!passInput.value) {
            event.preventDefault();
            if (window.RegistralsToast) window.RegistralsToast.show('Contrasenya obligatòria', 'Si us plau, introdueix la teva contrasenya d\'accés privat.', 'error');
            passInput.focus();
            return false;
          }
        ">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

          {% if recognized_user %}
            <div class="p-3 bg-white/10 border border-gold/40 rounded-2xl flex items-center justify-between text-xs text-cream/90">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-gold/20 text-gold border border-gold/40 flex items-center justify-center font-bold">
                  {{ recognized_user.firstName|slice(0, 1)|upper }}
                </div>
                <div>
                  <span class="font-medium text-cream block">Hola de nou, {{ recognized_user.firstName }}!</span>
                  <span class="text-cream/60 text-[11px]">{{ recognized_user.email }}</span>
                </div>
              </div>
              <a href="{{ path('app_login_forget_device') }}" class="text-gold text-[11px] hover:underline font-semibold">Canviar</a>
            </div>
          {% endif %}

          <div {% if recognized_user %}class="hidden"{% endif %}>
            <label for="inputEmail" class="block text-xs font-semibold uppercase tracking-wider text-cream/90 mb-1.5 font-raleway">Correu electrònic</label>
            <div class="relative rounded-xl shadow-xs">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-steel">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/></svg>
              </div>
              <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="block w-full pl-10 pr-3.5 py-2.5 bg-white/90 border border-steel/30 rounded-xl text-ink text-sm placeholder-steel/60 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/40 focus:bg-white transition-all" autocomplete="email" placeholder="nom@exemple.cat" required {% if not recognized_user %}autofocus{% endif %}>
            </div>
          </div>

          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label for="inputPassword" class="block text-xs font-semibold uppercase tracking-wider text-cream/90 font-raleway">Contrasenya</label>
              <a href="#" id="btn-forgot-password" onclick="event.preventDefault(); if (window.RegistralsToast) { window.RegistralsToast.show('Recuperació de Contrasenya', 'Aquesta funcionalitat d\'enviament d\'enllaç al correu estarà disponible properament.', 'info', 4500); } fetch('{{ path('api_track_feature_interest') }}', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ feature: 'password_reset', origin: 'login_form' }) }).catch(function(){}); return false;" class="text-[11px] text-gold hover:underline font-semibold font-raleway">
                Has oblidat la contrasenya?
              </a>
            </div>
            <div class="relative rounded-xl shadow-xs">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-steel">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              <input type="password" name="_password" id="inputPassword" class="block w-full pl-10 pr-3.5 py-2.5 bg-white/90 border border-steel/30 rounded-xl text-ink text-sm placeholder-steel/60 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/40 focus:bg-white transition-all" autocomplete="current-password" placeholder="••••••••" required {% if recognized_user %}autofocus{% endif %}>
            </div>
          </div>

          <div class="flex items-center justify-between text-xs text-cream/80 pt-1">
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" name="_remember_me" class="rounded border-steel/40 bg-white/90 accent-gold focus:ring-gold w-4 h-4 cursor-pointer" checked>
              <span>Recorda aquest dispositiu</span>
            </label>
          </div>

          <button type="submit" style="background-color: #CAA36C !important; color: #1D2F4B !important;" class="w-full mt-2 py-3 px-6 font-bold rounded-xl shadow-lg hover:brightness-95 active:scale-[0.99] transition-all flex items-center justify-center gap-2 text-sm sm:text-base uppercase tracking-wider font-raleway cursor-pointer">
            <span style="color: #1D2F4B !important;">Inicia Sessió</span>
            <svg class="w-4 h-4 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </form>

        {# Separador O continuar amb #}
        <div class="my-5 flex items-center gap-3">
          <div class="flex-1 h-px bg-gold/20"></div>
          <span class="text-xs uppercase tracking-wider text-cream/60 font-semibold">o bé</span>
          <div class="flex-1 h-px bg-gold/20"></div>
        </div>

        {# Botons Socials: Google & Apple unificats estil Notarial amb separació clara #}
        <div class="space-y-3.5 pt-1">
          <a href="{{ path('connect_google_start') }}" style="background-color: #FAF6F0; color: #1D2F4B;" class="w-full py-2.5 px-4 rounded-xl border border-steel/30 shadow-sm hover:brightness-95 active:scale-[0.99] transition-all flex items-center justify-center gap-3 text-sm font-semibold font-raleway">
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span style="color: #1D2F4B !important;">Continua amb Google</span>
          </a>

          {# Botó Apple ID: enllaç estil botó amb disparador únic #}
          <a href="#" id="btn-apple-login" role="button" onclick="event.preventDefault(); event.stopPropagation(); if (window.RegistralsToast) { window.RegistralsToast.show('Accés amb Apple ID', 'Aquesta funcionalitat estarà disponible properament. Gràcies pel teu interès!', 'info', 4500); } fetch('{{ path('api_track_feature_interest') }}', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ feature: 'apple_id', origin: 'login_button' }) }).catch(function(){}); return false;" style="background-color: #FAF6F0; color: #1D2F4B;" class="w-full py-2.5 px-4 rounded-xl border border-steel/30 shadow-sm hover:brightness-95 active:scale-[0.99] transition-all flex items-center justify-center gap-3 text-sm font-semibold font-raleway cursor-pointer select-none">
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="#1D2F4B">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.76 1.04-1.82.92-2.87-.9.04-2 .6-2.64 1.36-.57.65-1.06 1.73-.93 2.76 1.01.08 2.03-.49 2.65-1.25z"/>
            </svg>
            <span style="color: #1D2F4B !important;">Continua amb Apple</span>
          </a>
        </div>
      {% endif %}

      <div class="mt-6 pt-4 border-t border-gold/20 text-center">
        <p class="text-xs sm:text-sm text-cream/80">
          Encara no disposes de compte?
          <a href="{{ path('app_register') }}" class="text-gold hover:underline font-bold ml-1 whitespace-nowrap">Registra't gratis <span class="whitespace-nowrap">(Pla&nbsp;Free)</span></a>
        </p>
      </div>
    </div>
  </main>

  {# Peu de pàgina #}
  <footer class="w-full max-w-7xl mx-auto py-2 text-center text-xs text-ink/70 font-medium">
    <p>&copy; {{ "now"|date("Y") }} Registrals &middot; Plataforma protegida amb seguretat avançada i eIDAS.</p>
  </footer>

</div>
{% endblock %}
