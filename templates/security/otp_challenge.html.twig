{% extends 'base.html.twig' %}

{% block title %}{{ purpose.pageTitle }}{% endblock %}
{% block meta_description %}Introdueix el codi temporal de 6 dígits enviat per correu electrònic per verificar el teu accés a Registrals.{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {# Barra Superior Unificada #}
  <header class="border-b border-steel/20 bg-white sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
      <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 sm:gap-3.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded-xl p-1" aria-label="Tornar a la pàgina d'inici">
        <img src="{{ asset('img/logos/Isotip/1-transparent.svg') }}" alt="Isotip Registrals" class="w-8 h-8 sm:w-10 sm:h-10 transition-transform duration-300 group-hover:scale-105" />
        <span class="font-marcellus tracking-widest uppercase text-lg sm:text-2xl text-ink font-medium group-hover:text-gold transition-colors">Registrals</span>
      </a>
      <a href="{{ path(cancelRoute) }}" class="text-xs sm:text-sm text-ink/75 hover:text-ink transition-colors flex items-center gap-1 sm:gap-1.5 font-semibold shrink-0">
        <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>Tornar a Iniciar Sessió</span>
      </a>
    </div>
  </header>

  <main class="w-full max-w-md mx-auto my-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="bg-ink border border-gold/40 rounded-3xl p-6 sm:p-8 md:p-9 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)] relative overflow-hidden text-cream">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent opacity-90"></div>

      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gold/15 border border-gold/40 text-gold mb-2.5 shadow-xs">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <h1 class="text-2xl sm:text-3xl font-marcellus text-cream tracking-wide font-normal">{{ purpose.heading }}</h1>
        <p class="text-xs sm:text-sm text-cream/75 mt-1 font-raleway">
          {{ purpose.subtitle }}
        </p>
      </div>

      {% include 'partials/_persistent_flashes.html.twig' with { margin_class: 'mb-4' } %}

      <div class="border-l-[3.5px] border-gold bg-gold/12 p-3.5 rounded-r-xl text-xs text-cream/90 leading-relaxed mb-5">
        <strong>Correu de destinació:</strong> Hem enviat un codi temporal de 6 xifres a <code>{{ maskedEmail }}</code> (vàlid durant 15 minuts). Revisa també la carpeta de correu brossa.
      </div>

      {{ form_start(otpForm, {
        'action': path(formRoute),
        'attr': {
          'class': 'space-y-4',
          'novalidate': 'novalidate',
          'onsubmit': "
            const codeEl = document.getElementById('" ~ otpForm.code.vars.id ~ "');
            const clean = codeEl ? codeEl.value.replace(/\\s+/g, '') : '';
            if (!/^\\d{6}$/.test(clean)) {
              event.preventDefault();
              if (window.RegistralsToast) window.RegistralsToast.show('Codi invàlid', 'Introdueix exactament les 6 xifres numèriques del correu.', 'error');
              if (codeEl) codeEl.focus();
              return false;
            }
          "
        }
      }) }}
        <div>
          {{ form_label(otpForm.code, null, {'label_attr': {'class': 'block text-xs font-semibold uppercase tracking-wider text-cream/90 mb-2 font-raleway text-center'}}) }}
          {{ form_widget(otpForm.code, {
            'attr': {
              'class': 'block w-full px-4 py-3 bg-white/95 border border-steel/30 rounded-xl text-ink font-mono text-2xl font-bold tracking-[0.45em] text-center placeholder-steel/40 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/50 focus:bg-white transition-all',
              'autofocus': true
            }
          }) }}
          {{ form_errors(otpForm.code, {'attr': {'class': 'text-red-300 text-xs mt-1.5 text-center'}}) }}
        </div>

        <button type="submit" style="background-color: #CAA36C !important; color: #1D2F4B !important;" class="w-full py-3 px-6 font-bold rounded-xl shadow-lg hover:brightness-95 active:scale-[0.99] transition-all flex items-center justify-center gap-2 text-sm uppercase tracking-wider font-raleway cursor-pointer">
          <span style="color: #1D2F4B !important;">{{ purpose.submitButtonLabel }}</span>
          <svg class="w-4 h-4 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      {{ form_end(otpForm) }}

      <div class="mt-5 pt-4 border-t border-gold/20 text-center space-y-2.5">
        <form method="post" action="{{ path(resendRoute) }}">
          <input type="hidden" name="_token" value="{{ csrf_token(csrfResendTokenId) }}">
          <button
            id="btn-resend-otp"
            type="submit"
            data-cooldown="{{ cooldownRemaining }}"
            {% if cooldownRemaining > 0 %}disabled{% endif %}
            class="text-xs font-semibold transition-colors {{ cooldownRemaining > 0 ? 'text-cream/45 cursor-not-allowed' : 'text-gold hover:underline cursor-pointer' }}">
            {% if cooldownRemaining > 0 %}
              Pots reenviar un nou codi d'aquí <span id="otp-cooldown-sec">{{ cooldownRemaining }}</span>s
            {% else %}
              No has rebut el codi? Envia'n un de nou
            {% endif %}
          </button>
        </form>

        <div>
          <a href="{{ path(cancelRoute) }}" class="text-[11px] text-cream/65 hover:text-cream underline">
            Cancel·lar i tornar a l'inici de sessió
          </a>
        </div>
      </div>
    </div>
  </main>

  <footer class="w-full max-w-md mx-auto py-3 text-center text-xs text-ink/70 font-medium">
    <p>&copy; {{ "now"|date("Y") }} Registrals &middot; Autenticació segura de doble factor.</p>
  </footer>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const codeInput = document.getElementById('{{ otpForm.code.vars.id }}');
    if (codeInput) {
      codeInput.addEventListener('input', function() {
        this.value = this.value.replace(/\D/g, '').slice(0, 6);
      });
    }

    const resendBtn = document.getElementById('btn-resend-otp');
    if (resendBtn) {
      let remaining = parseInt(resendBtn.getAttribute('data-cooldown') || '0', 10);
      if (remaining > 0) {
        const timer = setInterval(function() {
          remaining -= 1;
          const secEl = document.getElementById('otp-cooldown-sec');
          if (remaining <= 0) {
            clearInterval(timer);
            resendBtn.disabled = false;
            resendBtn.className = 'text-xs font-semibold transition-colors text-gold hover:underline cursor-pointer';
            resendBtn.textContent = "No has rebut el codi? Envia'n un de nou";
          } else if (secEl) {
            secEl.textContent = String(remaining);
          }
        }, 1000);
      }
    }
  });
</script>
{% endblock %}
