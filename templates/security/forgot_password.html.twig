{% extends 'base.html.twig' %}

{% block title %}Recuperar Contrasenya — Registrals{% endblock %}
{% block meta_description %}Sol·licita un enllaç segur per restablir la contrasenya del teu compte a Registrals.{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {# Barra Superior Unificada #}
  <header class="border-b border-steel/20 bg-white sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
      <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 sm:gap-3.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded-xl p-1" aria-label="Tornar a la pàgina d'inici">
        <img src="{{ asset('img/logos/Isotip/1-transparent.svg') }}" alt="Isotip Registrals" class="w-8 h-8 sm:w-10 sm:h-10 transition-transform duration-300 group-hover:scale-105" />
        <span class="font-marcellus tracking-widest uppercase text-lg sm:text-2xl text-ink font-medium group-hover:text-gold transition-colors">Registrals</span>
      </a>
      <a href="{{ path('app_login') }}" class="text-xs sm:text-sm text-ink/75 hover:text-ink transition-colors flex items-center gap-1 sm:gap-1.5 font-semibold shrink-0">
        <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>Tornar a Iniciar Sessió</span>
      </a>
    </div>
  </header>

  <main class="w-full max-w-md mx-auto my-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="bg-ink border border-gold/40 rounded-3xl p-6 sm:p-8 md:p-9 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)] relative overflow-hidden text-cream">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent opacity-90"></div>

      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gold/15 border border-gold/40 text-gold mb-2.5 shadow-xs">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
        </div>
        <h1 class="text-2xl sm:text-3xl font-marcellus text-cream tracking-wide font-normal">Recuperar Contrasenya</h1>
        <p class="text-xs sm:text-sm text-cream/75 mt-1 font-raleway">
          {% if emailSent %}
            Revisa la teva safata d'entrada
          {% else %}
            T'enviarem un enllaç segur i temporal al teu correu
          {% endif %}
        </p>
      </div>

      {% include 'partials/_persistent_flashes.html.twig' with { margin_class: 'mb-4' } %}

      {% if emailSent %}
        <div class="border-l-[3.5px] border-gold bg-gold/12 p-4 rounded-r-xl text-xs sm:text-sm text-cream/90 leading-relaxed mb-6">
          <strong>Sol·licitud processada:</strong> Si existeix un compte actiu associat a l'adreça indicada, hi hem enviat un enllaç de recuperació vàlid durant <code>60 minuts</code>. Revisa també la carpeta de correu brossa.
        </div>

        <div class="space-y-3">
          <a href="{{ path('app_login') }}" style="background-color: #CAA36C !important; color: #1D2F4B !important;" class="w-full py-3 px-6 font-bold rounded-xl shadow-lg hover:brightness-95 active:scale-[0.99] transition-all flex items-center justify-center gap-2 text-sm uppercase tracking-wider font-raleway">
            <span style="color: #1D2F4B !important;">Tornar a Iniciar Sessió</span>
          </a>
          <div class="text-center pt-1">
            <a href="{{ path('app_forgot_password') }}" class="text-xs text-cream/75 hover:text-gold underline font-semibold">
              Provar amb un altre correu electrònic
            </a>
          </div>
        </div>
      {% else %}
        {{ form_start(requestForm, {
          'attr': {
            'class': 'space-y-4',
            'novalidate': 'novalidate',
            'onsubmit': "
              const emailEl = document.getElementById('" ~ requestForm.email.vars.id ~ "');
              if (!emailEl || !emailEl.value.trim()) {
                event.preventDefault();
                if (window.RegistralsToast) window.RegistralsToast.show('Correu obligatori', 'Introdueix el correu electrònic associat al teu compte.', 'error');
                if (emailEl) emailEl.focus();
                return false;
              }
            "
          }
        }) }}
          <div>
            {{ form_label(requestForm.email, null, {'label_attr': {'class': 'block text-xs font-semibold uppercase tracking-wider text-cream/90 mb-1.5 font-raleway'}}) }}
            <div class="relative rounded-xl shadow-xs">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-steel">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/></svg>
              </div>
              {{ form_widget(requestForm.email, {'attr': {'class': 'block w-full pl-10 pr-3.5 py-2.5 bg-white/90 border border-steel/30 rounded-xl text-ink text-sm placeholder-steel/60 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/40 focus:bg-white transition-all', 'autofocus': true}}) }}
            </div>
            {{ form_errors(requestForm.email, {'attr': {'class': 'text-red-300 text-xs mt-1.5'}}) }}
          </div>

          <button type="submit" style="background-color: #CAA36C !important; color: #1D2F4B !important;" class="w-full mt-2 py-3 px-6 font-bold rounded-xl shadow-lg hover:brightness-95 active:scale-[0.99] transition-all flex items-center justify-center gap-2 text-sm sm:text-base uppercase tracking-wider font-raleway cursor-pointer">
            <span style="color: #1D2F4B !important;">Enviar Enllaç de Recuperació</span>
            <svg class="w-4 h-4 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        {{ form_end(requestForm) }}
      {% endif %}

      <div class="mt-6 pt-4 border-t border-gold/20 text-center">
        <p class="text-xs sm:text-sm text-cream/80">
          Recordes la teva contrasenya?
          <a href="{{ path('app_login') }}" class="text-gold hover:underline font-bold ml-1">Inicia sessió</a>
        </p>
      </div>
    </div>
  </main>

  <footer class="w-full max-w-7xl mx-auto py-2 text-center text-xs text-ink/70 font-medium">
    <p>&copy; {{ "now"|date("Y") }} Registrals &middot; Plataforma protegida amb seguretat avançada i eIDAS.</p>
  </footer>

</div>
{% endblock %}
