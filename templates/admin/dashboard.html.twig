{% extends 'admin/layout.html.twig' %}

{% block title %}Panell de Control & KPIs — Administració Registrals{% endblock %}

{% block admin_content %}
<div class="space-y-8">

  {# Capçalera Solemne #}
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="font-marcellus text-2xl sm:text-3xl text-ink tracking-tight font-medium">Panell de Control & Supervisió</h1>
      <p class="font-raleway text-xs sm:text-sm text-ink/70 mt-1">
        Mètriques globals, custòdia probatòria i administració d'usuaris en temps real.
      </p>
    </div>
    
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white border border-steel/25 text-xs text-ink/80 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        <span>MySQL 8.4 & Node SGLang Operatius</span>
      </span>
    </div>
  </div>

  {# Graella de KPIs Principals (4 Targetes Solemnes) #}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    
    {# KPI 1: Usuaris Totals #}
    <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs hover:border-gold/50 transition-all">
      <div class="flex items-center justify-between text-steel mb-3">
        <span class="text-xs uppercase tracking-wider font-semibold text-ink/65 font-raleway">Comptes d'Usuari</span>
        <div class="w-8 h-8 rounded-xl bg-cream flex items-center justify-center text-ink">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        </div>
      </div>
      <div class="font-marcellus text-3xl font-bold text-ink">{{ totalUsers|number_format(0, ',', '.') }}</div>
      <div class="mt-3 pt-3 border-t border-steel/15 flex items-center justify-between text-xs text-ink/75 font-raleway">
        <span class="text-emerald-700 font-semibold">{{ activeUsers }} actius</span>
        {% if blockedUsers > 0 %}
          <span class="text-red-700 font-bold bg-red-50 px-2 py-0.5 rounded-md">{{ blockedUsers }} suspesos</span>
        {% else %}
          <span class="text-ink/60">0 suspesos</span>
        {% endif %}
      </div>
    </div>

    {# KPI 2: Béns Registrats #}
    <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs hover:border-gold/50 transition-all">
      <div class="flex items-center justify-between text-steel mb-3">
        <span class="text-xs uppercase tracking-wider font-semibold text-ink/65 font-raleway">Béns Custodiats</span>
        <div class="w-8 h-8 rounded-xl bg-ink text-gold flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        </div>
      </div>
      <div class="font-marcellus text-3xl font-bold text-ink">{{ totalItems|number_format(0, ',', '.') }}</div>
      <div class="mt-3 pt-3 border-t border-steel/15 flex items-center justify-between text-xs text-ink/75 font-raleway">
        <span class="text-emerald-700 font-semibold">{{ activeItems }} actius</span>
        <span class="text-ink/60">{{ (totalItems - activeItems) }} en procés</span>
      </div>
    </div>

    {# KPI 3: Proves & Arxius Custodiats #}
    <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs hover:border-gold/50 transition-all">
      <div class="flex items-center justify-between text-steel mb-3">
        <span class="text-xs uppercase tracking-wider font-semibold text-ink/65 font-raleway">Custòdia Flysystem</span>
        <div class="w-8 h-8 rounded-xl bg-gold/20 text-ink flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
      </div>
      <div class="font-marcellus text-3xl font-bold text-ink">{{ totalDocuments|number_format(0, ',', '.') }} <span class="text-sm font-raleway font-normal text-ink/70">arxius</span></div>
      <div class="mt-3 pt-3 border-t border-steel/15 flex items-center justify-between text-xs text-ink/75 font-raleway">
        <span class="text-ink/65 font-mono">
          {% if totalBytes > 1073741824 %}
            {{ (totalBytes / 1073741824)|number_format(2, ',', '.') }} GB
          {% elseif totalBytes > 1048576 %}
            {{ (totalBytes / 1048576)|number_format(1, ',', '.') }} MB
          {% else %}
            {{ (totalBytes / 1024)|number_format(0, ',', '.') }} KB
          {% endif %}
        </span>
        <span class="text-emerald-700 font-semibold">WebP aïllat</span>
      </div>
    </div>

    {# KPI 4: Assistència IA Sobirana #}
    <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs hover:border-gold/50 transition-all">
      <div class="flex items-center justify-between text-steel mb-3">
        <span class="text-xs uppercase tracking-wider font-semibold text-ink/65 font-raleway">IA Sobirana Qwen-VL</span>
        <div class="w-8 h-8 rounded-xl bg-ink text-gold flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
      </div>
      <div class="font-marcellus text-2xl font-bold text-ink flex items-center gap-2">
        {% if aiGlobalEnabled %}
          <span class="text-emerald-600">Activa</span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
        {% else %}
          <span class="text-amber-600">Pausada</span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500"></span>
        {% endif %}
      </div>
      <div class="mt-3 pt-3 border-t border-steel/15 flex items-center justify-between text-xs text-ink/75 font-raleway">
        <span class="text-ink/60">Node SGLang</span>
        <span class="font-mono text-emerald-700 font-semibold">127.0.0.1:30000</span>
      </div>
    </div>

  </div>

  {# Resum de Subscripcions / Ràtio de Plans Freemium #}
  <div class="bg-white rounded-2xl border border-steel/20 p-6 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
      <div>
        <h2 class="font-marcellus text-lg text-ink font-bold">Distribució de Plans & Conversió Freemium</h2>
        <p class="text-xs text-ink/70 font-raleway">Supervisió de la cartera d'usuaris per nivell de servei.</p>
      </div>
      <a href="{{ path('app_admin_users') }}" class="text-xs font-bold text-ink hover:text-gold transition-colors inline-flex items-center gap-1">
        <span>Veure tots els usuaris</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {% for plan in plans %}
        {% set planCount = usersByPlan[plan.code]|default(0) %}
        {% set planPercent = totalUsers > 0 ? ((planCount / totalUsers) * 100)|round(1) : 0 %}
        
        <div class="p-4 rounded-xl border {{ plan.code == 'plus' ? 'border-ink bg-ink/5' : (plan.code == 'unlimited' ? 'border-gold/60 bg-gold/5' : 'border-steel/20 bg-cream/20') }}">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold font-mono uppercase tracking-wider {{ plan.code == 'plus' ? 'text-ink' : (plan.code == 'unlimited' ? 'text-gold' : 'text-steel') }}">
              {{ plan.name }}
            </span>
            <span class="text-xs font-bold font-mono text-ink">{{ planPercent }}%</span>
          </div>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="font-marcellus text-2xl font-bold text-ink">{{ planCount }}</span>
            <span class="text-xs text-ink/65 font-raleway">usuaris</span>
          </div>
          <div class="w-full bg-steel/15 rounded-full h-1.5 mt-3 overflow-hidden">
            <div class="h-1.5 rounded-full {{ plan.code == 'plus' ? 'bg-ink' : (plan.code == 'unlimited' ? 'bg-gold' : 'bg-steel') }}" style="width: {{ planPercent }}%"></div>
          </div>
          <div class="mt-2.5 text-[11px] text-ink/60 font-raleway flex items-center justify-between">
            <span>Preu: {{ (plan.priceCents / 100)|number_format(2, ',', '.') }} €/any</span>
            <span>Màx: {{ plan.maxActiveItems == -1 ? 'Il·limitat' : plan.maxActiveItems ~ ' béns' }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Dues Columnes: Darrers Usuaris Registrats vs Darrers Béns #}
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    {# Columna 1: Darrers Usuaris Registrats #}
    <div class="bg-white rounded-2xl border border-steel/20 p-6 shadow-xs flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-steel/15 mb-4">
          <h2 class="font-marcellus text-base text-ink font-bold flex items-center gap-2">
            <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <span>Darreres Altes d'Usuaris</span>
          </h2>
          <a href="{{ path('app_admin_users') }}" class="text-xs font-semibold text-ink/70 hover:text-ink">Gestionar &rarr;</a>
        </div>

        <div class="divide-y divide-steel/10">
          {% for u in recentUsers %}
            <div class="py-3 flex items-center justify-between gap-3 text-xs">
              <div class="min-w-0">
                <a href="{{ path('app_admin_user_detail', {id: u.id}) }}" class="font-bold text-ink hover:text-gold transition-colors block truncate">
                  {{ u.fullName }}
                </a>
                <div class="text-[11px] text-ink/60 truncate font-raleway">{{ u.email }}</div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase {{ u.plan.code == 'plus' ? 'bg-ink text-gold' : (u.plan.code == 'unlimited' ? 'bg-gold text-ink' : 'bg-cream text-steel') }}">
                  {{ u.plan.code }}
                </span>
                {% if u.isActive %}
                  <span class="w-2 h-2 rounded-full bg-emerald-500" title="Compte Actiu"></span>
                {% else %}
                  <span class="w-2 h-2 rounded-full bg-red-600" title="Compte Suspès"></span>
                {% endif %}
              </div>
            </div>
          {% else %}
            <p class="text-xs text-ink/60 py-4 italic">No hi ha usuaris registrats.</p>
          {% endfor %}
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-steel/15 text-right">
        <a href="{{ path('app_admin_users') }}" class="text-xs font-bold text-ink hover:text-gold transition-colors">
          Veure tots els {{ totalUsers }} usuaris &rarr;
        </a>
      </div>
    </div>

    {# Columna 2: Darrers Béns Registrats #}
    <div class="bg-white rounded-2xl border border-steel/20 p-6 shadow-xs flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-steel/15 mb-4">
          <h2 class="font-marcellus text-base text-ink font-bold flex items-center gap-2">
            <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            <span>Darrers Béns Ingressats</span>
          </h2>
          <span class="text-xs text-ink/60 font-raleway">{{ activeItems }} béns actius</span>
        </div>

        <div class="divide-y divide-steel/10">
          {% for item in recentItems %}
            <div class="py-3 flex items-center justify-between gap-3 text-xs">
              <div class="min-w-0">
                <a href="{{ path('app_item_show', {cui: item.cui}) }}" class="font-bold text-ink hover:text-gold transition-colors block truncate" target="_blank">
                  {{ item.name }}
                </a>
                <div class="text-[11px] font-mono text-steel truncate">{{ item.cui }} &middot; {{ item.owner.fullName }}</div>
              </div>
              <div class="shrink-0 text-right">
                <span class="inline-block px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-emerald-50 text-emerald-800 border border-emerald-200">
                  {{ item.status.value }}
                </span>
                <div class="text-[10px] text-ink/50 mt-0.5">{{ item.createdAt|date('d/m/Y H:i') }}</div>
              </div>
            </div>
          {% else %}
            <p class="text-xs text-ink/60 py-4 italic">No hi ha béns registrats encara.</p>
          {% endfor %}
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-steel/15 text-xs text-ink/70 flex items-center justify-between">
        <span>Model determinista de hash SHA-256</span>
        <span class="text-emerald-700 font-semibold font-mono">Integritat OK</span>
      </div>
    </div>

  </div>

</div>
{% endblock %}
