{% extends 'admin/layout.html.twig' %}

{% block title %}Expedients &amp; Herències — Gestió i Custòdia Registrals{% endblock %}

{% block admin_content %}
<div class="space-y-6">
  <nav class="flex items-center gap-2 text-xs font-semibold font-raleway text-ink/65 flex-wrap">
    {% if is_granted('ROLE_ADMIN') %}
      <a href="{{ path('app_admin_dashboard') }}" class="hover:text-ink transition-colors">Inici</a>
      <span>/</span>
    {% endif %}
    <span class="text-ink">Gestió &amp; Custòdia</span>
    <span>/</span>
    <span class="text-ink font-bold">Expedients &amp; Herències</span>
  </nav>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="font-marcellus text-2xl sm:text-3xl text-ink tracking-tight">Expedients &amp; Herències Digitals</h1>
      <p class="font-raleway text-xs sm:text-sm text-ink/70 mt-1">
        Supervisió humana acotada (Art. 22 RGPD), verificació de documents custodiats i resolució motivada de traspassos successoris.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
      <span class="px-3 py-1.5 rounded-xl bg-white border border-steel/20 text-ink">
        <strong>{{ counts.pending_review }}</strong> en revisió
      </span>
      <span class="px-3 py-1.5 rounded-xl bg-white border border-orange-200 text-orange-800">
        <strong>{{ counts.hold_window }}</strong> finestra 72 h
      </span>
      <span class="px-3 py-1.5 rounded-xl bg-white border border-emerald-200 text-emerald-800">
        <strong>{{ counts.resolved }}</strong> resolts
      </span>
    </div>
  </div>

  {# Filtres compactes 16:9 #}
  <div class="bg-white rounded-2xl border border-steel/20 p-4 shadow-xs">
    <form method="get" action="{{ path('app_admin_gestions_herencies') }}" class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
      <div class="sm:col-span-6">
        <label for="q" class="block text-xs font-semibold text-ink/80 mb-1">Cerca per Referència, Sol·licitant o Titular</label>
        <input type="text" id="q" name="q" value="{{ currentSearch }}" placeholder="Ex: LEG-2026-..., nom o correu..."
               class="w-full bg-cream-50/60 border border-steel/30 rounded-xl px-3.5 py-2 text-xs sm:text-sm text-ink focus:outline-none focus:ring-2 focus:ring-gold">
      </div>
      <div class="sm:col-span-4">
        <label for="status" class="block text-xs font-semibold text-ink/80 mb-1">Estat de Tramitació</label>
        <select id="status" name="status" class="w-full bg-cream-50/60 border border-steel/30 rounded-xl px-3 py-2 text-xs sm:text-sm text-ink focus:outline-none focus:ring-2 focus:ring-gold">
          <option value="all" {{ currentStatus == 'all' ? 'selected' : '' }}>Tots els estats</option>
          {% for st in statuses %}
            <option value="{{ st.value }}" {{ currentStatus == st.value ? 'selected' : '' }}>{{ st.label }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="sm:col-span-2 flex items-center gap-2">
        <button type="submit" class="w-full bg-ink hover:bg-ink/90 text-gold font-bold text-xs py-2.5 px-4 rounded-xl border border-gold/40 cursor-pointer">
          Filtrar
        </button>
      </div>
    </form>
  </div>

  {# Taula de Cua d'Expedients #}
  <div class="bg-white rounded-2xl border border-steel/20 overflow-hidden shadow-xs">
    {% if claims is empty %}
      <div class="px-5 py-6 text-xs text-steel font-raleway flex items-center justify-between">
        <span>Cap expedient successori coincideix amb els criteris seleccionats.</span>
        {% if currentSearch or currentStatus != 'all' %}
          <a href="{{ path('app_admin_gestions_herencies') }}" class="text-ink font-semibold underline hover:text-gold">Restablir filtres</a>
        {% endif %}
      </div>
    {% else %}
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-raleway">
          <thead class="bg-cream-50/80 border-b border-steel/15 text-[11px] font-bold text-ink uppercase tracking-wider font-mono">
            <tr>
              <th class="px-4 py-3">Expedient</th>
              <th class="px-4 py-3">Titular Causant</th>
              <th class="px-4 py-3">Sol·licitant</th>
              <th class="px-4 py-3">Finestra 72 h</th>
              <th class="px-4 py-3">Pre-triatge IA</th>
              <th class="px-4 py-3">Estat</th>
              <th class="px-4 py-3 text-right">Inspecció</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-steel/10">
            {% for claim in claims %}
              <tr class="hover:bg-cream-50/40 transition-colors">
                <td class="px-4 py-3 font-mono font-bold text-ink">
                  <div>{{ claim.claimReference }}</div>
                  <div class="text-[10px] font-normal text-steel">{{ claim.createdAt|date('d/m/Y H:i') }}</div>
                </td>
                <td class="px-4 py-3">
                  <div class="font-semibold text-ink">{{ claim.deceasedOwner.fullName }}</div>
                  <div class="text-[11px] font-mono text-steel">{{ claim.deceasedOwner.email }}</div>
                </td>
                <td class="px-4 py-3">
                  <div class="font-semibold text-ink">{{ claim.claimantName }}</div>
                  <div class="text-[11px] font-mono text-steel">{{ claim.claimantEmail }} · {{ claim.claimantTaxId }}</div>
                </td>
                <td class="px-4 py-3 font-mono text-[11px]">
                  {% if claim.securityHoldUntil %}
                    {% if claim.isSecurityHoldActive %}
                      <span class="px-2 py-0.5 rounded bg-orange-50 text-orange-800 border border-orange-200 font-bold">
                        Bloquejat fins {{ claim.securityHoldUntil|date('d/m H:i') }}
                      </span>
                    {% else %}
                      <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold">
                        72 h completades
                      </span>
                    {% endif %}
                  {% else %}
                    <span class="text-steel">—</span>
                  {% endif %}
                </td>
                <td class="px-4 py-3 text-[11px] font-mono">
                  {% if claim.aiScreeningStatus == 'completed' %}
                    <span class="text-emerald-700 font-bold">
                      Completat{% if claim.aiConfidenceScore is not null %} ({{ (claim.aiConfidenceScore * 100)|round }}%){% endif %}
                    </span>
                  {% elseif claim.aiScreeningStatus == 'failed' %}
                    <span class="text-rose-700 font-bold">Revisió manual req.</span>
                  {% else %}
                    <span class="text-steel">Pendent / En cua</span>
                  {% endif %}
                </td>
                <td class="px-4 py-3">
                  <span class="inline-block px-2.5 py-0.5 rounded-full border text-[10px] font-bold {{ claim.status.badgeClasses }}">
                    {{ claim.status.label }}
                  </span>
                </td>
                <td class="px-4 py-3 text-right">
                  <a href="{{ path('app_admin_gestions_herencia_show', { uuid: claim.uuid.toRfc4122 }) }}"
                     class="inline-flex items-center px-3 py-1.5 rounded-lg bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-bold text-[11px]">
                    Obrir Dossier →
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}

