{% extends 'admin/layout.html.twig' %}

{% block title %}{{ claim.claimReference }} — Dossier Successori Registrals{% endblock %}

{% block admin_content %}
{% set claimUuid = claim.uuid.toRfc4122 %}
{% set holdActive = claim.isSecurityHoldActive %}
<div class="space-y-5">
  <nav class="flex items-center gap-2 text-xs font-semibold font-raleway text-ink/65 flex-wrap">
    {% if is_granted('ROLE_ADMIN') %}
      <a href="{{ path('app_admin_dashboard') }}" class="hover:text-ink">Inici</a>
      <span>/</span>
    {% endif %}
    <a href="{{ path('app_admin_gestions_herencies') }}" class="hover:text-ink">Expedients &amp; Herències</a>
    <span>/</span>
    <span class="text-ink font-mono font-bold">{{ claim.claimReference }}</span>
  </nav>

  {# Capçalera del Dossier #}
  <div class="bg-white rounded-2xl border border-gold/35 p-5 shadow-xs flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2.5 flex-wrap">
        <h1 class="font-marcellus text-2xl sm:text-3xl text-ink">{{ claim.claimReference }}</h1>
        <span class="px-3 py-1 rounded-full border text-xs font-bold {{ claim.status.badgeClasses }}">
          {{ claim.status.label }}
        </span>
        {% if holdActive %}
          <span class="px-3 py-1 rounded-full bg-orange-100 border border-orange-300 text-orange-900 text-xs font-mono font-bold">
            Bloqueig 72 h actiu fins {{ claim.securityHoldUntil|date('d/m/Y H:i') }} UTC
          </span>
        {% endif %}
      </div>
      <p class="text-xs text-steel font-raleway mt-1">
        Certificat font: <strong class="font-mono text-ink">{{ claim.sourceCertificate.certificateNumber }}</strong>
        · Obertura: {{ claim.createdAt|date('d/m/Y H:i') }} UTC
        · Taxa abonada: <strong class="font-mono text-ink">{{ (claim.openingFeePaidCents / 100)|number_format(2, ',', '.') }} €</strong>
      </p>
    </div>

    {% if not claim.status.isResolved %}
      <form method="post" action="{{ path('app_admin_gestions_herencia_retriatge', { uuid: claimUuid }) }}" class="shrink-0">
        <input type="hidden" name="_token" value="{{ csrf_token('succession_ai_' ~ claimUuid) }}">
        <button type="submit" class="px-3.5 py-2 rounded-xl bg-cream hover:bg-cream/80 text-ink border border-gold/40 text-xs font-bold cursor-pointer">
          ↻ Executar Pre-triatge IA Sobirà (Qwen-VL)
        </button>
      </form>
    {% endif %}
  </div>

  {# Panell 16:9 en 2 columnes paral·leles #}
  <div class="grid grid-cols-1 xl:grid-cols-12 gap-5 items-start">

    {# Columna Esquerra (6/12): Identitats, Coincidències i Pre-triatge IA #}
    <div class="xl:col-span-6 space-y-5">

      {# 1. Comparativa Titular / Persona de Confiança / Sol·licitant #}
      <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs space-y-4">
        <h2 class="font-marcellus text-lg text-ink border-b border-steel/15 pb-2">Parts i Verificació d'Identitat</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="p-3.5 rounded-xl bg-cream-50/70 border border-steel/15">
            <div class="text-[10px] font-mono uppercase text-steel font-bold">Titular del Patrimoni</div>
            <div class="font-bold text-ink mt-1">{{ claim.deceasedOwner.fullName }}</div>
            <div class="font-mono text-[11px] text-steel">{{ claim.deceasedOwner.email }}</div>
            <div class="text-[11px] text-ink/70 mt-1">Béns actius actuals: <strong>{{ activeItems|length }}</strong></div>
          </div>

          <div class="p-3.5 rounded-xl bg-cream-50/70 border border-steel/15">
            <div class="text-[10px] font-mono uppercase text-steel font-bold">Sol·licitant (OTP Verificat)</div>
            <div class="font-bold text-ink mt-1">{{ claim.claimantName }}</div>
            <div class="font-mono text-[11px] text-steel">{{ claim.claimantEmail }}</div>
            <div class="font-mono text-[11px] text-ink mt-1">ID: <strong>{{ claim.claimantTaxId }}</strong></div>
          </div>
        </div>

        {% if claim.legacyContact %}
          {% set emailMatchesDesignated = (claim.legacyContact.email|lower == claim.claimantEmail|lower) %}
          <div class="p-3 rounded-xl border text-xs {{ emailMatchesDesignated ? 'bg-emerald-50/60 border-emerald-200 text-emerald-900' : 'bg-amber-50/70 border-amber-200 text-amber-900' }}">
            <strong>Persona de Confiança al certificat:</strong> {{ claim.legacyContact.fullName }} ({{ claim.legacyContact.email }}) —
            {{ emailMatchesDesignated ? 'Coincideix exactament amb el correu del sol·licitant.' : 'El sol·licitant utilitza un correu diferent (verificar legitimació al títol).' }}
          </div>
        {% endif %}
      </div>

      {# 2. Assistència de lectura sobirana (Qwen-VL) #}
      <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs space-y-3">
        <div class="flex items-center justify-between gap-2 border-b border-steel/15 pb-2">
          <div>
            <h2 class="font-marcellus text-lg text-ink">Assistència de Lectura Sobirana (Qwen-VL)</h2>
            <p class="text-[11px] text-steel">Execució local protegida · Suport tècnic OCR sense valor decisori (Art. 22 RGPD).</p>
          </div>
          {% if claim.aiConfidenceScore is not null %}
            <span class="px-2.5 py-0.5 rounded-full bg-cream border border-gold/40 font-mono text-xs font-bold text-ink">
              {{ (claim.aiConfidenceScore * 100)|round }}% certesa
            </span>
          {% endif %}
        </div>

        {% if claim.aiExtractionJson %}
          {% set ai = claim.aiExtractionJson %}
          {% if ai.warnings is defined and ai.warnings is not empty %}
            <div class="border-l-[3.5px] border-amber-500 bg-amber-50 p-3 rounded-r-xl text-xs text-amber-950 space-y-1">
              <strong>Alertes d'inspecció detectades:</strong>
              {% for w in ai.warnings %}
                <div>• {{ w }}</div>
              {% endfor %}
            </div>
          {% endif %}

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            {% for label, doc in { 'Certificat de Defunció': ai.death_certificate ?? {}, 'Títol Successori': ai.succession_title ?? {} } %}
              <div class="p-3.5 rounded-xl bg-cream-50/60 border border-steel/15 space-y-1.5">
                <div class="font-bold text-ink uppercase text-[10px] font-mono text-gold">{{ label }}</div>
                <div><span class="text-steel">Causant detectat:</span> <strong class="text-ink">{{ doc.deceased_full_name|default('No detectat') }}</strong></div>
                {% if doc.death_date is defined and doc.death_date %}
                  <div><span class="text-steel">Data defunció:</span> <strong class="font-mono text-ink">{{ doc.death_date }}</strong></div>
                {% endif %}
                {% if doc.issuing_authority is defined and doc.issuing_authority %}
                  <div><span class="text-steel">Organisme emissor:</span> <strong class="text-ink">{{ doc.issuing_authority }}</strong></div>
                {% endif %}
                {% if doc.beneficiary_or_heir_names is defined and doc.beneficiary_or_heir_names is not empty %}
                  <div><span class="text-steel">Hereus / Marmessors:</span> <strong class="text-ink">{{ doc.beneficiary_or_heir_names|join(', ') }}</strong></div>
                {% endif %}
                {% if doc.notes is defined and doc.notes %}
                  <div class="text-[11px] text-ink/75 pt-1 border-t border-steel/10">{{ doc.notes }}</div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="text-xs text-steel italic">
            Pre-triatge encara pendent o no executat. Pots llançar-lo manualment amb el botó superior o comprovar directament els documents custodiats.
          </p>
        {% endif %}
      </div>

      {# 3. Resolució Motivada & Execució #}
      <div class="bg-white rounded-2xl border border-gold/35 p-5 shadow-xs space-y-4">
        <h2 class="font-marcellus text-lg text-ink border-b border-steel/15 pb-2">Resolució del Gestor</h2>

        {% if claim.status.isResolved %}
          <div class="p-4 rounded-xl border text-xs space-y-2 {{ claim.status.value == 'approved' ? 'bg-emerald-50/60 border-emerald-200 text-emerald-950' : 'bg-rose-50/60 border-rose-200 text-rose-950' }}">
            <div><strong>Resolt per:</strong> {{ claim.reviewedByEmail }} el {{ claim.reviewedAt|date('d/m/Y H:i') }} UTC</div>
            {% if claim.status.value == 'approved' %}
              <div><strong>Béns transferits per lot:</strong> {{ claim.executedTransferCount }}</div>
            {% endif %}
            <div><strong>Justificació oficial:</strong> {{ claim.resolutionNotes }}</div>
          </div>
        {% else %}
          {% if holdActive %}
            <div class="border-l-[3.5px] border-red-600 bg-red-50 p-3.5 rounded-r-xl text-xs text-red-900">
              <strong>Finestra preventiva de 72 h activa:</strong> L'aprovació i el traspàs romanen bloquejats automàticament fins al <strong>{{ claim.securityHoldUntil|date('d/m/Y H:i') }} UTC</strong>. Pots rebutjar l'expedient immediatament si hi ha indicis de frau.
            </div>
          {% endif %}

          <form id="succession-decision-form" method="post" action="" class="space-y-3">
            <input type="hidden" name="_token" value="{{ csrf_token('succession_decision_' ~ claimUuid) }}">
            <div>
              <label for="resolution_notes" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
                Justificació Motivada Obligatòria (Auditoria Forense) *
              </label>
              <textarea id="resolution_notes" name="resolution_notes" rows="3" required minlength="10"
                        placeholder="Indica les comprovacions realitzades sobre el certificat de defunció i el títol successori..."
                        class="w-full rounded-xl border border-steel/30 bg-cream-50/40 px-3.5 py-2.5 text-xs sm:text-sm text-ink focus:outline-none focus:ring-2 focus:ring-gold"></textarea>
            </div>

            <div class="flex flex-wrap items-center justify-end gap-2.5 pt-1">
              <button type="button"
                      onclick="openSuccessionDecisionModal('reject', '{{ path('app_admin_gestions_herencia_reject', { uuid: claimUuid }) }}')"
                      class="px-4 py-2 rounded-xl border border-red-200 bg-white hover:bg-red-50 text-red-700 font-bold text-xs cursor-pointer">
                Rebutjar Expedient
              </button>
              <button type="button"
                      {% if holdActive %}disabled title="Bloquejat fins al venciment de la finestra preventiva de 72 h"{% else %}onclick="openSuccessionDecisionModal('approve', '{{ path('app_admin_gestions_herencia_approve', { uuid: claimUuid }) }}')"{% endif %}
                      class="px-4 py-2 rounded-xl font-bold text-xs {{ holdActive ? 'bg-steel/30 text-ink/50 cursor-not-allowed' : 'bg-ink text-gold border border-gold/40 hover:bg-ink/90 cursor-pointer shadow-xs' }}">
                Aprovar i Traspassar {{ activeItems|length }} Bé(ns) →
              </button>
            </div>
          </form>
        {% endif %}
      </div>
    </div>

    {# Columna Dreta (6/12): Documents Custodiats a Flysystem i Patrimoni #}
    <div class="xl:col-span-6 space-y-5">
      <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs space-y-4">
        <h2 class="font-marcellus text-lg text-ink border-b border-steel/15 pb-2">Documents Custodiats (Flysystem)</h2>

        <div class="space-y-4 text-xs">
          {% for docSpec in [
            { title: '1. Certificat Oficial de Defunció', kind: 'defuncio', sha: claim.deathCertificateSha256 },
            { title: '2. Títol Successori Legitimador', kind: 'titol', sha: claim.successionTitleSha256 }
          ] %}
            {% set docUrl = path('app_admin_gestions_herencia_document', { uuid: claimUuid, kind: docSpec.kind }) %}
            <div class="rounded-xl border border-steel/20 bg-cream-50/40 p-3.5 space-y-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <strong class="text-ink">{{ docSpec.title }}</strong>
                <a href="{{ docUrl }}" target="_blank" rel="noopener noreferrer"
                   class="px-3 py-1 rounded-lg bg-ink text-gold text-[11px] font-bold hover:bg-ink/90">
                  Obrir en pestanya nova ↗
                </a>
              </div>
              <div class="text-[10px] font-mono text-steel break-all">
                SHA-256: <span class="text-ink">{{ docSpec.sha }}</span>
              </div>
              <iframe src="{{ docUrl }}" title="{{ docSpec.title }}" class="w-full h-56 rounded-lg border border-steel/20 bg-white"></iframe>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs space-y-3">
        <div class="flex items-center justify-between border-b border-steel/15 pb-2">
          <h2 class="font-marcellus text-lg text-ink">Béns Actius Inclosos en el Traspàs</h2>
          <span class="font-mono text-xs font-bold text-ink">{{ activeItems|length }}</span>
        </div>

        {% if activeItems is empty %}
          <p class="text-xs text-steel">El titular no conserva béns en estat actiu pendents de traspàs.</p>
        {% else %}
          <div class="max-h-56 overflow-y-auto divide-y divide-steel/10 text-xs">
            {% for it in activeItems %}
              <div class="py-2 flex items-center justify-between gap-2">
                <div>
                  <span class="font-semibold text-ink">{{ it.name }}</span>
                  <span class="text-steel text-[11px]">· {{ it.category.name }}</span>
                </div>
                <code class="font-mono text-[11px] text-ink bg-cream px-2 py-0.5 rounded">{{ it.cui }}</code>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</div>

{# Modal Dual Institucional per Confirmar Resolució #}
<div id="modal-succession-decision" class="hidden fixed inset-0 z-50 bg-ink/75 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4" onclick="if (event.target === this) closeSuccessionDecisionModal();">
  <div class="bg-white rounded-t-3xl sm:rounded-2xl border-t sm:border border-gold/40 shadow-2xl max-w-md w-full overflow-hidden flex flex-col">
    <div class="sm:hidden w-10 h-1 bg-steel/30 rounded-full mx-auto mt-2 -mb-1 shrink-0"></div>
    <div class="p-4 sm:p-5 border-b border-steel/15 flex items-center justify-between">
      <h3 id="sd-modal-title" class="font-marcellus text-lg text-ink">Confirmar Resolució</h3>
      <button type="button" onclick="closeSuccessionDecisionModal()" class="text-steel hover:text-ink p-1 cursor-pointer">✕</button>
    </div>
    <div class="p-4 sm:p-5 text-xs sm:text-sm text-ink/85 leading-relaxed space-y-3">
      <p id="sd-modal-body"></p>
      <div class="border-l-[3.5px] border-gold bg-gold/10 p-3 rounded-r-lg text-xs text-ink/85">
        Tota resolució queda signada amb el teu identificador de gestor i registrada de manera permanent al registre d'auditoria forense.
      </div>
    </div>
    <div class="p-4 bg-cream-50/60 border-t border-steel/15 flex items-center justify-end gap-2.5">
      <button type="button" onclick="closeSuccessionDecisionModal()" class="bg-cream hover:bg-cream/80 text-ink text-xs font-semibold px-4 py-2 rounded-xl cursor-pointer">
        Cancel·lar
      </button>
      <button type="button" id="sd-modal-confirm" onclick="submitSuccessionDecision()" class="text-white font-bold text-xs px-4 py-2 rounded-xl shadow-xs cursor-pointer bg-ink">
        Confirmar
      </button>
    </div>
  </div>
</div>

<script>
  let pendingDecisionAction = null;
  function openSuccessionDecisionModal(mode, actionUrl) {
    const notesEl = document.getElementById('resolution_notes');
    if (!notesEl || notesEl.value.trim().length < 10) {
      notesEl.focus();
      notesEl.reportValidity();
      return;
    }
    pendingDecisionAction = actionUrl;
    const isApprove = mode === 'approve';
    document.getElementById('sd-modal-title').textContent = isApprove ? 'Aprovar i Executar Traspàs Successori' : 'Rebutjar Expedient Successori';
    document.getElementById('sd-modal-body').textContent = isApprove
      ? 'Estàs a punt d\'aprovar l\'expedient {{ claim.claimReference }} i transferir els {{ activeItems|length }} béns actius cap a {{ claim.claimantEmail|e('js') }}. Aquesta acció és definitiva.'
      : 'Confirmes el rebuig motivat de l\'expedient {{ claim.claimReference }}? No es mourà cap bé i es notificarà el sol·licitant.';
    const btn = document.getElementById('sd-modal-confirm');
    btn.textContent = isApprove ? 'Confirmar Aprovació i Traspàs' : 'Confirmar Rebuig';
    btn.className = isApprove
      ? 'bg-ink hover:bg-ink/90 text-gold border border-gold/40 font-bold text-xs px-4 py-2 rounded-xl shadow-xs cursor-pointer'
      : 'bg-red-700 hover:bg-red-800 text-white font-bold text-xs px-4 py-2 rounded-xl shadow-xs cursor-pointer';
    document.getElementById('modal-succession-decision').classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  }
  function closeSuccessionDecisionModal() {
    document.getElementById('modal-succession-decision').classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }
  function submitSuccessionDecision() {
    if (!pendingDecisionAction) return;
    const form = document.getElementById('succession-decision-form');
    form.action = pendingDecisionAction;
    form.submit();
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeSuccessionDecisionModal();
  });
</script>
{% endblock %}
