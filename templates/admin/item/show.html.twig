{% extends 'admin/layout.html.twig' %}

{% block title %}Inspecció Notarial: {{ item.name }} ({{ item.cui }}) — Administració Registrals{% endblock %}

{% block admin_content %}
<div class="space-y-6">

  {# Fil d'Ariadna de Ruta Canònic (Sense botó de tornar) #}
  <nav class="flex items-center gap-2 text-xs font-semibold font-raleway text-ink/65 flex-wrap">
    <a href="{{ path('app_admin_dashboard') }}" class="hover:text-ink transition-colors">Inici</a>
    <span>/</span>
    <a href="{{ path('app_admin_items') }}" class="hover:text-ink transition-colors">Béns & Patrimoni</a>
    <span>/</span>
    <a href="{{ path('app_admin_user_detail', {id: item.owner.id}) }}" class="hover:text-ink transition-colors">
      {{ item.owner.fullName }}
    </a>
    <span>/</span>
    <span class="text-gold font-bold font-mono">{{ item.cui }}</span>
  </nav>

  {# Capçalera de Secció Solemne #}
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="font-marcellus text-2xl sm:text-3xl text-ink tracking-tight font-medium">Fitxa del Bé</h1>
      <p class="font-raleway text-xs sm:text-sm text-ink/70 mt-1">
        Inspecció notarial, integritat probatòria, hashes deterministes i traçabilitat forense.
      </p>
    </div>

    {# Opcions Superiors a la Dreta #}
    <div class="flex items-center gap-2.5">
      <button type="button" onclick="openStatusModal()" class="px-4 py-2 rounded-xl bg-ink text-gold border border-gold/40 text-xs font-bold hover:bg-ink/90 transition-all shadow-xs cursor-pointer flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        <span>Modificar Estat Notarial</span>
      </button>
    </div>
  </div>

  {# Capçalera de la Fitxa d'Inspecció Notarial #}
  <div class="bg-white rounded-2xl border border-steel/20 p-6 shadow-xs flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div class="flex items-start gap-4">
      <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-ink text-gold border border-gold/40 flex items-center justify-center font-bold text-xl font-marcellus shadow-xs shrink-0">
        {{ item.name|slice(0, 1)|upper }}
      </div>
      <div>
        <div class="flex items-center gap-2.5 flex-wrap">
          <h1 class="font-marcellus text-xl sm:text-2xl text-ink font-bold">{{ item.name }}</h1>
          <span class="inline-block px-2.5 py-0.5 rounded-md text-[11px] font-mono font-bold uppercase border {{ item.status.badgeClasses }}">
            {{ item.status.label }}
          </span>
        </div>
        <div class="text-xs sm:text-sm text-ink/70 font-raleway mt-1 flex items-center gap-2 flex-wrap">
          <span>Categoria: <strong>{{ item.category.name }}</strong></span>
          {% if item.subcategory %}
            <span>&middot;</span>
            <span class="text-ink/60">{{ item.subcategory.name }}</span>
          {% endif %}
        </div>
        <div class="mt-2 flex items-center gap-2 text-xs font-mono text-steel">
          <span class="px-2 py-0.5 rounded bg-cream text-ink border border-gold/30 font-bold">CUI: {{ item.cui }}</span>
          <span>&middot;</span>
          <span>Alta: {{ item.createdAt|date('d/m/Y H:i') }}</span>
        </div>
      </div>
    </div>

    {# Valor Estimat #}
    <div class="bg-cream-50/70 border border-gold/30 rounded-xl p-3.5 md:text-right shrink-0">
      <span class="text-[10px] uppercase tracking-wider text-ink/60 font-bold block font-raleway">Valor Declarat</span>
      <span class="font-marcellus text-2xl font-bold text-ink">
        {% if item.declaredValueEuros is not null %}
          {{ item.declaredValueEuros|number_format(2, ',', '.') }} €
        {% else %}
          <span class="text-xs text-ink/50 italic font-raleway">Sense valor declarat</span>
        {% endif %}
      </span>
      <span class="text-[10px] text-ink/50 block font-raleway mt-0.5">Adquisició: {{ item.acquisitionType.label|default('Compra') }}</span>
    </div>
  </div>

  {# Graella Panoràmica d'Inspecció 16:9 #}
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    {# Columna 1: Titularitat & Especificacions Tècniques (4 Cols) #}
    <div class="lg:col-span-4 space-y-6">
      
      {# Targeta del Titular #}
      <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-steel/15">
          <h2 class="font-marcellus text-sm font-bold text-ink uppercase tracking-wider text-gold flex items-center gap-2">
            <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <span>Titular Registrat</span>
          </h2>
          <a href="{{ path('app_admin_user_detail', {id: item.owner.id}) }}" class="text-[11px] font-bold text-ink hover:text-gold transition-colors font-mono">
            Veure Perfil &rarr;
          </a>
        </div>

        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-cream border border-gold/40 text-ink flex items-center justify-center font-bold text-xs font-raleway shrink-0">
            {{ item.owner.firstName|first|upper }}{{ item.owner.lastName|first|upper }}
          </div>
          <div class="min-w-0">
            <a href="{{ path('app_admin_user_detail', {id: item.owner.id}) }}" class="font-bold text-ink text-sm hover:underline block truncate">
              {{ item.owner.fullName }}
            </a>
            <div class="text-xs text-ink/65 truncate">{{ item.owner.email }}</div>
          </div>
        </div>

        <div class="pt-3 border-t border-steel/10 grid grid-cols-2 gap-2 text-xs font-raleway">
          <div>
            <span class="text-[10px] uppercase text-ink/50 block font-mono">Pla</span>
            <span class="font-bold text-ink">{{ item.owner.plan ? item.owner.plan.name : 'Sense pla' }}</span>
          </div>
          <div>
            <span class="text-[10px] uppercase text-ink/50 block font-mono">NIF / CIF</span>
            <span class="font-bold text-ink font-mono">{{ item.owner.taxId|default('No informat') }}</span>
          </div>
        </div>
      </div>

      {# Targeta d'Especificacions Tècniques #}
      <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs space-y-4">
        <div class="pb-3 border-b border-steel/15">
          <h2 class="font-marcellus text-sm font-bold text-ink uppercase tracking-wider text-gold">
            Especificacions & Identificadors
          </h2>
        </div>

        <dl class="space-y-3 text-xs font-raleway">
          <div class="flex items-center justify-between">
            <dt class="text-ink/60">Marca / Fabricant</dt>
            <dd class="font-bold text-ink">{{ item.brand|default('No informat') }}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-ink/60">Model / Sèrie</dt>
            <dd class="font-bold text-ink">{{ item.model|default('No informat') }}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-ink/60">Número de Sèrie</dt>
            <dd class="font-mono font-bold text-ink bg-cream-50 px-2 py-0.5 rounded border border-steel/20">
              {{ item.serialNumber|default('Sense número de sèrie') }}
            </dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-ink/60">Data d'Adquisició</dt>
            <dd class="font-bold text-ink">
              {{ item.acquisitionDate ? item.acquisitionDate|date('d/m/Y') : 'No informada' }}
            </dd>
          </div>
        </dl>

        {% if item.acquisitionCircumstances %}
          <div class="pt-3 border-t border-steel/10">
            <span class="text-[10px] uppercase text-ink/50 font-bold block mb-1 font-mono">Circumstàncies & Descripció</span>
            <p class="text-xs text-ink/80 leading-relaxed bg-cream-50/50 p-3 rounded-xl border border-steel/15">
              {{ item.acquisitionCircumstances }}
            </p>
          </div>
        {% endif %}
      </div>

    </div>

    {# Columna 2: Proves Documentals & Galeria Flysystem (5 Cols) #}
    <div class="lg:col-span-5 space-y-6">
      
      {# Galeria Fotogràfica #}
      <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-steel/15">
          <h2 class="font-marcellus text-sm font-bold text-ink uppercase tracking-wider text-gold flex items-center gap-2">
            <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>Fotografies Custodiades ({{ item.photos|length }})</span>
          </h2>
          <span class="text-[10px] font-mono text-steel">Flysystem Privat</span>
        </div>

        {% if item.photos|length > 0 %}
          <div class="grid grid-cols-2 gap-3">
            {% for photo in item.photos %}
              <div class="relative group rounded-xl overflow-hidden border border-steel/20 bg-cream/20">
                <img src="{{ path('app_media_document', {uuid: photo.uuid}) }}" alt="{{ photo.originalFilename }}" 
                     class="w-full aspect-[16/9] object-cover group-hover:scale-105 transition-transform" />
                <div class="p-2 bg-white/95 text-[10px] font-mono border-t border-steel/15">
                  <div class="truncate font-bold text-ink">{{ photo.originalFilename }}</div>
                  <div class="text-steel flex items-center justify-between mt-0.5">
                    <span>{{ (photo.fileSizeBytes / 1024)|round(1) }} KB</span>
                    <a href="{{ path('app_media_document', {uuid: photo.uuid}) }}" target="_blank" class="text-gold font-bold hover:underline">Obrir ↗</a>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="py-6 text-center text-xs text-ink/60 italic bg-cream-50/50 rounded-xl border border-dashed border-steel/25">
            Aquest bé no té fotografies custodiades.
          </div>
        {% endif %}
      </div>

      {# Proves Documentals (Factures, Tiquets, Garanties) #}
      <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-steel/15">
          <h2 class="font-marcellus text-sm font-bold text-ink uppercase tracking-wider text-gold flex items-center gap-2">
            <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Proves & Factures ({{ item.evidenceDocuments|length }})</span>
          </h2>
          <span class="text-[10px] font-mono text-steel">Custòdia Xifrada</span>
        </div>

        {% if item.evidenceDocuments|length > 0 %}
          <div class="space-y-2.5">
            {% for doc in item.evidenceDocuments %}
              <div class="p-3 rounded-xl border border-steel/20 bg-cream-50/40 hover:bg-cream-50 flex items-center justify-between gap-3 transition-colors">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-8 h-8 rounded-lg bg-ink text-gold flex items-center justify-center font-bold text-[10px] font-mono shrink-0">
                    {{ doc.mimeType == 'application/pdf' ? 'PDF' : 'IMG' }}
                  </div>
                  <div class="min-w-0">
                    <span class="text-xs font-bold text-ink truncate block">{{ doc.originalFilename }}</span>
                    <span class="text-[10px] text-steel font-mono block">
                      {{ (doc.fileSizeBytes / 1024)|round(1) }} KB &middot; {{ doc.createdAt|date('d/m/Y') }}
                    </span>
                  </div>
                </div>

                <a href="{{ path('app_media_document', {uuid: doc.uuid}) }}" target="_blank" 
                   class="px-3 py-1 rounded-lg bg-white border border-steel/30 hover:border-gold text-ink text-xs font-semibold shrink-0 transition-colors shadow-2xs">
                  Descarregar ↗
                </a>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="py-6 text-center text-xs text-ink/60 italic bg-cream-50/50 rounded-xl border border-dashed border-steel/25">
            Aquest bé no té factures ni documents d'evidència adjunts.
          </div>
        {% endif %}
      </div>

    </div>

    {# Columna 3: Traçabilitat Forense, Criptogràfica & IA (3 Cols) #}
    <div class="lg:col-span-3 space-y-6">
      
      {# Segellat & Estat Criptogràfic #}
      <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs space-y-4">
        <div class="pb-3 border-b border-steel/15">
          <h2 class="font-marcellus text-sm font-bold text-ink uppercase tracking-wider text-gold">
            Garantia Notarial & Criptogràfica
          </h2>
        </div>

        <div class="space-y-3 text-xs font-raleway">
          <div class="p-3 rounded-xl bg-ink text-white space-y-1.5">
            <span class="text-[10px] uppercase font-mono tracking-wider text-gold font-bold block">Polygon PoS (Layer 2)</span>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span class="text-xs font-bold">Fingerprint SHA-256 Registrat</span>
            </div>
          </div>

          <div class="p-3 rounded-xl bg-cream-50 border border-gold/30 space-y-1.5">
            <span class="text-[10px] uppercase font-mono tracking-wider text-steel font-bold block">Segellat eIDAS (Signaturit)</span>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-bold text-ink">Segell Qualificat de Temps</span>
            </div>
          </div>
        </div>

        {# Avís d'Immutabilitat Notarial #}
        <div class="border-l-[3.5px] border-gold bg-gold/10 p-3 rounded-r-xl font-raleway text-[11px] text-ink/80 leading-relaxed">
          <strong>Immutabilitat:</strong> Qualsevol alteració de les dades o proves genera un nou hash SHA-256 i crea una nova versió a l'històric d'auditoria.
        </div>
      </div>

      {# Traçabilitat d'Assistència d'IA Sobirana #}
      <div class="bg-white rounded-2xl border border-steel/20 p-5 shadow-xs space-y-3">
        <div class="pb-3 border-b border-steel/15">
          <h2 class="font-marcellus text-sm font-bold text-ink uppercase tracking-wider text-gold">
            Traçabilitat IA Sobirana
          </h2>
        </div>

        <div class="text-xs font-raleway space-y-2">
          <div class="flex items-center justify-between text-ink/75">
            <span>Model de Visió:</span>
            <span class="font-mono font-bold text-ink">Qwen-VL</span>
          </div>
          <div class="flex items-center justify-between text-ink/75">
            <span>Node Execució:</span>
            <span class="font-mono font-bold text-emerald-700">SGLang Local</span>
          </div>
          <div class="flex items-center justify-between text-ink/75">
            <span>Compliment AI Act:</span>
            <span class="font-bold text-ink">Human-in-the-Loop</span>
          </div>
        </div>
      </div>

    </div>

  </div>

</div>

{# Modal Notarial de Canvi d'Estat del Bé #}
<div id="status-modal" class="hidden fixed inset-0 z-50 bg-ink/65 backdrop-blur-xs flex items-center justify-center p-4">
  <div class="bg-white border border-gold/40 rounded-2xl shadow-2xl max-w-md w-full overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <div class="h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>
    
    <div class="p-6">
      <div class="flex items-center justify-between pb-3 border-b border-steel/15 mb-4">
        <h3 class="font-marcellus text-lg text-ink font-bold">Modificar Estat del Bé</h3>
        <button type="button" onclick="closeStatusModal()" class="text-steel hover:text-ink text-sm font-bold cursor-pointer">✕</button>
      </div>

      <form method="post" action="{{ path('app_admin_item_update_status', {cui: item.cui}) }}" class="space-y-4">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_item_status_' ~ item.id) }}" />

        <div>
          <label for="item-status" class="block text-xs font-bold text-ink mb-1.5 font-raleway">Selecciona el nou estat</label>
          <select id="item-status" name="status" class="w-full bg-cream-50 border border-steel/30 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-ink focus:ring-2 focus:ring-gold font-raleway">
            {% for st in statuses %}
              <option value="{{ st.value }}" {{ item.status == st ? 'selected' : '' }}>
                {{ st.label }} ({{ st.value }})
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="border-l-[3.5px] border-gold bg-gold/10 p-3 rounded-r-xl font-raleway text-[11px] text-ink/80 leading-relaxed">
          <strong>Atenció Administrativa:</strong> Canviar l'estat d'un bé a <em>"Revisió pendent"</em> o <em>"Denunciat per robatori"</em> afectarà immediatament la seva validesa pública i l'emissió de certificats.
        </div>

        <div class="pt-3 border-t border-steel/15 flex items-center justify-end gap-3">
          <button type="button" onclick="closeStatusModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-ink bg-cream hover:bg-cream/80 transition-colors cursor-pointer">
            Cancel·lar
          </button>
          <button type="submit" class="px-5 py-2 rounded-xl text-xs font-bold text-gold bg-ink hover:bg-ink/90 border border-gold/40 transition-colors shadow-xs cursor-pointer">
            Confirmar Canvi
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openStatusModal() {
    document.getElementById('status-modal').classList.remove('hidden');
  }
  function closeStatusModal() {
    document.getElementById('status-modal').classList.add('hidden');
  }
</script>
{% endblock %}
