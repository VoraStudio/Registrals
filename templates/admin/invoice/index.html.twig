{% extends 'admin/layout.html.twig' %}

{% block title %}Llibre de Factures Emeses & AEAT — Administració Registrals{% endblock %}

{% block admin_content %}
<div class="space-y-6">

  {# Fil d'Ariadna de Ruta Canònic #}
  <nav class="flex items-center gap-2 text-xs font-semibold font-raleway text-ink/65 flex-wrap">
    <a href="{{ path('app_admin_dashboard') }}" class="hover:text-ink transition-colors">Inici</a>
    <span>/</span>
    <span class="text-ink font-bold">Llibre de Factures Emeses</span>
  </nav>

  {# Capçalera de Pàgina Panoràmica 16:9 #}
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="font-marcellus text-2xl sm:text-3xl text-ink tracking-tight font-medium">Llibre de Factures Emeses &amp; Fiscalitat</h1>
      <p class="font-raleway text-xs sm:text-sm text-ink/70 mt-1">
        Registre oficial auditable F1, F2 i R1 amb encadenament VeriFactu i exportació per a gestoria fiscal.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <a href="{{ path('app_admin_invoices_export_csv', {year: selectedYear, quarter: selectedQuarter}) }}" 
         class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-raleway font-bold text-xs uppercase tracking-wider shadow-2xs transition-all cursor-pointer">
        <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Exportar CSV Gestoria (A3/Sage)</span>
      </a>

      <a href="{{ path('app_admin_billing_config') }}" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white border border-steel/30 text-ink hover:border-gold hover:text-gold text-xs font-semibold font-raleway shadow-2xs transition-all">
        <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span>Dades Emissor</span>
      </a>
    </div>
  </div>

  {# 4 Targetes KPI de Mètriques Fiscals #}
  <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl border border-steel/20 p-4 shadow-xs">
      <div class="text-[11px] font-mono uppercase tracking-wider text-ink/60">Factures del Període</div>
      <div class="font-mono text-xl sm:text-2xl font-bold text-ink mt-1">{{ kpis.count }}</div>
      <div class="text-[10px] text-steel mt-0.5">Documents comptabilitzats</div>
    </div>

    <div class="bg-white rounded-2xl border border-steel/20 p-4 shadow-xs">
      <div class="text-[11px] font-mono uppercase tracking-wider text-ink/60">Base Imposable Total</div>
      <div class="font-mono text-xl sm:text-2xl font-bold text-ink mt-1">{{ kpis.subtotalFormatted }}</div>
      <div class="text-[10px] text-steel mt-0.5">Ingressos nets d'impostos</div>
    </div>

    <div class="bg-white rounded-2xl border border-steel/20 p-4 shadow-xs">
      <div class="text-[11px] font-mono uppercase tracking-wider text-ink/60">Quota IVA Repercutit (21%)</div>
      <div class="font-mono text-xl sm:text-2xl font-bold text-gold mt-1">{{ kpis.vatFormatted }}</div>
      <div class="text-[10px] text-steel mt-0.5">A liquidar al Model 303 AEAT</div>
    </div>

    <div class="bg-white rounded-2xl border border-steel/20 p-4 shadow-xs">
      <div class="text-[11px] font-mono uppercase tracking-wider text-ink/60">Total Facturat (Brut)</div>
      <div class="font-mono text-xl sm:text-2xl font-bold text-emerald-800 mt-1">{{ kpis.totalFormatted }}</div>
      <div class="text-[10px] text-steel mt-0.5">Cobraments totals processats</div>
    </div>
  </div>

  {# Barra de Filtres per Any i Trimestre #}
  <div class="bg-white rounded-2xl border border-steel/20 p-4 shadow-xs">
    <form method="get" action="{{ path('app_admin_invoices') }}" class="flex flex-wrap items-center justify-between gap-3">
      <input type="hidden" name="limit" value="{{ currentLimit }}" />
      <div class="flex items-center gap-3">
        <div>
          <label class="block text-[10px] font-mono uppercase text-ink/60 mb-1">Exercici Fiscal</label>
          <select name="year" onchange="this.form.submit()" class="px-3 py-1.5 rounded-lg border border-steel/30 bg-white text-xs font-mono font-bold text-ink focus:outline-none focus:border-gold">
            {% for y in 2026..2028 %}
              <option value="{{ y }}" {{ selectedYear == y ? 'selected' : '' }}>{{ y }}</option>
            {% endfor %}
          </select>
        </div>

        <div>
          <label class="block text-[10px] font-mono uppercase text-ink/60 mb-1">Període Trimestral</label>
          <select name="quarter" onchange="this.form.submit()" class="px-3 py-1.5 rounded-lg border border-steel/30 bg-white text-xs font-mono text-ink focus:outline-none focus:border-gold">
            <option value="0" {{ selectedQuarter == 0 ? 'selected' : '' }}>Tots els mesos (Any sencer)</option>
            <option value="1" {{ selectedQuarter == 1 ? 'selected' : '' }}>1r Trimestre (T1: Gen-Mar)</option>
            <option value="2" {{ selectedQuarter == 2 ? 'selected' : '' }}>2n Trimestre (T2: Abr-Jun)</option>
            <option value="3" {{ selectedQuarter == 3 ? 'selected' : '' }}>3r Trimestre (T3: Jul-Set)</option>
            <option value="4" {{ selectedQuarter == 4 ? 'selected' : '' }}>4t Trimestre (T4: Oct-Des)</option>
          </select>
        </div>
      </div>

      <div class="text-xs text-steel font-raleway">
        Filtrat per: <strong>{{ selectedQuarter > 0 ? ('Trimestre ' ~ selectedQuarter ~ ' / ' ~ selectedYear) : ('Tot l\'exercici ' ~ selectedYear) }}</strong>
      </div>
    </form>
  </div>

  {# Taula Notarial d'Alta Densitat #}
  <div class="bg-white rounded-2xl border border-steel/20 shadow-xs overflow-hidden">
    {% if invoices is not empty %}
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-raleway">
          <thead class="bg-cream/40 border-b border-steel/15 text-[10px] uppercase font-mono tracking-wider text-ink/70">
            <tr>
              <th class="py-3 px-4">Data Emissió</th>
              <th class="py-3 px-4">Núm. Factura</th>
              <th class="py-3 px-4">Tipus</th>
              <th class="py-3 px-4">Client / NIF</th>
              <th class="py-3 px-4 text-right">Base</th>
              <th class="py-3 px-4 text-right">IVA (21%)</th>
              <th class="py-3 px-4 text-right">Total</th>
              <th class="py-3 px-4 text-center">VeriFactu Hash</th>
              <th class="py-3 px-4 text-center">Estat</th>
              <th class="py-3 px-4 text-right">Accions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-steel/10 bg-white">
            {% for inv in invoices %}
              <tr class="hover:bg-cream/20 transition-colors">
                <td class="py-3 px-4 font-mono text-xs text-ink/75 whitespace-nowrap">
                  {{ inv.issuedAt|date('d/m/Y') }}
                </td>
                <td class="py-3 px-4 font-mono font-bold text-xs text-ink whitespace-nowrap">
                  {{ inv.invoiceNumber }}
                </td>
                <td class="py-3 px-4 whitespace-nowrap">
                  {% if inv.invoiceType.value == 'F1' %}
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-blue-50 text-blue-800 border border-blue-200">
                      F1 Completa
                    </span>
                  {% elseif inv.invoiceType.value == 'F2' %}
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-gray-100 text-gray-700 border border-gray-200">
                      F2 Simplificada
                    </span>
                  {% else %}
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-50 text-rose-800 border border-rose-200">
                      R1 Rectificativa
                    </span>
                  {% endif %}
                </td>
                <td class="py-3 px-4 min-w-[200px]">
                  <div class="font-bold text-ink truncate">{{ inv.customerSnapshot['legal_name']|default('Consumidor Final') }}</div>
                  <div class="text-[10px] font-mono text-steel mt-0.5">
                    {{ inv.customerSnapshot['tax_id'] ? ('NIF: ' ~ inv.customerSnapshot['tax_id']) : 'Sense NIF facilitat' }}
                  </div>
                </td>
                <td class="py-3 px-4 text-right font-mono text-ink whitespace-nowrap">
                  {{ inv.subtotalFormatted }}
                </td>
                <td class="py-3 px-4 text-right font-mono text-gold font-semibold whitespace-nowrap">
                  {{ inv.vatAmountFormatted }}
                </td>
                <td class="py-3 px-4 text-right font-mono font-bold text-ink whitespace-nowrap">
                  {{ inv.totalFormatted }}
                </td>
                <td class="py-3 px-4 text-center whitespace-nowrap font-mono text-[9px] text-steel" title="{{ inv.currentHash }}">
                  {{ inv.currentHash|slice(0, 8) }}...{{ inv.currentHash|slice(-4) }}
                </td>
                <td class="py-3 px-4 text-center whitespace-nowrap">
                  {% if inv.invoiceType.value == 'R1' %}
                    <span class="inline-flex items-center justify-center gap-1.5 w-24 py-0.5 rounded-full bg-cream text-ink text-[10px] font-mono font-bold border border-gold/40">
                      <span class="w-1.5 h-1.5 rounded-full bg-ink shrink-0"></span> Abonada
                    </span>
                  {% elseif inv.status.value == 'paid' %}
                    <span class="inline-flex items-center justify-center gap-1.5 w-24 py-0.5 rounded-full bg-emerald-50 text-emerald-800 text-[10px] font-mono font-bold border border-emerald-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span> Cobrada
                    </span>
                  {% elseif inv.status.value == 'refunded' %}
                    <div class="inline-flex flex-col items-center gap-1">
                      <span class="inline-flex items-center justify-center gap-1.5 w-24 py-0.5 rounded-full bg-emerald-50 text-emerald-800 text-[10px] font-mono font-bold border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span> Cobrada
                      </span>
                      <span class="inline-flex items-center justify-center gap-1.5 w-24 py-0.5 rounded-full bg-rose-50 text-rose-800 text-[10px] font-mono font-bold border border-rose-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500 shrink-0"></span> Rectificada
                      </span>
                    </div>
                  {% else %}
                    <span class="inline-flex items-center justify-center gap-1.5 w-24 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[10px] font-mono font-bold border border-slate-300">
                      {{ inv.status.label }}
                    </span>
                  {% endif %}
                </td>
                <td class="py-3 px-4 text-right whitespace-nowrap">
                  <div class="inline-flex items-center justify-end gap-1.5 min-w-[150px]">
                    <a href="{{ path('app_admin_invoice_pdf', {uuid: inv.uuid}) }}" target="_blank"
                       class="w-16 h-7 inline-flex items-center justify-center gap-1 rounded-lg bg-cream/50 hover:bg-gold hover:text-ink text-ink border border-gold/40 text-xs font-semibold transition-all shadow-2xs">
                      <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                      <span>PDF</span>
                    </a>

                    {% if inv.status.value == 'paid' and inv.invoiceType.value != 'R1' and inv.paymentTransaction is not null and inv.paymentTransaction.type.value == 'subscription' %}
                      {% set isWithin14 = inv.isWithinWithdrawalPeriod(14) %}
                      <button type="button" 
                              onclick="openRefundModal('{{ inv.id }}', '{{ inv.invoiceNumber }}', '{{ inv.totalFormatted }}', '{{ inv.customerSnapshot['legal_name']|default('Client')|e('js') }}', {{ isWithin14 ? 'true' : 'false' }})"
                              class="w-20 h-7 inline-flex items-center justify-center gap-1 rounded-lg {{ isWithin14 ? 'bg-rose-50 hover:bg-rose-100 text-rose-800 border border-rose-200' : 'bg-slate-100 hover:bg-slate-200 text-slate-600 border border-slate-300' }} text-xs font-semibold transition-all shadow-2xs cursor-pointer"
                              title="{{ isWithin14 ? 'Abonar subscripció (Dret legal de desistiment — 14 dies)' : 'Abonar subscripció (> 14 dies, concessió comercial extraordinària)' }}">
                        <svg class="w-3.5 h-3.5 shrink-0 {{ isWithin14 ? 'text-rose-600' : 'text-slate-500' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a5 5 0 015 5v2M3 10l6 6m-6-6l6-6"/></svg>
                        <span>Abonar</span>
                      </button>

                      <form id="refund-form-{{ inv.id }}" method="post" action="{{ path('app_admin_invoice_refund', {uuid: inv.uuid}) }}" class="hidden">
                        <input type="hidden" name="_token" value="{{ csrf_token('refund_invoice_' ~ inv.uuid.toRfc4122) }}">
                        <input type="hidden" name="reason" id="refund-reason-{{ inv.id }}" value="">
                      </form>
                    {% else %}
                      <span class="w-20 inline-block" aria-hidden="true"></span>
                    {% endif %}
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {# Paginació #}
      {% if totalItems > 0 %}
        <div class="px-4 sm:px-6 py-4 border-t border-steel/15 bg-cream-50/50 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-raleway">
          <div class="flex items-center gap-3 flex-wrap">
            <span class="text-ink/65">
              Mostrant <span class="font-bold text-ink">{{ invoices|length }}</span> de <span class="font-bold text-ink">{{ totalItems }}</span> factures
              {% if totalPages > 1 %}
                &middot; Pàgina <span class="font-bold text-ink">{{ currentPage }}</span> de <span class="font-bold text-ink">{{ totalPages }}</span>
              {% endif %}
            </span>

            {# Selector de Quantitat per Pàgina #}
            <div class="flex items-center gap-1.5 pl-3 border-l border-steel/20">
              <span class="text-ink/50 text-[11px]">Per pàgina:</span>
              {% for l in [10, 25, 50, 100] %}
                <a href="{{ path('app_admin_invoices', {page: 1, year: selectedYear, quarter: selectedQuarter, limit: l}) }}" 
                   class="px-2 py-0.5 rounded-md text-[11px] font-mono font-bold transition-colors {{ currentLimit == l ? 'bg-ink text-gold border border-gold/40 shadow-2xs' : 'bg-white hover:bg-cream border border-steel/25 text-ink/70' }}">
                  {{ l }}
                </a>
              {% endfor %}
            </div>
          </div>

          {% if totalPages > 1 %}
            <div class="flex items-center gap-1.5">
              {% if currentPage > 1 %}
                <a href="{{ path('app_admin_invoices', {page: currentPage - 1, year: selectedYear, quarter: selectedQuarter, limit: currentLimit}) }}" class="px-3 py-1.5 rounded-lg border border-steel/25 bg-white text-ink font-semibold hover:bg-cream-50 transition-colors">
                  &larr; Anterior
                </a>
              {% endif %}
              {% if currentPage < totalPages %}
                <a href="{{ path('app_admin_invoices', {page: currentPage + 1, year: selectedYear, quarter: selectedQuarter, limit: currentLimit}) }}" class="px-3 py-1.5 rounded-lg border border-steel/25 bg-white text-ink font-semibold hover:bg-cream-50 transition-colors">
                  Següent &rarr;
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% else %}
      <div class="p-8 text-center text-ink/65 font-raleway text-sm">
        No hi ha cap factura registrada per a l'exercici i període seleccionats.
      </div>
    {% endif %}
  </div>

  {# Modal Canònic de Confirmació de Reemborsament #}
  <div id="refund-modal" class="hidden fixed inset-0 z-50 bg-ink/75 backdrop-blur-xs items-end sm:items-center justify-center p-0 sm:p-4 transition-all duration-200" onclick="if(event.target === this) closeRefundModal();">
    <div class="bg-white rounded-t-3xl sm:rounded-2xl border-t sm:border border-gold/40 shadow-2xl max-w-lg w-full max-h-[90vh] sm:max-h-[92vh] overflow-hidden flex flex-col animate-in fade-in zoom-in-95 duration-150">
      {# Nansa tàctil mòbil #}
      <div class="sm:hidden w-10 h-1 bg-steel/30 rounded-full mx-auto mt-2 -mb-1 shrink-0"></div>

      {# Capçalera Solemne #}
      <div class="p-4 sm:p-5 border-b border-steel/15 flex items-center justify-between bg-cream/30">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a5 5 0 015 5v2M3 10l6 6m-6-6l6-6"/></svg>
          </div>
          <div>
            <h3 class="font-marcellus text-base sm:text-lg text-ink font-bold leading-tight">
              Reemborsament Oficial Stripe
            </h3>
            <p class="text-[11px] font-mono text-steel" id="modal-invoice-ref">Factura ---</p>
          </div>
        </div>
        <button type="button" onclick="closeRefundModal()" class="w-8 h-8 rounded-lg bg-white border border-steel/20 text-steel hover:text-ink flex items-center justify-center text-sm font-bold cursor-pointer">
          ✕
        </button>
      </div>

      {# Cos del Modal #}
      <div class="p-4 sm:p-5 overflow-y-auto space-y-3 font-raleway text-xs sm:text-sm text-ink/80 leading-relaxed">
        <p>
          Estàs a punt d'executar un reemborsament a través de l'API de Stripe per un import de <strong class="text-rose-700 font-mono text-sm" id="modal-invoice-amount">0,00 €</strong> a favor de <strong id="modal-customer-name">Client</strong>.
        </p>

        {# Avís dinàmic de període de desistiment #}
        <div id="modal-period-alert"></div>

        <div class="p-3.5 rounded-xl bg-gold/10 border-l-[3.5px] border-gold text-ink text-xs font-raleway space-y-1">
          <strong>Efectes Automàtics de l'Abonament:</strong>
          <ul class="list-disc pl-4 space-y-0.5 text-ink/80 text-[11px] pt-1">
            <li>Retorn immediat dels diners a la targeta del titular via Stripe.</li>
            <li>Cancel·lació de la subscripció recurrent a Stripe si correspon a un Pla Plus.</li>
            <li>Retorn del compte d'usuari al <strong>Pla Free</strong> (amb 7 dies de gràcia si té >20 béns).</li>
            <li>Emissió automàtica d'una <strong>Factura Rectificativa R1</strong> encadenada a VeriFactu.</li>
          </ul>
        </div>

        <div>
          <label class="block text-[11px] font-semibold text-ink/80 mb-1">Motiu del Reemborsament / Abonament</label>
          <input type="text" id="modal-refund-reason" 
                 value="Dret de desistiment (14 dies) sol·licitat pel titular" 
                 class="w-full px-3 py-2 rounded-lg border border-steel/30 text-xs font-raleway text-ink focus:outline-none focus:border-gold" />
        </div>
      </div>

      {# Peu d'accions #}
      <div class="p-4 bg-cream-50/50 border-t border-steel/15 flex flex-col sm:flex-row items-center justify-end gap-2.5">
        <button type="button" onclick="closeRefundModal()" class="w-full sm:w-auto px-4 py-2 rounded-xl border border-steel/30 bg-white text-ink/80 hover:text-ink text-xs font-semibold text-center transition-all cursor-pointer">
          Cancel·lar
        </button>
        <button type="button" onclick="confirmRefund()" id="modal-confirm-btn" class="w-full sm:w-auto px-5 py-2 rounded-xl bg-rose-700 hover:bg-rose-800 text-white font-bold text-xs uppercase tracking-wider text-center transition-all shadow-sm flex items-center justify-center gap-1.5 cursor-pointer">
          <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7"/></svg>
          <span id="modal-confirm-btn-label">Confirmar i Executar a Stripe</span>
        </button>
      </div>
    </div>
  </div>

</div>

<script>
  let activeRefundInvoiceId = null;

  function openRefundModal(id, invoiceNumber, amount, customerName, isWithin14) {
    activeRefundInvoiceId = id;
    document.getElementById('modal-invoice-ref').textContent = 'Factura ' + invoiceNumber;
    document.getElementById('modal-invoice-amount').textContent = amount;
    document.getElementById('modal-customer-name').textContent = customerName;

    const alertBox = document.getElementById('modal-period-alert');
    const reasonInput = document.getElementById('modal-refund-reason');
    const confirmBtn = document.getElementById('modal-confirm-btn');
    const confirmLabel = document.getElementById('modal-confirm-btn-label');

    if (isWithin14) {
      alertBox.innerHTML = '<div class="p-2.5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center gap-2 font-raleway"><svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg><span><strong>Dins de termini:</strong> Aquesta factura està dins dels 14 dies de dret legal de desistiment (Art. 102 TRLGDCU).</span></div>';
      reasonInput.value = 'Dret de desistiment (14 dies) sol·licitat pel titular';
      confirmBtn.className = 'w-full sm:w-auto px-5 py-2 rounded-xl bg-rose-700 hover:bg-rose-800 text-white font-bold text-xs uppercase tracking-wider text-center transition-all shadow-sm flex items-center justify-center gap-1.5 cursor-pointer';
      confirmLabel.textContent = 'Confirmar i Executar a Stripe';
    } else {
      alertBox.innerHTML = '<div class="p-2.5 rounded-lg bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-start gap-2 font-raleway"><svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg><span><strong>Fora de termini (&gt; 14 dies):</strong> El titular ja no disposa del dret legal de desistiment. Aquest abonament s\'executarà com a concessió comercial extraordinària de l\'administració.</span></div>';
      reasonInput.value = 'Abonament comercial extraordinari autoritzat per administració';
      confirmBtn.className = 'w-full sm:w-auto px-5 py-2 rounded-xl bg-slate-700 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider text-center transition-all shadow-sm flex items-center justify-center gap-1.5 cursor-pointer';
      confirmLabel.textContent = 'Confirmar Abonament Extraordinari';
    }

    const modal = document.getElementById('refund-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
  }

  function closeRefundModal() {
    activeRefundInvoiceId = null;
    const modal = document.getElementById('refund-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  }

  function confirmRefund() {
    if (!activeRefundInvoiceId) return;
    const reasonInput = document.getElementById('modal-refund-reason');
    const targetReason = document.getElementById('refund-reason-' + activeRefundInvoiceId);
    const targetForm = document.getElementById('refund-form-' + activeRefundInvoiceId);
    if (targetReason && targetForm) {
      targetReason.value = reasonInput.value.trim() || 'Sol·licitat pel titular';
      targetForm.submit();
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeRefundModal();
  });
</script>
{% endblock %}

