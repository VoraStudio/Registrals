<!doctype html>
<html lang="ca"{% block html_attributes %}{% endblock %}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}{% endblock %}" />
    <meta name="robots" content="{% block meta_robots %}index, follow{% endblock %}" />
    <meta name="theme-color" content="#1D2F4B" />
    <link rel="canonical" href="{% block canonical_url %}{% endblock %}" />
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}" />
    <meta property="og:title" content="{% block og_title %}{% endblock %}" />
    <meta property="og:description" content="{% block og_description %}{% endblock %}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ block('canonical_url') }}" />
    <meta property="og:site_name" content="Registrals" />
    <meta property="og:locale" content="ca_ES" />
    {# Absolute URLs: these files are served as-is from web/img/ (not through AssetMapper) #}
    <meta property="og:image" content="https://www.registrals.com/img/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Registrals — El registre dels teus béns, a un clic" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.registrals.com/img/og-image.png" />
    {% block structured_data %}{% endblock %}
    {# Built by symfonycasts/tailwind-bundle (php bin/console tailwind:build) #}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}" />
    <link rel="preload" href="{{ asset('fonts/Marcellus-Regular.ttf') }}" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="{{ asset('fonts/Raleway-Regular.ttf') }}" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="{{ asset('css/fonts.css') }}" />
    {% block head_extra %}{% endblock %}
  </head>
  <body class="{% block body_class %}{% endblock %}">
    {% block body %}{% endblock %}

    {% include 'partials/_cookie_banner.html.twig' with { cookie_policy_href: cookie_policy_href } only %}
    {% block javascripts %}
    <script src="{{ asset('js/cookies.js') }}" defer></script>
    {% endblock %}
  </body>
</html>
