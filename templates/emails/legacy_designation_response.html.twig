{% set isRenounced = renounced|default(false) %}
<!DOCTYPE html>
<html lang="ca">
<head>
  <meta charset="UTF-8">
  <title>{{ accepted ? 'Designació acceptada' : (isRenounced ? 'Renúncia de persona de confiança' : 'Designació declinada') }} — Registrals</title>
</head>
<body style="margin: 0; padding: 0; background-color: #FAF6F0; font-family: 'Raleway', Helvetica, Arial, sans-serif; color: #1D2F4B;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #FAF6F0; padding: 30px 15px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" style="max-width: 600px; background-color: #FFFFFF; border-radius: 20px; border: 1px solid rgba(202, 163, 108, 0.4); overflow: hidden; box-shadow: 0 10px 25px rgba(29, 47, 75, 0.08);">
          <tr>
            <td style="height: 6px; background: linear-gradient(90deg, #1D2F4B 0%, #CAA36C 50%, #1D2F4B 100%);"></td>
          </tr>

          <tr>
            <td style="padding: 30px 40px 20px; text-align: center; border-bottom: 1px solid rgba(106, 134, 162, 0.15);">
              <h1 style="font-family: 'Marcellus', Georgia, serif; font-size: 26px; color: #1D2F4B; margin: 0 0 5px; letter-spacing: 1px;">REGISTRALS</h1>
              <p style="font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: #CAA36C; font-weight: bold; margin: 0;">Herència Digital &amp; Custòdia</p>
            </td>
          </tr>

          <tr>
            <td style="padding: 35px 40px;">
              <h2 style="font-family: 'Marcellus', Georgia, serif; font-size: 20px; color: #1D2F4B; margin: 0 0 15px;">
                {% if accepted %}
                  Consentiment de Persona de Confiança Confirmat
                {% elseif isRenounced %}
                  Renúncia de Persona de Confiança (Art. 7.3 RGPD)
                {% else %}
                  Designació de Persona de Confiança Declinada
                {% endif %}
              </h2>

              <p style="font-size: 14px; line-height: 1.6; color: #1D2F4B; margin: 0 0 16px;">
                Hola {{ owner.firstName }},
              </p>

              {% if accepted %}
                <p style="font-size: 14px; line-height: 1.6; color: #1D2F4B; margin: 0 0 22px;">
                  T'informem que <strong>{{ contact.fullName }}</strong> (<code>{{ contact.email }}</code>) ha acceptat formalment figurar com la teva <strong>Persona de Confiança</strong> dins el marc de l'Art. 96 de la LOPDGDD.
                </p>
                <div style="border-left: 3.5px solid #10B981; background-color: rgba(16, 185, 129, 0.08); padding: 12px 16px; border-radius: 0 10px 10px 0; margin-bottom: 24px; font-size: 12.5px; color: #1D2F4B; line-height: 1.55;">
                  <strong>Estat actualitzat:</strong> El consentiment ja consta actiu al teu perfil. Recorda que pots revocar aquesta designació en qualsevol moment des del teu espai privat.
                </div>
              {% elseif isRenounced %}
                <p style="font-size: 14px; line-height: 1.6; color: #1D2F4B; margin: 0 0 22px;">
                  T'informem que <strong>{{ contact.fullName }}</strong> (<code>{{ contact.email }}</code>) ha exercit el dret de retirada de consentiment i ha <strong>renunciat</strong> a continuar figurant com la teva Persona de Confiança. Qualsevol certificat d'Inventari Global de Llegat vinculat ha quedat revocat automàticament i ja disposes de la plaça lliure al teu perfil.
                </p>
              {% else %}
                <p style="font-size: 14px; line-height: 1.6; color: #1D2F4B; margin: 0 0 22px;">
                  T'informem que <strong>{{ contact.fullName }}</strong> (<code>{{ contact.email }}</code>) ha optat per declinar la designació com a Persona de Confiança. La teva capacitat disponible al perfil s'ha alliberat perquè puguis designar un altre contacte si ho desitges.
                </p>
              {% endif %}

              <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                <tr>
                  <td align="center">
                    <a href="{{ profileUrl }}" style="display: inline-block; background-color: #1D2F4B; color: #CAA36C; font-size: 13px; font-weight: bold; text-decoration: none; padding: 13px 26px; border-radius: 12px; border: 1px solid rgba(202, 163, 108, 0.5); text-transform: uppercase; letter-spacing: 1px;">
                      Gestionar al meu Perfil &rarr;
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding: 18px 40px; background-color: #FAF6F0; border-top: 1px solid rgba(106, 134, 162, 0.15); text-align: center; font-size: 11px; color: #6A86A2;">
              &copy; {{ "now"|date("Y") }} Registrals &middot; Notificació automatitzada de seguretat.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>

