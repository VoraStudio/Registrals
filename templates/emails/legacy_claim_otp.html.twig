<!DOCTYPE html>
<html lang="ca">
<head>
  <meta charset="UTF-8">
  <title>Codi de Verificació d'Expedient Successori — Registrals</title>
</head>
<body style="margin: 0; padding: 0; background-color: #FAF6F0; font-family: 'Raleway', Helvetica, Arial, sans-serif; color: #1D2F4B;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #FAF6F0; padding: 30px 15px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" style="max-width: 580px; background-color: #FFFFFF; border-radius: 20px; border: 1px solid rgba(202, 163, 108, 0.4); overflow: hidden; box-shadow: 0 10px 25px rgba(29, 47, 75, 0.08);">
          <tr><td style="height: 6px; background: linear-gradient(90deg, #1D2F4B 0%, #CAA36C 50%, #1D2F4B 100%);"></td></tr>
          <tr>
            <td style="padding: 28px 36px 18px; text-align: center; border-bottom: 1px solid rgba(106, 134, 162, 0.15);">
              <h1 style="font-family: 'Marcellus', Georgia, serif; font-size: 26px; color: #1D2F4B; margin: 0 0 4px;">REGISTRALS</h1>
              <p style="font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: #CAA36C; font-weight: bold; margin: 0;">Verificació d'Identitat Successòria</p>
            </td>
          </tr>
          <tr>
            <td style="padding: 32px 36px;">
              <p style="font-size: 14px; line-height: 1.6; margin: 0 0 14px;">Hola {{ claimantName }},</p>
              <p style="font-size: 14px; line-height: 1.6; margin: 0 0 22px;">
                Introdueix el següent codi de verificació per continuar amb l'obertura d'expedient sobre el certificat <strong>{{ certificateNumber }}</strong>:
              </p>
              <div style="text-align: center; margin: 0 0 24px;">
                <span style="display: inline-block; background-color: #1D2F4B; color: #CAA36C; font-family: monospace; font-size: 28px; font-weight: bold; letter-spacing: 8px; padding: 14px 28px; border-radius: 14px; border: 1px solid #CAA36C;">{{ otpCode }}</span>
              </div>
              <div style="border-left: 3.5px solid #CAA36C; background-color: rgba(202, 163, 108, 0.09); padding: 12px 16px; border-radius: 0 10px 10px 0; font-size: 12px; line-height: 1.5;">
                Aquest codi caduca d'aquí a <strong>15 minuts</strong>. Si no has sol·licitat aquesta tramitació, ignora aquest missatge.
              </div>
            </td>
          </tr>
          <tr>
            <td style="padding: 18px 36px; background-color: #FAF6F0; border-top: 1px solid rgba(106, 134, 162, 0.15); text-align: center; font-size: 11px; color: #6A86A2;">
              © {{ 'now'|date('Y') }} Registrals · Custòdia contractual i certificació digital.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>

