{% extends 'base.html.twig' %}

{% block title %}Benvingut a Registrals — El teu espai segur de custòdia{% endblock %}
{% block meta_description %}Comença a protegir el teu patrimoni moble amb certificació digital de propietat i tecnologia notarial avançada.{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {# Barra Superior Unificada (Fons Blanc + Línia Tènue) #}
  <header class="border-b border-steel/20 bg-white sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
      <div class="flex items-center gap-2.5 sm:gap-3.5">
        <img src="{{ asset('img/logos/Isotip/1-transparent.svg') }}" alt="Isotip Registrals" class="w-8 h-8 sm:w-10 sm:h-10" />
        <span class="font-marcellus tracking-widest uppercase text-lg sm:text-2xl text-ink font-medium">Registrals</span>
      </div>
      <div class="flex items-center gap-2 text-xs text-steel font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Compte actiu
      </div>
    </div>
  </header>

  {# Contingut Central Onboarding #}
  <main class="w-full max-w-4xl mx-auto my-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
    
    {# Banner de Benvinguda Notarial #}
    <div class="text-center space-y-3">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-ink text-gold border border-gold/40 shadow-md mb-1">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
      <h1 class="text-3xl sm:text-4xl font-marcellus text-ink tracking-wide font-normal">
        Benvingut/da, {{ user.firstName }}!
      </h1>
      <p class="text-sm sm:text-base text-ink/75 max-w-xl mx-auto">
        El teu espai privat de custòdia documental i immutabilitat criptogràfica està preparat.
      </p>
    </div>

    {# 3 Passos Ràpids (El valor de Registrals) #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-white/90 border border-gold/30 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold font-mono text-gold bg-gold/10 px-2 py-0.5 rounded">PAS 1</span>
          <h2 class="font-marcellus text-base text-ink mt-2 font-normal">Registra un objecte</h2>
          <p class="text-xs text-ink/70 mt-1 leading-relaxed">Puja una fotografia del teu bé (joia, bicicleta, rellotge o tecnologia) i el tiquet o factura.</p>
        </div>
      </div>

      <div class="bg-white/90 border border-gold/30 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold font-mono text-gold bg-gold/10 px-2 py-0.5 rounded">PAS 2</span>
          <h2 class="font-marcellus text-base text-ink mt-2 font-normal">CUI Únic i Segellat</h2>
          <p class="text-xs text-ink/70 mt-1 leading-relaxed">L'assistent d'IA extreu les dades i s'emet el teu codi d'identificació notarial únic CUI.</p>
        </div>
      </div>

      <div class="bg-white/90 border border-gold/30 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold font-mono text-gold bg-gold/10 px-2 py-0.5 rounded">PAS 3</span>
          <h2 class="font-marcellus text-base text-ink mt-2 font-normal">Certificat Digital</h2>
          <p class="text-xs text-ink/70 mt-1 leading-relaxed">Descarrega el certificat de custòdia de propietat, apte per a inventaris i reclamacions.</p>
        </div>
      </div>
    </div>

    {# Selector de Plans Informatiu amb el Pla Free Actiu #}
    <div class="bg-white/80 backdrop-blur-md border border-gold/40 rounded-3xl p-6 sm:p-8 shadow-xl space-y-6">
      <div class="text-center space-y-1">
        <h2 class="text-xl sm:text-2xl font-marcellus text-ink font-normal">El teu Pla de Custòdia</h2>
        <p class="text-xs sm:text-sm text-ink/70">Comences automàticament amb el <strong class="text-ink">Pla Free</strong> gratuït. Pots canviar de pla en qualsevol moment.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        
        {# Card Free (Actiu) #}
        <div class="border-2 border-gold rounded-2xl p-5 bg-cream/30 relative flex flex-col justify-between shadow-xs">
          <div class="absolute -top-3 right-4 bg-gold text-ink text-[11px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
            Pla Actiu
          </div>
          <div>
            <h3 class="font-marcellus text-xl text-ink">Free</h3>
            <p class="text-xs text-ink/70 mt-0.5">Custòdia i inventari bàsic</p>
            <div class="mt-3 text-2xl font-bold text-ink">0 €</div>
            <ul class="mt-4 space-y-2 text-xs text-ink/80">
              <li class="flex items-center gap-2">
                <svg class="text-gold shrink-0" style="width: 14px; height: 14px; min-width: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span>Fins a <strong>20 béns</strong> en propietat</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="text-gold shrink-0" style="width: 14px; height: 14px; min-width: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span><strong>2 consultes d'IA</strong> de tast</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="text-gold shrink-0" style="width: 14px; height: 14px; min-width: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span>Certificat esborrany d'inventari</span>
              </li>
            </ul>
          </div>
          <div class="mt-5 text-center text-xs font-semibold text-gold">
            Inclòs al teu compte
          </div>
        </div>

        {# Card Plus (Pròximament) #}
        <div class="border border-steel/20 rounded-2xl p-5 bg-white/60 relative flex flex-col justify-between opacity-80 hover:opacity-100 transition-opacity">
          <div>
            <h3 class="font-marcellus text-xl text-ink">Plus</h3>
            <p class="text-xs text-ink/70 mt-0.5">Col·leccionistes i usuaris actius</p>
            <div class="mt-3 text-2xl font-bold text-ink">22 € <span class="text-xs font-normal text-ink/60">/ any</span></div>
            <ul class="mt-4 space-y-2 text-xs text-ink/70">
              <li class="flex items-center gap-2">
                <svg class="text-steel shrink-0" style="width: 14px; height: 14px; min-width: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Fins a <strong>100 béns</strong></span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="text-steel shrink-0" style="width: 14px; height: 14px; min-width: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Certificats oficials eIDAS</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="text-steel shrink-0" style="width: 14px; height: 14px; min-width: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Traspassos de propietat C2C</span>
              </li>
            </ul>
          </div>
          <button type="button" onclick="if (window.RegistralsToast) { window.RegistralsToast.show('Pla Plus', 'La contractació d\'aquest pla estarà disponible properament. Gaudeix ara del teu Pla Free!', 'info', 4500); }" class="mt-5 w-full py-2 px-3 bg-cream/60 hover:bg-cream text-ink text-xs font-semibold rounded-xl border border-steel/30 transition-all cursor-pointer">
            Pròximament
          </button>
        </div>

        {# Card Unlimited (Pròximament) #}
        <div class="border border-steel/20 rounded-2xl p-5 bg-white/60 relative flex flex-col justify-between opacity-80 hover:opacity-100 transition-opacity">
          <div>
            <h3 class="font-marcellus text-xl text-ink">Unlimited</h3>
            <p class="text-xs text-ink/70 mt-0.5">Patrimoni d'alt valor</p>
            <div class="mt-3 text-2xl font-bold text-ink">A consultar</div>
            <ul class="mt-4 space-y-2 text-xs text-ink/70">
              <li class="flex items-center gap-2">
                <svg class="text-steel shrink-0" style="width: 14px; height: 14px; min-width: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Béns de més de 5.000 €</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="text-steel shrink-0" style="width: 14px; height: 14px; min-width: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Ítems il·limitats</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="text-steel shrink-0" style="width: 14px; height: 14px; min-width: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Gestor personal assignat</span>
              </li>
            </ul>
          </div>
          <button type="button" onclick="if (window.RegistralsToast) { window.RegistralsToast.show('Pla Unlimited', 'La contractació d\'aquest pla estarà disponible properament. Gaudeix ara del teu Pla Free!', 'info', 4500); }" class="mt-5 w-full py-2 px-3 bg-cream/60 hover:bg-cream text-ink text-xs font-semibold rounded-xl border border-steel/30 transition-all cursor-pointer">
            Pròximament
          </button>
        </div>

      </div>

      {# Botó d'Acció Continuar al Dashboard #}
      <form method="post" action="{{ path('app_onboarding_complete') }}" class="pt-2 text-center">
        <button type="submit" style="background-color: #1D2F4B; color: #FAF6F0;" class="inline-flex items-center justify-center gap-2.5 py-3.5 px-8 rounded-xl shadow-lg hover:bg-ink/90 active:scale-[0.99] font-semibold text-sm sm:text-base font-raleway cursor-pointer transition-all">
          <span>Comença a custodiar el teu patrimoni</span>
          <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      </form>
    </div>

  </main>

  {# Peu de pàgina discret #}
  <footer class="w-full max-w-5xl mx-auto pt-6 text-center text-xs text-ink/60">
    <p>&copy; {{ "now"|date("Y") }} Registrals &middot; Plataforma protegida amb seguretat avançada i eIDAS.</p>
  </footer>

</div>
{% endblock %}
