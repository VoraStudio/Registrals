{% extends 'base.html.twig' %}

{% block title %}Crear Compte — Registrals{% endblock %}
{% block meta_description %}Dona't d'alta gratuïtament a Registrals i comença a protegir el teu patrimoni moble amb tecnologia d'última generació.{% endblock %}

{% block body_class %}bg-cream text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream">

  {# Barra Superior Unificada (Fons Blanc + Línia Tènue) #}
  <header class="border-b border-steel/20 bg-white sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
      <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 sm:gap-3.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded-xl p-1" aria-label="Tornar a la pàgina d'inici">
        <img src="{{ asset('img/logos/Isotip/1-transparent.svg') }}" alt="Isotip Registrals" class="w-8 h-8 sm:w-10 sm:h-10 transition-transform duration-300 group-hover:scale-105" />
        <span class="font-marcellus tracking-widest uppercase text-lg sm:text-2xl text-ink font-medium group-hover:text-gold transition-colors">Registrals</span>
      </a>
      <a href="{{ path('app_login') }}" class="text-xs sm:text-sm text-ink/75 hover:text-ink transition-colors flex items-center gap-1 sm:gap-1.5 font-semibold shrink-0">
        <span>Ja tens compte?</span> <strong class="text-ink underline hover:text-gold">Inicia sessió</strong>
      </a>
    </div>
  </header>

  {# Formulari de Registre (Adaptat en horitzontal amb targeta blanc cru tènue) #}
  <main class="w-full max-w-4xl mx-auto my-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="bg-white/80 backdrop-blur-md border border-gold/40 rounded-3xl p-6 sm:p-8 md:p-10 shadow-2xl shadow-ink/10 relative overflow-hidden text-ink">
      {# Lluentor daurada superior #}
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent opacity-80"></div>

      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-cream border border-gold/50 text-gold mb-2.5 shadow-xs">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
        </div>
        <h1 class="text-2xl sm:text-3xl font-marcellus text-ink tracking-wide font-normal">Crea el teu Compte</h1>
        <p class="text-xs sm:text-sm text-ink/70 mt-1 font-raleway">Comença amb el <span class="text-gold font-bold whitespace-nowrap">Pla&nbsp;Free de Custòdia</span> (fins a 20 béns inclosos)</p>
      </div>

      {{ form_start(registrationForm, {
        'attr': {
          'id': 'form-register',
          'class': 'space-y-4',
          'novalidate': 'novalidate',
          'onsubmit': "
            const fn = document.getElementById('registration_form_firstName');
            const ln = document.getElementById('registration_form_lastName');
            const em = document.getElementById('registration_form_email');
            const p1 = document.getElementById('registration_form_plainPassword_first');
            const p2 = document.getElementById('registration_form_plainPassword_second');
            const terms = document.getElementById('registration_form_agreeTerms');

            if (!fn.value.trim()) {
              event.preventDefault();
              if (window.RegistralsToast) window.RegistralsToast.show('Nom requerit', 'Si us plau, indica el teu nom per al registre.', 'error');
              fn.focus();
              return false;
            }
            if (!ln.value.trim()) {
              event.preventDefault();
              if (window.RegistralsToast) window.RegistralsToast.show('Cognoms requerits', 'Si us plau, indica els teus cognoms.', 'error');
              ln.focus();
              return false;
            }
            if (!em.value.trim()) {
              event.preventDefault();
              if (window.RegistralsToast) window.RegistralsToast.show('Correu obligatori', 'Si us plau, introdueix la teva adreça electrònica.', 'error');
              em.focus();
              return false;
            }
            if (!p1.value) {
              event.preventDefault();
              if (window.RegistralsToast) window.RegistralsToast.show('Contrasenya obligatòria', 'Si us plau, defineix una contrasenya de com a mínim 8 caràcters.', 'error');
              p1.focus();
              return false;
            }
            if (p1.value.length < 8) {
              event.preventDefault();
              if (window.RegistralsToast) window.RegistralsToast.show('Contrasenya curta', 'La contrasenya ha de tenir un mínim de 8 caràcters.', 'error');
              p1.focus();
              return false;
            }
            if (p1.value !== p2.value) {
              event.preventDefault();
              if (window.RegistralsToast) window.RegistralsToast.show('Contrasenyes no coincideixen', 'La confirmació de la contrasenya no coincideix amb la contrasenya introduïda.', 'error');
              p2.focus();
              return false;
            }
            if (!terms.checked) {
              event.preventDefault();
              if (window.RegistralsToast) window.RegistralsToast.show('Condicions legals', 'Has d\'acceptar les Condicions Generals i la política de privacitat.', 'error');
              terms.focus();
              return false;
            }
          "
        }
      }) }}

        {# Nota Notarial sobre el Pla Free (Guia d'Estils) #}
        <div class="guide-note mb-4 text-left">
          <strong>Pla Free de Custòdia:</strong> Compte gratuït per defecte amb custòdia de fins a <code>20 béns</code> actius, 1 fotografia i 1 comprovant documental per bé.
        </div>

        {# Layout en 2 columnes en desktop per aprofitar espai horitzontal #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">

          {# Columna Esquerra: Dades d'identitat #}
          <div class="space-y-3.5">
            {# Nom i Cognoms #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                {{ form_label(registrationForm.firstName, null, {'label_attr': {'class': 'block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5 font-raleway'}}) }}
                {{ form_widget(registrationForm.firstName, {'attr': {'class': 'block w-full px-3.5 py-2.5 bg-white/90 border border-steel/30 rounded-xl text-ink text-sm placeholder-steel/60 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/30 focus:bg-white transition-all'}}) }}
                {{ form_errors(registrationForm.firstName, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
              </div>
              <div>
                {{ form_label(registrationForm.lastName, null, {'label_attr': {'class': 'block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5 font-raleway'}}) }}
                {{ form_widget(registrationForm.lastName, {'attr': {'class': 'block w-full px-3.5 py-2.5 bg-white/90 border border-steel/30 rounded-xl text-ink text-sm placeholder-steel/60 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/30 focus:bg-white transition-all'}}) }}
                {{ form_errors(registrationForm.lastName, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
              </div>
            </div>

            {# DNI / NIE #}
            <div>
              {{ form_label(registrationForm.taxId, null, {'label_attr': {'class': 'block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5 font-raleway'}}) }}
              {{ form_widget(registrationForm.taxId, {'attr': {'class': 'block w-full px-3.5 py-2.5 bg-white/90 border border-steel/30 rounded-xl text-ink text-sm placeholder-steel/60 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/30 focus:bg-white transition-all'}}) }}
              {{ form_errors(registrationForm.taxId, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
              <p class="text-[11px] text-ink/60 mt-1">Necessari posteriorment només per a l'emissió de certificats eIDAS.</p>
            </div>

            {# Correu electrònic #}
            <div>
              {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5 font-raleway'}}) }}
              {{ form_widget(registrationForm.email, {'attr': {'class': 'block w-full px-3.5 py-2.5 bg-white/90 border border-steel/30 rounded-xl text-ink text-sm placeholder-steel/60 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/30 focus:bg-white transition-all'}}) }}
              {{ form_errors(registrationForm.email, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
            </div>
          </div>

          {# Columna Dreta: Seguretat i Acció #}
          <div class="space-y-3.5 flex flex-col justify-between">
            <div>
              {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': 'block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5 font-raleway'}}) }}
              {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'block w-full px-3.5 py-2.5 bg-white/90 border border-steel/30 rounded-xl text-ink text-sm placeholder-steel/60 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/30 focus:bg-white transition-all'}}) }}
              {{ form_errors(registrationForm.plainPassword.first, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
            </div>

            <div>
              {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': 'block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5 font-raleway'}}) }}
              {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'block w-full px-3.5 py-2.5 bg-white/90 border border-steel/30 rounded-xl text-ink text-sm placeholder-steel/60 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/30 focus:bg-white transition-all'}}) }}
              {{ form_errors(registrationForm.plainPassword.second, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
            </div>

            {# Termes legals #}
            <div class="pt-1">
              <label class="flex items-start gap-2.5 cursor-pointer text-xs text-ink/80 select-none">
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'mt-0.5 rounded border-steel/40 bg-white accent-gold focus:ring-gold w-4 h-4 shrink-0 cursor-pointer'}}) }}
                <span>
                  He llegit i accepto les <a href="{{ path('app_legal') }}" target="_blank" class="text-gold underline hover:text-ink font-semibold">Condicions Generals</a> i la política de privacitat.
                </span>
              </label>
              {{ form_errors(registrationForm.agreeTerms, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
            </div>

            <button type="submit" class="w-full mt-2 py-3 px-6 bg-ink text-cream font-semibold rounded-xl shadow-lg hover:bg-ink/90 active:scale-[0.99] transition-all flex items-center justify-center gap-2 text-sm sm:text-base uppercase tracking-wider font-raleway cursor-pointer">
              <span>Crear Compte Gratuït</span>
              <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
          </div>

        </div>

      {{ form_end(registrationForm) }}

      {# Disparador de Toasts en cas d'errors retornats pel servidor Symfony #}
      {% if not registrationForm.vars.valid %}
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            if (window.RegistralsToast) {
              {% if registrationForm.email.vars.errors|length > 0 %}
                window.RegistralsToast.show(
                  'Correu ja registrat',
                  '{{ registrationForm.email.vars.errors[0].message|e('js') }}',
                  'error',
                  6000
                );
              {% else %}
                window.RegistralsToast.show(
                  'Dades Incompletes o Incorrectes',
                  'Revisa els camps marcats en vermell per continuar amb el registre.',
                  'error',
                  5000
                );
              {% endif %}
            }
          });
        </script>
      {% endif %}

      {# Separador O continuar amb #}
      <div class="my-5 flex items-center gap-3">
        <div class="flex-1 h-px bg-steel/20"></div>
        <span class="text-xs uppercase tracking-wider text-ink/60 font-semibold">o bé</span>
        <div class="flex-1 h-px bg-steel/20"></div>
      </div>

      {# Botons Socials: Google & Apple alineats en horitzontal #}
      <div class="max-w-xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <a href="{{ path('connect_google_start') }}" class="w-full py-2.5 px-4 bg-white hover:bg-cream/40 text-ink font-semibold rounded-xl border border-steel/30 shadow-xs hover:shadow transition-all flex items-center justify-center gap-2.5 text-xs sm:text-sm font-raleway">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Registra't amb Google</span>
        </a>

        {# Botó Apple ID: estil blanc/crema unificat en paral·lel #}
        <a href="#" id="btn-apple-register" role="button" onclick="event.preventDefault(); event.stopPropagation(); if (window.RegistralsToast) { window.RegistralsToast.show('Registre amb Apple ID', 'Aquesta funcionalitat estarà disponible properament. Gràcies pel teu interès!', 4500); } fetch('{{ path('api_track_feature_interest') }}', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ feature: 'apple_id', origin: 'register_button' }) }).catch(function(){}); return false;" class="w-full py-2.5 px-4 bg-white hover:bg-cream/40 text-ink font-semibold rounded-xl border border-steel/30 shadow-xs hover:shadow transition-all flex items-center justify-center gap-2.5 text-xs sm:text-sm font-raleway cursor-pointer select-none">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="#1D2F4B">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.76 1.04-1.82.92-2.87-.9.04-2 .6-2.64 1.36-.57.65-1.06 1.73-.93 2.76 1.01.08 2.03-.49 2.65-1.25z"/>
          </svg>
          <span>Registra't amb Apple</span>
        </a>
      </div>

      <div class="mt-6 pt-4 border-t border-cream text-center">
        <p class="text-xs sm:text-sm text-ink/80">
          Ja disposes d'un compte actiu?
          <a href="{{ path('app_login') }}" class="text-gold hover:underline font-bold ml-1">Inicia sessió aquí</a>
        </p>
      </div>
    </div>
  </main>

  {# Peu de pàgina #}
  <footer class="w-full max-w-7xl mx-auto py-2 text-center text-xs text-ink/70 font-medium">
    <p>&copy; {{ "now"|date("Y") }} Registrals &middot; Compliment de privacitat RGPD i xifrat de dades en repòs.</p>
  </footer>

</div>
{% endblock %}
