{% extends 'base.html.twig' %}

{% block title %}El meu Perfil & Dades — Registrals{% endblock %}
{% block meta_description %}Gestió de dades personals, fiscals i de seguretat del titular a Registrals.{% endblock %}

{% block body_class %}bg-cream-50 text-ink min-h-screen flex flex-col justify-between selection:bg-gold selection:text-ink font-raleway{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col justify-between bg-cream-50">

  {# Barra Superior Privada Unificada #}
  {% include 'partials/_private_header.html.twig' %}

  <main class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-8 py-3.5 sm:py-5 w-full flex-1 pb-20 md:pb-5">

    {# Capçalera Notarial Canònica de Subpàgina (Opció B: Contextual) #}
    {% include 'partials/_subpage_header.html.twig' with {
      breadcrumbs: [
        { label: 'Inici', url: path('app_dashboard') },
        { label: 'Perfil' }
      ],
      title: 'El meu Perfil & Dades',
      subtitle: 'Identificació fiscal, credencials i paràmetres de seguretat del titular registrat.',
      badge: user.plan ? '<span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-white border border-gold/40 text-ink shadow-2xs">' ~ user.plan.name ~ '</span>' : null,
      nav_prev_url: null,
      nav_next_url: path('app_plan'),
      nav_next_label: 'El meu Pla'
    } %}

    {% include 'partials/_persistent_flashes.html.twig' with { margin_class: 'mb-3' } %}

    {# Graella Principal Compacta (8 cols / 4 cols) #}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-3.5 sm:gap-4 items-start">

      {# Columna Esquerra: Formularis (8 de 12) #}
      <div class="lg:col-span-8 space-y-3 sm:space-y-3.5">

        {# Targeta 1: Dades Personals & Fiscals #}
        <div class="bg-white rounded-xl border border-steel/20 shadow-2xs p-4 sm:p-5">
          {{ form_start(profileForm) }}
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-2.5 mb-3 border-b border-steel/15 gap-2.5">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-cream flex items-center justify-center text-gold shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
                <div>
                  <h2 class="font-marcellus text-sm sm:text-base text-ink">Dades Personals & Fiscals</h2>
                </div>
              </div>

              <button type="submit" class="w-full sm:w-auto px-4 py-2 sm:py-1.5 rounded-lg bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-raleway font-bold text-xs uppercase tracking-wider shadow-2xs transition-all cursor-pointer min-h-[44px] sm:min-h-0 flex items-center justify-center">
                Desar Dades
              </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 text-xs">
              <div>
                {{ form_label(profileForm.firstName, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                {{ form_widget(profileForm.firstName) }}
                {{ form_errors(profileForm.firstName, {'attr': {'class': 'text-[10px] text-red-600 mt-0.5'}}) }}
              </div>
              <div>
                {{ form_label(profileForm.lastName, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                {{ form_widget(profileForm.lastName) }}
                {{ form_errors(profileForm.lastName, {'attr': {'class': 'text-[10px] text-red-600 mt-0.5'}}) }}
              </div>
              <div>
                {{ form_label(profileForm.email, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                {{ form_widget(profileForm.email) }}
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 text-xs mt-2.5">
              <div>
                {{ form_label(profileForm.taxId, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                {{ form_widget(profileForm.taxId) }}
                {{ form_errors(profileForm.taxId, {'attr': {'class': 'text-[10px] text-red-600 mt-0.5'}}) }}
              </div>
              <div>
                {{ form_label(profileForm.phone, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                {{ form_widget(profileForm.phone) }}
                {{ form_errors(profileForm.phone, {'attr': {'class': 'text-[10px] text-red-600 mt-0.5'}}) }}
              </div>
              <div>
                {{ form_label(profileForm.countryCode, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                {{ form_widget(profileForm.countryCode) }}
                {{ form_errors(profileForm.countryCode, {'attr': {'class': 'text-[10px] text-red-600 mt-0.5'}}) }}
              </div>
            </div>
          {{ form_end(profileForm) }}
        </div>

        {# Targeta 2: Seguretat d'Accés #}
        <div class="bg-white rounded-xl border border-steel/20 shadow-2xs p-4 sm:p-5">
          <div class="flex items-center gap-2 pb-2.5 mb-3 border-b border-steel/15">
            <div class="w-7 h-7 rounded-lg bg-cream flex items-center justify-center text-gold shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            <div>
              <h2 class="font-marcellus text-sm sm:text-base text-ink">Seguretat d'Accés</h2>
            </div>
          </div>

          {% if isOAuthUser %}
            <div class="p-3 rounded-lg bg-cream/40 border border-gold/30 flex items-center gap-3">
              <div class="w-7 h-7 rounded-full bg-white flex items-center justify-center shadow-2xs shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
              </div>
              <div class="text-xs">
                <span class="font-bold text-ink">Compte protegit amb Google Workspace (OAuth2)</span>
                <span class="text-ink/70 block text-[11px] mt-0.5">La verificació de doble factor (2FA) i les credencials estan gestionades directament pel teu compte de Google.</span>
              </div>
            </div>
          {% else %}
            {{ form_start(passwordForm) }}
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 text-xs">
                <div>
                  {{ form_label(passwordForm.currentPassword, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                  <div class="relative">
                    {{ form_widget(passwordForm.currentPassword) }}
                    {% include 'partials/_password_toggle_button.html.twig' with { target_id: passwordForm.currentPassword.vars.id, icon_class: 'w-4 h-4', btn_class: 'pr-2.5' } %}
                  </div>
                  {{ form_errors(passwordForm.currentPassword, {'attr': {'class': 'text-[10px] text-red-600 mt-0.5'}}) }}
                </div>
                <div>
                  {{ form_label(passwordForm.newPassword.first, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                  <div class="relative">
                    {{ form_widget(passwordForm.newPassword.first) }}
                    {% include 'partials/_password_toggle_button.html.twig' with { target_id: passwordForm.newPassword.first.vars.id, icon_class: 'w-4 h-4', btn_class: 'pr-2.5' } %}
                  </div>
                  {{ form_errors(passwordForm.newPassword.first, {'attr': {'class': 'text-[10px] text-red-600 mt-0.5'}}) }}
                </div>
                <div>
                  {{ form_label(passwordForm.newPassword.second, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                  <div class="relative">
                    {{ form_widget(passwordForm.newPassword.second) }}
                    {% include 'partials/_password_toggle_button.html.twig' with { target_id: passwordForm.newPassword.second.vars.id, icon_class: 'w-4 h-4', btn_class: 'pr-2.5' } %}
                  </div>
                  {{ form_errors(passwordForm.newPassword.second, {'attr': {'class': 'text-[10px] text-red-600 mt-0.5'}}) }}
                </div>
              </div>

              <div class="pt-2.5 flex justify-end">
                <button type="submit" class="w-full sm:w-auto px-4 py-2 sm:py-1.5 rounded-lg bg-white border border-steel/30 text-ink hover:border-gold hover:text-gold font-raleway font-bold text-xs uppercase tracking-wider shadow-2xs transition-all cursor-pointer min-h-[44px] sm:min-h-0 flex items-center justify-center">
                  Actualitzar Contrasenya
                </button>
              </div>
            {{ form_end(passwordForm) }}

            {# Verificació en Dos Passos Opcional (2FA per Correu Electrònic) #}
            <div class="mt-4 pt-4 border-t border-steel/15">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="space-y-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="font-marcellus text-xs sm:text-sm text-ink">Autenticació en Dos Passos (2FA per Correu)</h3>
                    {% if user.twoFactorEnabled %}
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 text-[10px] font-mono font-bold border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Activat
                      </span>
                    {% else %}
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-cream/60 text-steel text-[10px] font-mono font-bold border border-steel/25">
                        Desactivat (per defecte)
                      </span>
                    {% endif %}
                  </div>
                  <p class="text-[11px] text-ink/70 leading-snug font-raleway">
                    {% if user.twoFactorEnabled %}
                      En cada inici de sessió amb contrasenya t'enviarem un codi temporal de 6 dígits a <code>{{ user.email }}</code>.
                    {% else %}
                      Opcionalment, activa el doble factor per rebre un codi numèric de 6 dígits al teu correu cada vegada que entris.
                    {% endif %}
                  </p>
                </div>

                <form method="post" action="{{ path('app_profile_toggle_2fa') }}" class="shrink-0">
                  <input type="hidden" name="_token" value="{{ csrf_token('profile_toggle_2fa') }}">
                  <button type="submit" class="w-full sm:w-auto px-4 py-2 sm:py-1.5 rounded-lg font-raleway font-bold text-xs uppercase tracking-wider shadow-2xs transition-all cursor-pointer min-h-[44px] sm:min-h-0 flex items-center justify-center {{ user.twoFactorEnabled ? 'bg-white border border-red-200 text-red-700 hover:bg-red-50' : 'bg-ink text-gold border border-gold/40 hover:bg-ink/90' }}">
                    {{ user.twoFactorEnabled ? 'Desactivar 2FA' : 'Activar 2FA per Correu' }}
                  </button>
                </form>
              </div>
            </div>
          {% endif %}
        </div>

        {# Targeta 3: Herència Digital & Persona de Confiança #}
        <div id="herencia-digital" class="bg-white rounded-xl border border-gold/35 shadow-2xs p-4 sm:p-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-2.5 mb-3 border-b border-steel/15 gap-2">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-lg bg-cream flex items-center justify-center text-gold shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h2 class="font-marcellus text-sm sm:text-base text-ink">Herència Digital &amp; Persona de Confiança</h2>
                <p class="text-[11px] text-ink/65 font-raleway">Designació consentida conforme a l'Art. 96 LOPDGDD (no substitueix un testament civil).</p>
              </div>
            </div>

            {% if user.plan and user.plan.allowLegacyDesignation %}
              <span class="px-2 py-0.5 rounded-full bg-cream border border-gold/40 text-[10px] font-mono font-bold text-ink shrink-0">
                {{ legacyEligibility.usedSlots|default(0) }} / {{ legacyEligibility.maxSlots|default(1) >= 9999 or legacyEligibility.maxSlots|default(1) == -1 ? '∞' : legacyEligibility.maxSlots|default(1) }} places
              </span>
            {% else %}
              <span class="px-2 py-0.5 rounded-full bg-cream/70 border border-steel/25 text-[10px] font-mono font-bold text-steel shrink-0">
                Funció Pla Plus
              </span>
            {% endif %}
          </div>

          {% if not (user.plan and user.plan.allowLegacyDesignation) %}
            <div class="border-l-[3.5px] border-gold bg-gold/10 p-3.5 rounded-r-xl text-xs text-ink/85 leading-relaxed flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <strong>Continuïtat Patrimonial del Pla Plus:</strong> Designa una persona de confiança amb consentiment confirmat perquè pugui sol·licitar el traspàs successori acreditat dels teus béns custodiats.
              </div>
              <a href="{{ path('app_plan') }}" class="px-3.5 py-2 rounded-lg bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-bold text-[11px] uppercase tracking-wider shrink-0 text-center">
                Passar al Pla Plus →
              </a>
            </div>
          {% else %}
            <div class="border-l-[3.5px] border-gold bg-gold/10 p-3 rounded-r-xl text-[11px] text-ink/80 leading-relaxed mb-3.5">
              <strong>Privadesa per Disseny (Art. 14 RGPD):</strong> La persona designada rebrà un correu de confirmació amb la identitat del titular i l'enllaç d'acceptació o rebuig, però <strong>mai no es divulga cap bé, fotografia ni valor econòmic</strong> abans d'un expedient validat.
            </div>

            {% if legacyContacts is defined and legacyContacts is not empty %}
              <div class="space-y-2.5 mb-4">
                {% for lc in legacyContacts %}
                  <div class="p-3 rounded-xl border {{ lc.status.isAccepted ? 'border-emerald-300 bg-emerald-50/40' : (lc.status.isPending ? 'border-amber-300 bg-amber-50/30' : 'border-steel/20 bg-cream-50/50') }} flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-xs">
                    <div class="min-w-0">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-bold text-ink truncate">{{ lc.fullName }}</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold border {{ lc.status.badgeClasses }}">
                          {{ lc.status.label }}
                        </span>
                      </div>
                      <div class="text-[11px] text-ink/70 font-mono mt-0.5 break-all">
                        {{ lc.email }}{% if lc.relationship %} · <span class="font-raleway">{{ lc.relationship }}</span>{% endif %}
                      </div>
                      <div class="text-[10px] text-steel mt-0.5">
                        Designació: {{ lc.ownerConsentAt|date('d/m/Y H:i') }}
                        {% if lc.contactConsentedAt %} · Resposta: {{ lc.contactConsentedAt|date('d/m/Y H:i') }}{% endif %}
                      </div>
                    </div>

                    {% if not lc.status.isTerminated %}
                      <div class="flex items-center gap-2 shrink-0 flex-wrap justify-end">
                        {% if lc.status.isAccepted and legacyCertEligibility is defined and legacyCertEligibility is not null %}
                          {% if legacyCertEligibility.canIssue and not legacyCertEligibility.alreadyUpToDate %}
                            <form method="post" action="{{ path('app_certificate_legacy_issue') }}">
                              <input type="hidden" name="_token" value="{{ csrf_token('legacy_certificate_issue') }}">
                              <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-ink text-gold border border-gold/40 hover:bg-ink/90 text-[11px] font-bold uppercase tracking-wider transition-colors cursor-pointer">
                                {{ legacyCertEligibility.isSnapshotStale ? '↻ Actualitzar Certificat' : '📜 Emetre Certificat' }}
                              </button>
                            </form>
                          {% elseif legacyCertEligibility.latestValidCert %}
                            <a href="{{ path('app_certificate_direct_download', { uuid: legacyCertEligibility.latestValidCert.uuid }) }}"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="px-2.5 py-1.5 rounded-lg bg-ink text-gold border border-gold/40 hover:bg-ink/90 text-[11px] font-bold uppercase tracking-wider transition-colors">
                              Veure Certificat →
                            </a>
                          {% endif %}
                        {% endif %}
                        {% if lc.status.isPending %}
                          <form method="post" action="{{ path('app_profile_legacy_resend', {uuid: lc.uuid.toRfc4122}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('legacy_resend_' ~ lc.uuid.toRfc4122) }}">
                            <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-white border border-steel/30 text-ink hover:border-gold hover:text-gold text-[11px] font-bold uppercase tracking-wider transition-colors cursor-pointer">
                              Reenviar
                            </button>
                          </form>
                        {% endif %}
                        <button type="button"
                                onclick="openLegacyRevokeModal('{{ path('app_profile_legacy_revoke', {uuid: lc.uuid.toRfc4122}) }}', '{{ csrf_token('legacy_revoke_' ~ lc.uuid.toRfc4122) }}', '{{ lc.fullName|e('js') }}')"
                                class="px-2.5 py-1.5 rounded-lg bg-white border border-red-200 text-red-700 hover:bg-red-50 text-[11px] font-bold uppercase tracking-wider transition-colors cursor-pointer">
                          Revocar
                        </button>
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            {% endif %}

            {% if legacyEligibility is defined and not legacyEligibility.allowed %}
              {% if legacyEligibility.reason == 'missing_full_name' %}
                <div class="p-3 rounded-lg bg-amber-50 border border-amber-200 text-xs text-amber-900">
                  <strong>Nom real obligatori:</strong> Desa el teu <strong>Nom</strong> i <strong>Cognoms</strong> al bloc superior de Dades Personals abans de designar una persona de confiança.
                </div>
              {% elseif legacyEligibility.reason == 'quota_reached' %}
                <p class="text-[11px] text-steel">
                  Tens totes les places de persona de confiança assignades. Per designar una persona diferent, revoca primer la designació actual.
                </p>
              {% endif %}
            {% elseif legacyForm is defined and legacyForm is not null %}
              {{ form_start(legacyForm) }}
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 text-xs">
                  <div>
                    {{ form_label(legacyForm.fullName, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                    {{ form_widget(legacyForm.fullName) }}
                    {{ form_errors(legacyForm.fullName, {'attr': {'class': 'text-[10px] text-red-600 mt-0.5'}}) }}
                  </div>
                  <div>
                    {{ form_label(legacyForm.email, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                    {{ form_widget(legacyForm.email) }}
                    {{ form_errors(legacyForm.email, {'attr': {'class': 'text-[10px] text-red-600 mt-0.5'}}) }}
                  </div>
                  <div>
                    {{ form_label(legacyForm.relationship, null, {'label_attr': {'class': 'block text-[11px] font-semibold text-ink/80 mb-0.5'}}) }}
                    {{ form_widget(legacyForm.relationship) }}
                    {{ form_errors(legacyForm.relationship, {'attr': {'class': 'text-[10px] text-red-600 mt-0.5'}}) }}
                  </div>
                </div>

                <label class="mt-3 flex items-start gap-2.5 p-2.5 rounded-lg bg-cream-50/70 border border-steel/15 cursor-pointer text-[11px] text-ink/85 leading-snug">
                  {{ form_widget(legacyForm.ownerConsent, {'attr': {'class': 'mt-0.5 w-4 h-4 rounded border-steel/30 text-ink focus:ring-gold shrink-0'}}) }}
                  <span>{{ legacyForm.ownerConsent.vars.label }}</span>
                </label>

                <div class="pt-3 flex justify-end">
                  <button type="submit" class="w-full sm:w-auto px-4 py-2 sm:py-1.5 rounded-lg bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-raleway font-bold text-xs uppercase tracking-wider shadow-2xs transition-all cursor-pointer min-h-[44px] sm:min-h-0 flex items-center justify-center">
                    Designar &amp; Enviar Invitació →
                  </button>
                </div>
              {{ form_end(legacyForm) }}
            {% endif %}
          {% endif %}

          {% if incomingLegacyContacts is defined and incomingLegacyContacts is not empty %}
            <div class="mt-5 pt-4 border-t border-steel/15 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <h3 class="font-marcellus text-base text-ink">Designacions rebudes com a Persona de Confiança</h3>
                  <p class="font-raleway text-[11px] text-steel">Titulars que t'han designat per custodiar la seva continuïtat patrimonial (Art. 96 LOPDGDD).</p>
                </div>
                <span class="px-2 py-0.5 rounded-full bg-cream border border-gold/40 text-ink font-mono text-[10px] font-semibold">
                  {{ incomingLegacyContacts|length }} {{ incomingLegacyContacts|length == 1 ? 'designació' : 'designacions' }}
                </span>
              </div>

              <div class="border-l-[3.5px] border-gold bg-gold/10 p-3 rounded-r-lg text-xs text-ink/85 font-raleway leading-relaxed">
                <strong>Privadesa patrimonial (Art. 14 RGPD):</strong> Aquesta secció confirma exclusivament la teva condició de persona designada. No mostra ni dóna accés als béns, valors ni certificats del titular mentre el compte romangui actiu.
              </div>

              <div class="space-y-2.5">
                {% for incoming in incomingLegacyContacts %}
                  {% set incomingUuid = incoming.uuid.toRfc4122 %}
                  <div class="rounded-xl border border-steel/20 bg-cream-50/70 p-3.5 space-y-2.5">
                    <div class="flex flex-wrap items-start justify-between gap-2">
                      <div>
                        <div class="font-marcellus text-sm text-ink">{{ incoming.owner.fullName }}</div>
                        <div class="font-raleway text-[11px] text-steel">
                          {% if incoming.relationship %}
                            Vinculació indicada: <span class="text-ink font-medium">{{ incoming.relationship }}</span>
                          {% else %}
                            Persona de Confiança designada
                          {% endif %}
                        </div>
                      </div>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full border text-[10px] font-semibold font-raleway {{ incoming.status.badgeClasses }}">
                        {{ incoming.status.label }}
                      </span>
                    </div>

                    <div class="font-raleway text-[11px] text-steel flex flex-wrap items-center gap-x-3 gap-y-1">
                      {% if incoming.status.isPending %}
                        <span>Invitació rebuda el {{ incoming.createdAt|date('d/m/Y') }}</span>
                        {% if incoming.invitationExpiresAt %}
                          <span>· Vàlida fins al {{ incoming.invitationExpiresAt|date('d/m/Y H:i') }}</span>
                        {% endif %}
                      {% elseif incoming.status.isAccepted %}
                        <span>Consentiment confirmat el {{ (incoming.contactConsentedAt ?? incoming.createdAt)|date('d/m/Y H:i') }}</span>
                      {% endif %}
                    </div>

                    <div class="flex flex-wrap items-center justify-end gap-2 pt-1.5 border-t border-steel/10">
                      {% if incoming.status.isPending %}
                        <form method="post" action="{{ path('app_profile_legacy_incoming_decline', {uuid: incomingUuid}) }}">
                          <input type="hidden" name="_token" value="{{ csrf_token('legacy_incoming_decline_' ~ incomingUuid) }}">
                          <button type="submit" class="px-3 py-1.5 rounded-lg border border-steel/30 bg-white hover:bg-cream-50 text-ink font-raleway font-semibold text-xs transition-all cursor-pointer min-h-[40px] sm:min-h-0">
                            Refusar
                          </button>
                        </form>
                        <form method="post" action="{{ path('app_profile_legacy_incoming_accept', {uuid: incomingUuid}) }}">
                          <input type="hidden" name="_token" value="{{ csrf_token('legacy_incoming_accept_' ~ incomingUuid) }}">
                          <button type="submit" class="px-3.5 py-1.5 rounded-lg bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-raleway font-bold text-xs transition-all cursor-pointer min-h-[40px] sm:min-h-0">
                            Acceptar Designació →
                          </button>
                        </form>
                      {% elseif incoming.status.isAccepted %}
                        <button
                          type="button"
                          onclick="openLegacyRenounceModal('{{ path('app_profile_legacy_incoming_renounce', {uuid: incomingUuid}) }}', '{{ csrf_token('legacy_incoming_renounce_' ~ incomingUuid) }}', '{{ incoming.owner.fullName|e('js') }}')"
                          class="px-3 py-1.5 rounded-lg border border-red-200 bg-white hover:bg-red-50 text-red-700 font-raleway font-semibold text-xs transition-all cursor-pointer min-h-[40px] sm:min-h-0"
                        >
                          Renunciar al rol (Art. 7.3 RGPD)
                        </button>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>

      </div>

      {# Columna Dreta: Credencial Notarial i Garantia (4 de 12) #}
      <div class="lg:col-span-4 space-y-3 sm:space-y-3.5">

        {# Caixa Notarial de Credencial #}
        <div class="bg-white rounded-xl border border-gold/30 shadow-2xs p-4 sm:p-4.5">
          <div class="flex items-center justify-between pb-2 mb-2.5 border-b border-steel/15">
            <h3 class="font-marcellus text-sm text-ink">Credencial de Certificació</h3>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-mono font-semibold border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Activa
            </span>
          </div>

          <div class="space-y-2.5 text-xs">
            <div>
              <span class="text-[10px] uppercase font-mono tracking-wider text-ink/50 block">UUID Titular</span>
              <span class="font-mono text-ink text-[10px] font-semibold break-all bg-cream/30 p-1 rounded-md block mt-0.5 border border-steel/15">
                {{ user.uuid }}
              </span>
            </div>

            <div class="grid grid-cols-2 gap-2 pt-1">
              <div>
                <span class="text-[10px] uppercase font-mono tracking-wider text-ink/50 block">Alta al Registre</span>
                <span class="font-bold text-ink text-xs">{{ user.createdAt|date('d/m/Y') }}</span>
              </div>
              <div>
                <span class="text-[10px] uppercase font-mono tracking-wider text-ink/50 block">Verificació KYC</span>
                <span class="font-semibold text-amber-700 text-xs capitalize">{{ user.kycStatus.value }}</span>
              </div>
            </div>

            <div class="pt-2 border-t border-steel/10 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase font-mono tracking-wider text-ink/50 block">Pla Actiu</span>
                <span class="font-bold text-ink text-xs">{{ user.plan ? user.plan.name : 'Administrador del Sistema' }}</span>
              </div>
              <a href="{{ path('app_plan') }}" class="text-[10px] font-bold text-gold hover:underline font-raleway uppercase tracking-wider">
                Pla & Facturació →
              </a>
            </div>

            <div class="pt-2 border-t border-steel/10 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase font-mono tracking-wider text-ink/50 block">Correu Electrònic</span>
                {% if user.emailVerified %}
                  <span class="font-bold text-emerald-800 text-xs flex items-center gap-1">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                    <span>Verificat</span>
                    <span class="text-[10px] font-mono text-steel font-normal">{{ user.emailVerifiedAt|date('d/m/Y') }}</span>
                  </span>
                {% else %}
                  <span class="font-bold text-amber-700 text-xs flex items-center gap-1">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    <span>Pendent de verificar</span>
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="pt-2 border-t border-steel/10 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase font-mono tracking-wider text-ink/50 block">Clàusules de Certificació</span>
                {% if user.legalTermsAcceptedAt %}
                  <span class="font-bold text-emerald-800 text-xs flex items-center gap-1">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                    <span>Acceptades ({{ user.legalTermsVersion }})</span>
                    <span class="text-[10px] font-mono text-steel font-normal">{{ user.legalTermsAcceptedAt|date('d/m/Y H:i') }}</span>
                  </span>
                {% else %}
                  <span class="font-bold text-amber-700 text-xs flex items-center gap-1">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    <span>Pendent</span>
                  </span>
                {% endif %}
              </div>
              <a href="{{ path('app_legal_view_clauses') }}" class="text-[10px] font-bold text-gold hover:text-ink hover:underline font-raleway uppercase tracking-wider shrink-0">
                Veure clàusules →
              </a>
            </div>
          </div>
        </div>

        {# Caixa Blava Notarial Ink #}
        <div class="bg-ink text-cream border border-gold/40 rounded-xl p-3 sm:p-3.5 shadow-md relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-gold to-transparent opacity-80"></div>
          <div class="flex items-center gap-1.5 pb-1 mb-1 border-b border-gold/20">
            <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <h4 class="font-marcellus text-xs text-white tracking-wide">Vinculació Jurídica</h4>
          </div>
          <p class="text-cream/85 text-[11px] leading-snug font-raleway">
            El teu NIF/CIF i nom complet queden indissolublement vinculats als segellats eIDAS i Polygon L2 davant tercers i traspassos.
          </p>
        </div>

        {# Targeta d'IA Sobirana & Marc Legal #}
        <div class="bg-white rounded-xl border border-steel/20 shadow-2xs p-3.5 sm:p-4">
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-steel/15">
            <div class="flex items-center gap-1.5">
              <span class="text-gold text-sm">⚡</span>
              <h3 class="font-marcellus text-xs sm:text-sm text-ink font-bold">IA Sobirana & Marc Legal</h3>
            </div>
            <span class="px-1.5 py-0.5 rounded-full bg-cream text-ink text-[9px] font-mono font-bold border border-gold/30">Local</span>
          </div>
          <p class="text-[11px] text-ink/75 leading-snug font-raleway mb-2.5">
            Model de visió OCR executat en infraestructura pròpia sense transferència a tercers (AI Act & RGPD).
          </p>
          <a href="{{ path('app_legal_ai_sovereign') }}" class="w-full py-1.5 px-3 rounded-lg bg-cream/70 hover:bg-cream border border-gold/40 text-ink text-xs font-semibold flex items-center justify-between transition-colors shadow-2xs group">
            <span class="text-[11px]">Compromís i Marc Legal</span>
            <span class="text-gold font-bold group-hover:translate-x-0.5 transition-transform">→</span>
          </a>
        </div>

        {# Botó de Tancar Sessió #}
        <div class="pt-1">
          <a href="{{ path('app_logout') }}" class="w-full py-2.5 px-4 rounded-xl bg-white border border-red-200 hover:bg-red-50 text-red-700 text-xs font-bold font-raleway flex items-center justify-center gap-2 transition-colors shadow-2xs min-h-[44px]">
            <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            <span>Tancar Sessió</span>
          </a>
        </div>

      </div>

    </div>

  </main>

  {# Barra Inferior Dinàmica PWA per a Mòbil #}
  {% include 'partials/_pwa_bottom_nav.html.twig' with {'active_tab': 'profile'} %}

</div>

{# Modal Institucional PWA Dual per Revocar Persona de Confiança #}
<div id="modal-legacy-revoke" class="hidden fixed inset-0 z-50 bg-ink/75 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 transition-all duration-200" onclick="if (event.target === this) closeLegacyRevokeModal();">
  <div class="bg-white rounded-t-3xl sm:rounded-2xl border-t sm:border border-gold/40 shadow-2xl max-w-md w-full max-h-[90vh] sm:max-h-[92vh] overflow-hidden relative flex flex-col">
    <div class="sm:hidden w-10 h-1 bg-steel/30 rounded-full mx-auto mt-2 -mb-1 shrink-0"></div>
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>

    <div class="p-4 sm:p-5 border-b border-steel/15 flex items-center justify-between gap-3">
      <h3 class="font-marcellus text-lg text-ink flex items-center gap-2">
        <span class="w-6 h-6 rounded-full bg-red-50 text-red-700 flex items-center justify-center text-xs font-bold">!</span>
        <span id="legacy-modal-title">Revocar Persona de Confiança</span>
      </h3>
      <button type="button" onclick="closeLegacyRevokeModal()" class="text-steel hover:text-ink p-1 rounded-lg transition-colors cursor-pointer" aria-label="Tancar">✕</button>
    </div>

    <div class="p-4 sm:p-5 font-raleway text-xs sm:text-sm text-ink/85 leading-relaxed overflow-y-auto space-y-3">
      <p>
        <span id="legacy-modal-prefix">Estàs a punt de revocar la designació de </span><strong id="legacy-revoke-contact-name" class="text-ink"></strong><span id="legacy-modal-suffix">.</span>
      </p>
      <div class="border-l-[3.5px] border-gold bg-gold/10 p-3 rounded-r-lg text-xs text-ink/85">
        <strong id="legacy-modal-note-title">Efecte immediat:</strong>
        <span id="legacy-modal-note-body">Aquesta persona perdrà l'enllaç o el consentiment vigent i qualsevol Certificat d'Inventari Global de Llegat vinculat quedarà revocat automàticament.</span>
      </div>
    </div>

    <form id="legacy-revoke-form" method="post" action="" class="p-4 bg-cream-50/60 border-t border-steel/15 flex items-center justify-end gap-2.5">
      <input type="hidden" name="_token" id="legacy-revoke-csrf" value="">
      <button type="button" onclick="closeLegacyRevokeModal()" class="bg-cream hover:bg-cream/80 text-ink text-xs font-semibold px-4 py-2 rounded-xl transition-all cursor-pointer">
        Cancel·lar
      </button>
      <button type="submit" id="legacy-modal-submit" class="bg-red-700 hover:bg-red-800 text-white font-bold text-xs px-4 py-2 rounded-xl shadow-xs transition-all cursor-pointer">
        Confirmar Revocació
      </button>
    </form>
  </div>
</div>

<script>
  function openLegacyConfirmModal(config) {
    const modal = document.getElementById('modal-legacy-revoke');
    document.getElementById('legacy-revoke-form').action = config.actionUrl;
    document.getElementById('legacy-revoke-csrf').value = config.csrfToken;
    document.getElementById('legacy-modal-title').textContent = config.title;
    document.getElementById('legacy-modal-prefix').textContent = config.prefix;
    document.getElementById('legacy-revoke-contact-name').textContent = config.targetName;
    document.getElementById('legacy-modal-suffix').textContent = config.suffix;
    document.getElementById('legacy-modal-note-title').textContent = config.noteTitle;
    document.getElementById('legacy-modal-note-body').textContent = config.noteBody;
    document.getElementById('legacy-modal-submit').textContent = config.submitLabel;
    modal.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  }
  function openLegacyRevokeModal(actionUrl, csrfToken, contactName) {
    openLegacyConfirmModal({
      actionUrl: actionUrl,
      csrfToken: csrfToken,
      title: 'Revocar Persona de Confiança',
      prefix: 'Estàs a punt de revocar la designació de ',
      targetName: contactName,
      suffix: '.',
      noteTitle: 'Efecte immediat:',
      noteBody: 'Aquesta persona perdrà l\'enllaç o el consentiment vigent i qualsevol Certificat d\'Inventari Global de Llegat vinculat quedarà revocat automàticament.',
      submitLabel: 'Confirmar Revocació'
    });
  }
  function openLegacyRenounceModal(actionUrl, csrfToken, ownerName) {
    openLegacyConfirmModal({
      actionUrl: actionUrl,
      csrfToken: csrfToken,
      title: 'Renunciar com a Persona de Confiança',
      prefix: 'Confirmes que vols retirar el teu consentiment (Art. 7.3 RGPD) per a la designació de ',
      targetName: ownerName,
      suffix: '?',
      noteTitle: 'Efecte irreversible:',
      noteBody: 'Es notificarà el titular per correu electrònic i qualsevol Certificat d\'Inventari Global de Llegat vinculat a aquesta designació quedarà revocat automàticament.',
      submitLabel: 'Confirmar Renúncia'
    });
  }
  function closeLegacyRevokeModal() {
    const modal = document.getElementById('modal-legacy-revoke');
    if (modal && !modal.classList.contains('hidden')) {
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      closeLegacyRevokeModal();
    }
  });
</script>
{% endblock %}
