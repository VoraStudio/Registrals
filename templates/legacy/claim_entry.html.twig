{% extends 'base.html.twig' %}

{% block title %}
  {% if state == 'valid' %}
    Canal d'Obertura Successòria {{ certificate.certificateNumber }} — Registrals
  {% else %}
    Certificat Successori No Vàlid — Registrals
  {% endif %}
{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body_class %}bg-cream-50 text-ink antialiased min-h-screen flex flex-col font-raleway{% endblock %}

{% block body %}
<header class="bg-white border-b border-steel/20 sticky top-0 z-40 shadow-xs">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-3 sm:py-3.5 flex items-center justify-between gap-2">
    <a href="{{ path('app_home') }}" class="flex items-center gap-2 sm:gap-2.5 group shrink-0">
      <img src="{{ asset('img/logos/Isotip/1-transparent.svg') }}" alt="Registrals" class="w-7 h-7 sm:w-8 sm:h-8 group-hover:scale-105 transition-transform shrink-0" />
      <span class="font-marcellus text-lg sm:text-xl text-ink tracking-wide whitespace-nowrap">REGISTRALS</span>
    </a>
    <span class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-[10px] sm:text-xs font-semibold uppercase tracking-wider bg-ink text-gold border border-gold/30 whitespace-nowrap shrink-0">
      Custòdia Successòria
    </span>
  </div>
</header>

<main class="flex-1 max-w-3xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-10">
  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="mb-4 rounded-2xl border p-3.5 text-xs sm:text-sm font-raleway {{ label == 'error' ? 'bg-red-50 border-red-200 text-red-900' : (label == 'warning' ? 'bg-amber-50 border-amber-200 text-amber-900' : 'bg-emerald-50 border-emerald-200 text-emerald-900') }}">
        {{ message }}
      </div>
    {% endfor %}
  {% endfor %}

  {% if state == 'invalid' %}
    <div class="bg-white rounded-3xl border border-steel/20 shadow-xl p-8 text-center relative overflow-hidden">
      <div class="h-1 bg-red-600 absolute top-0 inset-x-0"></div>
      <h1 class="font-marcellus text-2xl text-ink mb-2">Enllaç Successori No Vàlid</h1>
      <p class="text-sm text-steel mb-6">
        Aquest codi QR no correspon a cap Certificat d'Inventari Global de Llegat registrat o el testimoni criptogràfic és incorrecte.
      </p>
      <a href="{{ path('app_home') }}" class="inline-flex items-center px-5 py-2.5 rounded-xl bg-ink text-gold text-xs font-bold uppercase tracking-wider">
        Tornar a Registrals
      </a>
    </div>
  {% elseif state in ['revoked', 'superseded'] %}
    <div class="bg-white rounded-3xl border border-red-200 shadow-xl p-8 relative overflow-hidden">
      <div class="h-1 bg-red-600 absolute top-0 inset-x-0"></div>
      <div class="text-xs font-mono uppercase tracking-wider text-red-700 font-bold mb-1">
        {{ state == 'revoked' ? 'Certificat Revocat' : 'Certificat Superat per Nova Versió' }} · {{ certificate.certificateNumber }}
      </div>
      <h1 class="font-marcellus text-2xl text-ink mb-3">Document No Apte per a Tramitació Successòria</h1>
      <p class="text-sm text-ink/80 leading-relaxed mb-5">
        {% if state == 'revoked' %}
          Aquest Certificat d'Inventari Global de Llegat va quedar revocat automàticament arran de la revocació o renúncia de la Persona de Confiança vinculada.
        {% else %}
          El titular va emetre una versió posterior actualitzada d'aquest inventari global. Cal escanejar el codi QR del certificat vigent més recent.
        {% endif %}
      </p>
      <div class="border-l-[3.5px] border-gold bg-gold/10 p-3.5 rounded-r-xl text-xs text-ink/85">
        <strong>Seguretat jurídica:</strong> Per protegir la voluntat actualitzada del titular, els documents revocats o superats no admeten l'obertura d'expedients post-mortem.
      </div>
    </div>
  {% else %}
    <div class="bg-white rounded-3xl border border-gold/40 shadow-xl overflow-hidden">
      <div class="h-1.5 bg-gradient-to-r from-ink via-gold to-ink"></div>
      <div class="p-5 sm:p-8 border-b border-steel/15 bg-cream-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="text-[11px] font-mono uppercase tracking-widest text-steel font-bold">
            Certificat d'Inventari Global de Llegat · {{ certificate.certificateNumber }}
          </div>
          <h1 class="font-marcellus text-2xl sm:text-3xl text-ink mt-1">Canal d'Obertura d'Expedient Successori</h1>
        </div>
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-bold shrink-0 self-start sm:self-center">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          DOCUMENT VIGENT
        </span>
      </div>

      <div class="p-5 sm:p-8 space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div class="p-3.5 rounded-xl bg-cream-50 border border-steel/15">
            <span class="block text-[10px] uppercase tracking-wider font-bold text-steel">Titular Registrat</span>
            <span class="font-mono font-bold text-ink mt-1 block">{{ maskedOwnerName }}</span>
          </div>
          <div class="p-3.5 rounded-xl bg-cream-50 border border-steel/15">
            <span class="block text-[10px] uppercase tracking-wider font-bold text-steel">Persona de Confiança</span>
            <span class="font-mono font-bold text-ink mt-1 block">{{ maskedContactName ?? 'Confirmada' }}</span>
          </div>
          <div class="p-3.5 rounded-xl bg-cream-50 border border-steel/15">
            <span class="block text-[10px] uppercase tracking-wider font-bold text-steel">Abast de Custòdia</span>
            <span class="font-marcellus text-base font-bold text-ink mt-0.5 block">{{ itemsCount }} {{ itemsCount == 1 ? 'bé actiu' : 'béns actius' }}</span>
          </div>
        </div>

        {% if activeClaim is defined and activeClaim is not null %}
          {# EXPEDIENT JA REGISTRAT #}
          <div class="rounded-2xl border border-gold/40 bg-cream-50/70 p-5 space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-steel/15 pb-3">
              <div>
                <div class="text-[11px] font-mono text-steel uppercase">Expedient Obert</div>
                <div class="font-marcellus text-xl text-ink">{{ activeClaim.claimReference }}</div>
              </div>
              <span class="px-3 py-1 rounded-full border text-xs font-bold {{ activeClaim.status.badgeClasses }}">
                {{ activeClaim.status.label }}
              </span>
            </div>

            {% if activeClaim.status.value == 'pending_payment' %}
              <p class="text-xs sm:text-sm text-ink/85 leading-relaxed">
                Els dos documents acreditatius han quedat desats sota custòdia privada (SHA-256 verificat). Només falta abonar la taxa d'obertura i auditoria documental per iniciar el termini preventiu de <strong>72 hores</strong> i enviar l'expedient a la cua del gestor.
              </p>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-[11px] font-mono bg-white p-3.5 rounded-xl border border-steel/15">
                <div>
                  <span class="block text-steel uppercase text-[10px]">SHA-256 Cert. Defunció</span>
                  <span class="text-ink break-all">{{ activeClaim.deathCertificateSha256|slice(0, 24) }}…</span>
                </div>
                <div>
                  <span class="block text-steel uppercase text-[10px]">SHA-256 Títol Successori</span>
                  <span class="text-ink break-all">{{ activeClaim.successionTitleSha256|slice(0, 24) }}…</span>
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
                <form method="post" action="{{ path('app_legacy_claim_reset', { token: token }) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('legacy_claim_reset_' ~ token) }}">
                  <button type="submit" class="px-3.5 py-2 rounded-xl border border-steel/30 bg-white hover:bg-cream-50 text-xs font-semibold text-steel cursor-pointer">
                    Cancelar i reiniciar
                  </button>
                </form>

                <form method="post" action="{{ path('app_legacy_claim_checkout', { token: token }) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('legacy_claim_pay_' ~ token) }}">
                  <input type="hidden" name="claim_uuid" value="{{ activeClaim.uuid.toRfc4122 }}">
                  <button type="submit" class="px-5 py-3 rounded-xl bg-ink text-gold border border-gold/50 hover:bg-ink/90 font-bold text-xs sm:text-sm uppercase tracking-wider shadow-md transition-all cursor-pointer">
                    Abonar {{ (openingFeeCents / 100)|number_format(2, ',', '.') }} € i Activar Revisió →
                  </button>
                </form>
              </div>
            {% else %}
              <div class="border-l-[3.5px] border-gold bg-gold/10 p-4 rounded-r-xl text-xs text-ink/85 leading-relaxed space-y-1.5">
                <div><strong>Estat de la tramitació:</strong> Taxa abonada ({{ (activeClaim.openingFeePaidCents / 100)|number_format(2, ',', '.') }} €).</div>
                {% if activeClaim.securityHoldUntil %}
                  <div><strong>Finestra preventiva anti-frau (72 h):</strong> Activa fins al <strong>{{ activeClaim.securityHoldUntil|date('d/m/Y H:i') }} UTC</strong>.</div>
                {% endif %}
                <div>T'informarem a <strong>{{ activeClaim.claimantEmail }}</strong> tan bon punt el gestor humà resolgui l'expedient.</div>
              </div>
            {% endif %}
          </div>

        {% elseif otpState is defined and otpState is not null and otpState.verifiedAt %}
          {# PAS 2: CÀRREGA SEGURA A FLYSYSTEM #}
          <div class="space-y-4">
            <div class="flex items-center justify-between gap-2 border-b border-steel/15 pb-3">
              <div>
                <div class="text-[11px] font-mono text-emerald-700 font-bold uppercase">Pas 2 de 3 · Identitat Verificada ({{ otpState.maskedEmail }})</div>
                <h2 class="font-marcellus text-xl text-ink">Aportació de Documentació Oficial</h2>
              </div>
              <form method="post" action="{{ path('app_legacy_claim_reset', { token: token }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('legacy_claim_reset_' ~ token) }}">
                <button type="submit" class="text-xs text-steel underline hover:text-ink cursor-pointer">Canviar correu</button>
              </form>
            </div>

            <div class="border-l-[3.5px] border-gold bg-gold/10 p-3.5 rounded-r-xl text-xs text-ink/85 leading-relaxed">
              <strong>Custòdia privada (Flysystem + SHA-256):</strong> Els documents carregats s'emmagatzemen aïllats fora del servidor web públic i només són consultables pel gestor autoritzat de l'expedient. Formats admesos: <code>PDF</code>, <code>JPG</code>, <code>PNG</code> o <code>WebP</code> (màx. 15 MB cadascun).
            </div>

            <form method="post" action="{{ path('app_legacy_claim_upload', { token: token }) }}" enctype="multipart/form-data" class="space-y-4">
              <input type="hidden" name="_token" value="{{ csrf_token('legacy_claim_upload_' ~ token) }}">

              <div>
                <label for="death_certificate" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                  1. Certificat Oficial de Defunció *
                </label>
                <input type="file" id="death_certificate" name="death_certificate" required accept=".pdf,image/jpeg,image/png,image/webp"
                       class="w-full rounded-xl border border-steel/30 bg-cream-50/50 px-3.5 py-2.5 text-xs text-ink file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-ink file:text-gold file:font-bold file:text-xs cursor-pointer">
              </div>

              <div>
                <label for="succession_title" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                  2. Títol Successori (Últimes Voluntats / Testament / Declaració d'Hereus) *
                </label>
                <input type="file" id="succession_title" name="succession_title" required accept=".pdf,image/jpeg,image/png,image/webp"
                       class="w-full rounded-xl border border-steel/30 bg-cream-50/50 px-3.5 py-2.5 text-xs text-ink file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-ink file:text-gold file:font-bold file:text-xs cursor-pointer">
              </div>

              <div class="pt-2 flex justify-end">
                <button type="submit" class="w-full sm:w-auto px-5 py-3 rounded-xl bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-bold text-xs uppercase tracking-wider shadow-md transition-all cursor-pointer">
                  Pujar Documents i Continuar al Pagament →
                </button>
              </div>
            </form>
          </div>

        {% elseif otpState is defined and otpState is not null %}
          {# PAS 1B: VALIDACIÓ CODI OTP #}
          <div class="space-y-4">
            <div class="border-b border-steel/15 pb-3 flex items-center justify-between gap-2">
              <div>
                <div class="text-[11px] font-mono text-gold font-bold uppercase">Pas 1 de 3 · Verificació per Correu (OTP)</div>
                <h2 class="font-marcellus text-xl text-ink">Introdueix el codi enviat a {{ otpState.maskedEmail }}</h2>
              </div>
              <form method="post" action="{{ path('app_legacy_claim_reset', { token: token }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('legacy_claim_reset_' ~ token) }}">
                <button type="submit" class="text-xs text-steel underline hover:text-ink cursor-pointer">Editar dades</button>
              </form>
            </div>

            <form method="post" action="{{ path('app_legacy_claim_verify_otp', { token: token }) }}" class="space-y-4">
              <input type="hidden" name="_token" value="{{ csrf_token('legacy_claim_verify_otp_' ~ token) }}">
              <div>
                <label for="otp_code" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">Codi de 6 dígits *</label>
                <input type="text" id="otp_code" name="otp_code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus
                       placeholder="000000"
                       class="w-full sm:w-56 text-center tracking-[0.4em] font-mono text-xl font-bold rounded-xl border border-steel/30 bg-cream-50/50 px-4 py-3 text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold">
              </div>

              <div class="flex flex-wrap items-center gap-3">
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-bold text-xs uppercase tracking-wider cursor-pointer">
                  Confirmar Codi →
                </button>
              </div>
            </form>
          </div>

        {% else %}
          {# PAS 1A: IDENTIFICACIÓ INICIAL + SOL·LICITUD D'OTP #}
          <div class="border-l-[3.5px] border-gold bg-gold/10 p-4 rounded-r-xl text-xs text-ink/85 leading-relaxed space-y-1.5">
            <div><strong>Procediment acreditat de tramitació successòria:</strong></div>
            <div>1. Verificació d'identitat del sol·licitant mitjançant codi OTP de 6 dígits al correu electrònic.</div>
            <div>2. Aportació custodiada del <strong>Certificat Oficial de Defunció</strong> i del <strong>Títol Successori</strong> (darreres voluntats, testament o declaració d'hereus).</div>
            <div>3. Taxa d'obertura i auditoria documental: <strong>{{ (openingFeeCents / 100)|number_format(2, ',', '.') }} €</strong>, amb <strong>finestra preventiva de seguretat de 72 hores</strong> abans de la resolució per part de l'equip de gestió de custòdia.</div>
          </div>

          <form method="post" action="{{ path('app_legacy_claim_send_otp', { token: token }) }}" class="space-y-4 pt-1">
            <input type="hidden" name="_token" value="{{ csrf_token('legacy_claim_otp_' ~ token) }}">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div class="sm:col-span-2">
                <label for="claimant_name" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">Nom i Cognoms del Sol·licitant *</label>
                <input type="text" id="claimant_name" name="claimant_name" required value="{{ prefillName }}"
                       placeholder="Ex. Maria Puig Soler"
                       class="w-full rounded-xl border border-steel/30 bg-cream-50/40 px-3.5 py-2.5 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold">
              </div>

              <div>
                <label for="claimant_email" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">Correu Electrònic de Contacte *</label>
                <input type="email" id="claimant_email" name="claimant_email" required value="{{ prefillEmail }}"
                       placeholder="nom@exemple.cat"
                       class="w-full rounded-xl border border-steel/30 bg-cream-50/40 px-3.5 py-2.5 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold">
              </div>

              <div>
                <label for="claimant_tax_id" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">NIF / NIE / Passaport *</label>
                <input type="text" id="claimant_tax_id" name="claimant_tax_id" required maxlength="30"
                       placeholder="Ex. 12345678Z"
                       class="w-full rounded-xl border border-steel/30 bg-cream-50/40 px-3.5 py-2.5 text-sm text-ink uppercase font-mono focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold">
              </div>
            </div>

            <div class="pt-1 flex justify-end">
              <button type="submit" class="w-full sm:w-auto px-5 py-3 rounded-xl bg-ink text-gold border border-gold/40 hover:bg-ink/90 font-bold text-xs uppercase tracking-wider shadow-md transition-all cursor-pointer">
                Iniciar i Verificar Correu (OTP) →
              </button>
            </div>
          </form>
        {% endif %}

        <div class="pt-3 flex flex-col sm:flex-row items-center justify-between gap-2 border-t border-steel/15 text-xs text-steel">
          <span>Aquest canal no exposa béns ni valors sense expedient documental validat.</span>
          <a href="{{ path('app_verify_certificate', { uuid: certificate.uuid.toRfc4122 }) }}" class="text-ink font-semibold underline hover:text-gold">
            Comprovar vigència pública eIDAS →
          </a>
        </div>
      </div>
    </div>
  {% endif %}
</main>
{% endblock %}
